<view class="sn-preview-card" hover-class="sn-preview-card--pressed" hover-stay-time="80" bindtap="onOpen">
  <view class="sn-preview-stage">
    <image class="sn-preview-sat" src="/images/space-notices/china-sat-preview.jpg" mode="scaleToFill" />
    <canvas type="2d" id="snPreviewCanvas" class="sn-preview-canvas"></canvas>
    <view class="sn-china-hud">
      <text class="sn-china-hud-title">{{title}}</text>
      <text class="sn-china-hud-sub">{{hint}}</text>
    </view>
  </view>
</view>
