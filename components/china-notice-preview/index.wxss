.sn-preview-card {
  position: relative;
  padding: 0;
  overflow: hidden;
  border-radius: 24rpx;
}
.sn-preview-card--pressed {
  opacity: 0.92;
}
.sn-preview-stage {
  position: relative;
  height: 560rpx;
  overflow: hidden;
  border-radius: 24rpx;
  background: #071018;
}
.sn-preview-sat,
.sn-preview-canvas {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  display: block;
  border-radius: 24rpx;
}
.sn-preview-canvas {
  pointer-events: none;
}
.sn-china-hud {
  position: absolute;
  left: 16rpx;
  right: 16rpx;
  bottom: 16rpx;
  padding: 16rpx 20rpx;
  border-radius: 14rpx;
  background-color: rgba(8, 10, 14, 0.72);
  pointer-events: none;
}
.sn-china-hud-title {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #ffffff;
  line-height: 1.35;
}
.sn-china-hud-sub {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.72);
  line-height: 1.35;
}
