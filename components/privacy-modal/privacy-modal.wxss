/* root-portal 真机上脱离页面 DOM 树，styles/tokens.wxss 里 page{} / .theme-light 的变量继承不进来
   （开发者工具能继承、真机不能），var(--color-text-*) 会全部解析失败回退成近黑色，浅色主题下
   白卡压黑字尚可、深色主题下黑字压深卡就“看不见”。故与 morning-briefing / net-change-modal 同法：
   深色 token 直接定义在 .privacy-modal-root 上，浅色由 .theme-light 覆盖（themeClass 由组件 JS 挂上）。 */
.privacy-modal-root {
  --bg-glass-popup: rgba(22, 24, 28, 0.85);
  --bg-glass: rgba(22, 24, 28, 0.85);
  --color-bg-card: #16181C;
  --color-text-primary: #F5F5F7;
  --color-text-secondary: #8E8E93;
  --color-divider: rgba(255, 255, 255, 0.08);
  --color-divider-faint: rgba(255, 255, 255, 0.04);
  --color-border-glass: rgba(255, 255, 255, 0.1);
  --privacy-accent: rgba(64, 156, 255, 0.92);
  --radius-card: 32rpx;
  position: fixed;
  inset: 0;
  /* 需压过弹窗广告(100000)/开屏(99999)/太空简报(12000)，保证任何时点弹出都在最上层 */
  z-index: 200000;
}

.privacy-modal-root--closing {
  opacity: 0;
}

.privacy-modal-root--closing .privacy-modal-mask,
.privacy-modal-root--closing .privacy-modal-panel {
  backdrop-filter: none;
  -webkit-backdrop-filter: none;
}

.privacy-modal-root.theme-light {
  --bg-glass-popup: rgba(255, 255, 255, 0.88);
  --bg-glass: rgba(255, 255, 255, 0.88);
  --color-bg-card: #FFFFFF;
  --color-text-primary: #1C1C1E;
  --color-text-secondary: #6E6E73;
  --color-divider: rgba(0, 0, 0, 0.07);
  --color-divider-faint: rgba(0, 0, 0, 0.04);
  --color-border-glass: rgba(0, 0, 0, 0.06);
  /* 白卡上 rgba(64,156,255,.92) 对比度不足，浅色改用更深的品牌蓝 */
  --privacy-accent: #2563EB;
}

/* 授权确认前的全屏禁触层：透明不影响开屏视觉，仅吞触控；低于弹窗本体(200000)，
   也低于开屏「跳过」按钮(200000)——跳过是安全操作且能加速隐私弹窗弹出，不应被禁触 */
.privacy-gate-blocker {
  position: fixed;
  inset: 0;
  z-index: 199999;
  background: transparent;
}

.privacy-modal-mask {
  position: absolute;
  inset: 0;
  background: rgba(0, 0, 0, 0.68);
  backdrop-filter: blur(8rpx);
  -webkit-backdrop-filter: blur(8rpx);
}

.privacy-modal-panel {
  position: absolute;
  left: 32rpx;
  right: 32rpx;
  top: 50%;
  transform: translateY(-50%);
  padding: 36rpx 32rpx 32rpx;
  border-radius: 32rpx;
  background: var(--bg-glass-popup, rgba(22, 24, 28, 0.85));
  backdrop-filter: blur(32rpx) saturate(150%);
  -webkit-backdrop-filter: blur(32rpx) saturate(150%);
  box-sizing: border-box;
}

.privacy-modal-header {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.privacy-modal-title {
  font-size: 36rpx;
  line-height: 1.3;
  color: var(--color-text-primary);
  font-weight: 700;
}

.privacy-modal-subtitle {
  font-size: 26rpx;
  line-height: 1.7;
  color: var(--color-text-secondary);
}

.privacy-modal-body {
  margin-top: 28rpx;
}

.privacy-modal-card {
  padding: 24rpx;
  border-radius: 24rpx;
  background: var(--color-divider-faint);
}

.privacy-modal-card-title {
  display: block;
  margin-bottom: 14rpx;
  font-size: 28rpx;
  color: var(--color-text-primary);
  font-weight: 600;
}

.privacy-modal-card-text {
  display: block;
  font-size: 24rpx;
  line-height: 1.8;
  color: var(--color-text-secondary);
}

.privacy-modal-scene {
  display: block;
  margin-top: 18rpx;
  font-size: 22rpx;
  color: var(--privacy-accent);
}

.privacy-modal-tip {
  display: block;
  margin-top: 18rpx;
  font-size: 22rpx;
  line-height: 1.7;
  color: var(--color-text-secondary);
}

.privacy-modal-actions {
  margin-top: 30rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.privacy-btn {
  width: 100%;
  height: 88rpx;
  border-radius: 999rpx;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.privacy-btn::after {
  border: none;
}

.privacy-btn-primary {
  background: linear-gradient(135deg, #07C160 0%, #06AD56 100%);
  color: #ffffff;
  font-weight: 600;
}

.privacy-btn-primary--pressed {
  opacity: 0.88;
}

.privacy-btn--pressed {
  opacity: 0.72;
}

.privacy-btn-ghost {
  background: var(--color-divider);
  color: var(--color-text-primary);
  border: 1px solid var(--color-border-glass);
}

.privacy-btn-secondary {
  background: transparent;
  color: var(--color-text-secondary);
  border: 1px solid var(--color-divider);
}
