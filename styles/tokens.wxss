/* styles/tokens.wxss — 全局设计 Token（低饱和科技简约）
 * 在 page{} 定义，借助 DOM 继承被所有页面与自定义组件共享（不受组件样式隔离影响），分包页面同样可用。
 * 颜色经 WCAG AA 校准：正文 ≥ 4.5:1，大字 ≥ 3:1。
 */
page {
  /* —— 背景：深空灰 / 冷黑 —— */
  --color-bg: #0B0C0E;
  --color-bg-page: linear-gradient(180deg, #0B0C0E 0%, #121418 100%);
  --color-bg-card: #16181C;
  --color-bg-elevated: #1A1C20;
  --bg-glass: rgba(22, 24, 28, 0.72);
  --bg-glass-nav: rgba(12, 14, 18, 0.55);
  --bg-glass-strong: rgba(12, 14, 18, 0.12);
  --bg-ai-soft: rgba(0, 122, 255, 0.08);
  --bg-microlight: radial-gradient(ellipse 80% 40% at 50% 0%, rgba(0, 122, 255, 0.08) 0%, transparent 70%);

  /* —— 文字 —— */
  --color-text-primary: #F5F5F7;
  --color-text-secondary: #8E8E93;
  --color-text-tertiary: #6E6E73;
  --color-text-quaternary: #5A5A5E;
  --color-text-on-glass: rgba(245, 245, 247, 0.92);
  --color-text-on-inverse: #F5F5F7;

  /* —— 品牌：单一低明度浅蓝点缀 —— */
  --color-brand: #3B82F6;
  --color-brand-soft: rgba(59, 130, 246, 0.22);
  --color-brand-glow: rgba(59, 130, 246, 0.35);
  --color-success: #34C759;
  --color-warning: #FF9500;
  --color-danger: #FF3B30;

  /* —— 分隔线 / 描边 —— */
  --color-divider: rgba(255, 255, 255, 0.08);
  --color-divider-strong: rgba(255, 255, 255, 0.12);
  --color-divider-faint: rgba(255, 255, 255, 0.04);
  --color-border-glass: rgba(255, 255, 255, 0.1);

  /* —— 字号阶梯（rpx）：主次靠字号/字重，少辅助小字 —— */
  --font-size-2xs: 18rpx;
  --font-size-xs: 20rpx;
  --font-size-sm: 22rpx;
  --font-size-base: 28rpx;
  --font-size-md: 30rpx;
  --font-size-lg: 32rpx;
  --font-size-xl: 36rpx;
  --font-size-2xl: 40rpx;
  --font-size-display: 52rpx;

  /* —— 行高 & 字重 —— */
  --line-height-tight: 1.25;
  --line-height-normal: 1.55;
  --line-height-relaxed: 1.7;
  --font-weight-regular: 400;
  --font-weight-medium: 500;
  --font-weight-semibold: 600;
  --font-weight-bold: 700;

  /* —— 圆角：柔和浅圆角 —— */
  --radius-sm: 12rpx;
  --radius-md: 16rpx;
  --radius-card: 20rpx;
  --radius-lg: 28rpx;
  --radius-xl: 36rpx;
  --radius-pill: 999rpx;
  --radius-circle: 50%;

  /* —— 间距：放大留白，降低密度 —— */
  --space-2xs: 10rpx;
  --space-xs: 16rpx;
  --space-sm: 20rpx;
  --space-md: 28rpx;
  --space-lg: 36rpx;
  --space-xl: 48rpx;
  --space-2xl: 64rpx;
  --space-3xl: 80rpx;

  /* —— 阴影：极淡柔和 —— */
  --shadow-card: 0 4rpx 16rpx rgba(0, 0, 0, 0.18);
  --shadow-glass-inset: inset 0 1rpx 0 rgba(255, 255, 255, 0.06);
  --shadow-tabbar: 0 4rpx 20rpx rgba(0, 0, 0, 0.2), inset 0 1rpx 0 rgba(255, 255, 255, 0.1);
  --shadow-ai-glow: 0 0 24rpx rgba(59, 130, 246, 0.18);
  /* 弹窗磨砂底：透明度较高，真机 backdrop-filter 在全屏弹层失效时仍保证可读 */
  --bg-glass-popup: rgba(22, 24, 28, 0.85);

  /* —— 玻璃模糊（降饱和/半径，控制合成成本）—— */
  --blur-card: blur(24rpx) saturate(140%);
  --blur-nav: blur(32rpx) saturate(140%);
  --blur-strong: blur(40rpx) saturate(160%);

  --icon-invert: 0;
}

/* ============================================================
 * 明亮主题：冷白 / 浅中性
 * ============================================================ */
.theme-light {
  --color-bg: #F4F5F7;
  --color-bg-page: linear-gradient(180deg, #F4F5F7 0%, #EBEDF0 100%);
  --color-bg-card: #FFFFFF;
  --color-bg-elevated: #FFFFFF;
  --bg-glass: rgba(255, 255, 255, 0.78);
  --bg-glass-nav: rgba(244, 245, 247, 0.78);
  --bg-glass-strong: rgba(255, 255, 255, 0.7);
  --bg-ai-soft: rgba(59, 130, 246, 0.06);
  --bg-microlight: radial-gradient(ellipse 80% 40% at 50% 0%, rgba(59, 130, 246, 0.06) 0%, transparent 70%);

  --color-text-primary: #1C1C1E;
  --color-text-secondary: #6E6E73;
  --color-text-tertiary: #8E8E93;
  --color-text-quaternary: #AEAEB2;
  --color-text-on-glass: rgba(28, 28, 30, 0.92);
  --color-text-on-inverse: #F5F5F7;

  --color-brand: #3B82F6;
  --color-brand-soft: rgba(59, 130, 246, 0.12);
  --color-brand-glow: rgba(59, 130, 246, 0.2);
  --color-success: #34C759;
  --color-warning: #FF9500;
  --color-danger: #FF3B30;

  --color-divider: rgba(0, 0, 0, 0.07);
  --color-divider-strong: rgba(0, 0, 0, 0.1);
  --color-divider-faint: rgba(0, 0, 0, 0.04);
  --color-border-glass: rgba(0, 0, 0, 0.06);

  --shadow-card: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
  --shadow-glass-inset: inset 0 0 0 rgba(0, 0, 0, 0);
  --shadow-tabbar: 0 2rpx 16rpx rgba(0, 0, 0, 0.06);
  --shadow-ai-glow: 0 0 20rpx rgba(59, 130, 246, 0.12);
  --bg-glass-popup: rgba(255, 255, 255, 0.88);

  --icon-invert: 1;
}
