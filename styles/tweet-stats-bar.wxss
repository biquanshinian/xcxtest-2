/* 今日各账号更新统计：progress 页与 morning-briefing（styleIsolation: apply-shared）共用 */

.tweet-stats-bar {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-xs);
  margin-bottom: var(--space-md);
}

.tweet-stat-item {
  display: flex;
  align-items: center;
  padding: 12rpx 18rpx;
  background: var(--color-divider-faint);
  border-radius: var(--radius-pill);
  border: 1px solid var(--color-divider);
  max-width: 100%;
  overflow: hidden;
}

.tweet-stat-avatar {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  margin-right: 10rpx;
  flex-shrink: 0;
  overflow: hidden;
}

.tweet-stat-name {
  font-size: var(--font-size-sm);
  color: var(--color-text-secondary);
  margin-right: 10rpx;
}

.tweet-stat-count {
  font-size: var(--font-size-xs);
  color: var(--color-brand);
  font-weight: var(--font-weight-semibold);
}

/* 简报弹窗内无数据提示（仅 morning-briefing 使用） */
.tweet-stat-briefing-empty {
  width: 100%;
  padding: 8rpx 0 4rpx;
}

.tweet-stat-briefing-empty-text {
  font-size: 22rpx;
  color: var(--color-text-tertiary, rgba(255, 255, 255, 0.35));
}
