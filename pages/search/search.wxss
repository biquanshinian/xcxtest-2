page {
  height: 100vh;
  background: #0B0C0E;
}

.search-page {
  min-height: 100vh;
  height: 100vh;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  background: var(--color-bg-page);
  overflow: hidden;
}

.search-page-main {
  flex: 1;
  min-height: 0;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
}

/* ========== 搜索头部 ========== */

.search-header {
  flex-shrink: 0;
  padding: 20rpx 32rpx 28rpx;
  display: flex;
  align-items: center;
  gap: 24rpx;
}

/* 简洁搜索条：纯色圆角灰底 + 左侧放大镜，无边框 */
.search-input-wrap {
  flex: 1;
  min-width: 0;
  height: 76rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 0 24rpx;
  background: rgba(255, 255, 255, 0.08);
  border-radius: 24rpx;
  transition: background 200ms;
}

.search-input-wrap:focus-within {
  background: rgba(255, 255, 255, 0.1);
}

.search-icon-prefix {
  flex-shrink: 0;
  display: flex;
  align-items: center;
}

.search-icon-glass {
  font-size: 34rpx;
  color: rgba(255, 255, 255, 0.35);
  line-height: 1;
}

.search-input {
  flex: 1;
  min-width: 0;
  height: 76rpx;
  color: var(--color-text-primary, #fff);
  font-size: 30rpx;
  line-height: 76rpx;
}

.search-placeholder {
  color: rgba(255, 255, 255, 0.32);
  font-size: 28rpx;
}

.search-input-clear {
  flex-shrink: 0;
  width: 40rpx;
  height: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.12);
}

.search-input-clear text {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.5);
  line-height: 1;
}

.search-cancel-btn {
  flex-shrink: 0;
  font-size: 30rpx;
  color: var(--color-brand);
  font-weight: 600;
  padding: 10rpx 4rpx;
}

/* ========== 滚动区域 ========== */

.search-scroll-wrap {
  flex: 1;
  min-height: 0;
  display: flex;
  flex-direction: column;
}

.search-results {
  flex: 1;
  height: 100%;
  padding: 8rpx 32rpx 48rpx;
  box-sizing: border-box;
  overflow-x: hidden;
}

/* ========== 搜索面板 ========== */

.search-panel {
  display: flex;
  flex-direction: column;
  gap: 44rpx;
}

/* 摘要区：去卡片化，纯文字分层 */
.search-panel-top {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  padding: 8rpx 4rpx 0;
}

.search-panel-summary {
  font-size: 26rpx;
  line-height: 1.6;
  color: var(--color-text-secondary, rgba(255, 255, 255, 0.55));
}

.search-panel-context,
.search-panel-count {
  font-size: 22rpx;
  color: var(--color-text-tertiary, rgba(255, 255, 255, 0.38));
}

/* ========== 搜索历史 & 推荐 ========== */

.search-section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
  padding: 0 4rpx;
}

.search-section-title {
  font-size: 28rpx;
  color: var(--color-text-primary, rgba(255, 255, 255, 0.92));
  font-weight: 600;
}

.search-section-action {
  font-size: 22rpx;
  color: var(--color-text-tertiary, rgba(255, 255, 255, 0.38));
}

.search-section-action:active {
  color: var(--color-text-secondary, rgba(255, 255, 255, 0.55));
}

.search-chip-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

/* 词条统一中性灰底，仅前三名序号用品牌蓝点缀 */
.search-chip {
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 14rpx 24rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.06);
  transition: transform 100ms, background 100ms;
}

.search-chip:active {
  transform: scale(0.96);
  background: rgba(255, 255, 255, 0.1);
}

.search-chip text {
  font-size: 24rpx;
  color: var(--color-text-secondary, rgba(255, 255, 255, 0.72));
  line-height: 1.2;
}

.search-chip-rank {
  font-size: 20rpx;
  font-weight: 700;
  color: var(--color-brand);
  min-width: 22rpx;
}

/* ========== 加载 & 空状态 ========== */

.search-loading {
  width: 100%;
  padding: 80rpx 0;
  text-align: center;
  font-size: 26rpx;
  color: var(--color-text-tertiary, rgba(255, 255, 255, 0.38));
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
}

.search-loading-spinner {
  width: 32rpx;
  height: 32rpx;
  border: 3rpx solid rgba(59, 130, 246, 0.2);
  border-top-color: var(--color-brand);
  border-radius: 50%;
  animation: search-spin 0.7s linear infinite;
}

@keyframes search-spin {
  to { transform: rotate(360deg); }
}

.search-empty {
  width: 100%;
  padding: 100rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
}

.search-empty-icon {
  font-size: 64rpx;
  opacity: 0.4;
  margin-bottom: 8rpx;
}

.search-empty-text {
  font-size: 28rpx;
  color: var(--color-text-tertiary, rgba(255, 255, 255, 0.38));
  text-align: center;
}

.search-empty-suggestion {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 24rpx;
  color: var(--color-text-tertiary, rgba(255, 255, 255, 0.38));
  margin-top: 8rpx;
}

.search-empty-link {
  color: var(--color-brand);
}

/* ========== 搜索结果分组 ========== */

.search-related-section {
  width: 100%;
}

.search-related-divider {
  display: flex;
  align-items: center;
  gap: 18rpx;
  margin: 16rpx 0 32rpx;
}

.search-related-line {
  flex: 1;
  height: 1px;
  background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.08), transparent);
}

.search-related-label {
  font-size: 22rpx;
  color: var(--color-text-tertiary, rgba(255, 255, 255, 0.38));
  white-space: nowrap;
}

.search-group {
  margin-bottom: 44rpx;
  width: 100%;
  box-sizing: border-box;
}

/* 分组标题：纯文字分层（主标题粗、副标题淡），不再按类型着色 */
.search-group-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 20rpx;
  padding: 0 4rpx;
  gap: 16rpx;
}

.search-group-title {
  font-size: 30rpx;
  color: var(--color-text-primary, #fff);
  font-weight: 600;
  flex: 1;
  min-width: 0;
}

.search-group-subtitle {
  font-size: 22rpx;
  color: var(--color-text-tertiary, rgba(255, 255, 255, 0.38));
  flex-shrink: 0;
}

/* ========== 搜索结果卡片 ==========
 * 统一中性底，无侧条、无类型彩底、无边框阴影；
 * 类型差异只保留右上角徽标文案本身。 */

.search-result-item {
  width: 100%;
  padding: 28rpx;
  margin-bottom: 16rpx;
  background: var(--bg-glass, rgba(255, 255, 255, 0.05));
  border-radius: var(--radius-card, 20rpx);
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  position: relative;
  overflow: hidden;
  box-sizing: border-box;
  transition: transform 100ms;
}

.search-result-item:active {
  transform: scale(0.985);
}

.search-result-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.search-result-title-wrap,
.search-result-meta-wrap {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  overflow: hidden;
}

.search-result-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-text-primary, #fff);
  line-height: 1.5;
  word-break: break-word;
}

/* 徽标：统一安静的中性小胶囊 */
.search-result-badge {
  font-size: 20rpx;
  color: var(--color-text-tertiary, rgba(255, 255, 255, 0.45));
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.06);
  flex-shrink: 0;
}

.search-result-meta {
  font-size: 24rpx;
  color: var(--color-text-secondary, rgba(255, 255, 255, 0.5));
  line-height: 1.6;
  word-break: break-word;
}

/* 关键词高亮：全类型统一品牌蓝淡底 */
.search-highlight {
  color: var(--color-text-primary, #fff);
  background: rgba(59, 130, 246, 0.22);
  border-radius: 6rpx;
  padding: 0 4rpx;
  margin: 0 2rpx;
}

.search-highlight--soft {
  color: var(--color-text-secondary, rgba(255, 255, 255, 0.75));
  background: rgba(59, 130, 246, 0.12);
}

.search-result-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 2rpx;
}

.search-result-tag {
  font-size: 20rpx;
  color: var(--color-text-secondary, rgba(255, 255, 255, 0.6));
  padding: 6rpx 14rpx;
  border-radius: 8rpx;
  background: rgba(255, 255, 255, 0.06);
}

/* 匹配说明：弱化为浅灰辅助信息 */
.search-result-reason {
  font-size: 22rpx;
  line-height: 1.5;
  color: var(--color-text-tertiary, rgba(255, 255, 255, 0.38));
}

.search-result-footer {
  display: flex;
  justify-content: flex-end;
}

.search-result-score {
  font-size: 20rpx;
  color: var(--color-text-quaternary, rgba(255, 255, 255, 0.25));
}

/* ========== AI 智能回答卡片 ==========
 * 唯一允许品牌色渲染的区块：极淡蓝底 + 品牌图标，无渐变堆叠、无侧条 */

.ai-answer-card {
  width: 100%;
  margin-bottom: 32rpx;
  padding: 28rpx;
  background: rgba(59, 130, 246, 0.07);
  border-radius: var(--radius-card, 20rpx);
  box-sizing: border-box;
  position: relative;
  overflow: hidden;
}

.ai-answer-head {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.ai-answer-icon-wrap {
  width: 36rpx;
  height: 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(59, 130, 246, 0.16);
  border-radius: 10rpx;
}

.ai-answer-icon {
  font-size: 20rpx;
  color: var(--color-brand);
}

.ai-answer-label {
  font-size: 22rpx;
  font-weight: 600;
  color: var(--color-text-secondary, rgba(255, 255, 255, 0.6));
  letter-spacing: 0.5px;
}

.ai-answer-body {
  padding-left: 4rpx;
}

.ai-answer-text {
  font-size: 28rpx;
  line-height: 1.75;
  color: var(--color-text-primary, rgba(255, 255, 255, 0.88));
  word-wrap: break-word;
  white-space: pre-wrap;
}

.ai-answer-error {
  font-size: 26rpx;
  color: var(--color-danger, rgba(255, 69, 58, 0.75));
}

.ai-answer-loading {
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 8rpx 0;
}

.ai-answer-dot-group {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.ai-answer-dot {
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: var(--color-brand);
  opacity: 0.4;
  animation: aiDotPulse 1.4s ease-in-out infinite;
}

.ai-answer-dot:nth-child(2) { animation-delay: 0.2s; }
.ai-answer-dot:nth-child(3) { animation-delay: 0.4s; }

@keyframes aiDotPulse {
  0%, 80%, 100% { opacity: 0.3; transform: scale(0.8); }
  40% { opacity: 1; transform: scale(1.15); }
}

.ai-answer-loading-text {
  font-size: 24rpx;
  color: var(--color-text-tertiary, rgba(255, 255, 255, 0.35));
}

/* ========== 明亮主题（theme-light）覆盖 ========== */

.theme-light .search-input-wrap {
  background: #FFFFFF;
}

.theme-light .search-input-wrap:focus-within {
  background: #FFFFFF;
}

.theme-light .search-icon-glass {
  color: var(--color-text-tertiary);
}

.theme-light .search-placeholder {
  color: #8E8E93;
}

.theme-light .search-input-clear {
  background: rgba(0, 0, 0, 0.08);
}

.theme-light .search-input-clear text {
  color: var(--color-text-tertiary);
}

.theme-light .search-chip {
  background: rgba(0, 0, 0, 0.05);
}

.theme-light .search-chip:active {
  background: rgba(0, 0, 0, 0.09);
}

.theme-light .search-related-line {
  background: linear-gradient(90deg, transparent, rgba(0, 0, 0, 0.1), transparent);
}

.theme-light .search-result-item {
  background: var(--color-bg-card, #FFFFFF);
}

.theme-light .search-result-badge {
  background: rgba(0, 0, 0, 0.05);
}

.theme-light .search-highlight {
  background: rgba(59, 130, 246, 0.16);
}

.theme-light .search-highlight--soft {
  background: rgba(59, 130, 246, 0.1);
}

.theme-light .search-result-tag {
  background: rgba(0, 0, 0, 0.05);
}

.theme-light .ai-answer-card {
  background: rgba(59, 130, 246, 0.06);
}

.theme-light .ai-answer-error {
  color: #FF3B30;
}
