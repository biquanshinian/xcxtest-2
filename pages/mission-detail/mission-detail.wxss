@import "./fav-btn.wxss";

page {
  background: var(--color-bg-page);
  overflow: hidden;
  height: 100vh;
  width: 100%;
}

.hero-overlay-right {
  display: flex;
  align-items: center;
  gap: 8rpx;
  flex-shrink: 0;
  pointer-events: auto;
}

/* 头图左上：360 + 3D 并排（3D 在全景右边；无全景时 3D 单独占左上） */
.hero-media-btns {
  position: absolute;
  left: 22rpx;
  top: 22rpx;
  z-index: 3;
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  pointer-events: auto;
  transform: scale(0.9);
  transform-origin: left top;
}

.hero-pano-btn,
.hero-3d-btn {
  position: relative;
  width: 80rpx;
  height: 80rpx;
  flex-shrink: 0;
  font-size: 20rpx;
  line-height: 1;
}

.hero-3d-btn {
  height: 102rpx;
}

.hero-pano-btn--pressed,
.hero-3d-btn--pressed {
  opacity: 0.72;
  transform: scale(0.94);
}

.hero-pano-orbit {
  position: absolute;
  left: 4rpx;
  top: 4rpx;
  right: 4rpx;
  bottom: 4rpx;
  border-radius: 50%;
  border: 3rpx solid rgba(255, 255, 255, 0.22);
  border-top-color: #ffffff;
  border-right-color: rgba(255, 255, 255, 0.55);
  box-sizing: border-box;
  animation: hero-pano-spin 1.8s linear infinite;
}

.hero-pano-orbit--tilt {
  left: -2rpx;
  right: -2rpx;
  top: 20rpx;
  bottom: 20rpx;
  border-top-color: rgba(255, 255, 255, 0.95);
  border-bottom-color: rgba(255, 255, 255, 0.28);
  border-left-color: rgba(255, 255, 255, 0.12);
  border-right-color: rgba(255, 255, 255, 0.12);
  animation-duration: 2.8s;
  animation-direction: reverse;
}

.hero-pano-core {
  position: absolute;
  left: 18rpx;
  top: 18rpx;
  right: 18rpx;
  bottom: 18rpx;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.58);
  border: 2rpx solid rgba(255, 255, 255, 0.88);
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.hero-pano-360 {
  font-size: 20rpx;
  font-weight: 800;
  color: #ffffff;
  line-height: 1;
  letter-spacing: -1rpx;
}

@keyframes hero-pano-spin {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

/* 3D 入口：线框正方体只绕 Y 翻面，缩放另层做，避免翻面拉形 */
.hero-3d-scene {
  position: relative;
  width: 80rpx;
  height: 64rpx;
  perspective: 240rpx;
  -webkit-perspective: 240rpx;
  perspective-origin: 50% 50%;
}

.hero-3d-pulse {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 32rpx;
  height: 32rpx;
  margin: -16rpx 0 0 -16rpx;
  transform-origin: center center;
  animation: hero-3d-pulse 5.6s ease-in-out infinite;
}

.hero-3d-cube {
  width: 32rpx;
  height: 32rpx;
  transform-style: preserve-3d;
  -webkit-transform-style: preserve-3d;
  transform-origin: center center;
  transform: rotateX(-20deg) rotateY(24deg);
  animation: hero-3d-flip 5.6s ease-in-out infinite;
}

.hero-3d-face {
  position: absolute;
  left: 0;
  top: 0;
  width: 32rpx;
  height: 32rpx;
  box-sizing: border-box;
  border: 3rpx solid rgba(255, 255, 255, 0.94);
  background: rgba(15, 23, 42, 0.14);
  backface-visibility: visible;
  -webkit-backface-visibility: visible;
}

.hero-3d-face--front {
  transform: translateZ(16rpx);
  border-color: #ffffff;
}

.hero-3d-face--back {
  transform: rotateY(180deg) translateZ(16rpx);
  border-color: rgba(226, 232, 240, 0.72);
}

.hero-3d-face--right {
  transform: rotateY(90deg) translateZ(16rpx);
  border-color: rgba(241, 245, 249, 0.88);
}

.hero-3d-face--left {
  transform: rotateY(-90deg) translateZ(16rpx);
  border-color: rgba(226, 232, 240, 0.78);
}

.hero-3d-face--top {
  transform: rotateX(90deg) translateZ(16rpx);
  border-color: #ffffff;
}

.hero-3d-face--bottom {
  transform: rotateX(-90deg) translateZ(16rpx);
  border-color: rgba(203, 213, 225, 0.7);
}

.hero-3d-cap {
  display: block;
  width: 100%;
  text-align: center;
  font-size: 18rpx;
  font-weight: 700;
  color: #ffffff;
  line-height: 1;
  letter-spacing: 2rpx;
}

@keyframes hero-3d-flip {
  0% {
    transform: rotateX(-20deg) rotateY(24deg);
  }
  22% {
    transform: rotateX(-20deg) rotateY(204deg);
  }
  44% {
    transform: rotateX(-20deg) rotateY(204deg);
  }
  66% {
    transform: rotateX(-20deg) rotateY(384deg);
  }
  100% {
    transform: rotateX(-20deg) rotateY(384deg);
  }
}

@keyframes hero-3d-pulse {
  0%,
  22% {
    transform: scale(1);
  }
  30% {
    transform: scale(0.72);
  }
  40%,
  66% {
    transform: scale(1);
  }
  100% {
    transform: scale(1);
  }
}

/* 头图收藏：与铃铛同款——无圆底、无阴影，爱心与铃铛同大 */
.fav-btn--hero {
  width: 88rpx;
  height: 88rpx;
  background: transparent;
  border: none;
  border-radius: 0;
  box-shadow: none;
  backdrop-filter: none;
  -webkit-backdrop-filter: none;
}

