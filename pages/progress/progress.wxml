<page-meta background-color="{{pageBgColor}}" background-color-top="{{pageBgColor}}" background-color-bottom="{{pageBgColor}}" />
<wxs module="navPad" src="/utils/nav-scroll-pad.wxs"></wxs>
<view class="container {{themeClass}} tab-bg-video-host">
  <view class="tab-bg-shell" aria-hidden="true">
    <view class="tab-bg-cover"></view>
    <view class="tab-bg-frost"></view>
  </view>
  <!-- 顶部导航栏 -->
  <view class="top-nav-wrapper" style="padding-top: {{statusBarHeight}}px;">
    <view class="top-nav top-nav--page-center">
      <text class="nav-title nav-title--page-center">星舰进度</text>
    </view>
  </view>

  <!-- 自定义下拉三点：复用首页样式（app.wxss + nav-scroll-pad.wxs） -->
  <view id="pullRefreshDots" class="pull-refresh-dots" aria-hidden="true">
    <view class="pull-refresh-dots__dot"></view>
    <view class="pull-refresh-dots__dot"></view>
    <view class="pull-refresh-dots__dot"></view>
  </view>

  <scroll-view
    class="content-scroll main-content-scroll nav-aware-scroll"
    scroll-y="{{true}}"
    enhanced="{{true}}"
    bounces="{{true}}"
    refresher-enabled="{{true}}"
    refresher-default-style="none"
    refresher-background="{{pageBgColor}}"
    refresher-threshold="36"
    refresher-triggered="{{scrollRefreshing}}"
    data-nav-h="{{navPlaceholderHeight}}"
    data-refresh-threshold="36"
    bindtouchend="{{navPad.onRelease}}"
    bindtouchcancel="{{navPad.onRelease}}"
    bindrefresherpulling="{{navPad.onPulling}}"
    bindrefresherrestore="{{navPad.onReset}}"
    bindrefresherabort="{{navPad.onReset}}"
    bindrefresherrefresh="onScrollRefresh"
    bindscroll="onProgressScroll"
  >
    
    <nav-scroll-pad id="navScrollPad" class="nav-scroll-pad" height="{{navPlaceholderHeight}}" />

    <!-- 星舰硬件设施（NSF 数据） -->
    <view class="hardware-section">
      <view class="section-title">
        <text>星舰硬件设施</text>
        <view class="section-title-right progress-map-actions">
          <view class="progress-map-btn" bindtap="openStarbaseMap">
            <text>设施图</text>
          </view>
          <view class="progress-map-btn progress-map-btn--blue" bindtap="openLaunchSiteMap">
            <text>发射场</text>
          </view>
          <view class="booster-view-all" hover-class="booster-view-all--pressed" hover-stay-time="120"
                bindtap="onHardwareViewAllTap">
            <text>查看全部</text>
            <text class="booster-view-all-arrow">›</text>
          </view>
        </view>
      </view>

      <!-- 骨架屏 -->
      <view class="hardware-grid" wx:if="{{!hardwareLoaded}}">
        <view class="hardware-card glass-card hardware-card-skeleton skeleton-shimmer" wx:for="{{[0, 1]}}" wx:key="*this"></view>
      </view>

      <block wx:else>
        <!-- 卡片网格 -->
        <view class="hardware-grid" wx:if="{{hardwareVisible.length > 0}}">
          <view
            class="hardware-card glass-card card-hover"
            wx:for="{{hardwareVisible}}"
            wx:key="id"
            data-id="{{item.id}}"
            data-index="{{index}}"
            bindtap="onHardwareCardTap"
          >
            <view class="hardware-card-image-wrap">
              <image
                class="hardware-card-image"
                src="{{item.displayImage}}"
                mode="aspectFill"
                lazy-load="{{true}}"
                data-index="{{index}}"
                binderror="onHardwareImageError"
              ></image>
              <view class="hardware-card-image-mask"></view>
              <view class="hardware-card-overlay">
                <view class="hardware-card-status status-{{item.statusType}}">
                  <view class="status-dot"></view>
                  <text class="status-value">{{item.statusZh}}</text>
                </view>
                <text class="hardware-card-name">{{item.name}}</text>
              </view>
            </view>
            <view class="hardware-card-body">
              <text class="hardware-card-type">{{item.typeZh}}</text>
            </view>
          </view>
        </view>

        <!-- 空态 -->
        <view class="hardware-empty glass-card" wx:if="{{hardwareVisible.length === 0}}">
          <text>{{hardwareError || '没有匹配的硬件，换个关键词试试'}}</text>
        </view>
      </block>
    </view>

    <!-- ══ 事件更新（爱好者追踪）：progress-extra 分包组件 ══
         状态由页面下发；交互经单一 sectionevent 通道回传（detail: { name, dataset, edetail }） -->
    <event-updates
      id="eventUpdatesSection"
      theme-class="{{themeClass}}"
      event-updates="{{eventUpdates}}"
      event-updates-expanded="{{eventUpdatesExpanded}}"
      event-updates-loading="{{eventUpdatesLoading}}"
      event-updates-error="{{eventUpdatesError}}"
      event-updates-no-more="{{eventUpdatesNoMore}}"
      event-scroll-refreshing="{{eventScrollRefreshing}}"
      tweet-account-stats="{{tweetAccountStats}}"
      tweet-stats-chips-has-overflow="{{tweetStatsChipsHasOverflow}}"
      tweet-event-total="{{tweetEventTotal}}"
      is-pro-user="{{isProUser}}"
      pressed-event-id="{{pressedEventId}}"
      enable-event-video="{{enableEventVideo}}"
      enable-live-entry="{{enableLiveEntry}}"
      bind:sectionevent="onProgressSectionEvent"
    />

    <!-- 封路/在轨追踪/指挥室/检查清单：progress-extra 分包 -->
    <progress-below-fold
      below-fold-sections-ready="{{belowFoldSectionsReady}}"
      enable-mission-sim="{{enableMissionSim}}"
      show-launch-library-updates="{{showLaunchLibraryUpdates}}"
      ll2-launch-updates="{{ll2LaunchUpdates}}"
      ll2-launch-updates-error="{{ll2LaunchUpdatesError}}"
      ll2-launch-updates-loading="{{ll2LaunchUpdatesLoading}}"
      ll2-timeline-error="{{ll2TimelineError}}"
      ll2-timeline-loading="{{ll2TimelineLoading}}"
      ll2-timeline-rows="{{ll2TimelineRows}}"
      nsf-checklist-error="{{nsfChecklistError}}"
      nsf-checklist-items="{{nsfChecklistItems}}"
      nsf-checklist-progress-done="{{nsfChecklistProgressDone}}"
      nsf-checklist-progress-total="{{nsfChecklistProgressTotal}}"
      nsf-checklist-syncing="{{nsfChecklistSyncing}}"
      road-closure="{{roadClosure}}"
      road-closure-status="{{roadClosureStatus}}"
      road-closure-syncing="{{roadClosureSyncing}}"
      tab-bar-reserved-height="{{tabBarReservedHeight}}"
      theme-class="{{themeClass}}"
      bind:sectionevent="onProgressBelowFoldEvent"
    />


  </scroll-view>

  <view class="event-share-sheet-mask" wx:if="{{showEventShareSheet}}" bindtap="closeEventShareSheet">
    <view class="event-share-sheet" catchtap="stopPropagation">
      <text class="event-share-sheet-title">分享这条推文</text>
      <text class="event-share-sheet-desc">长按已选中当前推文，可直接分享给朋友，或进入详情页后分享到朋友圈/收藏。</text>
      <button
        class="event-share-sheet-btn event-share-sheet-btn--primary"
        open-type="share"
        hover-class="none"
        plain="true"
        data-share-type="eventUpdateItem"
        data-id="{{selectedEventShareId}}"
        bindtap="onEventShareButtonTap"
      >分享给朋友</button>
      <view class="event-share-sheet-btn" bindtap="openSelectedEventDetailForShare">打开详情页分享到朋友圈/收藏</view>
      <view class="event-share-sheet-btn event-share-sheet-btn--cancel" bindtap="closeEventShareSheet">取消</view>
    </view>
  </view>

  <!-- 事件更新多图：长按选择保存原图 -->
  <view class="event-image-save-mask" wx:if="{{showEventImageSavePicker}}" catchtouchmove="stopPropagation" bindtap="closeEventImageSavePicker">
    <view class="event-image-save-sheet" catchtap="stopPropagation">
      <view class="event-image-save-header">
        <text class="event-image-save-title">选择要保存的原图</text>
        <text class="event-image-save-select-all" bindtap="selectAllEventImageSave">全选</text>
      </view>
      <scroll-view class="event-image-save-scroll" scroll-y="{{true}}">
        <view class="event-image-save-grid">
          <view
            class="event-image-save-item {{eventImageSaveSelected[index] ? 'is-selected' : ''}}"
            wx:for="{{eventImageSaveThumbs}}"
            wx:key="index"
            bindtap="toggleEventImageSaveSelect"
            data-index="{{index}}"
          >
            <image class="event-image-save-thumb" src="{{item}}" mode="aspectFill" lazy-load="{{true}}"></image>
            <view class="event-image-save-check" wx:if="{{eventImageSaveSelected[index]}}">✓</view>
          </view>
        </view>
      </scroll-view>
      <view class="event-image-save-actions">
        <view class="event-share-sheet-btn event-share-sheet-btn--cancel" bindtap="closeEventImageSavePicker">取消</view>
        <view class="event-share-sheet-btn event-share-sheet-btn--primary" bindtap="confirmEventImageSavePicker">保存原图</view>
      </view>
    </view>
  </view>
<nasa-float id="nasaFloat" />
  <privacy-modal id="globalPrivacyModal"></privacy-modal>
  <popup-ad visible="{{popupAdVisible}}" shop-item="{{popupAdItem}}" bind:close="onPopupAdClose"></popup-ad>
  <demo-overlay id="demoOverlay" showControls="{{false}}" qrcodeUrl="https://mars-1397421562.cos.ap-guangzhou.myqcloud.com/%E5%B0%8F%E7%A8%8B%E5%BA%8F%E4%BA%8C%E7%BB%B4%E7%A0%81/1775323336594_jkl6zv.png" loop="{{true}}" />
  <share-guide />
</view>
