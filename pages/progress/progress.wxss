
@import "../../styles/tweet-stats-bar.wxss";

page {
  overflow: hidden;
  height: 100vh;
  width: 100%;
}
.container {
  padding-bottom: 0;
  padding-top: 0;
}

.top-nav-wrapper {
  background: rgba(12, 14, 18, 0.08);
  backdrop-filter: blur(48rpx) saturate(170%);
  -webkit-backdrop-filter: blur(48rpx) saturate(170%);
  border-bottom: 1px solid rgba(255, 255, 255, 0.07);
}

.content-scroll {
  padding: var(--space-lg);
}
.section-title {
  display: flex;
  align-items: center;
  font-size: var(--font-size-xl);
  font-weight: var(--font-weight-semibold);
  color: var(--color-text-primary);
  margin-bottom: var(--space-md);
  padding: 0 var(--space-2xs);
}
.section-title-right {
  margin-left: auto;
}
.progress-map-actions {
  display: flex;
  align-items: center;
  gap: 14rpx;
}
.progress-map-btn {
  min-width: 92rpx;
  min-height: 44rpx;
  padding: 0 14rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(52, 199, 89, 0.16);
  border: 1px solid rgba(52, 199, 89, 0.42);
  box-sizing: border-box;
}
.progress-map-btn text {
  color: #A7FFCA;
  font-size: 20rpx;
  line-height: 1;
}
.progress-map-btn--blue {
  background: var(--color-brand-soft);
  border-color: rgba(59, 130, 246, 0.42);
}
.progress-map-btn--blue text {
  color: var(--color-brand);
}

.status-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #8E8E93;
  box-shadow: 0 0 8rpx rgba(142, 142, 147, 0.55);
}
.status-value {
  font-size: 24rpx;
  color: #8E8E93;
  font-weight: 500;
}

.status-active .status-dot {
  background: #34C759;
  box-shadow: 0 0 10rpx rgba(52, 199, 89, 0.7);
}
.status-active .status-value {
  color: #34C759;
}
.status-destroyed .status-dot {
  background: #FF3B30;
  box-shadow: 0 0 10rpx rgba(255, 59, 48, 0.7);
}
.status-destroyed .status-value {
  color: #FF3B30;
}
.status-expended .status-dot {
  background: #FF9500;
  box-shadow: 0 0 10rpx rgba(255, 149, 0, 0.7);
}
.status-expended .status-value {
  color: #FF9500;
}
.status-retired .status-dot {
  background: #8E8E93;
  box-shadow: 0 0 8rpx rgba(142, 142, 147, 0.55);
}
.status-retired .status-value {
  color: #8E8E93;
}

.hardware-section {
  margin-bottom: var(--space-xl);
}

.booster-view-all {
  display: flex;
  align-items: center;
  gap: 4rpx;
  font-size: 24rpx;
  font-weight: 500;
  color: var(--color-text-secondary, rgba(255, 255, 255, 0.55));
  padding: 8rpx 4rpx;
  transition: opacity 0.12s ease;
}
.booster-view-all--pressed {
  opacity: 0.6;
}
.booster-view-all-arrow {
  font-size: 30rpx;
  line-height: 1;
  color: var(--color-text-tertiary, rgba(255, 255, 255, 0.38));
}

.section-badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 36rpx;
  height: 36rpx;
  padding: 0 10rpx;
  margin-left: 12rpx;
  background: rgba(255, 59, 48, 0.8);
  border-radius: 18rpx;
  font-size: 22rpx;
  color: #fff;
  font-weight: 600;
}
.section-badge--new {
  background: rgba(10, 132, 255, 0.88);
  min-width: 0;
  padding: 0 12rpx;
}
.hardware-grid {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-md);
}
.hardware-card {
  width: calc((100% - 28rpx) / 2);
  padding: 0;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  overflow: hidden;
  border-radius: var(--radius-card);
}
.hardware-card-skeleton {
  height: 380rpx;
}
.hardware-card-image-wrap {
  width: 100%;
  aspect-ratio: 4 / 3;
  position: relative;
  overflow: hidden;
  background: rgba(30, 30, 30, 0.35);
}
.hardware-card-image {
  width: 100%;
  height: 100%;
  display: block;
  background-color: rgba(30, 30, 30, 0.35);
}
.hardware-card-image-mask {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 55%;
  background: linear-gradient(to bottom, rgba(0, 0, 0, 0) 0%, rgba(22, 22, 24, 0.92) 100%);
  pointer-events: none;
}
.hardware-card-overlay {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 14rpx 18rpx;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  pointer-events: none;
}
.hardware-card-status {
  display: flex;
  align-items: center;
  gap: 8rpx;
}
.hardware-card-status .status-value {
  font-size: 20rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
}
.hardware-card-status .status-dot {
  width: 10rpx;
  height: 10rpx;
}
.hardware-card-name {
  font-size: 32rpx;
  font-weight: 700;
  color: #FFFFFF;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.8);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.hardware-card-body {
  padding: 14rpx 18rpx 18rpx;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  flex: 1;
}
.hardware-card-type {
  font-size: 22rpx;
  color: #8E8E93;
}
.hardware-card-notes {
  font-size: 22rpx;
  color: #AEAEB2;
  line-height: 1.5;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}
.hardware-empty {
  padding: 40rpx 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.hardware-empty text {
  color: #8E8E93;
  font-size: 26rpx;
}





@keyframes mission-sim-dot-pulse {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.35; }
}




.detail-status-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
}
.status-dot-active {
  background: #34C759;
  box-shadow: 0 0 10rpx rgba(52, 199, 89, 0.7);
}
.detail-status-text {
  font-size: 24rpx;
  color: #34C759;
  font-weight: 600;
}
.detail-title {
  font-size: 44rpx;
  color: #FFFFFF;
  font-weight: 700;
  line-height: 1.1;
}
.detail-summary {
  text-align: justify;
  text-justify: inter-ideograph;
  font-size: 28rpx;
  color: #c7c7cc;
  line-height: 1.55;
}
.detail-checklist {
  margin-top: 30rpx;
}
@keyframes popup-slide-up {
  from { transform: translateY(100%); opacity: 0; }
  to   { transform: translateY(0);    opacity: 1; }
}
@keyframes popup-slide-down {
  from { transform: translateY(0);    opacity: 1; }
  to   { transform: translateY(100%); opacity: 0; }
}
.popup-title {
  font-size: 44rpx;
  color: #FFFFFF;
  font-weight: 700;
  line-height: 1.15;
  display: block;
}

.popup-body {
  flex: 1;
  min-height: 0;
  padding: 0 30rpx;
  box-sizing: border-box;
}
.checklist-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
}
.checklist-item {
  padding: 24rpx;
  min-height: 240rpx;
  transition: border-color 0.3s ease;
}
.checklist-item-title {
  font-size: 40rpx;
  color: #FFFFFF;
  font-weight: 700;
  margin-bottom: 16rpx;
  display: block;
}
.checklist-meta {
  margin-bottom: 8rpx;
}
.checklist-meta-text {
  font-size: 24rpx;
  color: #b7b7bd;
}
.checklist-desc {
  margin-top: 14rpx;
  font-size: 29rpx;
  color: #c7c7cc;
  line-height: 1.5;
  display: block;
}

button.notice-card {
  display: block !important;
  width: 100% !important;
  text-align: left !important;
  line-height: normal !important;
  min-height: 0 !important;
  margin: 0 !important;
}



.ll2-progress-pack {
  margin-bottom: var(--space-xl);
}
.ll2-progress-pack .ll2-progress-card.nsf-checklist-card {
}
.ll2-preview-timeline-rows {
  border-top: 1px solid rgba(255, 255, 255, 0.07);
}
.ll2-preview-timeline-rows .ll2-timeline-item {
  padding: 8rpx 12rpx 8rpx 8rpx;
}
.ll2-update-row--compact {
  padding-top: 16rpx;
  padding-bottom: 16rpx;
}

.ll2-progress-pack .nsf-checklist-preview-rows:not(.ll2-preview-timeline-rows) .ll2-update-row {
  padding-left: 28rpx;
  padding-right: 28rpx;
}

.ll2-timeline-section {
  margin-bottom: var(--space-xl);
}
.ll2-timeline-item {
  display: flex;
  align-items: stretch;
  flex-direction: row;
  min-height: 72rpx;
}
.ll2-timeline-axis {
  width: 56rpx;
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.ll2-timeline-line {
  width: 3rpx;
  flex: 1;
  min-height: 14rpx;
  background: rgba(255, 255, 255, 0.22);
  border-radius: 999rpx;
}
.ll2-timeline-node {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: rgba(30, 34, 42, 0.95);
  border: 2rpx solid rgba(255, 255, 255, 0.28);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  box-sizing: border-box;
}

.ll2-timeline-node-mark {
  flex-shrink: 0;
  box-sizing: border-box;
}
.ll2-timeline-node-mark--dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.88);
}
.ll2-timeline-node-mark--solid {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.92);
}
.ll2-timeline-node-mark--ring {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: transparent;
  border: 2rpx solid rgba(255, 255, 255, 0.85);
}
.ll2-timeline-node-mark--diamond {
  width: 10rpx;
  height: 10rpx;
  border-radius: 2rpx;
  background: rgba(255, 255, 255, 0.88);
  transform: rotate(45deg);
}
.ll2-timeline-node-mark--square {
  width: 10rpx;
  height: 10rpx;
  border-radius: 2rpx;
  background: rgba(255, 255, 255, 0.88);
}
.ll2-timeline-node-mark--lift {
  width: 0;
  height: 0;
  border-style: solid;
  border-width: 0 9rpx 15rpx 9rpx;
  border-color: transparent transparent rgba(255, 255, 255, 0.9) transparent;
  background: transparent;
}
.ll2-timeline-main {
  flex: 1;
  min-width: 0;
  padding: 4rpx 16rpx 24rpx 8rpx;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}
.ll2-timeline-title {
  font-size: 29rpx;
  color: rgba(255, 255, 255, 0.92);
  line-height: 1.45;
  font-weight: 500;
}
.ll2-timeline-title--lift {
  font-weight: 700;
  color: #ffffff;
}
.ll2-timeline-desc {
  font-size: 22rpx;
  color: rgba(142, 142, 147, 0.95);
  line-height: 1.45;
}
.ll2-timeline-clock {
  flex-shrink: 0;
  font-size: 26rpx;
  font-weight: 600;
  color: rgba(255, 255, 255, 0.92);
  font-variant-numeric: tabular-nums;
  padding-top: 6rpx;
  padding-left: 8rpx;
  max-width: 200rpx;
  text-align: right;
}
.ll2-updates-sync-btn {
  font-size: 24rpx;
  color: var(--color-brand);
  padding: 4rpx 16rpx;
  border: 1px solid rgba(59, 130, 246, 0.35);
  border-radius: var(--radius-sm);
  margin-left: auto;
}
.ll2-update-row {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  padding: 20rpx 0;
  border-bottom: 1px solid rgba(255, 255, 255, 0.06);
}
.ll2-update-row:last-child {
  border-bottom: none;
  padding-bottom: 0;
}
.ll2-update-row:first-child {
  padding-top: 0;
}
.ll2-update-main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}
.ll2-update-comment {
  font-size: 29rpx;
  color: #ffffff;
  line-height: 1.5;
}
.ll2-update-meta {
  font-size: 22rpx;
  color: rgba(142, 142, 147, 0.95);
}
.ll2-update-chevron {
  margin-top: 4rpx;
}

.tweet-stats-scroll-wrap {
  position: relative;
  margin-bottom: 20rpx;
  padding: 0 10rpx;
  box-sizing: border-box;
}
.tweet-stats-scroll {
  width: 100%;
  white-space: nowrap;
}
.tweet-stats-scroll-fade {
  position: absolute;
  top: 0;
  right: 10rpx;
  width: 44rpx;
  height: 100%;
  pointer-events: none;
  background: linear-gradient(90deg, rgba(14, 20, 34, 0), rgba(14, 20, 34, 0.92));
  border-top-right-radius: 16rpx;
  border-bottom-right-radius: 16rpx;
}
.tweet-stats-bar.tweet-stats-chips-row {
  display: inline-flex;
  flex-wrap: nowrap;
  gap: 10rpx;
  align-items: stretch;
  min-width: 100%;
  margin-bottom: 0;
  padding-right: 20rpx;
  box-sizing: border-box;
}
.tweet-stat-chip.tweet-stat-item {
  flex: 0 0 auto;
  padding: 8rpx 12rpx;
}
.tweet-stat-chip .tweet-stat-avatar {
  width: 32rpx;
  height: 32rpx;
  margin-right: 6rpx;
}
.tweet-stat-chip .tweet-stat-name {
  font-size: 20rpx;
  margin-right: 6rpx;
  white-space: nowrap;
}
.tweet-stat-chip .tweet-stat-count {
  font-size: 18rpx;
}
.expand-arrow {
  font-size: 32rpx;
  font-weight: 300;
  transform: rotate(90deg);
}
.expand-arrow--up {
  transform: rotate(-90deg);
}
@keyframes event-refresher-spin {
  from {
    transform: rotate(0deg);
  }
  to {
    transform: rotate(360deg);
  }
}
.event-share-sheet-mask {
  position: fixed;
  inset: 0;
  z-index: 1300;
  background: rgba(0, 0, 0, 0.52);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 32rpx;
  box-sizing: border-box;
}
.event-share-sheet {
  width: 100%;
  max-width: 620rpx;
  padding: 32rpx 28rpx;
  box-sizing: border-box;
  border-radius: 28rpx;
  background: var(--bg-glass-popup, rgba(22, 24, 28, 0.85));
  backdrop-filter: blur(32rpx) saturate(150%);
  -webkit-backdrop-filter: blur(32rpx) saturate(150%);
  box-shadow: 0 24rpx 80rpx rgba(0, 0, 0, 0.45);
}
.event-share-sheet-title {
  display: block;
  font-size: 32rpx;
  line-height: 1.4;
  font-weight: 700;
  color: #fff;
  text-align: center;
}
.event-share-sheet-desc {
  display: block;
  margin-top: 12rpx;
  margin-bottom: 24rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: rgba(255, 255, 255, 0.62);
  text-align: center;
}
.event-share-sheet-btn {
  width: 100%;
  min-height: 92rpx;
  margin: 0 0 16rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: #fff;
  background: rgba(255, 255, 255, 0.06);
  border: 1px solid rgba(255, 255, 255, 0.08);
}
.event-share-sheet-btn--primary {
  padding: 0 !important;
  line-height: 92rpx !important;
  background: var(--color-brand) !important;
  border: none !important;
  color: #fff !important;
}
.event-share-sheet-btn--primary::after {
  border: none;
}
.event-share-sheet-btn--cancel {
  color: rgba(255, 255, 255, 0.72);
}


.event-image-save-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 1200;
  background: rgba(0, 0, 0, 0.55);
  display: flex;
  align-items: flex-end;
  justify-content: center;
}
.event-image-save-sheet {
  width: 100%;
  max-height: 72vh;
  background: var(--bg-glass-popup, rgba(22, 24, 28, 0.85));
  backdrop-filter: blur(32rpx) saturate(150%);
  -webkit-backdrop-filter: blur(32rpx) saturate(150%);
  border-radius: 28rpx 28rpx 0 0;
  padding: 28rpx 28rpx calc(28rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
}
.event-image-save-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}
.event-image-save-title {
  font-size: 30rpx;
  font-weight: 600;
  color: rgba(255, 255, 255, 0.92);
}
.event-image-save-select-all {
  font-size: 26rpx;
  color: var(--color-brand);
  padding: 8rpx 4rpx;
}
.event-image-save-scroll {
  max-height: 48vh;
}
.event-image-save-grid {
  display: flex;
  flex-wrap: wrap;
  margin: 0 -8rpx;
}
.event-image-save-item {
  width: 33.33%;
  padding: 8rpx;
  box-sizing: border-box;
  position: relative;
}
.event-image-save-thumb {
  width: 100%;
  height: 210rpx;
  border-radius: 12rpx;
  background: rgba(255, 255, 255, 0.06);
  display: block;
}
.event-image-save-item.is-selected .event-image-save-thumb {
  outline: 3rpx solid var(--color-brand);
  outline-offset: -3rpx;
}
.event-image-save-check {
  position: absolute;
  right: 18rpx;
  top: 18rpx;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: var(--color-brand);
  color: #fff;
  font-size: 22rpx;
  line-height: 40rpx;
  text-align: center;
}
.event-image-save-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 24rpx;
}
.event-image-save-actions .event-share-sheet-btn {
  flex: 1;
}




.theme-light .top-nav-wrapper {
  background: var(--bg-glass-nav);
  border-bottom: 1px solid var(--color-divider);
}
.theme-light .section-title {
  color: var(--color-text-primary);
}

.theme-light .progress-map-btn {
  background: rgba(52, 199, 89, 0.12);
  border-color: rgba(52, 199, 89, 0.45);
}
.theme-light .progress-map-btn text {
  color: #1D8A46;
}
.theme-light .progress-map-btn--blue {
  background: var(--color-brand-soft);
  border-color: rgba(59, 130, 246, 0.45);
}
.theme-light .progress-map-btn--blue text {
  color: var(--color-brand);
}



.theme-light .hardware-card {
}
.theme-light .hardware-card-image-wrap {
  background: rgba(0, 0, 0, 0.05);
}
.theme-light .hardware-card-image {
  background-color: rgba(0, 0, 0, 0.05);
}


.theme-light .hardware-card-type {
  color: var(--color-text-secondary);
}
.theme-light .hardware-card-notes {
  color: var(--color-text-secondary);
}
.theme-light .hardware-empty text {
  color: var(--color-text-secondary);
}


.theme-light .ll2-preview-timeline-rows {
  border-top: 1px solid var(--color-divider);
}
.theme-light .ll2-timeline-line {
  background: rgba(0, 0, 0, 0.15);
}
.theme-light .ll2-timeline-node {
  background: var(--color-bg-card);
  border-color: rgba(0, 0, 0, 0.2);
}
.theme-light .ll2-timeline-node-mark--dot {
  background: rgba(28, 28, 30, 0.85);
}
.theme-light .ll2-timeline-node-mark--solid {
  background: rgba(28, 28, 30, 0.9);
}
.theme-light .ll2-timeline-node-mark--ring {
  border-color: rgba(28, 28, 30, 0.75);
}
.theme-light .ll2-timeline-node-mark--diamond {
  background: rgba(28, 28, 30, 0.85);
}
.theme-light .ll2-timeline-node-mark--square {
  background: rgba(28, 28, 30, 0.85);
}
.theme-light .ll2-timeline-node-mark--lift {
  border-color: transparent transparent rgba(28, 28, 30, 0.9) transparent;
}
.theme-light .ll2-timeline-title {
  color: var(--color-text-primary);
}
.theme-light .ll2-timeline-title--lift {
  color: var(--color-text-primary);
}
.theme-light .ll2-timeline-desc {
  color: var(--color-text-secondary);
}
.theme-light .ll2-timeline-clock {
  color: var(--color-text-primary);
}
.theme-light .ll2-updates-sync-btn {
  color: var(--color-brand);
  border-color: rgba(59, 130, 246, 0.35);
}
.theme-light .ll2-update-row {
  border-bottom: 1px solid var(--color-divider);
}
.theme-light .ll2-update-row:last-child {
  border-bottom: none;
}
.theme-light .ll2-update-comment {
  color: var(--color-text-primary);
}
.theme-light .ll2-update-meta {
  color: var(--color-text-secondary);
}

.theme-light .tweet-stats-scroll-fade {
  background: linear-gradient(90deg, rgba(242, 242, 247, 0), rgba(242, 242, 247, 0.92));
}

.theme-light .tweet-stat-item {
  background: rgba(0, 0, 0, 0.05);
  border-color: var(--color-divider);
}
.theme-light .tweet-stat-name {
  color: var(--color-text-secondary);
}
.theme-light .tweet-stat-count {
  color: #0071A9;
}

.theme-light .event-share-sheet {
  background: var(--bg-glass-popup, rgba(255, 255, 255, 0.88));
  box-shadow: 0 24rpx 80rpx rgba(0, 0, 0, 0.15);
}
.theme-light .event-share-sheet-title {
  color: var(--color-text-primary);
}
.theme-light .event-share-sheet-desc {
  color: var(--color-text-secondary);
}
.theme-light .event-share-sheet-btn {
  color: var(--color-text-primary);
  background: rgba(0, 0, 0, 0.05);
  border: 1px solid var(--color-divider);
}


.theme-light .event-share-sheet-btn--cancel {
  color: var(--color-text-secondary);
}

.theme-light .event-image-save-sheet {
  background: var(--bg-glass-popup, rgba(255, 255, 255, 0.88));
}
.theme-light .event-image-save-title {
  color: var(--color-text-primary);
}
.theme-light .event-image-save-thumb {
  background: rgba(0, 0, 0, 0.04);
}
