
@import "../../styles/monitor-block.wxss";

page {
  overflow: hidden;
  height: 100vh;
  width: 100%;
}
.container {
  padding-bottom: 0;
  padding-top: 0;
}

.top-nav-wrapper {
  background: rgba(12, 14, 18, 0.08);
  backdrop-filter: blur(48rpx) saturate(170%);
  -webkit-backdrop-filter: blur(48rpx) saturate(170%);
  border-bottom: 1px solid rgba(255, 255, 255, 0.07);
}

.content-scroll {
  padding: var(--space-md);
}
.section-title {
  font-size: var(--font-size-xl);
  font-weight: var(--font-weight-semibold);
  color: var(--color-text-primary);
  margin-bottom: var(--space-sm);
  padding: 0 var(--space-2xs);
  display: flex;
  align-items: center;
}

.section-badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 36rpx;
  height: 36rpx;
  padding: 0 10rpx;
  margin-left: 12rpx;
  background: rgba(255, 59, 48, 0.8);
  border-radius: 18rpx;
  font-size: 22rpx;
  color: #fff;
  font-weight: 600;
}
.section-title-main {
  display: flex;
  align-items: center;
  gap: 10rpx;
  min-width: 0;
}
.section-subtitle {
  font-size: 20rpx;
  font-weight: 400;
  color: rgba(255, 255, 255, 0.32);
}
.section-title-right {
  margin-left: auto;
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.icon-arrow--preview-card {
  font-size: 48rpx;
  color: #8E8E93;
  font-weight: 300;
  flex-shrink: 0;
}



.monitor-livestream-section {
  padding: 0;
  margin-bottom: var(--space-xl);
}

.monitor-livestream-section .section-title {
  padding: 0;
  gap: 14rpx;
}
.monitor-livestream-section-title {
  align-items: flex-start;
  justify-content: space-between;
  flex-wrap: nowrap;
  gap: 20rpx;
}
.monitor-livestream-title-left {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 14rpx;
  flex-shrink: 0;
}
.monitor-livestream-heading-text {
  font-size: var(--font-size-xl);
  font-weight: var(--font-weight-semibold);
  color: var(--color-text-primary);
}


.starbase-weather-cluster {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 2rpx;
}
.starbase-weather-loading text {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.45);
}
.starbase-weather-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: flex-end;
  gap: 8rpx;
  max-width: 100%;
}
.starbase-wx-icon {
  width: 32rpx;
  height: 32rpx;
  flex-shrink: 0;
}
.starbase-wx-condition {
  font-size: 24rpx;
  font-weight: 500;
  color: rgba(255, 255, 255, 0.92);
  white-space: nowrap;
}
.starbase-wx-temp {
  font-size: 24rpx;
  font-weight: 600;
  color: #FFFFFF;
  white-space: nowrap;
}
.starbase-weather-dot {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.3);
}
.starbase-wind-icon {
  width: 36rpx;
  height: 18rpx;
  flex-shrink: 0;
}
.starbase-wx-wind-text {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.7);
  white-space: nowrap;
}
.starbase-weather-caption {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.38);
  letter-spacing: 0.5rpx;
  white-space: nowrap;
}
.starbase-weather-err {
  font-size: 22rpx;
  color: rgba(255, 160, 140, 0.85);
  text-align: right;
}
.monitor-livestream-section .livestream-live-tag {
  display: inline-flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  height: 36rpx;
  padding: 0 14rpx;
  border-radius: 999rpx;
  white-space: nowrap;
  box-sizing: border-box;
  background: linear-gradient(90deg, #ff2d55, #ff453a);
  box-shadow: 0 4rpx 12rpx rgba(255, 45, 85, 0.35);
}
.monitor-livestream-section .livestream-live-tag-text {
  font-size: 20rpx;
  font-weight: 600;
  color: #ffffff;
  line-height: 1;
  letter-spacing: 0.5rpx;
}
.monitor-livestream-section .livestream-live-eq {
  display: flex;
  flex-direction: row;
  align-items: flex-end;
  gap: 3rpx;
  height: 18rpx;
  flex-shrink: 0;
}
.monitor-livestream-section .livestream-live-eq-bar {
  width: 4rpx;
  height: 100%;
  border-radius: 999rpx;
  background: #ffffff;
  transform-origin: center bottom;
  animation: monitor-livestream-eq 0.8s ease-in-out infinite;
}
.monitor-livestream-section .livestream-live-eq-bar:nth-child(1) { animation-delay: 0s; }
.monitor-livestream-section .livestream-live-eq-bar:nth-child(2) { animation-delay: 0.15s; }
.monitor-livestream-section .livestream-live-eq-bar:nth-child(3) { animation-delay: 0.3s; }
@keyframes monitor-livestream-eq {
  0%, 100% { transform: scaleY(0.35); }
  25% { transform: scaleY(1); }
  50% { transform: scaleY(0.55); }
  75% { transform: scaleY(0.85); }
}

.monitor-livestream-stack {
  display: flex;
  flex-direction: column;
  gap: var(--space-md);
}

.empty-state {
  padding: 40rpx 32rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  border-radius: 20rpx;
  border: 1px dashed rgba(255, 255, 255, 0.1);
}
.empty-state-icon {
  font-size: 52rpx;
  margin-bottom: 12rpx;
}
.empty-state-text {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.5);
}
.empty-state-hint {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.25);
  margin-top: 6rpx;
}
.monitor-share-wrap {
  position: relative;
  width: 28rpx;
  height: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.icon-share--monitor {
  width: 28rpx;
  height: 28rpx;
}
.monitor-share-btn {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  width: 100% !important;
  height: 100% !important;
  min-width: 0 !important;
  padding: 0 !important;
  margin: 0 !important;
  background: transparent !important;
  border: 0 !important;
  border-width: 0 !important;
  outline: 0 !important;
  box-shadow: none !important;
  opacity: 0;
}
.monitor-share-btn::after {
  display: none;
}




@keyframes starlinkOrbitSpin {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}










@keyframes passTrailFlash {
  0%, 85%, 100% {
    transform: translateX(0);
    opacity: 0;
  }
  90% {
    opacity: 0.7;
  }
  95% {
    transform: translateX(450%);
    opacity: 0;
  }
}
.icon-arrow--pass-toggle {
  font-size: 34rpx;
  color: rgba(255, 255, 255, 0.4);
  line-height: 1;
  transform: rotate(0deg);
  transition: transform 0.2s ease;
}
.icon-arrow--pass-toggle.expanded {
  transform: rotate(90deg);
}




.qrcode-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.6);
  z-index: 10002;
  display: flex;
  align-items: center;
  justify-content: center;
  animation: qrFadeIn 0.2s ease;
}
@keyframes qrFadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}
.qrcode-modal-content {
  width: 600rpx;
  max-width: 90%;
  background: var(--bg-glass-popup, rgba(22, 24, 28, 0.85));
  backdrop-filter: blur(32rpx) saturate(150%);
  -webkit-backdrop-filter: blur(32rpx) saturate(150%);
  border-radius: 24rpx;
  overflow: hidden;
  animation: qrSlideUp 0.3s ease;
}
@keyframes qrSlideUp {
  from { transform: translateY(40rpx); opacity: 0; }
  to { transform: translateY(0); opacity: 1; }
}
.qrcode-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx 40rpx;
  border-bottom: 1px solid rgba(255, 255, 255, 0.1);
}
.qrcode-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #FFFFFF;
}
.qrcode-close {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.1);
  transition: all 0.2s ease;
}
.qrcode-close:active {
  background: rgba(255, 255, 255, 0.2);
  transform: scale(0.95);
}
.icon-close--qrcode {
  font-size: 36rpx;
}
.qrcode-body {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 50rpx 40rpx;
  gap: 30rpx;
}
.qrcode-image {
  width: 400rpx;
  height: 400rpx;
  border-radius: 16rpx;
  background: #FFFFFF;
  padding: 20rpx;
  box-sizing: border-box;
}
.qrcode-tip {
  font-size: 24rpx;
  color: #8E8E93;
  text-align: center;
}
.qrcode-tip--name {
  font-size: 28rpx;
  color: #FFFFFF;
  font-weight: 600;
  margin-bottom: 8rpx;
}
.qrcode-copy-btn {
  margin-top: 10rpx;
  padding: 16rpx 40rpx;
  background: var(--color-brand);
  border-radius: var(--radius-sm);
  transition: all 0.2s ease;
}
.qrcode-copy-btn:active {
  background: rgba(59, 130, 246, 0.75);
  transform: scale(0.97);
}
.qrcode-copy-btn text {
  font-size: 28rpx;
  color: #FFFFFF;
  font-weight: 500;
}





.lazy-load-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: var(--space-lg) var(--space-xl);
  border-radius: var(--radius-card);
  gap: var(--space-2xs);
  box-sizing: border-box;
}
.lazy-load-card:active {
  opacity: 0.7;
  transform: scale(0.98);
}
.lazy-load-icon {
  font-size: 48rpx;
  margin-bottom: 6rpx;
}
.lazy-load-text {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.85);
  font-weight: 500;
}
.lazy-load-hint {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.4);
}




.theme-light .top-nav-wrapper {
  background: var(--bg-glass-nav);
  border-bottom: 1px solid var(--color-divider);
}

.theme-light .section-title {
  color: var(--color-text-primary);
}
.theme-light .section-subtitle {
  color: var(--color-text-tertiary);
}
.theme-light .empty-state {
  border: 1px dashed rgba(0, 0, 0, 0.1);
}
.theme-light .empty-state-text {
  color: var(--color-text-secondary);
}
.theme-light .empty-state-hint {
  color: var(--color-text-tertiary);
}

.theme-light .icon-arrow--preview-card {
  color: var(--color-text-tertiary);
}

.theme-light .monitor-livestream-heading-text {
  color: var(--color-text-primary);
}
.theme-light .monitor-livestream-section .livestream-live-tag {
  background: linear-gradient(90deg, #ff2d55, #ff453a);
  box-shadow: 0 4rpx 12rpx rgba(255, 45, 85, 0.28);
}
.theme-light .monitor-livestream-section .livestream-live-tag-text {
  color: #ffffff;
}

.theme-light .starbase-weather-loading text {
  color: var(--color-text-tertiary);
}
.theme-light .starbase-wx-condition {
  color: var(--color-text-primary);
}
.theme-light .starbase-wx-temp {
  color: var(--color-text-primary);
}
.theme-light .starbase-weather-dot {
  color: var(--color-text-quaternary, rgba(0, 0, 0, 0.2));
}
.theme-light .starbase-wx-wind-text {
  color: var(--color-text-secondary);
}
.theme-light .starbase-weather-caption {
  color: var(--color-text-tertiary);
}
.theme-light .starbase-weather-err {
  color: #FF3B30;
}

.theme-light .icon-arrow--pass-toggle {
  color: var(--color-text-tertiary);
}

.theme-light .qrcode-modal-content {
  background: var(--bg-glass-popup, rgba(255, 255, 255, 0.88));
}
.theme-light .qrcode-header {
  border-bottom: 1px solid var(--color-divider);
}
.theme-light .qrcode-title {
  color: var(--color-text-primary);
}
.theme-light .qrcode-close {
  background: rgba(0, 0, 0, 0.06);
}
.theme-light .qrcode-close:active {
  background: rgba(0, 0, 0, 0.1);
}
.theme-light .qrcode-tip {
  color: var(--color-text-secondary);
}
.theme-light .qrcode-tip--name {
  color: var(--color-text-primary);
}


.theme-light .agency-chip {
  background: rgba(0, 0, 0, 0.05);
  border: 1px solid var(--color-divider);
}
.theme-light .agency-chip text {
  color: var(--color-text-secondary);
}
.theme-light .agency-chip-active {
  background: var(--color-brand-soft);
  border-color: rgba(59, 130, 246, 0.45);
}
.theme-light .agency-chip-active text {
  color: var(--color-brand);
}
.theme-light .agency-search-icon {
  color: var(--color-text-secondary);
}
.theme-light .agency-search-input {
  color: var(--color-text-primary);
}
.theme-light .agency-search-placeholder {
  color: var(--color-text-tertiary);
}
.theme-light .agency-search-clear {
  background: rgba(0, 0, 0, 0.06);
}
.theme-light .agency-search-clear text {
  color: var(--color-text-secondary);
}

.theme-light .lazy-load-text {
  color: var(--color-text-primary);
}
.theme-light .lazy-load-hint {
  color: var(--color-text-tertiary);
}

.theme-light .starbase-wx-icon,
.theme-light .starbase-wind-icon {
  filter: invert(0.72);
}


.monitor-block > .section-title {
  min-height: 56rpx;
  display: flex;
  align-items: center;
  box-sizing: border-box;
}
/* restored: starbase preview card (page-level) */
.MARS-preview-section {
  margin-bottom: var(--space-xl);
}
.MARS-preview-card {
  padding: 0;
  overflow: hidden;
}
.preview-card-content {
  display: flex;
  align-items: center;
  padding: var(--space-lg) var(--space-xl);
  gap: var(--space-lg);
}
.preview-card-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: var(--space-2xs);
}
.preview-card-title {
  font-size: var(--font-size-lg);
  font-weight: var(--font-weight-semibold);
  color: var(--color-text-primary);
}
.preview-card-desc {
  font-size: 24rpx;
  color: var(--color-text-secondary);
}
.MARS-preview-section > .monitor-livestream-section {
  margin-top: var(--space-lg);
}
.theme-light .preview-card-title {
  color: var(--color-text-primary);
}
.theme-light .preview-card-desc {
  color: var(--color-text-secondary);
}
