
.container {
  background: var(--color-bg-page);
}
.top-nav-wrapper {
  z-index: 20;
  background: rgba(12, 14, 18, 0.08);
  backdrop-filter: blur(48rpx) saturate(170%);
  -webkit-backdrop-filter: blur(48rpx) saturate(170%);
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.07);
}
.top-nav--profile {
  position: relative;
}
.nav-title--profile {
  letter-spacing: 2rpx;
}

.profile-settings-entry {
  position: fixed;
  left: calc(24rpx + env(safe-area-inset-left));
  z-index: 1001;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 8rpx;
  box-sizing: border-box;
  background: transparent;
  border: none;
}
.profile-settings-entry:active {
  opacity: 0.72;
}
.profile-settings-entry-text {
  font-size: 34rpx; 
  font-weight: 600;
  color: rgba(255, 255, 255, 0.92);
  line-height: 1;
}
.theme-light .profile-settings-entry-text {
  color: #1C1C1E;
}
.content-scroll {
  padding-left: var(--space-lg);
  padding-right: var(--space-lg);
}


.pf-identity {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 28rpx;
  overflow: visible;
}
.pf-avatar-halo {
  position: relative;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: visible;
}
/* 为 box-shadow 光晕留出绘制空间，避免被身份行 / scroll-view 裁成一条直线 */
.pf-avatar-halo--pro {
  padding: 48rpx;
  box-sizing: content-box;
}
.pf-avatar-ring {
  position: relative;
  z-index: 1;
  flex-shrink: 0;
  border-radius: 50%;
  line-height: 0;
}
.pf-avatar-ring--pro {
  padding: 4rpx;
  background: linear-gradient(160deg, #FFF8D6 0%, #F5C84A 42%, #C47E12 78%, #FFE7A8 100%);
  box-shadow:
    0 0 14rpx rgba(245, 185, 63, 0.72),
    0 0 28rpx rgba(245, 185, 63, 0.38),
    0 0 48rpx rgba(212, 160, 40, 0.22);
}
.pf-avatar {
  position: relative;
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  flex-shrink: 0;
  overflow: hidden;
  background: #1a2438;
  border: 3rpx solid rgba(255, 255, 255, 0.18);
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.25);
  display: flex;
  align-items: center;
  justify-content: center;
}
.pf-avatar-ring--pro .pf-avatar {
  border-width: 0;
  box-shadow: none;
}
.pf-avatar-ring--pro .pf-avatar--empty {
  border-style: solid;
  border-color: transparent;
}
.pf-avatar--empty {
  border-style: dashed;
  border-color: rgba(255, 255, 255, 0.28);
  background: rgba(255, 255, 255, 0.06);
  box-shadow: none;
}
.pf-avatar-ring:active {
  opacity: 0.88;
}
.pf-avatar-img {
  width: 100%;
  height: 100%;
  display: block;
}
.pf-avatar-plus {
  font-size: 52rpx;
  font-weight: 300;
  line-height: 1;
  color: rgba(255, 255, 255, 0.55);
  transform: translateY(-2rpx);
}
.pf-identity-main {
  flex: 1;
  min-width: 0;
}
.pf-name-row {
  display: flex;
  align-items: center;
  min-width: 0;
  margin-bottom: 10rpx;
}
.pf-name {
  min-width: 0;
  max-width: 100%;
  font-size: 34rpx;
  font-weight: 700;
  color: var(--color-text-primary, #F5F5F7);
  line-height: 1.25;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.pf-name:active {
  opacity: 0.75;
}
.pf-badge-meta {
  display: flex;
  align-items: center;
  gap: 12rpx;
  min-width: 0;
}
.pf-badge-meta-text {
  flex-shrink: 0;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.45);
}
.pf-badge-scroll {
  flex: 1;
  min-width: 0;
  white-space: nowrap;
}
.pf-badge-row {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
}
.pf-badge-dot {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.08);
  border: 1rpx solid rgba(255, 255, 255, 0.12);
  display: inline-flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}
.pf-badge-dot--locked {
  opacity: 0.35;
  filter: grayscale(1);
}
.pf-badge-dot-img {
  width: 30rpx;
  height: 30rpx;
}

.checkin-btn {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 14rpx 28rpx;
  border-radius: 999rpx;
  background: var(--color-brand, #0A84FF);
  box-shadow: 0 4rpx 16rpx rgba(10, 132, 255, 0.35);
}
.checkin-btn:active {
  transform: scale(0.95);
  opacity: 0.9;
}
.checkin-btn--done {
  background: rgba(255, 255, 255, 0.1);
  box-shadow: none;
}
.checkin-btn-icon {
  font-size: 26rpx;
  color: #07C160;
}
.checkin-btn-text {
  font-size: 26rpx;
  font-weight: 600;
  color: #fff;
}


.pf-pass-card {
  position: relative;
  overflow: hidden;
  margin-bottom: 28rpx;
  padding: 28rpx 28rpx 24rpx;
  border-radius: 28rpx;
  background: linear-gradient(165deg, #FFFBEE 0%, #FFF3D3 42%, #FFE9B4 100%);
  border: none;
  box-shadow: none;
}
.pf-pass-card--pro {
  background: linear-gradient(165deg, #FFF9E4 0%, #FFEDBB 40%, #FFDF95 100%);
}
.pf-pass-card__shine {
  pointer-events: none;
  position: absolute;
  inset: 0;
  background: linear-gradient(115deg, rgba(255, 255, 255, 0.35) 0%, transparent 38%, rgba(255, 248, 220, 0.18) 70%, transparent 100%);
}
.pf-pass-top {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 22rpx;
}
.pf-pass-title-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 8rpx;
}
.pf-pass-badge {
  width: 40rpx;
  height: 40rpx;
}
.pf-pass-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #5C3A00;
}
.pf-pass-desc {
  display: block;
  font-size: 22rpx;
  color: #A97B1E;
  line-height: 1.4;
}
.pf-pass-cta {
  flex-shrink: 0;
  padding: 12rpx 22rpx;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #FFDE8F, #F5B93F);
  color: #5C3A00;
  font-size: 22rpx;
  font-weight: 600;
}
.pf-pass-benefits {
  position: relative;
  z-index: 1;
  display: flex;
  gap: 8rpx;
  padding: 16rpx 8rpx 14rpx;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.62);
}
.pf-pass-benefit {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
}
.pf-pass-benefit-icon {
  width: 72rpx;
  height: 72rpx;
  display: block;
}
.pf-pass-benefit-name {
  font-size: 20rpx;
  color: #6B4A0E;
  text-align: center;
  line-height: 1.2;
}

.pf-shop-title {
  display: flex;
  align-items: center;
  gap: 10rpx;
}
.pf-shop-title-icon {
  width: 32rpx;
  height: 32rpx;
  flex-shrink: 0;
}

.pf-shop {
  position: relative;
  width: 100%;
  display: flex;
  justify-content: center;
}
/* 店铺卡上黑下白，左右铺同色带，不改 store-home 内部 */
.pf-shop-blend {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 0;
  pointer-events: none;
  display: flex;
  flex-direction: column;
  border-radius: 20rpx;
  overflow: hidden;
}
.pf-shop-blend-top {
  flex: 53 0 0;
  background: #000000;
}
.pf-shop-blend-bot {
  flex: 47 0 0;
  background: #ffffff;
}
.pf-shop-home {
  position: relative;
  z-index: 1;
  display: block;
}

.pf-section {
  margin-bottom: 28rpx;
}


.pf-assets-card {
  padding: 28rpx 12rpx 16rpx;
  border-radius: 24rpx;
}
.pf-assets-grid {
  display: flex;
  align-items: stretch;
}
.pf-asset {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}
.pf-asset-num {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--color-text-primary, #F5F5F7);
  font-variant-numeric: tabular-nums;
  line-height: 1.15;
}
.pf-asset-label {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.45);
}
.pf-week {
  margin-top: 20rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.06);
}


.pf-promo {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  margin-bottom: 28rpx;
  padding: 28rpx;
  border-radius: 24rpx;
  background: linear-gradient(120deg, #0A84FF 0%, #5AC8FA 55%, #64D2FF 100%);
  box-shadow: 0 10rpx 28rpx rgba(10, 132, 255, 0.28);
}
.pf-promo--year {
  background: linear-gradient(120deg, #0B4F6C 0%, #1B7F9A 100%);
  box-shadow: 0 10rpx 28rpx rgba(11, 79, 108, 0.28);
}
.pf-promo-text {
  flex: 1;
  min-width: 0;
}
.pf-promo-title {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
  color: #FFFFFF;
  margin-bottom: 6rpx;
}
.pf-promo-desc {
  display: block;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.86);
  line-height: 1.35;
}
.pf-promo-btn {
  flex-shrink: 0;
  padding: 14rpx 26rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.95);
  color: #0A84FF;
  font-size: 24rpx;
  font-weight: 700;
}
.pf-promo--year .pf-promo-btn {
  color: #0B4F6C;
}


.pf-services-card {
  padding: 28rpx 12rpx 16rpx;
  border-radius: 24rpx;
}
.pf-services-grid {
  display: flex;
  flex-wrap: wrap;
}
.pf-service {
  width: 25%;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  padding: 12rpx 8rpx 20rpx;
  position: relative;
}
.pf-service:active,
.pf-service--pressed {
  opacity: 0.75;
}

button.pf-service--contact {
  width: 25% !important;
  margin: 0 !important;
  padding: 12rpx 8rpx 20rpx !important;
  height: auto !important;
  min-height: 0 !important;
  display: flex !important;
  flex-direction: column;
  align-items: center;
  justify-content: flex-start;
  gap: 12rpx;
  box-sizing: border-box;
  background: transparent;
  border: none;
  border-radius: 0;
  line-height: inherit;
  font-size: inherit;
  font-weight: inherit;
  color: inherit;
  box-shadow: none;
}
button.pf-service--contact::after {
  border: none;
}
.pf-service-icon-wrap {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.08);
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
}
.pf-service-icon {
  width: 48rpx;
  height: 48rpx;
}

.pf-service-icon--fav {
  width: 44rpx;
  height: 44rpx;
  opacity: 0.82;
  filter: invert(1);
}
.pf-service-fallback {
  font-size: 28rpx;
  font-weight: 700;
  color: rgba(255, 255, 255, 0.75);
}
.pf-service-label {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.72);
  text-align: center;
}
.pf-service-badge {
  position: absolute;
  top: 4rpx;
  right: 18rpx;
  min-width: 28rpx;
  height: 28rpx;
  padding: 0 8rpx;
  border-radius: 999rpx;
  background: #FF3B30;
  color: #fff;
  font-size: 18rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}

.theme-light .pf-avatar-ring--pro {
  box-shadow:
    0 0 12rpx rgba(245, 185, 63, 0.55),
    0 0 24rpx rgba(245, 185, 63, 0.28),
    0 0 40rpx rgba(212, 160, 40, 0.16);
}
.theme-light .pf-avatar {
  border-color: rgba(255, 255, 255, 0.9);
  box-shadow: 0 8rpx 24rpx rgba(10, 132, 255, 0.18);
  background: #E8EEF7;
}
.theme-light .pf-avatar-ring--pro .pf-avatar {
  box-shadow: none;
}
.theme-light .pf-avatar--empty {
  border-color: rgba(60, 60, 67, 0.28);
  background: rgba(0, 0, 0, 0.04);
  box-shadow: none;
}
.theme-light .pf-avatar-plus {
  color: rgba(60, 60, 67, 0.45);
}
.theme-light .pf-badge-meta-text {
  color: rgba(60, 60, 67, 0.55);
}
.theme-light .pf-badge-dot {
  background: rgba(0, 0, 0, 0.04);
  border-color: rgba(0, 0, 0, 0.06);
}
.theme-light .checkin-btn--done {
  background: rgba(0, 0, 0, 0.06);
}
.theme-light .checkin-btn--done .checkin-btn-text {
  color: #1C1C1E;
}
.theme-light .pf-asset-label {
  color: rgba(60, 60, 67, 0.55);
}
.theme-light .pf-week {
  border-top-color: rgba(0, 0, 0, 0.06);
}
.theme-light .pf-service-icon-wrap {
  background: rgba(0, 0, 0, 0.04);
}
.theme-light .pf-service-icon--fav {
  filter: none;
  opacity: 0.72;
}
.theme-light .pf-service-fallback {
  color: rgba(28, 28, 30, 0.7);
}
.theme-light .pf-service-label {
  color: rgba(28, 28, 30, 0.78);
}



.checkin-week {
  display: flex;
  justify-content: space-between;
  padding: 16rpx 8rpx 8rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.06);
}
.checkin-dot-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}
.checkin-dot {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.06);
  border: 2rpx solid transparent;
  transition: all 0.3s ease;
}
.checkin-dot--checked {
  background: linear-gradient(135deg, rgba(7, 193, 96, 0.3) 0%, rgba(6, 173, 86, 0.3) 100%);
  border-color: rgba(7, 193, 96, 0.5);
}
.checkin-dot--today {
  border-color: rgba(255, 255, 255, 0.25);
}
.checkin-dot--today.checkin-dot--checked {
  border-color: #07C160;
  box-shadow: 0 0 12rpx rgba(7, 193, 96, 0.4);
}
.checkin-dot--pop {
  animation: checkin-dot-pop 0.48s cubic-bezier(0.34, 1.56, 0.64, 1);
}
@keyframes checkin-dot-pop {
  0% { transform: scale(0.72); }
  55% { transform: scale(1.16); }
  100% { transform: scale(1); }
}
.pf-asset-num--pop {
  display: inline-block;
  animation: checkin-num-pop 0.42s cubic-bezier(0.34, 1.56, 0.64, 1);
}
@keyframes checkin-num-pop {
  0% { transform: scale(0.86); opacity: 0.55; }
  60% { transform: scale(1.12); opacity: 1; }
  100% { transform: scale(1); }
}
.checkin-dot-num {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.5);
  font-weight: 500;
}
.checkin-dot--checked .checkin-dot-num {
  color: #fff;
}
.checkin-dot-label {
  font-size: 18rpx;
  color: rgba(255, 255, 255, 0.3);
}
.checkin-dot-label--today {
  color: rgba(7, 193, 96, 0.9);
  font-weight: 600;
}

.fact-card {
  margin-bottom: var(--space-xl);
  margin-top: 0;
  padding: var(--space-lg);
  position: relative;
  opacity: 0;
  transform-origin: left center;
  transform: perspective(900rpx) rotateY(-78deg) scale(0.96);
  transition: transform 0.52s cubic-bezier(0.22, 1, 0.36, 1), opacity 0.32s ease;
}
.fact-card--show {
  opacity: 1;
  transform: perspective(900rpx) rotateY(0deg) scale(1);
}
.fact-card-close {
  position: absolute;
  top: 16rpx;
  right: 20rpx;
  width: 44rpx;
  height: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: rgba(255, 255, 255, 0.4);
  font-size: 24rpx;
  z-index: 2;
}
.fact-card-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 16rpx;
}
.fact-card-badge {
  font-size: var(--font-size-sm);
  color: var(--color-brand);
  font-weight: var(--font-weight-semibold);
}
.fact-card-category {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.35);
  padding: 4rpx 12rpx;
  background: rgba(255, 255, 255, 0.06);
  border-radius: 999rpx;
}
.fact-card-text {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.88);
  line-height: 1.7;
  display: block;
  margin-bottom: 12rpx;
}
.fact-card-source {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.3);
  display: block;
  text-align: right;
}

.achievement-section {
  margin-bottom: var(--space-xl);
}
.section-title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 var(--space-2xs);
  margin-bottom: var(--space-md);
}
.section-title-text {
  font-size: var(--font-size-md);
  font-weight: var(--font-weight-bold);
  color: var(--color-text-primary);
  letter-spacing: 1rpx;
}
.section-title-count {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.35);
  font-variant-numeric: tabular-nums;
}
.achievement-scroll {
  width: 100%;
}
.achievement-list {
  display: flex;
  gap: 16rpx;
  padding: 4rpx 4rpx 8rpx;
  white-space: nowrap;
}
.achievement-item {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  width: 148rpx;
  min-width: 148rpx;
  padding: 20rpx 12rpx 16rpx;
  background: rgba(255, 255, 255, 0.04);
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  border-radius: 20rpx;
  transition: all 0.3s ease;
}
.achievement-item--locked {
  opacity: 0.4;
}
.achievement-item--locked .achievement-icon-img {
  filter: grayscale(1);
}
.achievement-icon-img {
  width: 64rpx;
  height: 64rpx;
  margin-bottom: 8rpx;
}
.achievement-name {
  font-size: 22rpx;
  font-weight: 600;
  color: rgba(255, 255, 255, 0.85);
  margin-bottom: 4rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  max-width: 130rpx;
}
.achievement-desc {
  font-size: 18rpx;
  color: rgba(255, 255, 255, 0.35);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  max-width: 130rpx;
}




@keyframes glowPulse {
  0%, 100% {
    transform: scale(1);
    opacity: 0.75;
  }
  50% {
    transform: scale(1.12);
    opacity: 1;
  }
}






.favorite-section {
  margin-bottom: var(--space-xl);
}
.favorite-scroll {
  width: 100%;
  white-space: nowrap;
}
.favorite-row {
  display: inline-flex;
  gap: 16rpx;
  padding: 8rpx 4rpx 12rpx;
}
.favorite-card {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
  width: 176rpx;
  padding: 24rpx 16rpx 20rpx;
  border-radius: 20rpx;
  transition: transform 0.12s ease, opacity 0.12s ease;
}
.favorite-card--pressed {
  transform: scale(0.96);
  opacity: 0.85;
}
.favorite-remove {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  width: 40rpx;
  height: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.08);
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.5);
  z-index: 2;
}

.favorite-logo-chip {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 6rpx 18rpx rgba(0, 0, 0, 0.28);
  overflow: hidden;
}
.favorite-logo {
  width: 72rpx;
  height: 72rpx;
}
.favorite-logo-fallback {
  font-size: 44rpx;
}
.favorite-name {
  max-width: 100%;
  font-size: 24rpx;
  font-weight: 600;
  color: rgba(255, 255, 255, 0.9);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.favorite-type {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.4);
}

.appearance-grid {
  display: flex;
  align-items: stretch;
  gap: 16rpx;
}

.appearance-card--theme {
  flex: 8;
}
.appearance-card--art {
  flex: 6;
}



.content-scroll-android {
  -webkit-overflow-scrolling: auto;
}







@keyframes membership-pro-shine {
  0%   { transform: translateX(0) skewX(-18deg); opacity: 0; }
  10%  { opacity: 0.9; }
  60%  { transform: translateX(380%) skewX(-18deg); opacity: 0.9; }
  70%  { opacity: 0; }
  100% { transform: translateX(380%) skewX(-18deg); opacity: 0; }
}
@keyframes membership-pro-breath {
  0%, 100% { opacity: 0.3; }
  50%      { opacity: 0.7; }
}









.year-review-entry {
  margin-bottom: var(--space-xl);
  padding: var(--space-lg) var(--space-md);
  display: flex;
  align-items: center;
  justify-content: space-between;
  border: 1rpx solid rgba(59, 130, 246, 0.28);
  border-radius: var(--radius-card);
  background: linear-gradient(135deg, var(--color-brand-soft) 0%, var(--color-bg-card) 100%);
}
.year-review-entry-inner {
  display: flex;
  align-items: center;
  flex: 1;
  min-width: 0;
}
.year-review-entry-text {
  flex: 1;
  min-width: 0;
}
.year-review-entry-title {
  font-size: var(--font-size-md);
  font-weight: var(--font-weight-semibold);
  color: var(--color-text-primary);
  display: block;
}
.year-review-entry-desc {
  font-size: var(--font-size-sm);
  color: var(--color-brand);
  margin-top: 6rpx;
  display: block;
  opacity: 0.85;
}
.year-review-entry-arrow {
  font-size: 26rpx;
  color: var(--color-brand);
  flex-shrink: 0;
  margin-left: 16rpx;
}



