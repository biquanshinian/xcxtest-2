<wxs module="navPad" src="/utils/nav-scroll-pad.wxs"></wxs>
<!--pages/profile/profile.wxml-->
<page-meta background-color="{{pageBgColor}}" background-color-top="{{pageBgColor}}" background-color-bottom="{{pageBgColor}}" />
<view class="container {{themeClass}} tab-bg-video-host">
  <view class="tab-bg-shell" aria-hidden="true">
    <view class="tab-bg-frost"></view>
  </view>
  <view class="top-nav-wrapper" style="padding-top: {{statusBarHeight}}px;">
    <view class="top-nav top-nav--page-center top-nav--profile">
      <!-- 与右侧胶囊水平居中对齐 -->
      <view
        class="profile-settings-entry"
        style="top: {{menuButtonTop}}px; height: {{menuButtonHeight}}px;"
        bindtap="onToggleSettingsPanel"
        aria-role="button"
        aria-label="设置"
      >
        <text class="profile-settings-entry-text">设置</text>
      </view>
      <text class="nav-title nav-title--page-center nav-title--profile">我的太空</text>
    </view>
  </view>

  <!-- 自定义下拉三点：复用首页样式（app.wxss + nav-scroll-pad.wxs） -->
  <view id="pullRefreshDots" class="pull-refresh-dots" aria-hidden="true">
    <view class="pull-refresh-dots__dot"></view>
    <view class="pull-refresh-dots__dot"></view>
    <view class="pull-refresh-dots__dot"></view>
  </view>

  <scroll-view
    class="content-scroll main-content-scroll nav-aware-scroll {{isAndroid ? 'content-scroll-android' : ''}}"
    scroll-y="true"
    enhanced="{{true}}"
    show-scrollbar="false"
    bounces="{{true}}"
    refresher-enabled="{{true}}"
    refresher-default-style="none"
    refresher-background="{{pageBgColor}}"
    refresher-threshold="36"
    refresher-triggered="{{scrollRefreshing}}"
    data-nav-h="{{navPlaceholderHeight}}"
    data-refresh-threshold="36"
    bindtouchend="{{navPad.onRelease}}"
    bindtouchcancel="{{navPad.onRelease}}"
    bindrefresherpulling="{{navPad.onPulling}}"
    bindrefresherrestore="{{navPad.onReset}}"
    bindrefresherabort="{{navPad.onReset}}"
    bindrefresherrefresh="onScrollRefresh"
    bindscroll="onProfileScroll"
  >
    
    <nav-scroll-pad id="navScrollPad" class="nav-scroll-pad" height="{{navPlaceholderHeight}}" />

    <!-- ══ 身份区（头像可上传 · 昵称可改） ══ -->
    <view class="pf-identity">
      <view class="pf-avatar-halo {{memberIsPro ? 'pf-avatar-halo--pro' : ''}}">
        <view
          class="pf-avatar-ring {{memberIsPro ? 'pf-avatar-ring--pro' : ''}}"
          bindtap="onAvatarTap"
          aria-role="button"
          aria-label="{{identityHasAvatar ? '更换头像' : '添加头像'}}"
        >
          <view class="pf-avatar {{identityHasAvatar ? '' : 'pf-avatar--empty'}}">
            <image wx:if="{{identityHasAvatar}}" class="pf-avatar-img" src="{{identityAvatarUrl}}" mode="aspectFill" />
            <text wx:else class="pf-avatar-plus">+</text>
          </view>
        </view>
      </view>
      <view class="pf-identity-main">
        <view class="pf-name-row">
          <text class="pf-name" bindtap="onDisplayNameTap">{{identityDisplayName}}</text>
        </view>
        <view class="pf-badge-meta" bindtap="goBadges">
          <text class="pf-badge-meta-text">成就徽章 {{achievementInfo.unlockedCount}}/{{achievementInfo.totalCount}}</text>
          <scroll-view class="pf-badge-scroll" scroll-x enhanced show-scrollbar="{{false}}">
            <view class="pf-badge-row">
              <view
                class="pf-badge-dot {{item.unlocked ? '' : 'pf-badge-dot--locked'}}"
                wx:for="{{achievementInfo.achievements}}"
                wx:key="id"
                catchtap="onAchievementTap"
                data-index="{{index}}"
              >
                <image class="pf-badge-dot-img" src="{{item.iconUrl}}" mode="aspectFit" />
              </view>
            </view>
          </scroll-view>
        </view>
      </view>
      <view class="checkin-btn {{checkinSummary.isCheckedInToday ? 'checkin-btn--done' : ''}}" bindtap="onCheckIn">
        <text class="checkin-btn-icon" wx:if="{{checkinSummary.isCheckedInToday}}">✓</text>
        <text class="checkin-btn-text">{{checkinSummary.isCheckedInToday ? '已签到' : '签到'}}</text>
      </view>
    </view>

    <!-- ══ 通行证主卡 ══ -->
    <view
      class="pf-pass-card {{memberIsPro ? 'pf-pass-card--pro' : ''}}"
      wx:if="{{membershipEnabled}}"
      bindtap="goMembership"
    >
      <view class="pf-pass-card__shine" wx:if="{{memberIsPro}}"></view>
      <view class="pf-pass-top">
        <view class="pf-pass-top-text">
          <view class="pf-pass-title-row">
            <image wx:if="{{memberIcon}}" class="pf-pass-badge" src="{{memberIcon}}" mode="aspectFit" />
            <text class="pf-pass-title">星际通行证</text>
          </view>
          <text class="pf-pass-desc">{{memberIsPro ? '已开通 · 尊享全部权益' : '解锁 AI 无限对话、去广告等权益'}}</text>
        </view>
        <text class="pf-pass-cta">{{memberIsPro ? '查看权益' : '去开通'}}</text>
      </view>
      <view class="pf-pass-benefits">
        <view class="pf-pass-benefit" wx:for="{{passBenefits}}" wx:key="name">
          <image class="pf-pass-benefit-icon" src="{{item.iconUrl}}" mode="aspectFit" />
          <text class="pf-pass-benefit-name">{{item.name}}</text>
        </view>
      </view>
    </view>

    <!-- ══ 我的数据 ══ -->
    <view class="pf-section">
      <view class="section-title-row">
        <text class="section-title-text">我的数据</text>
      </view>
      <view class="pf-assets-card glass-card">
        <view class="pf-assets-grid">
          <view class="pf-asset">
            <text class="pf-asset-num">{{checkinSummary.totalDays}}</text>
            <text class="pf-asset-label">累计签到</text>
          </view>
          <view class="pf-asset">
            <text class="pf-asset-num {{streakPop ? 'pf-asset-num--pop' : ''}}">{{checkinSummary.currentStreak}}</text>
            <text class="pf-asset-label">连续天数</text>
          </view>
          <view class="pf-asset">
            <text class="pf-asset-num">{{checkinSummary.factsCollected}}</text>
            <text class="pf-asset-label">知识卡</text>
          </view>
          <view class="pf-asset">
            <text class="pf-asset-num">{{myReminders.length}}</text>
            <text class="pf-asset-label">我的提醒</text>
          </view>
        </view>
        <view class="checkin-week pf-week">
          <view class="checkin-dot-wrap" wx:for="{{weekDots}}" wx:key="date">
            <view class="checkin-dot {{item.checked ? 'checkin-dot--checked' : ''}} {{item.isToday ? 'checkin-dot--today' : ''}} {{item.isToday && checkinPop ? 'checkin-dot--pop' : ''}}">
              <text class="checkin-dot-num">{{item.dayNum}}</text>
            </view>
            <text class="checkin-dot-label {{item.isToday ? 'checkin-dot-label--today' : ''}}">{{item.day}}</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 签到成功知识卡 -->
    <view class="fact-card glass-card {{showFactCard ? 'fact-card--show' : ''}}" wx:if="{{todayFact}}">
      <view class="fact-card-close" bindtap="closeFactCard"><text>✕</text></view>
      <view class="fact-card-header">
        <text class="fact-card-badge">🌌 太空知识卡 #{{todayFact.id}}</text>
        <text class="fact-card-category">{{todayFact.category}}</text>
      </view>
      <text class="fact-card-text">{{todayFact.fact}}</text>
      <text class="fact-card-source">— {{todayFact.source}}</text>
    </view>

    <!-- ══ 推广条：观礼 / 年鉴 ══ -->
    <view class="pf-promo" wx:if="{{enableWatchParty}}" bindtap="goWatchParty">
      <view class="pf-promo-text">
        <text class="pf-promo-title">火箭发射观礼</text>
        <text class="pf-promo-desc">现场预约 · 奖品 · 商家合作{{watchPartyCount > 0 ? ' · ' + watchPartyCount + ' 场' : ''}}</text>
      </view>
      <text class="pf-promo-btn">去看看</text>
    </view>
    <view class="pf-promo pf-promo--year" wx:elif="{{yearReviewVisible}}" bindtap="goYearReview">
      <view class="pf-promo-text">
        <text class="pf-promo-title">{{yearReviewTitle}}</text>
        <text class="pf-promo-desc">{{yearReviewSubtitle}}</text>
      </view>
      <text class="pf-promo-btn">查看年鉴</text>
    </view>

    <!-- ══ 更多服务 ══ -->
    <view class="pf-section">
      <view class="section-title-row">
        <text class="section-title-text">更多服务</text>
      </view>
      <view class="pf-services-card glass-card">
        <view class="pf-services-grid">
          <view class="pf-service" wx:if="{{briefingEnabled}}" bindtap="openProfileBriefing">
            <view class="pf-service-icon-wrap pf-service-icon-wrap--briefing">
              <image wx:if="{{briefingIcon}}" class="pf-service-icon" src="{{briefingIcon}}" mode="aspectFit" />
              <text wx:else class="pf-service-fallback">报</text>
            </view>
            <text class="pf-service-label">今日简报</text>
          </view>
          <view class="pf-service" bindtap="goTimeline">
            <view class="pf-service-icon-wrap">
              <image wx:if="{{timelineIcon}}" class="pf-service-icon" src="{{timelineIcon}}" mode="aspectFit" />
              <text wx:else class="pf-service-fallback">旅</text>
            </view>
            <text class="pf-service-label">太空旅程</text>
          </view>
          <view class="pf-service" wx:if="{{membershipEnabled}}" bindtap="goMembership">
            <view class="pf-service-icon-wrap">
              <image wx:if="{{memberIcon}}" class="pf-service-icon" src="{{memberIcon}}" mode="aspectFit" />
              <text wx:else class="pf-service-fallback">证</text>
            </view>
            <text class="pf-service-label">通行证</text>
          </view>
          <view class="pf-service" wx:if="{{enableWatchParty}}" bindtap="goWatchParty">
            <view class="pf-service-icon-wrap">
              <image wx:if="{{watchPartyIcon}}" class="pf-service-icon" src="{{watchPartyIcon}}" mode="aspectFit" />
              <text wx:else class="pf-service-fallback">观</text>
            </view>
            <text class="pf-service-label">发射观礼</text>
            <view class="pf-service-badge" wx:if="{{watchPartyCount > 0}}"><text>{{watchPartyCount}}</text></view>
          </view>
          <view class="pf-service" bindtap="goFavorites">
            <view class="pf-service-icon-wrap">
              <image class="pf-service-icon pf-service-icon--fav" src="/images/icons/ic-fav-heart.svg" mode="aspectFit" />
            </view>
            <text class="pf-service-label">我的收藏</text>
            <view class="pf-service-badge" wx:if="{{favoritesCount > 0}}"><text>{{favoritesCount}}</text></view>
          </view>
          <view class="pf-service" bindtap="goVoteRecord">
            <view class="pf-service-icon-wrap">
              <text class="pf-service-fallback">猜</text>
            </view>
            <text class="pf-service-label">竞猜战绩</text>
          </view>
          <view class="pf-service" bindtap="goDailyQuiz">
            <view class="pf-service-icon-wrap">
              <text class="pf-service-fallback">挑</text>
            </view>
            <text class="pf-service-label">每日挑战</text>
          </view>
          <button
            class="pf-service pf-service--contact"
            open-type="contact"
            bindcontact="onContactCallback"
            session-from="profile-services"
            hover-class="pf-service--pressed"
          >
            <view class="pf-service-icon-wrap">
              <image class="pf-service-icon" src="/images/icon-customer-service.svg" mode="aspectFit" />
            </view>
            <text class="pf-service-label">在线客服</text>
          </button>
        </view>
      </view>
    </view>

    <!-- 徽章详情弹窗 -->
    <badge-modal visible="{{showBadgeModal}}" badge="{{badgeModalData}}" bind:close="closeBadgeModal" />


    <!-- ══ 设置 / 我的提醒 / 竞猜战绩 / 每日问答 / 在线客服：profile-extra 分包组件 ══
         纯展示组件，状态由页面下发；交互经单一 sectionevent 通道回传（detail: { name, dataset, edetail }） -->
    <profile-sections
      theme-class="{{themeClass}}"
      theme-mode="{{themeMode}}"
      rocket-art-style="{{rocketArtStyle}}"
      content-lang="{{contentLang}}"
      briefing-enabled="{{briefingEnabled}}"
      settings-panel-open="{{settingsPanelOpen}}"
      settings-panel-pad-top="{{settingsPanelPadTop}}"
      rocket-options="{{rocketOptions}}"
      site-options="{{siteOptions}}"
      notify-options="{{notifyOptions}}"
      rocket-map="{{rocketMap}}"
      site-map="{{siteMap}}"
      selected-rocket-count="{{selectedRocketCount}}"
      selected-site-count="{{selectedSiteCount}}"
      pref-rockets-expanded="{{prefRocketsExpanded}}"
      pref-sites-expanded="{{prefSitesExpanded}}"
      notify-minutes="{{notifyMinutes}}"
      road-closure-alert="{{roadClosureAlert}}"
      pref-saving="{{prefSaving}}"
      my-reminders="{{myReminders}}"
      oa-alert-enabled="{{oaAlertEnabled}}"
      oa-alert-followed="{{oaAlertFollowed}}"
      oa-alert-ready="{{oaAlertReady}}"
      oa-alert-message="{{oaAlertMessage}}"
      oa-alert-loading="{{oaAlertLoading}}"
      oa-qr-guide-open="{{oaQrGuideOpen}}"
      oa-follow-qr-url="{{oaFollowQrUrl}}"
      vote-stats="{{voteStats}}"
      vote-history="{{voteHistory}}"
      vote-history-expanded="{{voteHistoryExpanded}}"
      quiz-question="{{quizQuestion}}"
      quiz-answered="{{quizAnswered}}"
      quiz-selected-index="{{quizSelectedIndex}}"
      quiz-result="{{quizResult}}"
      quiz-stats="{{quizStats}}"
      about-text="{{aboutText}}"
      about-wechat="{{aboutWechat}}"
      figma-share-enabled="{{figmaShareEnabled}}"
      bind:sectionevent="onProfileSectionEvent"
    />

    <view style="height: {{tabBarReservedHeight}}px;"></view>
  </scroll-view>

<nasa-float id="nasaFloat" />
  <popup-ad visible="{{popupAdVisible}}" shop-item="{{popupAdItem}}" bind:close="onPopupAdClose"></popup-ad>
  <milestone-egg visible="{{showMilestoneEgg}}" milestone="{{currentMilestone}}" bindclose="onMilestoneClose" bindclaimed="onMilestoneClaimed" />
  <demo-overlay id="demoOverlay" showControls="{{false}}" qrcodeUrl="https://mars-1397421562.cos.ap-guangzhou.myqcloud.com/%E5%B0%8F%E7%A8%8B%E5%BA%8F%E4%BA%8C%E7%BB%B4%E7%A0%81/1775323336594_jkl6zv.png" loop="{{true}}" />
  <privacy-modal id="globalPrivacyModal"></privacy-modal>
</view>
