  text-overflow: ellipsis;
  white-space: nowrap;
}
.upcoming-agency-chip-count.tweet-stat-count {
  flex-shrink: 0;
  margin-left: 4rpx;
  font-size: 18rpx;
}
.missions-agency-empty {
  padding: 28rpx 16rpx 8rpx;
  text-align: center;
}

.mission-gate-banner {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin: 8rpx 0 16rpx;
  padding: 28rpx 28rpx;
  border-radius: 20rpx;
  background: linear-gradient(135deg, rgba(255, 179, 71, 0.14), rgba(255, 120, 73, 0.10));
  border: 1rpx solid rgba(255, 179, 71, 0.35);
}
.mission-gate-banner-icon {
  font-size: 40rpx;
  line-height: 1;
}
.mission-gate-banner-texts {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  min-width: 0;
}
.mission-gate-banner-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #ffb347;
}
.mission-gate-banner-sub {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.55);
}
.mission-gate-banner-arrow {
  font-size: 44rpx;
  color: rgba(255, 179, 71, 0.8);
  line-height: 1;
}
.theme-light .mission-gate-banner {
  background: linear-gradient(135deg, rgba(255, 150, 40, 0.10), rgba(255, 110, 60, 0.07));
  border-color: rgba(220, 130, 30, 0.35);
}
.theme-light .mission-gate-banner-title {
  color: #c97a12;
}
.theme-light .mission-gate-banner-sub {
  color: rgba(60, 50, 40, 0.6);
}
.theme-light .mission-gate-banner-arrow {
  color: rgba(201, 122, 18, 0.8);
}
.missions-list {
  display: flex;
  flex-direction: column;
  gap: var(--space-md);
  width: 100%;
  box-sizing: border-box;
}

.mission-skeleton-card {
  width: 100%;
  aspect-ratio: 4 / 2;
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 24rpx;
  padding: 24rpx;
  box-sizing: border-box;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.04);
  overflow: hidden;
}
.mission-skeleton-thumb {
  width: 35%;
  height: 100%;
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.07);
  animation: mission-skeleton-pulse 1.4s ease-in-out infinite;
}
.mission-skeleton-lines {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}
.mission-skeleton-line {
  height: 28rpx;
  border-radius: 8rpx;
  background: rgba(255, 255, 255, 0.07);
  animation: mission-skeleton-pulse 1.4s ease-in-out infinite;
}
.mission-skeleton-line--wide {
  width: 80%;
}
.mission-skeleton-line--narrow {
  width: 50%;
}
@keyframes mission-skeleton-pulse {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.45; }
}

.mission-swipe-cell {
  position: relative;
  width: 100%;
  overflow: hidden;
  border-radius: 24rpx;
}

.mission-swipe-cell--pinned > .mission-swipe-front {
  background: rgba(52, 199, 89, 0.22);
  border-radius: 24rpx;
  box-shadow:
    inset 0 0 0 3rpx rgba(130, 230, 156, 0.72),
    0 8rpx 28rpx rgba(52, 199, 89, 0.14);
}
.mission-swipe-actions {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 28rpx;
  padding: 24rpx 18rpx;
  
  opacity: 0;
  pointer-events: none;
  transition: opacity 0s linear 300ms;
  background: rgba(10, 14, 22, 0.94);
  z-index: 0;
}

.mission-swipe-actions--visible {
  opacity: 1;
  pointer-events: auto;
  transition: opacity 0s;
}
.mission-swipe-front {
  position: relative;
  z-index: 1;
  width: 100%;
  background: transparent;
}
.mission-swipe-btn {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  margin: 0;
}
.mission-swipe-btn-stack {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: auto;
  gap: 8rpx;
}
.mission-swipe-btn-label {
  font-size: 20rpx;
  line-height: 1.1;
  color: rgba(255, 255, 255, 0.72);
  font-weight: 500;
}
.mission-swipe-btn--on-bell .mission-swipe-btn-label {
  color: rgba(185, 244, 201, 0.98);
}
.mission-swipe-btn--on-pin .mission-swipe-btn-label {
  color: rgba(185, 244, 201, 0.98);
}
.mission-swipe-btn-grow {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  flex: none;
  min-height: 52rpx;
  will-change: transform, opacity;
}

.mission-swipe-icon-slot,
.mission-swipe-pin-slot {
  position: relative;
  width: 44rpx;
  height: 44rpx;
}
.mission-swipe-icon-layer {
  position: absolute;
  left: 0;
  top: 0;
  width: 44rpx;
  height: 44rpx;
  display: block;
}
.mission-swipe-icon {
  width: 44rpx;
  height: 44rpx;
  display: block;
}
.mission-swipe-pin-img-off {
  opacity: 0.88;
}
.mission-swipe-pin-img-on {
  opacity: 0;
  pointer-events: none;
}
.mission-swipe-btn--on-pin .mission-swipe-pin-img-off {
  opacity: 0;
  pointer-events: none;
}
.mission-swipe-btn--on-pin .mission-swipe-pin-img-on {
  opacity: 1;
  pointer-events: auto;
}
.mission-swipe-btn--on-bell {
  background: rgba(52, 199, 89, 0.26);
  border-radius: 999rpx;
  border: 2rpx solid rgba(130, 230, 156, 0.98);
}
.mission-swipe-btn--on-pin {
  background: rgba(52, 199, 89, 0.26);
  border-radius: 999rpx;
  border: 2rpx solid rgba(130, 230, 156, 0.98);
}
.mission-swipe-btn--on-pin .mission-swipe-pin-img-on {
  filter: drop-shadow(0 0 12rpx rgba(72, 230, 140, 0.85));
}
.mission-card-inner-row {
  display: flex;
  flex-direction: row;
  width: 100%;
  
  height: auto;
  min-height: 0;
}

.mission-card {
  width: 100%;
  max-width: 100%;
  min-height: 345rpx;
  display: flex;
  flex-direction: row;
  padding: 0;
  overflow: hidden;
  box-sizing: border-box;
}

.mission-card.mission-card--failure {
}
.mission-card.mission-card--partial {
}
.theme-light .mission-card.mission-card--failure {
}
.theme-light .mission-card.mission-card--partial {
}
.mission-card-link {
  text-decoration: none;
  color: inherit;
}
.mission-card-link::after {
  border: none;
}
.mission-card-link:active {
  color: inherit;
}
.mission-rocket-slot {
  position: relative;
  width: 40%;
  
  height: auto;
  align-self: stretch;
  min-width: 200rpx;
  flex-shrink: 0;
}
.mission-rocket-image {
  
  
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  min-width: 0;
  object-fit: cover;
  object-position: center center;
  background-color: #1a1a1a;
  display: block;
}
.mission-rocket-image--placeholder {
  background: rgba(255, 255, 255, 0.04);
}

.mission-card-pano {
  position: absolute;
  left: 10rpx;
  top: 10rpx;
  z-index: 3;
  width: 52rpx;
  height: 52rpx;
  pointer-events: none;
}

.mission-card-pano-orbit {
  position: absolute;
  left: 2rpx;
  top: 2rpx;
  right: 2rpx;
  bottom: 2rpx;
  border-radius: 50%;
  border: 2rpx solid rgba(255, 255, 255, 0.22);
  border-top-color: #ffffff;
  border-right-color: rgba(255, 255, 255, 0.55);
  box-sizing: border-box;
  animation: mission-card-pano-spin 1.8s linear infinite;
}

.mission-card-pano-orbit--tilt {
  left: -2rpx;
  right: -2rpx;
  top: 14rpx;
  bottom: 14rpx;
  border-top-color: rgba(255, 255, 255, 0.95);
  border-bottom-color: rgba(255, 255, 255, 0.28);
  border-left-color: rgba(255, 255, 255, 0.12);
  border-right-color: rgba(255, 255, 255, 0.12);
  animation-duration: 2.8s;
  animation-direction: reverse;
}

.mission-card-pano-core {
  position: absolute;
  left: 12rpx;
  top: 12rpx;
  right: 12rpx;
  bottom: 12rpx;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.58);
  border: 2rpx solid rgba(255, 255, 255, 0.88);
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.mission-card-pano-360 {
  font-size: 14rpx;
  font-weight: 800;
  color: #ffffff;
  line-height: 1;
  letter-spacing: -1rpx;
  transform: scale(0.8);
}

@keyframes mission-card-pano-spin {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}
.mission-rocket-countdown {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 36rpx 8rpx 10rpx;
  background: linear-gradient(180deg, rgba(0, 0, 0, 0) 0%, rgba(0, 0, 0, 0.78) 52%, rgba(0, 0, 0, 0.88) 100%);
  display: flex;
  align-items: flex-end;
  justify-content: center;
  pointer-events: none;
  box-sizing: border-box;
}

.mission-rocket-countdown .countdown-display--mission-card {
  width: 100%;
  margin: 0;
  gap: 6rpx;
}
.mission-rocket-countdown .countdown-item--tech {
