
@import "../../styles/tweet-stats-bar.wxss";
.container {
  padding-bottom: 0;
  padding-top: 0;
}

.top-nav-wrapper {
  background: rgba(12, 14, 18, 0.08);
  backdrop-filter: blur(48rpx) saturate(170%);
  -webkit-backdrop-filter: blur(48rpx) saturate(170%);
  display: flex;
  flex-direction: column;
  
}

.top-nav {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 70rpx 30rpx 0rpx;
  gap: 20rpx;
  min-height: 90rpx;
  position: relative;
}
.nav-search-btn {
  position: absolute;
  left: 30rpx;
  top: 12rpx;
  width: 74rpx;
  height: 54rpx;
  background: rgba(18, 20, 24, 0.16);
  backdrop-filter: blur(34rpx) saturate(170%);
  -webkit-backdrop-filter: blur(34rpx) saturate(170%);
  border: 1px solid rgba(255, 255, 255, 0.1);
  border-radius: 999rpx;
  box-shadow:
    0 4rpx 16rpx rgba(0, 0, 0, 0.3),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.12);
  padding: 0;
  z-index: 2;
  transition: opacity 0.2s ease, transform 0.2s ease;
}
.icon-search--nav {
  position: absolute;
  left: 50%;
  top: 50%;
  font-size: 51rpx;
  transform: translate(-50%, -55%) scaleX(-1);
}

.countdown-card-actions {
  position: relative;
  width: 100%;
  margin-top: 10rpx;
}

.nav-button {
  flex: 1;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  
  transform: translateY(3px);
  background: transparent;
  border: none;
  border-radius: 0;
  color: var(--color-text-secondary);
  font-size: var(--font-size-md);
  transition: color 0.25s ease, font-weight 0.25s ease;
  box-shadow: none;
  position: relative;
  overflow: visible;
}
.nav-button::after {
  content: '';
  position: absolute;
  left: 50%;
  bottom: 0;
  width: 44rpx;
  height: 6rpx;
  border-radius: 999rpx;
  background: var(--color-brand, #3B82F6);
  transform: translateX(-50%) scaleX(0);
  opacity: 0;
  transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.2s ease;
  pointer-events: none;
}
.nav-button.active {
  background: transparent;
  border: none;
  color: var(--color-text-primary);
  font-weight: 600;
  box-shadow: none;
}
.nav-button.active::after {
  transform: translateX(-50%) scaleX(1);
  opacity: 1;
}

.nav-button--completed.active {
  color: var(--color-text-primary);
}

.content-scroll {
  padding: 0 var(--space-lg);
}

.countdown-card {
  width: 100%;
  max-width: 100%;
  min-height: 380rpx;
  padding: var(--space-md) var(--space-lg) var(--space-sm);
  margin-top: 0;
  margin-bottom: var(--space-md);
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  overflow: visible;
  position: relative;
}

.countdown-card.glass-card::after,
.countdown-card::after {
  content: none;
  display: none;
}


.countdown-side-card {
  width: 100%;
  box-sizing: border-box;
  margin: -6rpx 0 var(--space-md);
  padding: var(--space-sm) var(--space-md) var(--space-sm) var(--space-sm);
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: var(--space-sm);
  border-radius: var(--radius-card);
  background: rgba(255, 255, 255, 0.04);
  transition: opacity 0.18s ease, transform 0.18s ease, background 0.18s ease;
}
.countdown-side-card:active {
  opacity: 0.88;
  transform: scale(0.992);
  background: rgba(255, 255, 255, 0.06);
}
.countdown-side-thumb {
  width: 64rpx;
  height: 64rpx;
  flex-shrink: 0;
  border-radius: 50%;
  overflow: hidden;
  background: rgba(255, 255, 255, 0.06);
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  box-sizing: border-box;
}
.countdown-side-thumb-img {
  width: 100%;
  height: 100%;
  display: block;
}
.countdown-side-thumb-placeholder {
  width: 100%;
  height: 100%;
  background: rgba(255, 255, 255, 0.05);
}
.countdown-side-body {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}
.countdown-side-top {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 10rpx;
  min-width: 0;
}
.countdown-side-label {
  font-size: 18rpx;
  line-height: 1.2;
  letter-spacing: 0.04em;
  color: rgba(255, 255, 255, 0.42);
  flex-shrink: 0;
}
.countdown-side-status {
  font-size: 18rpx;
  line-height: 1.2;
  color: rgba(255, 196, 120, 0.88);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.countdown-side-main {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}
.countdown-side-text {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 2rpx;
}
.countdown-side-name {
  font-size: 26rpx;
  line-height: 1.25;
  font-weight: 560;
  color: rgba(255, 255, 255, 0.9);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.countdown-side-cd {
  flex-shrink: 0;
  font-size: 36rpx;
  line-height: 1.1;
  font-weight: 640;
  letter-spacing: 0.02em;
  font-variant-numeric: tabular-nums;
  font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
  color: rgba(255, 255, 255, 0.92);
}
.countdown-side-cd--confirm {
  color: rgba(255, 196, 120, 0.95);
  font-family: inherit;
  font-size: 28rpx;
  font-weight: 600;
  letter-spacing: 0;
}
.countdown-side-meta {
  font-size: 20rpx;
  line-height: 1.2;
  color: rgba(255, 255, 255, 0.38);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.countdown-side-chevron {
  flex-shrink: 0;
  font-size: 32rpx;
  line-height: 1;
  color: rgba(255, 255, 255, 0.28);
  margin-top: -2rpx;
}
.countdown-card-main {
  display: flex;
  flex-direction: column;
  border-radius: 24rpx;
  transition: transform 0.18s ease, opacity 0.18s ease, background 0.18s ease;
}
.countdown-card-main:active {
  transform: scale(0.992);
  opacity: 0.92;
  background: rgba(255, 255, 255, 0.03);
}

.countdown-visual-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: flex-start;
  gap: 22rpx;
  flex-shrink: 0;
}

.countdown-rocket-wrap {
  position: relative;
  width: 132rpx;
  flex-shrink: 0;
  padding-bottom: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  
  overflow: visible;
}
.countdown-rocket-wrap.is-live {
  padding-bottom: 22rpx;
}
.countdown-rocket-wrap.is-t10 .countdown-rocket-slot {
  border: 3rpx solid #FF9500;
  animation: cd-t10-pulse 0.7s ease-in-out infinite;
}
@keyframes cd-t10-pulse {
  0%, 100% { box-shadow: 0 0 0 0 rgba(255, 149, 0, 0.42); }
  50% { box-shadow: 0 0 0 10rpx rgba(255, 149, 0, 0); }
}

.countdown-rocket-slot {
  position: relative;
  z-index: 2;
  width: 132rpx;
  height: 132rpx;
  flex-shrink: 0;
  border-radius: 50%;
  overflow: hidden;
  background: rgba(255, 255, 255, 0.06);
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
}
.countdown-rocket-slot--live {
  border: 4rpx solid #ff2d55;
  animation: cd-live-ring-breathe 1.6s ease-in-out infinite;
}
.countdown-rocket-img {
  width: 100%;
  height: 100%;
  display: block;
  object-fit: cover;
  object-position: center center;
}
.countdown-rocket-slot-inner {
  width: 100%;
  height: 100%;
}
.countdown-rocket-avatar--placeholder {
  background: rgba(255, 255, 255, 0.05);
}

.cd-live-ripple {
  position: absolute;
  top: 66rpx;
  left: 50%;
  width: 132rpx;
  height: 132rpx;
  margin-top: -66rpx;
  margin-left: -66rpx;
  border-radius: 50%;
  border: 2rpx solid rgba(255, 45, 85, 0.55);
  box-sizing: border-box;
  pointer-events: none;
  z-index: 1;
  animation: cd-live-ripple 1.8s ease-out infinite;
}
.cd-live-ripple--2 {
  animation-delay: 0.9s;
}

.cd-avatar-tag {
  position: absolute;
  left: 50%;
  bottom: 0;
  z-index: 3;
  transform: translateX(-50%);
  display: inline-flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  height: 36rpx;
  padding: 0 14rpx;
  border-radius: 999rpx;
  white-space: nowrap;
  box-sizing: border-box;
}
.cd-avatar-tag--live {
  background: linear-gradient(90deg, #ff2d55, #ff453a);
  box-shadow: 0 4rpx 12rpx rgba(255, 45, 85, 0.35);
}
.cd-avatar-tag-text {
  font-size: 20rpx;
  font-weight: 600;
  color: #ffffff;
  line-height: 1;
  letter-spacing: 0.5rpx;
}

.cd-live-eq {
  display: flex;
  flex-direction: row;
  align-items: flex-end;
  gap: 3rpx;
  height: 18rpx;
  flex-shrink: 0;
}
.cd-live-eq-bar {
  width: 4rpx;
  height: 100%;
  border-radius: 999rpx;
  background: #ffffff;
  transform-origin: center bottom;
  animation: cd-live-eq 0.8s ease-in-out infinite;
}
.cd-live-eq-bar:nth-child(1) { animation-delay: 0s; }
.cd-live-eq-bar:nth-child(2) { animation-delay: 0.15s; }
.cd-live-eq-bar:nth-child(3) { animation-delay: 0.3s; }

.countdown-rocket-wrap.is-entering .countdown-rocket-slot--live {
  animation: cd-live-enter 0.22s ease-out forwards;
}
.countdown-rocket-wrap.is-entering .cd-avatar-tag--live {
  animation: cd-live-tag-enter 0.22s ease-out forwards;
}
.countdown-rocket-wrap.is-entering .cd-live-ripple {
  animation: cd-live-ripple-burst 0.22s ease-out forwards;
}

.countdown-rocket-wrap.is-paused:not(.is-entering) .countdown-rocket-slot--live,
.countdown-rocket-wrap.is-paused:not(.is-entering) .cd-live-ripple,
.countdown-rocket-wrap.is-paused:not(.is-entering) .cd-live-eq-bar {
  animation: none !important;
}
@keyframes cd-live-ring-breathe {
  0%, 100% { border-color: rgba(255, 45, 85, 0.85); }
  50% { border-color: rgba(255, 45, 85, 1); }
}
@keyframes cd-live-ripple {
  0% {
    transform: scale(1);
    opacity: 0.55;
  }
  100% {
    transform: scale(1.38);
    opacity: 0;
  }
}
@keyframes cd-live-eq {
  0%, 100% { transform: scaleY(0.35); }
  25% { transform: scaleY(1); }
  50% { transform: scaleY(0.55); }
  75% { transform: scaleY(0.85); }
}
@keyframes cd-live-enter {
  0% { transform: scale(1); }
  45% { transform: scale(0.9); }
  100% { transform: scale(1.05); }
}
@keyframes cd-live-tag-enter {
  0% { transform: translateX(-50%) scale(1); }
  45% { transform: translateX(-50%) scale(0.92); }
  100% { transform: translateX(-50%) scale(1.08); }
}
@keyframes cd-live-ripple-burst {
  0% {
    transform: scale(1);
    opacity: 0.65;
  }
  100% {
    transform: scale(1.5);
    opacity: 0;
  }
}
.countdown-visual-right {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}
.countdown-header {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: stretch;
  margin-bottom: 8rpx;
  flex-shrink: 0;
  gap: 16rpx;
}
.header-left {
  display: flex;
  flex-direction: column;
  flex: 1;
  min-width: 0;
}

.header-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  justify-content: space-between;
  flex-shrink: 0;
  min-width: 0;
  align-self: stretch;
}

.status-indicator {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 8rpx;
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.04);
  border: 1px solid rgba(255, 255, 255, 0.06);
}
.status-light {
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
  background: #8E8E93;
  animation: breathe 2s ease-in-out infinite;
  flex-shrink: 0;
}

.status-indicator[data-status="pending"] .status-light {
  background: var(--color-brand);
  box-shadow: 0 0 8rpx var(--color-brand-glow);
}
.status-indicator[data-status="pending"] .status-text {
  color: var(--color-brand);
}
.status-indicator[data-status="inflight"] .status-light {
  background: #5AC8FA;
  box-shadow: 0 0 8rpx rgba(90, 200, 250, 0.6);
}
.status-indicator[data-status="inflight"] .status-text {
  color: #5AC8FA;
}
.status-indicator[data-status="delayed"] .status-light,
.status-indicator[data-status="cancelled"] .status-light {
  background: #FF9500;
  box-shadow: 0 0 8rpx rgba(255, 149, 0, 0.6);
}
.status-indicator[data-status="delayed"] .status-text,
.status-indicator[data-status="cancelled"] .status-text {
  color: #FF9500;
}
.status-indicator[data-status="success"] .status-light,
.status-indicator[data-status="deployed"] .status-light {
  background: #34C759;
  box-shadow: 0 0 8rpx rgba(52, 199, 89, 0.6);
}
.status-indicator[data-status="success"] .status-text,
.status-indicator[data-status="deployed"] .status-text {
  color: #34C759;
}
.status-indicator[data-status="failure"] .status-light {
  background: #FF3B30;
  box-shadow: 0 0 8rpx rgba(255, 59, 48, 0.6);
}
.status-indicator[data-status="failure"] .status-text {
  color: #FF3B30;
}
.status-indicator[data-status="partial"] .status-light {
  background: #FF9500;
  box-shadow: 0 0 8rpx rgba(255, 149, 0, 0.6);
}
.status-indicator[data-status="partial"] .status-text {
  color: #FF9500;
}
.status-text {
  font-size: 28rpx;
  color: #8E8E93;
  line-height: 1;
  white-space: nowrap;
}

@keyframes breathe {
  0%, 100% {
    opacity: 1;
    transform: scale(1);
  }
  50% {
    opacity: 0.5;
    transform: scale(0.8);
  }
}

.launch-time-label-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  margin-bottom: 4rpx;
  min-width: 0;
}
.launch-time-label {
  font-size: 21rpx;
  color: rgba(255, 255, 255, 0.52);
  letter-spacing: 1rpx;
  flex-shrink: 0;
  line-height: 1.2;
}

.launch-delay-badge {
  margin-left: 0;
  margin-bottom: 8rpx;
  padding: 0 8rpx;
  font-size: 17rpx;
  line-height: 26rpx;
  letter-spacing: 0;
  color: var(--color-warning, #FF9500);
  border: 1rpx solid rgba(255, 149, 0, 0.45);
  border-radius: 999rpx;
  white-space: nowrap;
  flex-shrink: 0;
  box-sizing: border-box;
  align-self: flex-end;
}
.launch-delay-badge-text {
  font-size: 17rpx;
  line-height: 26rpx;
  letter-spacing: 0;
  color: inherit;
}
.launch-time {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 2rpx;
  min-width: 0;
  font-size: 30rpx;
  color: #FFFFFF;
  font-weight: 500;
  line-height: 1.25;
}

.launch-time-date {
  display: block;
  font-size: inherit;
  color: inherit;
  font-weight: inherit;
  line-height: inherit;
}

.launch-time-weekclock {
  display: block;
  font-size: inherit;
  color: inherit;
  font-weight: inherit;
  line-height: inherit;
  white-space: nowrap;
}

.countdown-display {
  display: flex;
  align-items: stretch;
  justify-content: center;
  margin: 6rpx 0 4rpx;
  gap: 18rpx;
  flex-shrink: 0;
}
.countdown-display--tech {
  padding: 0;
  border-radius: 0;
  background: transparent;
  border: none;
  box-shadow: none;
}

.countdown-display--tbd {
  align-items: center;
  min-height: 92rpx;
  padding: 0 8rpx;
}
.countdown-tbd-text {
  font-size: 30rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
  color: rgba(200, 222, 255, 0.78);
}
.countdown-visual-right .countdown-display--tbd {
  min-height: 84rpx;
}
.countdown-item {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 0;
}
.countdown-visual-right .countdown-display {
  gap: 12rpx;
  margin-bottom: 2rpx;
}
.countdown-visual-right .countdown-item--tech {
  min-width: 0;
  flex: 1;
  padding: 8rpx 6rpx 6rpx;
}
.countdown-visual-right .countdown-value {
  font-size: 48rpx;
}
.countdown-visual-right .countdown-value-seconds {
  font-size: 48rpx;
}
.countdown-item--tech {
  min-width: 116rpx;
  padding: 10rpx 8rpx 8rpx;
  flex-direction: column;
  gap: 8rpx;
  border-radius: 14rpx;
  background: linear-gradient(180deg, rgba(255,255,255,0.06), rgba(255,255,255,0.02));
  border: 1px solid rgba(255, 255, 255, 0.08);
  box-sizing: border-box;
}
.countdown-item--seconds {
  background: linear-gradient(180deg, rgba(255,255,255,0.08), rgba(255,255,255,0.025));
  border-color: rgba(120, 192, 255, 0.16);
}
.countdown-value {
  font-size: 54rpx;
  font-weight: 700;
  color: #FFFFFF;
  line-height: 1;
  margin-bottom: 0;
  font-variant-numeric: tabular-nums;
  text-shadow: 0 0 10rpx rgba(72, 170, 255, 0.08);
}
.countdown-seconds-window {
  height: 58rpx;
  overflow: hidden;
  position: relative;
}
.countdown-seconds-reel {
  display: flex;
  flex-direction: column;
  transform: translateY(-58rpx);
  will-change: transform;
}
.countdown-seconds-reel--rolling {
  animation: countdown-seconds-roll-up 0.54s linear forwards;
}
.countdown-value-seconds {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 58rpx;
  color: #8ebdff;
  text-shadow: none;
  letter-spacing: 2rpx;
}
.countdown-label {
  font-size: 22rpx;
  line-height: 1;
  margin-top: 0;
}
.countdown-label--tech {
  font-size: 18rpx;
  color: rgba(149, 208, 255, 0.62);
  letter-spacing: 2rpx;
}
@keyframes countdown-seconds-roll-up {
  from {
    transform: translateY(0);
  }
  to {
    transform: translateY(-58rpx);
  }
}
@keyframes countdown-seconds-roll-up-detail {
  from {
    transform: translateY(0);
  }
  to {
    transform: translateY(-54rpx);
  }
}

.mission-info {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  margin-top: 10rpx;
  margin-bottom: 8rpx;
  flex: 1;
  min-height: 0;
}
.info-item {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  
  padding: 10rpx 0;
  border-bottom: 1px solid rgba(255, 255, 255, 0.05);
  min-height: 44rpx;
}
.info-label {
  font-size: 24rpx;
  color: var(--color-text-secondary);
  line-height: 1.42;
}
.info-value {
  font-size: 26rpx;
  color: var(--color-text-primary);
  line-height: 1.42;
  text-align: right;
  flex: 1;
  margin-left: 20rpx;
  word-break: break-word;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  line-height: 1.4;
}

.info-value--with-jump {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 12rpx;
  overflow: visible;
}
.info-item--recovery {
  align-items: center;
}
.info-value--recovery {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  overflow: visible;
  line-height: 1;
}
.info-value--with-jump > text {
  min-width: 0;
  word-break: break-word;
}

.info-jump-btn {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  gap: 2rpx;
  font-size: 24rpx;
  font-weight: 500;
  color: #ffffff;
  padding: 5rpx 17rpx 5rpx 19rpx;
  border-radius: var(--radius-pill);
  background: var(--color-brand);
  line-height: 1.4;
}
.info-jump-arrow {
  font-size: 29rpx;
  line-height: 1;
}





.missions-section {
  margin-bottom: var(--space-xl);
}
.section-title {
  font-size: var(--font-size-xl);
  font-weight: var(--font-weight-semibold);
  color: var(--color-text-primary);
