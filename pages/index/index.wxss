  backdrop-filter: blur(30rpx) saturate(170%);
  -webkit-backdrop-filter: blur(30rpx) saturate(170%);
  box-sizing: border-box;
  opacity: 0;
  transform: translateX(-20rpx);
  pointer-events: none;
  transition: opacity 0.28s ease, transform 0.28s ease;
}
.compact-cd--visible {
  opacity: 1;
  transform: translateX(0);
  pointer-events: auto;
}
.compact-cd-rocket-slot {
  width: 42rpx;
  height: 42rpx;
  flex-shrink: 0;
  border-radius: 50%;
  overflow: hidden;
  background: rgba(255, 255, 255, 0.08);
  border: 1rpx solid rgba(255, 255, 255, 0.12);
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
}
.compact-cd-rocket-img {
  width: 100%;
  height: 100%;
  display: block;
  object-fit: cover;
  object-position: center center;
}
.compact-cd-rocket-inner {
  width: 100%;
  height: 100%;
}
.compact-cd-rocket-placeholder {
  background: rgba(255, 255, 255, 0.04);
}
.compact-cd-name {
  font-size: 22rpx;
  font-weight: 500;
  color: rgba(255, 255, 255, 0.75);
  line-height: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  flex: 1;
  min-width: 0;
}
.compact-cd-time {
  font-size: 28rpx;
  font-weight: 600;
  color: #FFFFFF;
  line-height: 1;
  font-variant-numeric: tabular-nums;
  white-space: nowrap;
  flex-shrink: 0;
}
.nav-search-btn--hidden {
  opacity: 0;
  pointer-events: none;
  transform: scale(0.8);
  transition: opacity 0.2s ease, transform 0.2s ease;
}

@keyframes roadClosurePulse {
  0%, 100% { border-color: rgba(255, 152, 0, 0.3); }
  50% { border-color: rgba(255, 152, 0, 0.6); }
}
@keyframes marqueeScroll {
  from { transform: translate3d(0, 0, 0); }
  to { transform: translate3d(-50%, 0, 0); }
}








