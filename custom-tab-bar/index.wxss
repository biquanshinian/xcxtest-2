/* custom-tab-bar/index.wxss
 * 布局占位见 utils/layout.js（TABBAR_* 常量）
 * 轻量 Dock：约 120rpx 内容区 + 文字标签 + 柔和圆角
 */
.custom-tab-bar-root {
  position: relative;
  background-color: transparent;
}

.tab-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: calc((152 + 80 + 12) * 1rpx + env(safe-area-inset-bottom) - 2px);
  padding-bottom: calc(env(safe-area-inset-bottom) + 10rpx);
  z-index: 9999;
  padding-left: 28rpx;
  padding-right: 28rpx;
  box-sizing: border-box;
  pointer-events: none;
  background: transparent;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  opacity: 1;
  transition: opacity 0.12s ease;
}

/* ========== 添加到桌面提示横条 ==========
 * 注意：custom-tab-bar 独立于页面 DOM，page{} 的 CSS 变量不保证继承进来，
 * 所有 var() 必须带字面量兜底（深色值），浅色由 .theme-light 块覆盖 */
.tab-add-desktop-strip,
.desktop-guide-img-frame {
  box-sizing: border-box;
  background: var(--bg-glass, rgba(22, 24, 28, 0.72));
  backdrop-filter: blur(32rpx) saturate(160%);
  -webkit-backdrop-filter: blur(32rpx) saturate(160%);
  border: 1px solid var(--color-border-glass, rgba(255, 255, 255, 0.1));
  border-radius: 36rpx;
  box-shadow: var(--shadow-tabbar, 0 4rpx 20rpx rgba(0, 0, 0, 0.2));
  position: relative;
  overflow: hidden;
}

.tab-add-desktop-strip {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 12rpx;
  min-height: 72rpx;
  padding: calc(12rpx - 1px) 16rpx;
  pointer-events: auto;
}

.tab-add-desktop-strip-close {
  flex-shrink: 0;
  min-width: 44rpx;
  min-height: 44rpx;
  width: 44rpx;
  height: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 2;
}

.tab-add-desktop-strip-close text {
  font-size: 22rpx;
  color: var(--color-text-tertiary, #6E6E73);
}

.tab-add-desktop-strip-text {
  flex: 1;
  min-width: 0;
  font-size: 22rpx;
  line-height: 1.45;
  color: var(--color-text-on-glass, rgba(245, 245, 247, 0.92));
  z-index: 2;
}

.tab-add-desktop-strip-btn {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 10rpx 22rpx;
  border-radius: 999rpx;
  background: #34C759;
  z-index: 2;
}

.tab-add-desktop-strip-btn text {
  font-size: 22rpx;
  font-weight: 600;
  color: #ffffff;
  line-height: 1;
}

.tab-add-desktop-strip-btn:active {
  opacity: 0.88;
}

.tab-bar-content {
  display: flex;
  align-items: center;
  justify-content: space-around;
  height: 144rpx;
  flex-shrink: 0;
  background: var(--bg-glass, rgba(22, 24, 28, 0.72));
  backdrop-filter: blur(32rpx) saturate(160%);
  -webkit-backdrop-filter: blur(32rpx) saturate(160%);
  border: 1px solid var(--color-border-glass, rgba(255, 255, 255, 0.1));
  box-shadow: var(--shadow-tabbar, 0 4rpx 20rpx rgba(0, 0, 0, 0.2));
  padding: 8rpx 12rpx;
  border-radius: 36rpx;
  position: relative;
  overflow: hidden;
  box-sizing: border-box;
  pointer-events: auto;
  will-change: transform;
  transform: translateZ(0);
}

.tab-bar-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  padding: 2rpx 0;
  transition: opacity 0.2s ease;
  height: 100%;
  min-width: 0;
  position: relative;
}

/* 切换指示条：与页内导航（nav-button）同款动效——蓝色胶囊条 scaleX 展开 + 淡入 */
.tab-bar-item::after {
  content: '';
  position: absolute;
  left: 50%;
  bottom: 0;
  width: 44rpx;
  height: 6rpx;
  border-radius: 999rpx;
  background: var(--color-brand, #3B82F6);
  transform: translateX(-50%) scaleX(0);
  opacity: 0;
  transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.2s ease;
  pointer-events: none;
}

.tab-bar-item-active::after {
  transform: translateX(-50%) scaleX(1);
  opacity: 1;
}

.icon-wrapper {
  position: relative;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 70rpx;
  height: 70rpx;
  overflow: visible;
}

.red-dot {
  position: absolute;
  top: -2rpx;
  right: -6rpx;
  width: 12rpx;
  height: 12rpx;
  background: var(--color-danger, #FF3B30);
  border-radius: 50%;
}


.tab-bar-icon {
  width: 62rpx;
  height: 62rpx;
}

/* 进展（第 3 个 Tab）：星舰图标视觉偏小，单独放大 1.2 倍 */
.tab-bar-item:nth-child(3) .tab-bar-icon {
  width: 74rpx;
  height: 74rpx;
}

.tab-bar-item-profile .tab-bar-icon {
  width: 58rpx;
  height: 58rpx;
}

.tab-bar-label {
  font-size: 22rpx;
  line-height: 1.2;
  margin-top: -3px;
  color: var(--color-text-tertiary, #8E8E93);
  font-weight: 400;
  max-width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  text-align: center;
  transition: color 0.2s ease;
}

.tab-bar-item-active .tab-bar-label {
  color: var(--color-brand, #3B82F6);
  font-weight: 600;
}

.tab-bar-item-profile .red-dot {
  top: -4rpx;
  right: -6rpx;
}

.tab-bar-hidden {
  opacity: 0 !important;
  visibility: hidden !important;
  pointer-events: none !important;
}

/* ========== 添加到桌面指引图 ========== */
.desktop-guide-overlay {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 10050;
}

.desktop-guide-mask {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.52);
}

.desktop-guide-stack {
  position: relative;
  z-index: 1;
  height: 100%;
  display: flex;
  flex-direction: column;
  pointer-events: none;
}

.desktop-guide-safe-top {
  flex-shrink: 0;
  width: 100%;
}

.desktop-guide-center {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-start;
  padding: 0 40rpx 24rpx;
  box-sizing: border-box;
  pointer-events: auto;
}

.desktop-guide-img-frame {
  width: 100%;
  max-width: 640rpx;
  padding: 16rpx 18rpx;
  pointer-events: auto;
  flex-shrink: 0;
}

.desktop-guide-img {
  position: relative;
  z-index: 2;
  width: 100%;
  display: block;
  border-radius: 28rpx;
}

.desktop-guide-close-row {
  margin-top: 32rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  flex-shrink: 0;
}

.popup-close {
  box-sizing: border-box;
  position: relative;
  width: 80rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 40rpx;
  background: rgba(255, 255, 255, 0.1);
  flex-shrink: 0;
}

.popup-close--hover {
  background: rgba(255, 255, 255, 0.16);
}

.popup-close-icon {
  font-size: 32rpx;
  color: #ffffff;
  line-height: 1;
  pointer-events: none;
}

/* ========== 明亮主题（同样带字面量兜底） ========== */
.theme-light .tab-bar-content,
.theme-light .tab-add-desktop-strip,
.theme-light .desktop-guide-img-frame {
  background: var(--bg-glass, rgba(255, 255, 255, 0.78));
  border-color: var(--color-divider, rgba(0, 0, 0, 0.07));
  box-shadow: var(--shadow-tabbar, 0 2rpx 16rpx rgba(0, 0, 0, 0.06));
}

.theme-light .tab-add-desktop-strip-text {
  color: var(--color-text-on-glass, rgba(28, 28, 30, 0.92));
}

.theme-light .tab-add-desktop-strip-close text {
  color: var(--color-text-tertiary, #8E8E93);
}

.theme-light .tab-bar-label {
  color: var(--color-text-tertiary, #8E8E93);
}

.theme-light .tab-bar-item-active .tab-bar-label {
  color: var(--color-brand, #3B82F6);
}

.theme-light .popup-close {
  background: rgba(255, 255, 255, 0.85);
}

.theme-light .popup-close--hover {
  background: rgba(255, 255, 255, 1);
}

.theme-light .popup-close-icon {
  color: #1C1C1E;
}
