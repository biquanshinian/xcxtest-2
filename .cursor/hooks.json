{
  "version": 1,
  "hooks": {
    "afterFileEdit": [
      {
        "command": "node .cursor/hooks/admin-web-autobuild.js mark",
        "timeout": 15
      }
    ],
    "afterTabFileEdit": [
      {
        "command": "node .cursor/hooks/admin-web-autobuild.js mark",
        "timeout": 15
      }
    ],
    "stop": [
      {
        "command": "node .cursor/hooks/admin-web-autobuild.js stop",
        "timeout": 180
      }
    ]
  }
}
