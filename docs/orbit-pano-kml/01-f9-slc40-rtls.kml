        <Icon><href>http://maps.google.com/mapfiles/kml/paddle/wht-circle.png</href></Icon>
      </IconStyle>
      <LabelStyle><scale>1</scale></LabelStyle>
    </Style>
      <LookAt>
        <longitude>-80.577285</longitude>
        <latitude>28.561880</latitude>
        <altitude>0</altitude>
        <heading>0</heading>
        <tilt>45</tilt>
        <range>8000</range>
        <altitudeMode>relativeToGround</altitudeMode>
      </LookAt>
    <Placemark id="start">
