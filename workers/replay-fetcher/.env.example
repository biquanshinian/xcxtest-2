# adminGateway HTTP 访问地址（与 bilibili-publisher 相同的云函数 HTTP 触发 URL）
REPLAY_ADMIN_API_BASE=

# Agent 鉴权 token（≥16 位；对应云函数环境变量 REPLAY_AGENT_TOKEN，缺省共用 BILI_AGENT_TOKEN）
REPLAY_AGENT_TOKEN=

# 轮询间隔毫秒（默认 10 分钟；回放不是实时需求，无需高频）
REPLAY_POLL_MS=600000

# yt-dlp 可执行文件路径（默认 PATH 中的 yt-dlp）
YTDLP_PATH=yt-dlp

# ffmpeg 所在目录（yt-dlp 合并 + 兼容转码用；已在 PATH 中可留空）
# 兼容转码需要本机有 ffmpeg（libx264/aac）；未配置且不在 PATH 时任务会 fail
FFMPEG_PATH=

# 下载清晰度上限（默认 480：优先拉小分辨率源，上传前再做 H.264+AAC 兼容封装）
REPLAY_MAX_HEIGHT=480

# 上传前兼容处理（默认开）：已是 H.264+AAC 则 +faststart 重封装，否则转码。设为 0 可关
REPLAY_COMPAT_TRANSCODE=1

# 单文件大小上限 MB（超过则该源失败换下一源）
REPLAY_MAX_FILE_MB=1024

# 访问 YouTube/X 的代理候选（可留空）。配置优先；不可用则自动扫本机常见口（7890/10808…）。
# Agent 会在 VPN 未开时等待、开了再领任务，无需改端口/开全局模式。
# 例：http://127.0.0.1:7890,direct
REPLAY_PROXY=
