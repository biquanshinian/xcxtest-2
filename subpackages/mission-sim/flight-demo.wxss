.detail-page {
  min-height: 100vh;
  background: linear-gradient(180deg, #0B0C0E 0%, #121418 100%);
}

.detail-scroll {
  height: 100vh;
}

.fd-intro {
  margin: 12rpx 28rpx 20rpx;
  padding: 20rpx 24rpx;
  border-radius: 14rpx;
  background: rgba(59, 130, 246, 0.06);
  border: 1rpx solid rgba(59, 130, 246, 0.12);
}
.fd-intro-text {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.55);
  line-height: 1.5;
}

.fd-disabled {
  margin: 80rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 28rpx;
}
.fd-disabled-text {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.55);
  text-align: center;
  line-height: 1.6;
}
.fd-btn {
  padding: 18rpx 48rpx;
  border-radius: 999rpx;
  border: 1rpx solid rgba(59, 130, 246, 0.35);
  color: #3B82F6;
  font-size: 26rpx;
}

.fd-bottom-pad {
  height: calc(env(safe-area-inset-bottom) + 80rpx);
}
