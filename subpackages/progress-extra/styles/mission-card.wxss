/* 首页任务卡片核心样式（供进度详情等复用，与 pages/index 视觉对齐） */
.mission-card-inner-row {
  display: flex;
  flex-direction: row;
  width: 100%;
  height: auto;
  min-height: 0;
}

.mission-card {
  width: 100%;
  max-width: 100%;
  min-height: 345rpx;
  display: flex;
  flex-direction: row;
  padding: 0;
  overflow: hidden;
  box-sizing: border-box;
  border-radius: var(--radius-card);
}

.mission-card-link {
  text-decoration: none;
  color: inherit;
}

.mission-card-link::after {
  border: none;
}

.mission-card-link:active {
  color: inherit;
  opacity: 0.92;
}

.mission-rocket-slot {
  position: relative;
  width: 40%;
  height: auto;
  align-self: stretch;
  /* 与 .mission-card min-height 对齐：组件内 flex stretch 偶发塌缩时仍能露出配置图 */
  min-width: 200rpx;
  min-height: 345rpx;
  flex-shrink: 0;
}

.mission-rocket-image {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  min-width: 0;
  min-height: 345rpx;
  /* 等比例放大居中撑满左侧槽位 */
  object-fit: cover;
  object-position: center center;
  background-color: var(--color-bg-elevated, #1A1C20);
  display: block;
}

.mission-rocket-image--placeholder {
  background: var(--color-divider-faint);
}

/* 复用详情头图 360 环绕图标，缩小放在任务卡左侧图槽左上角 */
.mission-card-pano {
  position: absolute;
  left: 10rpx;
  top: 10rpx;
  z-index: 3;
  width: 52rpx;
  height: 52rpx;
  pointer-events: none;
}

.mission-card-pano-orbit {
  position: absolute;
  left: 2rpx;
  top: 2rpx;
  right: 2rpx;
  bottom: 2rpx;
  border-radius: 50%;
  border: 2rpx solid rgba(255, 255, 255, 0.22);
  border-top-color: #ffffff;
  border-right-color: rgba(255, 255, 255, 0.55);
  box-sizing: border-box;
  animation: mission-card-pano-spin 1.8s linear infinite;
}

.mission-card-pano-orbit--tilt {
  left: -2rpx;
  right: -2rpx;
  top: 14rpx;
  bottom: 14rpx;
  border-top-color: rgba(255, 255, 255, 0.95);
  border-bottom-color: rgba(255, 255, 255, 0.28);
  border-left-color: rgba(255, 255, 255, 0.12);
  border-right-color: rgba(255, 255, 255, 0.12);
  animation-duration: 2.8s;
  animation-direction: reverse;
}

.mission-card-pano-core {
  position: absolute;
  left: 12rpx;
  top: 12rpx;
  right: 12rpx;
  bottom: 12rpx;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.58);
  border: 2rpx solid rgba(255, 255, 255, 0.88);
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.mission-card-pano-360 {
  font-size: 14rpx;
  font-weight: 800;
  color: #ffffff;
  line-height: 1;
  letter-spacing: -1rpx;
  transform: scale(0.8);
}

@keyframes mission-card-pano-spin {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

.mission-info-content {
  flex: 1;
  padding: var(--space-md) var(--space-lg);
  display: flex;
  flex-direction: column;
  gap: var(--space-xs);
  box-sizing: border-box;
  min-width: 0;
  overflow: hidden;
}

.mission-card-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: var(--space-xs);
  margin-bottom: 4rpx;
}

.mission-card-header-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 4rpx;
  flex-shrink: 0;
  min-width: 0;
}

.mission-status-badge {
  font-size: var(--font-size-sm);
  font-weight: var(--font-weight-medium);
  padding: 4rpx 12rpx;
  border-radius: var(--radius-sm);
  flex-shrink: 0;
}

.mission-status-badge.status-success,
.mission-status-badge.status-deployed {
  color: var(--color-success);
  background: rgba(52, 199, 89, 0.15);
  border: 1px solid rgba(52, 199, 89, 0.35);
}

.mission-status-badge.status-failure {
  color: var(--color-danger);
  background: rgba(255, 59, 48, 0.15);
  border: 1px solid rgba(255, 59, 48, 0.35);
}

.mission-status-badge.status-partial,
.mission-status-badge.status-delayed,
.mission-status-badge.status-cancelled {
  color: var(--color-warning);
  background: rgba(255, 149, 0, 0.12);
  border: 1px solid rgba(255, 149, 0, 0.3);
}

.mission-status-badge.status-pending {
  color: var(--color-brand);
  background: var(--color-brand-soft);
  border: 1px solid rgba(59, 130, 246, 0.35);
}

.mission-status-badge.status-inflight {
  color: #5AC8FA;
  background: rgba(90, 200, 250, 0.15);
  border: 1px solid rgba(90, 200, 250, 0.4);
}

.mission-country {
  font-size: var(--font-size-sm);
  color: var(--color-text-secondary);
  flex-shrink: 0;
}

.mission-main-title {
  font-size: var(--font-size-lg);
  font-weight: var(--font-weight-semibold);
  color: var(--color-text-primary);
  line-height: var(--line-height-tight);
  word-break: break-word;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.mission-meta {
  font-size: 24rpx;
  color: var(--color-text-secondary);
  line-height: 1.4;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.mission-time {
  font-size: var(--font-size-md);
  font-weight: var(--font-weight-semibold);
  color: var(--color-text-primary);
  line-height: var(--line-height-tight);
  opacity: 0.92;
}

/* 回收块：与首页 index.wxss 对齐（可回收标签 + 溅落/回收图标） */
.mission-recovery-block {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10rpx;
  margin-top: 4rpx;
}

.recovery-tag {
  font-size: var(--font-size-sm);
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
  flex-shrink: 0;
}

.recovery-tag--reuse {
  color: var(--color-success);
  background: rgba(52, 199, 89, 0.12);
  border: 1px solid rgba(52, 199, 89, 0.25);
}

.recovery-tag--expendable {
  color: var(--color-text-tertiary);
  background: rgba(99, 99, 102, 0.15);
  border: 1px solid rgba(99, 99, 102, 0.25);
}

.recovery-tag--not-reused {
  color: var(--color-warning);
  background: rgba(255, 149, 0, 0.12);
  border: 1px solid rgba(255, 149, 0, 0.28);
}

.mission-recovery-icons {
  display: flex;
  align-items: center;
  gap: 10px;
  margin-left: 6px;
  margin-right: auto;
  flex-shrink: 0;
}

.mission-recovery-icon {
  width: 28rpx;
  height: 28rpx;
  flex-shrink: 0;
  transform: scale(1.15);
}

.mission-recovery-icon--net {
  transform: scale(1.265);
}

.recovery-icon-name {
  display: flex;
  align-items: center;
  gap: 6rpx;
  flex-wrap: wrap;
  justify-content: flex-end;
}

.recovery-type-name {
  font-size: var(--font-size-xs);
  line-height: 1.2;
  color: var(--color-success);
  background: rgba(52, 199, 89, 0.12);
  border: 1px solid rgba(52, 199, 89, 0.25);
  border-radius: 6rpx;
  padding: 2rpx 10rpx;
  white-space: nowrap;
}

.theme-light .mission-rocket-image {
  background-color: rgba(0, 0, 0, 0.06);
}

.theme-light .mission-rocket-image--placeholder {
  background: rgba(0, 0, 0, 0.04);
}

.theme-light .mission-country,
.theme-light .mission-meta {
  color: var(--color-text-tertiary, rgba(0, 0, 0, 0.45));
}

.theme-light .mission-main-title {
  color: var(--color-text-primary);
}

.theme-light .mission-time {
  color: var(--color-text-primary);
}

/* 回收图标：浅色主题下反色白色中性态（与首页一致） */
.theme-light .mission-recovery-icon--neutral {
  filter: invert(0.72);
}
