.container {
  min-height: 100vh;
  background: var(--color-bg-page);
}
.content-scroll {
  height: 100vh;
  box-sizing: border-box;
  padding: 0 30rpx;
}
.stats-card {
  padding: 28rpx 20rpx;
  border-radius: 24rpx;
  margin-bottom: 24rpx;
}
.stats-grid {
  display: flex;
}
.stats-cell {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}
.stats-num {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--color-text-primary);
}
.stats-num--ok {
  color: #0A84FF;
}
.stats-label {
  font-size: 22rpx;
  color: var(--color-text-tertiary);
}
.streak-bar {
  margin-top: 20rpx;
  padding: 14rpx;
  border-radius: 14rpx;
  text-align: center;
  font-size: 24rpx;
  color: #FF9500;
  background: rgba(255, 149, 0, 0.12);
}
.empty {
  padding: 80rpx 40rpx;
  text-align: center;
}
.empty-title {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-text-primary);
  margin-bottom: 12rpx;
}
.empty-hint {
  display: block;
  font-size: 24rpx;
  color: var(--color-text-tertiary);
  line-height: 1.5;
}

/* 近期竞猜：对齐「我的」页图三结构 */
.history-card {
  padding: 24rpx 24rpx 12rpx;
  border-radius: 24rpx;
}
.history-title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8rpx;
}
.history-title {
  font-size: 28rpx;
  font-weight: 650;
  color: var(--color-text-primary);
}
.history-count {
  font-size: 22rpx;
  color: var(--color-text-tertiary);
}
.history-list {
  display: flex;
  flex-direction: column;
}
.history-item {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.06);
}
.history-item:last-child {
  border-bottom: none;
}
.history-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  overflow: hidden;
  flex-shrink: 0;
  margin-right: 18rpx;
  background: rgba(255, 255, 255, 0.06);
}
.history-rocket-img {
  width: 100%;
  height: 100%;
  display: block;
}
.history-main {
  flex: 1;
  min-width: 0;
  margin-right: 16rpx;
}
.history-name-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
  min-width: 0;
}
.history-type {
  flex-shrink: 0;
  font-size: 18rpx;
  line-height: 1.2;
  padding: 2rpx 8rpx;
  border-radius: 6rpx;
  font-weight: 600;
}
.history-type--ontime {
  color: rgba(90, 200, 250, 0.95);
  background: rgba(90, 200, 250, 0.12);
}
.history-type--outcome {
  color: rgba(255, 159, 10, 0.95);
  background: rgba(255, 159, 10, 0.14);
}
.history-name {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-text-primary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  min-width: 0;
}
.history-rocket {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--color-text-tertiary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.history-side {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 8rpx;
  flex-shrink: 0;
}
.choice-tag {
  font-size: 22rpx;
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  font-weight: 600;
}
.choice-tag--ge {
  background: rgba(255, 107, 107, 0.15);
  color: #ff6b6b;
}
.choice-tag--buge {
  background: rgba(10, 132, 255, 0.14);
  color: #0A84FF;
}
.choice-tag--failure {
  background: rgba(255, 107, 107, 0.15);
  color: #ff6b6b;
}
.choice-tag--success {
  background: rgba(10, 132, 255, 0.14);
  color: #0A84FF;
}
.history-days {
  font-size: 20rpx;
  color: var(--color-text-tertiary);
}
.history-days--win {
  color: #0A84FF;
}
.history-days--lose {
  color: rgba(255, 100, 100, 0.75);
}

.theme-light .history-item {
  border-bottom-color: rgba(0, 0, 0, 0.06);
}
.theme-light .history-icon {
  background: rgba(0, 0, 0, 0.04);
}
.theme-light .history-type--ontime {
  color: #007AFF;
  background: rgba(0, 122, 255, 0.1);
}
.theme-light .choice-tag--buge,
.theme-light .choice-tag--success {
  background: rgba(10, 132, 255, 0.1);
  color: #0A84FF;
}
