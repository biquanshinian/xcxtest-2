/* ── 左抽屉设置（约 2/3 屏，灰底 + 浮层白/深色卡，深浅反色）── */
.settings-drawer-root {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 10050;
}

.settings-drawer-mask {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.42);
}

.theme-light .settings-drawer-mask {
  background: rgba(0, 0, 0, 0.28);
}

.settings-drawer-panel {
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  width: 66.666%;
  max-width: 66.666vw;
  /* 深色默认：反色于浅色侧栏 —— 深灰底 + 深色浮卡 */
  background: #121316;
  border-right: none;
  box-shadow: 16rpx 0 56rpx rgba(0, 0, 0, 0.45);
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  animation: settingsDrawerIn 0.24s ease-out;
}

.theme-light .settings-drawer-panel {
  /* 浅色：对齐参考侧栏 —— 浅灰底 + 白卡 */
  background: #F3F4F6;
  box-shadow: 16rpx 0 56rpx rgba(0, 0, 0, 0.14);
}

@keyframes settingsDrawerIn {
  from { transform: translateX(-100%); }
  to { transform: translateX(0); }
}

.settings-drawer-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 8rpx 28rpx 18rpx;
  flex-shrink: 0;
}

.settings-drawer-title {
  font-size: 36rpx;
  font-weight: 650;
  color: #F5F5F7;
}

.theme-light .settings-drawer-title {
  color: #1C1C1E;
}

.settings-drawer-close {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.1);
  color: rgba(255, 255, 255, 0.78);
  font-size: 26rpx;
}

.theme-light .settings-drawer-close {
  background: rgba(0, 0, 0, 0.06);
  color: rgba(28, 28, 30, 0.65);
}

.settings-drawer-scroll {
  flex: 1;
  height: 0;
  min-height: 0;
  padding: 0 20rpx;
  box-sizing: border-box;
}

.settings-body {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

/* 侧栏浮层卡 */
.drawer-card {
