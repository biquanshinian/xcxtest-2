<!-- 我的页下半屏区块（从 pages/profile/profile.wxml 原样拆出，交互经 sectionevent 回传页面） -->
<view class="{{themeClass}}">
  <!-- 左抽屉设置（约 2/3 屏；由导航栏「设置」打开；含外观 + 提醒偏好） -->
  <root-portal wx:if="{{settingsPanelOpen}}">
    <view class="settings-drawer-root {{themeClass}}" catchtouchmove="noop">
      <view class="settings-drawer-mask" catchtap="emitCloseSettingsPanel"></view>
      <view class="settings-drawer-panel" catchtap="noop">
        <view class="settings-drawer-head" style="padding-top: {{settingsPanelPadTop}}px;">
          <text class="settings-drawer-title">设置</text>
          <view class="settings-drawer-close" catchtap="emitCloseSettingsPanel" aria-role="button" aria-label="关闭">
            <text>✕</text>
          </view>
        </view>
        <scroll-view class="settings-drawer-scroll" scroll-y enhanced show-scrollbar="{{false}}">
          <view class="settings-body">
            <!-- 通用：语言 + 简报（侧栏白卡组） -->
            <view class="drawer-card">
              <view class="drawer-block">
                <text class="drawer-block-title">语言设置</text>
                <view class="theme-mode-group drawer-seg">
                  <view
                    class="theme-mode-opt {{contentLang === 'zh' ? 'theme-mode-opt--active' : ''}}"
                    data-value="zh"
                    catchtap="emitOnContentLangChange"
                  >中文</view>
                  <view
                    class="theme-mode-opt {{contentLang === 'en' ? 'theme-mode-opt--active' : ''}}"
                    data-value="en"
                    catchtap="emitOnContentLangChange"
                  >English</view>
                </view>
              </view>
              <view class="drawer-divider"></view>
              <view class="drawer-row">
                <view class="drawer-row-text">
                  <text class="drawer-block-title">每日太空简报</text>
                  <text class="drawer-block-desc">首页展示当日太空简报入口</text>
                </view>
                <switch
                  class="oa-alert-switch"
                  checked="{{briefingEnabled}}"
                  color="#0A84FF"
                  catchchange="emitOnBriefingToggle"
                />
              </view>
            </view>

            <!-- 外观 -->
            <view class="drawer-card">
              <view class="drawer-block">
                <text class="drawer-block-title">主题外观</text>
                <view class="theme-mode-group drawer-seg">
                  <view
                    class="theme-mode-opt {{themeMode === 'dark' ? 'theme-mode-opt--active' : ''}}"
                    data-mode="dark"
                    catchtap="emitOnThemeModeTap"
                  >深色</view>
                  <view
                    class="theme-mode-opt {{themeMode === 'light' ? 'theme-mode-opt--active' : ''}}"
                    data-mode="light"
                    catchtap="emitOnThemeModeTap"
                  >浅色</view>
                  <view
                    class="theme-mode-opt {{themeMode === 'system' ? 'theme-mode-opt--active' : ''}}"
                    data-mode="system"
                    catchtap="emitOnThemeModeTap"
                  >跟随系统</view>
                </view>
              </view>
              <view class="drawer-divider"></view>
              <view class="drawer-block">
                <text class="drawer-block-title">火箭配置图</text>
                <view class="theme-mode-group drawer-seg">
                  <view
                    class="theme-mode-opt {{rocketArtStyle === 'original' ? 'theme-mode-opt--active' : ''}}"
                    data-style="original"
                    catchtap="emitOnRocketArtTap"
                  >原图</view>
                  <view
                    class="theme-mode-opt {{rocketArtStyle === 'mecha' ? 'theme-mode-opt--active' : ''}}"
                    data-style="mecha"
                    catchtap="emitOnRocketArtTap"
                  >机娘风格</view>
                </view>
              </view>
            </view>

            <!-- 提醒偏好：标题 + 列表行，无长说明 -->
            <view class="drawer-card">
              <view class="drawer-block">
                <text class="drawer-block-title">提醒偏好</text>
              </view>

              <view class="pref-row" catchtap="emitOnTogglePrefRocketsExpand">
                <text class="pref-row-label">火箭型号</text>
                <view class="pref-row-trail">
                  <text class="pref-row-value">{{selectedRocketCount > 0 ? selectedRocketCount + ' 项' : '全部'}}</text>
                  <text class="pref-row-chevron">{{prefRocketsExpanded ? '▴' : '▾'}}</text>
                </view>
              </view>
              <view class="pref-tag-grid" wx:if="{{prefRocketsExpanded}}">
                <view
                  wx:for="{{rocketOptions}}"
                  wx:key="*this"
                  class="pref-tag {{rocketMap[item] ? 'pref-tag--active' : ''}}"
                  data-name="{{item}}"
                  catchtap="emitOnTogglePrefRocket"
                >{{item}}</view>
              </view>

              <view class="drawer-divider"></view>
              <view class="pref-row" catchtap="emitOnTogglePrefSitesExpand">
                <text class="pref-row-label">发射场</text>
                <view class="pref-row-trail">
                  <text class="pref-row-value">{{selectedSiteCount > 0 ? selectedSiteCount + ' 项' : '全部'}}</text>
                  <text class="pref-row-chevron">{{prefSitesExpanded ? '▴' : '▾'}}</text>
                </view>
              </view>
              <view class="pref-tag-grid" wx:if="{{prefSitesExpanded}}">
                <view
                  wx:for="{{siteOptions}}"
                  wx:key="*this"
                  class="pref-tag {{siteMap[item] ? 'pref-tag--active' : ''}}"
                  data-name="{{item}}"
                  catchtap="emitOnTogglePrefSite"
                >{{item}}</view>
              </view>

              <view class="drawer-divider"></view>
              <view class="pref-row" catchtap="emitOnTogglePrefKeywordsExpand">
                <text class="pref-row-label">事件关键词</text>
                <view class="pref-row-trail">
                  <text class="pref-row-value">{{selectedKeywordCount > 0 ? selectedKeywordCount + ' 项' : '未选'}}</text>
                  <text class="pref-row-chevron">{{prefKeywordsExpanded ? '▴' : '▾'}}</text>
                </view>
              </view>
              <view class="pref-tag-grid" wx:if="{{prefKeywordsExpanded}}">
                <view
                  wx:for="{{keywordOptions}}"
                  wx:key="*this"
                  class="pref-tag {{keywordMap[item] ? 'pref-tag--active' : ''}}"
                  data-name="{{item}}"
                  catchtap="emitOnTogglePrefKeyword"
                >{{item}}</view>
              </view>

              <view class="drawer-divider"></view>
              <view class="pref-row" catchtap="emitOnTogglePrefWatchExpand">
                <text class="pref-row-label">关注账号</text>
                <view class="pref-row-trail">
                  <text class="pref-row-value">{{selectedWatchCount > 0 ? selectedWatchCount + ' 项' : '全部'}}</text>
                  <text class="pref-row-chevron">{{prefWatchExpanded ? '▴' : '▾'}}</text>
                </view>
              </view>
              <view class="pref-tag-grid" wx:if="{{prefWatchExpanded}}">
                <view
                  wx:for="{{watchAccountOptions}}"
                  wx:key="screenName"
                  class="pref-tag {{watchMap[item.screenName] ? 'pref-tag--active' : ''}}"
                  data-name="{{item.screenName}}"
                  catchtap="emitOnTogglePrefEventAccount"
                >{{item.label}}</view>
              </view>

              <view class="drawer-divider"></view>
              <view class="drawer-block pref-seg-block">
                <text class="pref-row-label">提前提醒</text>
                <view class="theme-mode-group drawer-seg">
                  <view
                    wx:for="{{notifyOptions}}"
                    wx:key="value"
                    class="theme-mode-opt {{notifyMinutes === item.value ? 'theme-mode-opt--active' : ''}}"
                    data-value="{{item.value}}"
                    catchtap="emitOnNotifyPrefChange"
                  >{{item.label}}</view>
                </view>
              </view>

              <view class="drawer-divider"></view>
              <view class="drawer-block pref-seg-block">
                <text class="pref-row-label">星舰封路</text>
                <view class="theme-mode-group drawer-seg">
                  <view
                    class="theme-mode-opt {{roadClosureAlert ? 'theme-mode-opt--active' : ''}}"
                    data-value="1"
                    catchtap="emitOnRoadClosurePrefChange"
                  >接收</view>
                  <view
                    class="theme-mode-opt {{!roadClosureAlert ? 'theme-mode-opt--active' : ''}}"
                    data-value="0"
                    catchtap="emitOnRoadClosurePrefChange"
                  >不接收</view>
                </view>
              </view>

              <view
                class="pref-save-btn {{prefSaving ? 'pref-save-btn--loading' : ''}}"
                catchtap="emitOnSaveReminderPrefs"
              >
                <text>{{prefSaving ? '保存中...' : '保存'}}</text>
              </view>
            </view>
          </view>
          <view class="settings-drawer-bottom-space"></view>
        </scroll-view>
      </view>
    </view>
  </root-portal>

  <!-- ══ 我的提醒 ══ -->
  <view class="reminder-section">
    <view class="section-title-row">
      <text class="section-title-text">我的提醒</text>
    </view>

    <!-- 服务号 B 通道：仅 ready（已关注+已开）才显示开启；未关注弹二维码 -->
    <view class="oa-alert-card glass-card">
      <view class="oa-alert-row">
        <view class="oa-alert-info">
          <text class="oa-alert-title">服务号自动提醒</text>
          <text class="oa-alert-desc">开启后发射前约30分钟及完成后结果由服务号自动推送，无需再逐条订阅</text>
        </view>
        <switch
          class="oa-alert-switch"
          checked="{{oaAlertReady}}"
          color="#07C160"
          disabled="{{oaAlertLoading}}"
          bindchange="emitOnOaAlertSwitch"
        />
      </view>
      <view class="oa-alert-status" wx:if="{{oaAlertMessage}}">
        <text class="oa-alert-status-text {{oaAlertReady ? 'oa-alert-status-text--ready' : ''}}">{{oaAlertMessage}}</text>
      </view>
      <!-- 仅未关注时出扫码入口，避免与上方「已关注」文案重复 -->
      <view class="oa-alert-guide" wx:if="{{!oaAlertFollowed}}" catchtap="emitShowOaQrGuide">
        <text class="oa-alert-guide-text">未关注服务号？点此扫码关注</text>
        <text class="oa-alert-guide-copy">查看二维码</text>
      </view>
    </view>

    <!-- 关注服务号二维码：长按识别 -->
    <root-portal wx:if="{{oaQrGuideOpen}}">
      <view class="oa-qr-root {{themeClass}}" catchtouchmove="noop">
        <view class="oa-qr-mask" catchtap="emitCloseOaQrGuide"></view>
        <view class="oa-qr-panel" catchtap="noop">
          <text class="oa-qr-title">关注服务号</text>
          <text class="oa-qr-desc">长按下方二维码 → 识别图中二维码 → 关注「火星探索日志」后，再回来打开开关</text>
          <image
            class="oa-qr-img"
            src="{{oaFollowQrUrl}}"
            mode="aspectFit"
            show-menu-by-longpress="{{true}}"
          />
          <view class="oa-qr-btn" catchtap="emitCloseOaQrGuide">我知道了</view>
        </view>
      </view>
    </root-portal>

    <!-- 有单独铃铛提醒时才展示时间线；无提醒则不显示空态引导卡 -->
    <view class="reminder-timeline glass-card" wx:if="{{myReminders.length > 0}}">
      <view class="rm-item" wx:for="{{myReminders}}" wx:key="key">
        <!-- 左侧时间轴：节点 + 连线 -->
        <view class="rm-rail">
          <view class="rm-node rm-node--{{item.status}}"></view>
          <view class="rm-line" wx:if="{{index < myReminders.length - 1}}"></view>
        </view>
        <!-- 右侧内容 -->
        <view class="rm-body {{index === myReminders.length - 1 ? 'rm-body--last' : ''}}" bindtap="emitOnReminderTap" data-type="{{item.type}}" data-missionid="{{item.missionId}}" data-date="{{item.date}}">
          <view class="rm-time-row">
            <text class="rm-time rm-time--{{item.status}}">{{item.dateLabel}}</text>
            <text class="rm-badge rm-badge--{{item.status}}">{{item.daysLabel}}</text>
            <view class="rm-cancel" catchtap="emitOnCancelReminder" data-key="{{item.key}}" data-type="{{item.type}}" data-missionid="{{item.missionId}}">
              <text>✕</text>
            </view>
          </view>
          <view class="rm-main">
            <image class="rm-thumb" wx:if="{{item.rocketImg}}" src="{{item.rocketImg}}" mode="aspectFill" lazy-load />
            <view class="rm-thumb rm-thumb--placeholder" wx:else>
              <text>🚀</text>
            </view>
            <view class="rm-text-col">
              <text class="rm-title">{{item.title}}</text>
              <text class="rm-rocket" wx:if="{{item.rocketName}}">{{item.rocketName}}</text>
            </view>
            <text class="rm-arrow">›</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 客服介绍：低调附在提醒区底部（浅色小字，不抢视线） -->
    <view class="reminder-about" wx:if="{{aboutText || aboutWechat}}">
      <text class="reminder-about-text" wx:if="{{aboutText}}">{{aboutText}}</text>
      <text
        class="reminder-about-wechat"
        wx:if="{{aboutWechat}}"
        catchtap="emitOnCopyWechat"
      >微信 {{aboutWechat}}</text>
    </view>
  </view>

  <!-- 竞猜 / 每日挑战 / 客服已迁到「更多服务」详情页，此处不再重复展示 -->
  <!-- ══ 发射竞猜统计（保留代码路径时可用；默认隐藏） ══ -->
  <view class="vote-stats-section" wx:if="{{false && voteStats.total > 0}}">
    <view class="section-title-row">
      <text class="section-title-text">竞猜战绩</text>
      <text class="section-title-count">参与 {{voteStats.total}} 场</text>
    </view>
    <view class="vote-stats-card glass-card">
      <!-- 核心数据 -->
      <view class="vote-stats-grid">
        <view class="vote-stats-cell">
          <text class="vote-stats-num">{{voteStats.settled}}</text>
          <text class="vote-stats-label">已揭晓</text>
        </view>
        <view class="vote-stats-cell">
          <text class="vote-stats-num vote-stats-num--correct">{{voteStats.correct}}</text>
          <text class="vote-stats-label">猜对</text>
        </view>
        <view class="vote-stats-cell">
          <text class="vote-stats-num {{voteStats.accuracy >= 60 ? 'vote-stats-num--correct' : ''}}">{{voteStats.accuracy}}%</text>
          <text class="vote-stats-label">命中率</text>
        </view>
        <view class="vote-stats-cell">
          <text class="vote-stats-num vote-stats-num--streak">{{voteStats.bestStreak}}</text>
          <text class="vote-stats-label">最佳连胜</text>
        </view>
      </view>

      <!-- 当前连胜提示 -->
      <view class="vote-streak-bar" wx:if="{{voteStats.streak > 0}}">
        <text class="vote-streak-text">🔥 当前连胜 {{voteStats.streak}} 场</text>
      </view>

      <!-- 近期记录 -->
      <view class="vote-history" wx:if="{{voteHistory.length > 0}}">
        <view class="vote-history-title-row">
          <text class="vote-history-title">近期竞猜</text>
          <view class="vote-history-clear" hover-class="vote-history-clear--pressed" hover-stay-time="120" catchtap="emitOnClearVoteHistory">
            <text>清除</text>
          </view>
        </view>
        <view class="vote-history-list">
          <view class="vote-history-item" wx:for="{{voteHistoryExpanded ? voteHistory : voteHistory}}" wx:if="{{voteHistoryExpanded || index < 1}}" wx:key="id" bindtap="emitOnVoteHistoryTap" data-id="{{item.launchId || item.id}}">
            <view class="vote-history-icon vote-history-icon--launch">
              <image
                class="vote-history-rocket-img"
                src="{{item.rocketImage}}"
                mode="aspectFill"
                binderror="emitOnVoteHistoryRocketImageError"
                data-index="{{index}}"
              />
            </view>
            <view class="vote-history-left">
              <view class="vote-history-name-row">
                <text class="vote-history-type vote-history-type--{{item.voteType}}">{{item.voteTypeLabel || (item.voteType === 'outcome' ? '成败' : '准时')}}</text>
                <text class="vote-history-name">{{item.name}}</text>
              </view>
              <text class="vote-history-rocket" wx:if="{{item.rocket}}">{{item.rocket}}</text>
            </view>
            <view class="vote-history-right">
              <text class="vote-choice-tag vote-choice-tag--{{item.choice}}">我猜{{item.choiceLabel}}</text>
              <text class="vote-history-days {{item.result ? (item.isCorrect ? 'vote-history-days--win' : 'vote-history-days--lose') : ''}}">{{item.daysLabel}}</text>
            </view>
          </view>
        </view>
        <view class="vote-history-expand" wx:if="{{voteHistory.length > 1}}" bindtap="emitOnToggleVoteHistory">
          <text>{{voteHistoryExpanded ? '收起' : '展开全部 (' + voteHistory.length + ')'}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- ══ 每日问答挑战（已迁详情页） ══ -->
  <view class="quiz-section" wx:if="{{false && quizQuestion}}">
    <view class="section-title-row">
      <text class="section-title-text">每日挑战</text>
      <text class="section-title-count">正确率 {{quizStats.accuracy}}%</text>
    </view>
    <view class="quiz-card glass-card">
      <view class="quiz-header">
        <text class="quiz-badge">太空问答 #{{quizQuestion.id}}</text>
      </view>
      <text class="quiz-question">{{quizQuestion.question}}</text>
      <view class="quiz-options">
        <view
          class="quiz-option {{quizSelectedIndex === index ? 'quiz-option--selected' : ''}} {{quizAnswered && index === quizQuestion.answer ? 'quiz-option--correct' : ''}} {{quizAnswered && quizSelectedIndex === index && index !== quizQuestion.answer ? 'quiz-option--wrong' : ''}} {{quizAnswered ? 'quiz-option--disabled' : ''}}"
          wx:for="{{quizQuestion.options}}"
          wx:key="*this"
          bindtap="emitOnQuizSelect"
          data-index="{{index}}"
        >
          <text class="quiz-option-letter">{{['A','B','C','D'][index]}}</text>
          <text class="quiz-option-text">{{item}}</text>
          <!-- 图标位始终占宽，避免答题后插入 ✓/✕ 把选项行撑高 -->
          <text
            class="quiz-option-icon {{quizAnswered && index === quizQuestion.answer ? 'quiz-option-icon--visible quiz-option-icon--ok' : ''}} {{quizAnswered && quizSelectedIndex === index && index !== quizQuestion.answer ? 'quiz-option-icon--visible quiz-option-icon--bad' : ''}}"
          >{{quizAnswered && quizSelectedIndex === index && index !== quizQuestion.answer ? '✕' : '✓'}}</text>
        </view>
      </view>
      <!-- 答题结果 -->
      <view class="quiz-result" wx:if="{{quizResult}}">
        <text class="quiz-result-tag {{quizResult.correct ? 'quiz-result-tag--correct' : 'quiz-result-tag--wrong'}}">{{quizResult.correct ? '回答正确！' : '回答错误'}}</text>
        <text class="quiz-explanation">{{quizResult.explanation}}</text>
      </view>
    </view>
  </view>

  <!-- ══ 我的奖品 ══ -->
  <view class="prize-section" wx:if="{{myPrizes.length > 0}}">
    <view class="section-title-row">
      <text class="section-title-text">我的奖品</text>
      <text class="section-title-count">{{myPrizes.length}}件</text>
    </view>
    <view class="prize-list">
      <view class="prize-card glass-card" wx:for="{{myPrizes}}" wx:key="_id">
        <view class="prize-card-top">
          <image wx:if="{{item.prizeImage}}" class="prize-card-img" src="{{item.prizeImage}}" mode="aspectFit" />
          <view wx:else class="prize-card-icon">🎁</view>
          <view class="prize-card-info">
            <view class="prize-card-title">{{item.prizeTitle || '奖品'}}</view>
            <view class="prize-card-desc">{{item.prizeDesc || ''}}</view>
            <view class="prize-card-size" wx:if="{{item.selectionsText}}">{{item.selectionsText}}</view>
            <view class="prize-card-size" wx:elif="{{item.size}}">尺码：{{item.size}}</view>
          </view>
          <view class="prize-status prize-status--{{item.prizeType === 'pro_1month' || item.grantKind === 'pro_1month' ? 'completed' : item.status}}">
            {{item.prizeType === 'pro_1month' || item.grantKind === 'pro_1month' ? (item.status === 'completed' ? '已到账' : '发放中') : (item.status === 'pending' ? '待发货' : item.status === 'shipped' ? '已发货' : '已完成')}}
          </view>
        </view>
        <view class="prize-tracking" wx:if="{{item.trackingNumber}}">
          <text class="prize-tracking-label">物流单号：</text>
          <text class="prize-tracking-number">{{item.trackingNumber}}</text>
          <button class="prize-copy-btn" size="mini" catchtap="emitOnCopyTracking" data-num="{{item.trackingNumber}}" hover-class="prize-copy-btn--hover">复制</button>
        </view>
        <view class="prize-tracking prize-tracking--waiting" wx:elif="{{(item.prizeType === 'pro_1month' || item.grantKind === 'pro_1month') && item.status === 'completed'}}">
          <text>1个月PRO会员已到账</text>
        </view>
        <view class="prize-tracking prize-tracking--waiting" wx:elif="{{item.status === 'pending' && item.prizeType !== 'pro_1month' && item.grantKind !== 'pro_1month'}}">
          <text>正在为您准备奖品，请耐心等待～</text>
        </view>
        <view class="prize-tracking prize-tracking--waiting" wx:elif="{{item.status === 'shipped' && !item.trackingNumber}}">
          <text>已发出，物流单号更新中…</text>
        </view>
      </view>
    </view>
  </view>


  <!-- ══ 在线客服（已迁详情页） ══ -->
  <view class="about-section" wx:if="{{false}}">
    <view class="section-title-row">
      <text class="section-title-text">在线客服</text>
    </view>
    <view class="about-card glass-card">
      <text class="about-text">{{aboutText}}</text>
      <view class="about-wechat" wx:if="{{aboutWechat}}">
        <text class="about-wechat-label">微信：</text>
        <text class="about-wechat-id">{{aboutWechat}}</text>
        <button class="about-copy-btn" size="mini" catchtap="emitOnCopyWechat" hover-class="about-copy-btn--hover">复制</button>
      </view>

      <!-- 在线客服：微信小程序官方客服会话（open-type="contact"） -->
      <button class="service-contact-row" open-type="contact" bindcontact="emitOnContactCallback" session-from="profile-about" hover-class="service-contact-row--hover">
        <view class="service-contact-icon">
          <image class="service-contact-icon-img" src="/images/icon-customer-service.svg" mode="aspectFit" />
        </view>
        <view class="service-contact-text">
          <text class="service-contact-title">立即联系</text>
          <text class="service-contact-sub">遇到问题或有建议？点击直接对话</text>
        </view>
        <text class="service-contact-arrow">›</text>
      </button>

      <view wx:if="{{figmaShareEnabled}}" class="figma-share-row" bindtap="emitOnShareFigma" hover-class="figma-share-row--hover">
        <view class="figma-share-icon">
          <text class="figma-share-icon-text">F</text>
        </view>
        <view class="figma-share-text">
          <text class="figma-share-title">Starship Tracking 设计稿</text>
          <text class="figma-share-sub">点击查看设计稿</text>
