<page-meta background-color="{{pageBgColor}}" background-color-top="{{pageBgColor}}" background-color-bottom="{{pageBgColor}}" />
<view class="container {{themeClass}}">
  <view class="top-nav-wrapper" style="padding-top:{{statusBarHeight}}px;">
    <view class="top-nav top-nav--page-grid">
      <view class="top-nav-slot--back" bindtap="goBack">
        <text class="icon-back icon-back--nav">‹</text>
      </view>
      <text class="nav-title nav-title--page-grid">在线客服</text>
      <view class="top-nav-slot--spacer"></view>
    </view>
  </view>

  <scroll-view class="content-scroll" scroll-y enhanced show-scrollbar="{{false}}" style="padding-top:{{navPlaceholderHeight}}px;">
    <view class="card glass-card">
      <text class="about-text">{{aboutText}}</text>
      <view class="wechat-row" wx:if="{{aboutWechat}}">
        <text class="wechat-label">微信：</text>
        <text class="wechat-id">{{aboutWechat}}</text>
        <button class="copy-btn" size="mini" bindtap="onCopyWechat">复制</button>
      </view>

      <button
        class="contact-btn"
        open-type="contact"
        bindcontact="onContactCallback"
        session-from="profile-contact"
      >
        <text class="contact-btn-title">立即联系</text>
        <text class="contact-btn-sub">遇到问题或有建议？点击直接对话</text>
      </button>
    </view>
    <view style="height: 80rpx;"></view>
  </scroll-view>
</view>
