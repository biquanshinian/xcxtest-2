.container {
  min-height: 100vh;
  background: var(--color-bg-page);
}
.content-scroll {
  height: 100vh;
  box-sizing: border-box;
  padding: 0 30rpx;
}
.card {
  padding: 32rpx;
  border-radius: 24rpx;
}
.about-text {
  display: block;
  font-size: 28rpx;
  line-height: 1.65;
  color: var(--color-text-secondary);
  margin-bottom: 28rpx;
}
.wechat-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-bottom: 28rpx;
}
.wechat-label {
  font-size: 26rpx;
  color: var(--color-text-tertiary);
}
.wechat-id {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-text-primary);
}
.copy-btn {
  margin-left: auto;
}
.contact-btn {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 8rpx;
  width: 100%;
  padding: 28rpx;
  border-radius: 20rpx;
  background: rgba(10, 132, 255, 0.14);
  border: 1rpx solid rgba(10, 132, 255, 0.28);
  line-height: 1.3;
}
.contact-btn::after {
  border: none;
}
.contact-btn-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #0A84FF;
}
.contact-btn-sub {
  font-size: 22rpx;
  color: var(--color-text-secondary);
}
