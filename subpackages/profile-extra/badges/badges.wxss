/* 我的徽章：深色舞台 + 浅色反色 */

.badges-page {
  min-height: 100vh;
  background: #0B0E18;
  color: #F5F5F7;
}

.badges-page.theme-light {
  background: #F3F4F7;
  color: #1C1C1E;
}

/* 导航随主题反色（本页自定义底色，不依赖全局 page 变量时补齐） */
.badges-page .nav-title,
.badges-page .nav-title--page-grid {
  color: #FFFFFF;
}

.badges-page.theme-light .nav-title,
.badges-page.theme-light .nav-title--page-grid {
  color: #1C1C1E;
}

.badges-scroll {
  height: 100vh;
  box-sizing: border-box;
}

.badges-hero {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 12rpx 32rpx 28rpx;
}

.badges-avatar {
  width: 148rpx;
  height: 148rpx;
  border-radius: 50%;
  overflow: hidden;
  background: #1a2438;
  border: 4rpx solid rgba(245, 185, 63, 0.75);
  margin-bottom: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.badges-avatar--empty {
  border-style: dashed;
  border-color: rgba(255, 255, 255, 0.28);
  background: rgba(255, 255, 255, 0.06);
}

.theme-light .badges-avatar {
  background: #E8EEF7;
  border-color: #EFC565;
}

.theme-light .badges-avatar--empty {
  border-color: rgba(60, 60, 67, 0.28);
  background: rgba(0, 0, 0, 0.04);
}

.badges-avatar-img {
  width: 100%;
  height: 100%;
  display: block;
}

.badges-avatar-plus {
  font-size: 64rpx;
  font-weight: 300;
  line-height: 1;
  color: rgba(255, 255, 255, 0.55);
}

.theme-light .badges-avatar-plus {
  color: rgba(60, 60, 67, 0.45);
}

.badges-user {
  font-size: 32rpx;
  font-weight: 650;
  color: #F5F5F7;
  margin-bottom: 10rpx;
}

.theme-light .badges-user {
  color: #1C1C1E;
}

.badges-count {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.55);
}

.theme-light .badges-count {
  color: rgba(60, 60, 67, 0.6);
}

.badges-count-num {
  color: #F5B93F;
  font-weight: 700;
}

.theme-light .badges-count-num {
  color: #D98E12;
}

.badges-series {
  padding: 8rpx 36rpx 20rpx;
}

.badges-series-active {
  font-size: 30rpx;
  font-weight: 700;
  color: #F5B93F;
}

.theme-light .badges-series-active {
  color: #D98E12;
}

.badges-grid-wrap {
  margin: 0 20rpx;
  padding: 28rpx 12rpx 40rpx;
  border-radius: 32rpx 32rpx 0 0;
  background: #101528;
  box-shadow: inset 0 1rpx 0 rgba(245, 185, 63, 0.22);
}

.theme-light .badges-grid-wrap {
  background: #FFFFFF;
  box-shadow: inset 0 1rpx 0 rgba(0, 0, 0, 0.04);
}

.badges-grid {
  display: flex;
  flex-wrap: wrap;
}

.badge-cell {
  width: 33.333%;
  box-sizing: border-box;
  padding: 18rpx 10rpx 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
}

.badge-cell:active {
  opacity: 0.8;
}

.badge-cell-icon-wrap {
  width: 140rpx;
  height: 140rpx;
  border-radius: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.04);
  border: 2rpx solid rgba(255, 255, 255, 0.08);
}

.theme-light .badge-cell-icon-wrap {
  background: rgba(0, 0, 0, 0.03);
  border-color: rgba(0, 0, 0, 0.06);
}

.badge-cell--on .badge-cell-icon-wrap {
  border-color: rgba(245, 185, 63, 0.55);
  background: rgba(245, 185, 63, 0.12);
}

.theme-light .badge-cell--on .badge-cell-icon-wrap {
  border-color: rgba(239, 197, 101, 0.65);
  background: rgba(255, 227, 160, 0.35);
}

.badge-cell--off .badge-cell-icon {
  filter: grayscale(1) brightness(0.85);
  opacity: 0.55;
}

.theme-light .badge-cell--off .badge-cell-icon {
  filter: grayscale(1) brightness(1.05);
  opacity: 0.45;
}

.badge-cell-icon {
  width: 96rpx;
  height: 96rpx;
}

.badge-cell-name {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.72);
  text-align: center;
  max-width: 180rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.theme-light .badge-cell-name {
  color: rgba(28, 28, 30, 0.78);
}

.badge-cell--off .badge-cell-name {
  color: rgba(255, 255, 255, 0.38);
}

.theme-light .badge-cell--off .badge-cell-name {
  color: rgba(60, 60, 67, 0.45);
}

/* —— 单枚详情舞台 —— */
.badge-detail {
  position: fixed;
  inset: 0;
  z-index: 10060;
}

.badge-detail-mask {
  position: absolute;
  inset: 0;
  background: rgba(0, 0, 0, 0.55);
}

.theme-light .badge-detail-mask {
  background: rgba(0, 0, 0, 0.35);
}

.badge-detail-panel {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 72%;
  background: #05070D;
  border-radius: 36rpx 36rpx 0 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 28rpx 24rpx calc(28rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  animation: badgeDetailUp 0.24s ease-out;
}

.theme-light .badge-detail-panel {
  background: #FFFFFF;
}

@keyframes badgeDetailUp {
  from { transform: translateY(24%); opacity: 0.7; }
  to { transform: translateY(0); opacity: 1; }
}

.badge-detail-stage {
  width: 100%;
  height: 340rpx;
  margin-top: 8rpx;
  background: radial-gradient(ellipse 60% 70% at 50% 20%, rgba(245, 185, 63, 0.22) 0%, transparent 70%);
}

.theme-light .badge-detail-stage {
  background: radial-gradient(ellipse 60% 70% at 50% 20%, rgba(255, 227, 160, 0.55) 0%, transparent 70%);
}

.badge-detail-swiper {
  width: 100%;
  height: 340rpx;
}

.badge-detail-slide {
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  transform: scale(0.78);
  opacity: 0.45;
  transition: transform 0.2s ease, opacity 0.2s ease;
}

.badge-detail-slide--active {
  transform: scale(1);
  opacity: 1;
}

.badge-detail-frame {
  width: 260rpx;
  height: 260rpx;
  border-radius: 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.04);
  border: 3rpx solid rgba(255, 255, 255, 0.16);
}

.theme-light .badge-detail-frame {
  background: #F5F5F7;
  border-color: rgba(0, 0, 0, 0.08);
}

.badge-detail-frame--on {
  border-color: rgba(245, 185, 63, 0.75);
  box-shadow: 0 0 40rpx rgba(245, 185, 63, 0.22);
}

.badge-detail-frame--off .badge-detail-icon {
  filter: grayscale(1);
  opacity: 0.7;
}

.badge-detail-icon {
  width: 180rpx;
  height: 180rpx;
}

.badge-detail-info {
  width: 100%;
  padding: 12rpx 24rpx 0;
  text-align: center;
  flex: 0 0 auto;
}

.badge-detail-title-row {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  margin-bottom: 12rpx;
}

.badge-detail-orn {
  font-size: 18rpx;
  color: #F5B93F;
}

.theme-light .badge-detail-orn {
  color: #D98E12;
}

.badge-detail-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #FFE3A0;
}

.theme-light .badge-detail-title {
  color: #5C3A00;
}

.badge-detail-desc {
  display: block;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.55);
  margin-bottom: 12rpx;
}

.theme-light .badge-detail-desc {
  color: rgba(60, 60, 67, 0.65);
}

.badge-detail-hint {
  display: block;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.72);
  line-height: 1.45;
}

.theme-light .badge-detail-hint {
  color: rgba(28, 28, 30, 0.7);
}

.badge-detail-hint--ok {
  color: #07C160;
}

.badge-detail-cta {
  margin-top: 40rpx;
  width: 78%;
  height: 88rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(90deg, #FFE3A0 0%, #F7BE45 55%, #F0AE2C 100%);
  color: #5C3A00;
  font-size: 30rpx;
  font-weight: 700;
  flex-shrink: 0;
}

.badge-detail-cta--done {
  background: rgba(7, 193, 96, 0.18);
  color: #07C160;
}

.theme-light .badge-detail-cta--done {
  background: rgba(7, 193, 96, 0.12);
  color: #248A3D;
}

.badge-detail-close {
  margin-top: 28rpx;
  margin-bottom: 8rpx;
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  border: 2rpx solid rgba(255, 255, 255, 0.35);
  color: rgba(255, 255, 255, 0.85);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  flex-shrink: 0;
}

.theme-light .badge-detail-close {
  border-color: rgba(0, 0, 0, 0.18);
  color: rgba(28, 28, 30, 0.65);
}
