.road-closure-banner {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin: 16rpx 0 8rpx;
  padding: 16rpx 20rpx;
  border-radius: 16rpx;
  background: linear-gradient(135deg, rgba(255, 152, 0, 0.15) 0%, rgba(255, 87, 34, 0.12) 100%);
  border: 1px solid rgba(255, 152, 0, 0.3);
  
  animation: roadClosurePulse 3s ease-in-out infinite;
  text-align: left;
  line-height: normal;
  box-sizing: border-box;
  overflow: hidden;
}
.road-closure-banner::after {
  border: none;
}
.road-closure-icon-wrap {
  flex-shrink: 0;
  width: 44rpx;
  height: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 152, 0, 0.25);
  border-radius: 50%;
  margin-top: 2rpx;
}
.road-closure-icon {
  font-size: 26rpx;
  line-height: 1;
  color: #FF9800;
}
.road-closure-content {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  overflow: hidden;
}
.road-closure-title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}
.road-closure-title {
  font-size: 24rpx;
  font-weight: 600;
  color: #FF9800;
  line-height: 1.3;
}
.road-closure-msg-scroll {
  width: 100%;
  overflow: hidden;
  white-space: nowrap;
}
.road-closure-msg-track {
  display: inline-flex;
  flex-wrap: nowrap;
  width: max-content;
  will-change: transform;
  backface-visibility: hidden;
  animation: marqueeScroll 18s linear infinite;
}
.road-closure-msg {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.85);
  line-height: 1.4;
  flex-shrink: 0;
  white-space: nowrap;
  padding-right: 80rpx;
  box-sizing: content-box;
}
.road-closure-arrow {
  flex-shrink: 0;
  font-size: 36rpx;
  color: rgba(255, 255, 255, 0.4);
  font-weight: 300;
}
.road-closure-source {
  font-size: 20rpx;
  color: rgba(255, 152, 0, 0.7);
  padding: 2rpx 10rpx;
  border: 1px solid rgba(255, 152, 0, 0.3);
  border-radius: 6rpx;
  flex-shrink: 0;
}
.theme-light .road-closure-msg {
  color: var(--color-text-primary);
}
.theme-light .road-closure-arrow {
  color: var(--color-text-tertiary);
}
