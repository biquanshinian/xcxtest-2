<!-- 封路通知：状态常显 + 灯箱跑完整明细（点击进详情，日历视图隐藏） -->
<view
  class="road-closure-host {{themeClass}}"
  wx:if="{{visible}}"
  bindtap="emitOpen"
  hover-class="road-closure-host--pressed"
  hover-stay-time="80"
>
  <view class="road-closure-banner">
    <view class="road-closure-rail"></view>
    <view class="road-closure-side">
      <view class="road-closure-chip">
        <view class="road-closure-dot"></view>
        <text class="road-closure-chip-text">封路</text>
      </view>
      <text class="road-closure-source" wx:if="{{previewNotice.sourceLabel}}">{{previewNotice.sourceLabel}}</text>
    </view>
    <view class="road-closure-main">
      <text class="road-closure-headline" wx:if="{{headline}}">{{headline}}</text>
      <view class="road-closure-ticker">
        <text class="road-closure-ticker-probe">{{displayText}}</text>
        <view class="road-closure-ticker-fade road-closure-ticker-fade--left" wx:if="{{scrolling}}"></view>
        <view class="road-closure-ticker-track {{scrolling ? 'is-scrolling' : ''}}" style="{{trackStyle}}">
          <text class="road-closure-ticker-item">{{displayText}}</text>
          <view class="road-closure-sep" wx:if="{{scrolling}}"></view>
          <text class="road-closure-ticker-item" wx:if="{{scrolling}}" aria-hidden="true">{{displayText}}</text>
          <view class="road-closure-sep" wx:if="{{scrolling}}"></view>
        </view>
        <view class="road-closure-ticker-fade road-closure-ticker-fade--right" wx:if="{{scrolling}}"></view>
      </view>
    </view>
    <text class="road-closure-arrow">›</text>
  </view>
</view>
