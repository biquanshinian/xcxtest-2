.share-dialog-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.55);
  z-index: 9999;
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0;
  transition: opacity 0.22s ease;
  padding: 0 60rpx;
}

.share-dialog-mask--visible {
  opacity: 1;
}

.share-dialog {
  width: 100%;
  max-width: 560rpx;
  background: var(--bg-glass-popup, rgba(22, 24, 28, 0.85));
  backdrop-filter: blur(32rpx) saturate(150%);
  -webkit-backdrop-filter: blur(32rpx) saturate(150%);
  border-radius: 28rpx;
  padding: 44rpx 36rpx 28rpx;
  box-shadow: 0 12rpx 36rpx rgba(0, 0, 0, 0.5);
  animation: share-dialog-pop 0.28s cubic-bezier(0.2, 0.9, 0.3, 1.15);
}

@keyframes share-dialog-pop {
  0% { transform: scale(0.82); opacity: 0; }
  100% { transform: scale(1); opacity: 1; }
}

.share-dialog-header {
  text-align: center;
  margin-bottom: 40rpx;
}

.share-dialog-title {
  display: block;
  font-size: 32rpx;
  color: #ffffff;
  font-weight: 600;
}

.share-dialog-subtitle {
  display: block;
  margin-top: 10rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.55);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  padding: 0 20rpx;
}

.share-dialog-actions {
  display: flex;
  justify-content: space-around;
  align-items: flex-start;
  padding: 0 0 36rpx;
}

.share-dialog-actions--single {
  justify-content: center;
}

.share-dialog-btn {
  background: transparent !important;
  border: none !important;
  padding: 14rpx 10rpx !important;
  margin: 0 !important;
  display: flex !important;
  flex-direction: column;
  align-items: center;
  width: 180rpx;
  line-height: 1;
  border-radius: 16rpx;
  transition: background 0.18s ease;
}

.share-dialog-btn::after {
  border: none !important;
}

.share-dialog-btn--hover {
  background: rgba(255, 255, 255, 0.06) !important;
}

.share-dialog-icon {
  width: 96rpx;
  height: 96rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 16rpx;
  background: rgba(255, 255, 255, 0.06);
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  overflow: hidden;
}

.share-dialog-icon-img {
  width: 52rpx;
  height: 52rpx;
}

.share-dialog-label {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.9);
}

.share-dialog-cancel {
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  font-size: 30rpx;
  color: rgba(255, 255, 255, 0.9);
  background: rgba(255, 255, 255, 0.06);
  border-radius: 16rpx;
}

.share-dialog-cancel--hover {
  background: rgba(255, 255, 255, 0.12);
}

.theme-light .share-dialog {
  background: var(--bg-glass-popup, rgba(255, 255, 255, 0.88));
  box-shadow: 0 12rpx 36rpx rgba(0, 0, 0, 0.16);
}

.theme-light .share-dialog-title {
  color: var(--color-text-primary);
}

.theme-light .share-dialog-subtitle {
  color: var(--color-text-secondary);
}

.theme-light .share-dialog-btn--hover {
  background: rgba(0, 0, 0, 0.05) !important;
}

.theme-light .share-dialog-icon {
  background: rgba(0, 0, 0, 0.05);
  border: 1rpx solid var(--color-divider);
}

.theme-light .share-dialog-label {
  color: var(--color-text-primary);
}

.theme-light .share-dialog-cancel {
  color: var(--color-text-primary);
  background: rgba(0, 0, 0, 0.05);
}

.theme-light .share-dialog-cancel--hover {
  background: rgba(0, 0, 0, 0.1);
}
