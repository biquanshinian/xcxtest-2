.image-carousel {
  width: 100%;
  max-width: 100%;
  height: 400rpx;
  margin-top: var(--space-md);
  margin-bottom: var(--space-xl);
  border-radius: var(--radius-card);
  overflow: hidden;
  box-sizing: border-box;
  background-color: var(--color-bg-elevated);
  position: relative;
}

.swiper {
  width: 100%;
  height: 100%;
  background-color: transparent;
}

.swiper-item {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
}

.carousel-image-wrap {
  position: relative;
  width: 100%;
  height: 100%;
}

.carousel-image {
  width: 100%;
  height: 100%;
  display: block;
  background-color: #1a1a1a;
  object-fit: cover;
  border-radius: 16rpx;
  min-height: 300rpx;
}

.carousel-video-wrap {
  width: 100%;
  height: 100%;
  position: relative;
  border-radius: 16rpx;
  overflow: hidden;
  background-color: #000;
}

.carousel-video {
  width: 100%;
  height: 100%;
}

.carousel-video-cover {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(150deg, #1c2430 0%, #10151d 55%, #0a0d12 100%);
  pointer-events: none;
  overflow: hidden;
}

.carousel-video-cover-img {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  display: block;
}

.carousel-video-cover-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  background: rgba(0, 0, 0, 0.28);
}

.carousel-video-cover-icon {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.12);
  border: 1px solid rgba(255, 255, 255, 0.18);
  display: flex;
  align-items: center;
  justify-content: center;
}

.carousel-video-cover-play {
  font-size: 36rpx;
  color: rgba(255, 255, 255, 0.85);
  margin-left: 6rpx;
}

.carousel-video-cover-text {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.45);
  letter-spacing: 2rpx;
}

.carousel-video-caption {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 16rpx 20rpx;
  background: linear-gradient(transparent, rgba(0, 0, 0, 0.7));
  pointer-events: auto;
}

.carousel-video-caption-text {
  font-size: 24rpx;
  line-height: 1.5;
  color: rgba(255, 255, 255, 0.9);
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  text-overflow: ellipsis;
  word-break: break-all;
}

.carousel-account-badge {
  position: absolute;
  left: 20rpx;
  top: 20rpx;
  display: flex;
  align-items: center;
  gap: 10rpx;
  max-width: 60%;
  padding: 8rpx 20rpx 8rpx 10rpx;
  border-radius: 999rpx;
  background: rgba(0, 0, 0, 0.45);
  backdrop-filter: blur(8px);
  border: 1rpx solid rgba(255, 255, 255, 0.18);
  pointer-events: none;
  z-index: 3;
  transform: scale(0.7);
  transform-origin: top left;
}

.carousel-account-avatar {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  flex-shrink: 0;
  background: rgba(255, 255, 255, 0.15);
}

.carousel-account-name {
  font-size: 24rpx;
  font-weight: 600;
  color: rgba(255, 255, 255, 0.95);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
