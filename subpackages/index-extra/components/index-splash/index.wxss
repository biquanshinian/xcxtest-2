/* ========== 开屏动画 ========== */
.splash-overlay {
  position: fixed;
  top: 0;
  left: 0;
  width: 100vw;
  height: 100vh;
  z-index: 99999;
  background: #000;
}
.splash-overlay--in {
  animation: splashFadeIn 0.45s ease-out forwards;
}
.splash-overlay--out {
  animation: splashFadeOut 0.5s ease-in forwards;
  pointer-events: none;
}
@keyframes splashFadeIn {
  from { opacity: 0; }
  to   { opacity: 1; }
}
@keyframes splashFadeOut {
  from { opacity: 1; }
  to   { opacity: 0; }
}
.splash-media {
  width: 100vw;
  height: 100vh;
  /* 视频/图都必须 cover 裁剪，禁止 stretch 变形 */
  object-fit: cover;
}
.splash-video-cover {
  position: absolute;
  top: 0;
  left: 0;
  width: 100vw;
  height: 100vh;
  z-index: 1;
  pointer-events: none;
  background: #000;
}
.splash-video-cover-fallback {
  width: 100%;
  height: 100%;
  background: #000;
}
.splash-skip {
  position: fixed;
  right: 28rpx;
  display: flex;
  align-items: center;
  gap: 0;
  height: 64rpx;
  background: rgba(255, 255, 255, 0.15);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border: 1px solid rgba(255, 255, 255, 0.2);
  border-radius: 36rpx;
  /* 注意：隐私禁触遮罩挂在 root-portal 根层级，与本按钮不在同一层叠上下文，
     单纯抬 z-index 压不过它；开屏期间由 app.setSplashActive(true) 让遮罩不渲染
     （见 _showSplash / closeSplash），「跳过」才能收到点击 */
  z-index: 200000;
  animation: splashSkipIn 0.4s 0.3s ease-out both;
  overflow: hidden;
}
.splash-skip-countdown {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 600;
  color: #fff;
  font-variant-numeric: tabular-nums;
}
.splash-skip-divider {
  width: 1px;
  height: 28rpx;
  background: rgba(255, 255, 255, 0.25);
  flex-shrink: 0;
}
.splash-skip-text {
  padding: 0 24rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.9);
  letter-spacing: 1rpx;
  line-height: 64rpx;
}
@keyframes splashSkipIn {
  from { opacity: 0; transform: translateY(-12rpx) scale(0.92); }
  to   { opacity: 1; transform: translateY(0) scale(1); }
}
/* 开屏底部叠层：通知条 + 倒计时卡纵向排列 */
.splash-bottom-stack {
  position: fixed;
  left: 50%;
  bottom: 180rpx;
  transform: translateX(-50%);
  z-index: 2;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 18rpx;
  width: 672rpx;
  max-width: calc(100vw - 48rpx);
  box-sizing: border-box;
  pointer-events: none;
}
.splash-bottom-stack .splash-mission-card {
  pointer-events: auto;
}

/* 开屏全局通知条：贴在倒计时卡上方；无任务卡时单独显示 */
.splash-notice {
  box-sizing: border-box;
  width: 100%;
  max-width: 672rpx;
  padding: 18rpx 28rpx;
  border-radius: 24rpx;
  background: linear-gradient(
    165deg,
    rgba(255, 255, 255, 0.08) 0%,
    rgba(0, 0, 0, 0.22) 100%
  );
  backdrop-filter: blur(8px) saturate(1.3);
  -webkit-backdrop-filter: blur(8px) saturate(1.3);
  border: 1rpx solid rgba(255, 255, 255, 0.14);
  box-shadow: 0 10rpx 28rpx rgba(0, 0, 0, 0.18);
  animation: splashNoticeIn 0.45s cubic-bezier(0.22, 1, 0.36, 1) 0.1s both;
}
@keyframes splashNoticeIn {
  from {
    opacity: 0;
    transform: translateY(16rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}
.splash-notice-text {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 6;
  overflow: hidden;
  text-overflow: ellipsis;
  word-break: break-word;
  overflow-wrap: anywhere;
  font-size: 32rpx;
  line-height: 1.4;
  text-align: center;
  color: rgba(255, 255, 255, 0.92);
  letter-spacing: 0.5rpx;
  text-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.4);
}
.splash-notice-lines {
  display: flex;
  flex-direction: column;
  width: 100%;
  color: rgba(255, 255, 255, 0.92);
  text-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.4);
  word-break: break-word;
}
.splash-notice-lines--left { align-items: flex-start; text-align: left; }
.splash-notice-lines--center { align-items: center; text-align: center; }
.splash-notice-lines--right { align-items: flex-end; text-align: right; }
.splash-notice-line {
  display: block;
  width: 100%;
  white-space: pre-wrap;
  box-sizing: border-box;
}
.splash-notice-line--left { text-align: left; }
.splash-notice-line--center { text-align: center; }
.splash-notice-line--right { text-align: right; }
.splash-notice-line--empty {
  min-height: 1.2em;
}
.splash-notice-seg {
  font-size: 32rpx;
  font-weight: 500;
  color: inherit;
}
.splash-notice-seg--bold {
  font-weight: 700;
}
.splash-notice--default .splash-notice-text,
.splash-notice--default .splash-notice-seg {
  font-weight: 500;
}
.splash-notice--default .splash-notice-seg--bold {
  font-weight: 700;
}
.splash-notice--yahei .splash-notice-text,
.splash-notice--yahei .splash-notice-seg {
  font-family: "Microsoft YaHei", "微软雅黑", "PingFang SC", "Helvetica Neue", sans-serif;
  font-weight: 400;
}
.splash-notice--yahei .splash-notice-seg--bold {
  font-weight: 700;
}
.splash-notice--yahei-bold .splash-notice-text,
.splash-notice--yahei-bold .splash-notice-seg {
  font-family: "Microsoft YaHei", "微软雅黑", "PingFang SC", "Helvetica Neue", sans-serif;
  font-weight: 700;
}

/* 开屏任务倒计时卡片：下部居中；尺寸按 1.2 倍实算（不用 transform scale，避免点击热区错位） */
.splash-mission-card {
  position: relative;
  left: auto;
  bottom: auto;
  transform: none;
  z-index: 2;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  min-width: 504rpx;
  width: 100%;
  max-width: 672rpx;
  padding: 34rpx 44rpx 28rpx;
  box-sizing: border-box;
  background: linear-gradient(
    165deg,
    rgba(255, 255, 255, 0.04) 0%,
    rgba(0, 0, 0, 0.13) 48%,
    rgba(0, 0, 0, 0.16) 100%
  );
  backdrop-filter: blur(7px) saturate(1.35);
  -webkit-backdrop-filter: blur(7px) saturate(1.35);
  border-radius: 38rpx;
  animation: splashMissionIn 0.55s cubic-bezier(0.22, 1, 0.36, 1) 0.18s both;
}
.splash-mission-meta {
  display: flex;
  flex-direction: column;
  align-items: center;
  max-width: 600rpx;
  width: 100%;
}
.splash-mission-agency {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  max-width: 100%;
}
.splash-mission-agency-logo {
  width: 44rpx;
  height: 44rpx;
  flex-shrink: 0;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.12);
  border: 1rpx solid rgba(255, 255, 255, 0.2);
  overflow: hidden;
}
.splash-mission-agency-name {
  min-width: 0;
  max-width: 520rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: rgba(255, 255, 255, 0.88);
  line-height: 1.2;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.splash-mission-title-row {
  display: flex;
  align-items: baseline;
  justify-content: center;
  flex-wrap: nowrap;
  gap: 14rpx;
  max-width: 600rpx;
  width: 100%;
  box-sizing: border-box;
}
.splash-mission-title-row .splash-mission-name {
  flex: 0 1 auto;
  min-width: 0;
  max-width: 58%;
}
.splash-mission-title-row .splash-mission-rocket {
  flex: 0 1 auto;
  min-width: 0;
  max-width: 40%;
  font-size: 36rpx;
  font-weight: 600;
  color: #fff;
  letter-spacing: 0.5rpx;
  line-height: 1.25;
  text-align: left;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  text-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.35);
}
.splash-mission-card:active {
  opacity: 0.92;
}
@keyframes splashMissionIn {
  from {
    opacity: 0;
    transform: translateY(28rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}
.splash-mission-eyebrow {
  font-size: 22rpx;
  font-weight: 600;
  letter-spacing: 3.6rpx;
  color: rgba(255, 255, 255, 0.55);
  line-height: 1;
}
.splash-mission-name {
  max-width: 600rpx;
  font-size: 36rpx;
  font-weight: 600;
  color: #fff;
  text-align: center;
  letter-spacing: 0.5rpx;
  line-height: 1.25;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  text-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.35);
}
.splash-mission-cd {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-top: 4rpx;
  color: #fff;
}
.splash-mission-cd-prefix {
  font-size: 34rpx;
  font-weight: 700;
  color: rgba(255, 255, 255, 0.78);
  letter-spacing: 1rpx;
  padding-top: 2rpx;
}
.splash-mission-cd-cells {
  display: flex;
  align-items: stretch;
  gap: 0;
}
.splash-mission-cd-cell {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-width: 76rpx;
  padding: 12rpx 14rpx 10rpx;
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.1);
  border: 1rpx solid rgba(255, 255, 255, 0.14);
}
.splash-mission-cd-cell--sec {
  background: rgba(255, 255, 255, 0.16);
  border-color: rgba(255, 255, 255, 0.26);
}
.splash-mission-cd-sep {
  align-self: center;
  width: 22rpx;
  text-align: center;
  font-size: 34rpx;
  font-weight: 600;
  color: rgba(255, 255, 255, 0.4);
  line-height: 1;
  padding-bottom: 16rpx;
}
.splash-mission-cd-num {
  font-size: 48rpx;
  font-weight: 700;
  font-variant-numeric: tabular-nums;
  font-feature-settings: 'tnum' 1;
  line-height: 1;
  letter-spacing: 0.5rpx;
}
.splash-mission-cd-unit {
  margin-top: 8rpx;
  font-size: 22rpx;
  font-weight: 500;
  color: rgba(255, 255, 255, 0.58);
  letter-spacing: 1rpx;
  line-height: 1;
}
.splash-mission-cd--imminent {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-top: 4rpx;
  padding: 14rpx 34rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.12);
  border: 1rpx solid rgba(255, 255, 255, 0.2);
  font-size: 40rpx;
  font-weight: 700;
  letter-spacing: 6rpx;
  color: #fff;
}
.splash-mission-imminent-dot {
  width: 14rpx;
  height: 14rpx;
  flex-shrink: 0;
  border-radius: 50%;
  background: #7dffb3;
  box-shadow: 0 0 12rpx rgba(125, 255, 179, 0.75);
  animation: splashMissionPulse 1.2s ease-in-out infinite;
}
@keyframes splashMissionPulse {
  0%, 100% { opacity: 1; transform: scale(1); }
  50% { opacity: 0.55; transform: scale(0.85); }
}
.splash-mission-hint {
  display: flex;
  align-items: center;
  gap: 4rpx;
  margin-top: 2rpx;
  padding-top: 12rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.12);
  width: 100%;
  justify-content: center;
  box-sizing: border-box;
}
.splash-mission-hint-text {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.62);
  letter-spacing: 1.5rpx;
}
.splash-mission-hint-arrow {
  font-size: 34rpx;
  line-height: 1;
  color: rgba(255, 255, 255, 0.7);
  transform: translateY(-1rpx);
}
