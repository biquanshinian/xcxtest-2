.vote-box-placeholder { flex: 1; }

.vote-box {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  flex-wrap: nowrap;
  gap: 6rpx 8rpx;
  padding: 8rpx 12rpx;
  border-radius: 14rpx;
  border: 1px solid rgba(255, 255, 255, 0.1);
  background: rgba(255, 255, 255, 0.03);
}

.vote-box--antimiss {
  padding-right: 14rpx;
}

.vote-box--antimiss.vote-box--dual {
  
  padding: 8rpx 14rpx 10rpx 10rpx;
  gap: 12rpx;
}

.vote-type-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  gap: 10rpx;
  min-width: 0;
}

.vote-type-meta {
  flex-shrink: 0;
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.34);
  font-variant-numeric: tabular-nums;
  white-space: nowrap;
}

.vote-box--antimiss .vote-box-label.vote-box-label--polling {
  flex: 1;
  min-width: 0;
  flex-shrink: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.72);
}

.vote-box--antimiss .vote-pills-with-meta {
  flex-shrink: 0;
  gap: 14rpx;
}

.vote-box--antimiss .vote-pill {
  min-height: 48rpx;
  padding: 6rpx 14rpx;
}

.vote-box--dual {
  flex-direction: column;
  align-items: stretch;
  gap: 6rpx;
  padding: 8rpx 10rpx 10rpx;
}

.vote-type-tabs {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 5rpx;
}

.vote-type-tab {
  position: relative;
  overflow: visible;
  font-size: 24rpx;
  line-height: 1.2;
  color: var(--color-text-secondary, #8E8E93);
  padding: 2rpx 12rpx 12rpx;
  background: transparent;
  border: none;
  box-shadow: none;
  transition: color 0.25s ease;
}

.vote-type-tab::after {
  content: '';
  position: absolute;
  left: 50%;
  bottom: 0;
  width: 44rpx;
  height: 6rpx;
  border-radius: 999rpx;
  background: var(--color-brand, #3B82F6);
  transform: translateX(-50%) scaleX(0);
  opacity: 0;
  transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.2s ease;
  pointer-events: none;
}

.vote-type-tab--active {
  color: var(--color-text-primary);
  font-weight: 600;
  background: transparent;
}

.vote-type-tab--active::after {
  transform: translateX(-50%) scaleX(1);
  opacity: 1;
}

.vote-box-body {
  display: flex;
  align-items: center;
  flex-wrap: nowrap;
  gap: 6rpx 8rpx;
  min-width: 0;
}

.vote-box-label {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.45);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.vote-box-flex-fill {
  flex: 1;
  min-width: 0;
  margin-right: 4rpx;
}

.vote-pills-with-meta {
  flex-shrink: 0;
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 8rpx;
  max-width: 100%;
}

.vote-box-label.vote-box-label--polling {
  flex-shrink: 0;
  overflow: visible;
  text-overflow: clip;
  white-space: nowrap;
}

.vote-pills-with-meta--compact .vote-pill {
  min-height: 48rpx;
  gap: 4rpx;
  padding: 6rpx 10rpx;
}

.vote-pills-with-meta--compact .vote-pill-dot {
  width: 12rpx;
  height: 12rpx;
}

.vote-pills-with-meta--compact .vote-pill-text {
  font-size: 22rpx;
}

.vote-pills-with-meta--compact .vote-pill-count {
  font-size: 18rpx;
}

.vote-pills-with-meta--compact .vote-total-inline {
  margin-left: 2rpx;
  padding-left: 6rpx;
}

.vote-total-inline {
  margin-left: 4rpx;
  padding-left: 10rpx;
  border-left: 1rpx solid rgba(255, 255, 255, 0.08);
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.34);
  line-height: 1.15;
  white-space: nowrap;
  flex-shrink: 0;
  font-variant-numeric: tabular-nums;
}

.vote-box-label--closed {
  color: rgba(255, 152, 0, 0.7);
  font-size: 20rpx;
}

.vote-box-label--result {
  font-size: 22rpx;
}

.vote-pill--disabled {
  opacity: 0.5;
  pointer-events: none;
}

.vote-pill {
  min-height: 52rpx;
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.06);
  border: 1px solid rgba(255, 255, 255, 0.08);
  box-sizing: border-box;
  transition: all 0.25s ease;
}

.vote-pill:active {
  transform: scale(0.96);
}

.vote-pill-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.vote-pill-dot--ge {
  background: #FF9500;
  box-shadow: 0 0 6rpx rgba(255, 149, 0, 0.4);
}

.vote-pill-dot--buge {
  background: #07C160;
  box-shadow: 0 0 6rpx rgba(7, 193, 96, 0.4);
}

.vote-pill-text {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
  font-weight: 500;
}

.vote-pill-count {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.35);
  font-variant-numeric: tabular-nums;
}

.vote-pill--active-ge {
  background: rgba(255, 149, 0, 0.15);
  border-color: rgba(255, 149, 0, 0.35);
}

.vote-pill--active-ge .vote-pill-text { color: #FF9500; }

.vote-pill--active-buge {
  background: rgba(7, 193, 96, 0.15);
  border-color: rgba(7, 193, 96, 0.35);
}

.vote-pill--active-buge .vote-pill-text { color: #07C160; }

.vote-pill--voted { pointer-events: none; }

.vote-bar-row {
  margin-top: 8rpx;
}

.vote-bar {
  display: flex;
  height: 6rpx;
  border-radius: 3rpx;
  overflow: hidden;
}

.vote-bar-ge {
  background: linear-gradient(90deg, #FF9500, #FF6B00);
  transition: width 0.6s ease;
}

.vote-bar-buge {
  background: linear-gradient(90deg, #07C160, #06AD56);
  transition: width 0.6s ease;
}

.theme-light .vote-box {
  border: 1px solid var(--color-divider);
  background: rgba(0, 0, 0, 0.03);
}

.theme-light .vote-type-tab {
  color: var(--color-text-secondary, #8E8E93);
  background: transparent;
}

.theme-light .vote-type-tab--active {
  color: var(--color-text-primary);
  background: transparent;
}

.theme-light .vote-box-label {
  color: var(--color-text-tertiary);
}

.theme-light .vote-total-inline {
  border-left: 1rpx solid var(--color-divider);
  color: var(--color-text-tertiary);
}

.theme-light .vote-type-meta {
  color: var(--color-text-tertiary);
}

.theme-light .vote-box--antimiss .vote-box-label.vote-box-label--polling {
  color: rgba(0, 0, 0, 0.72);
}

.theme-light .vote-pill {
  background: rgba(0, 0, 0, 0.05);
  border: 1px solid rgba(0, 0, 0, 0.06);
}

.theme-light .vote-pill-text {
  color: var(--color-text-primary);
}

.theme-light .vote-pill-count {
  color: var(--color-text-tertiary);
}

.theme-light .vote-pill--active-ge {
  background: rgba(255, 149, 0, 0.12);
  border-color: rgba(255, 149, 0, 0.35);
}

.theme-light .vote-pill--active-buge {
  background: rgba(7, 193, 96, 0.12);
  border-color: rgba(7, 193, 96, 0.35);
}
