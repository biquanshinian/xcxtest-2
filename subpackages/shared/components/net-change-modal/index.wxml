<!-- 发射时间变更弹窗：多条时左右滑卡（类 iOS 锁屏通知）
     事件结构对齐 morning-briefing（真机验证可点）：mask 只 catchtouchmove，
     不挂 catchtouchstart（会干扰 root-portal 内 tap 手势合成）。
     单卡不套 swiper：root-portal 内 swiper 手势层会吃掉相邻按钮的 tap。 -->
<template name="ncmCard">
  <view class="ncm-popup ncm-popup--{{item.changeKind}} {{active ? 'ncm-popup--active' : 'ncm-popup--back'}}">
    <view class="ncm-glow"></view>
    <view class="ncm-stars" aria-hidden="true">
      <view class="ncm-star s1"></view>
      <view class="ncm-star s2"></view>
      <view class="ncm-star s3"></view>
      <view class="ncm-star s4"></view>
      <view class="ncm-star s5"></view>
    </view>

    <view class="ncm-body">
      <text class="ncm-kicker" wx:if="{{devMode}}">开发预览</text>
      <text class="ncm-title">{{item.titleText}}</text>
      <view class="ncm-dir-pill ncm-dir-pill--{{item.newTimeUntrusted ? 'pending' : item.changeKind}}" wx:if="{{item.deltaText}}">
        <text>{{item.deltaText}}</text>
      </view>

      <view class="ncm-hero">
        <view class="ncm-rocket-slot">
          <image
            wx:if="{{item.rocketImage}}"
            class="ncm-rocket-img"
            src="{{item.rocketImage}}"
            mode="aspectFill"
            data-index="{{index}}"
            binderror="onRocketImageError"
          />
          <view wx:else class="ncm-rocket-placeholder"></view>
        </view>
      </view>

      <text class="ncm-headline" wx:if="{{item.headlineText}}" user-select="{{true}}">{{item.headlineText}}</text>

      <view class="ncm-agency-row" wx:if="{{item.agencyName}}">
        <image
          class="ncm-agency-logo {{item.logoBgTone === 'dark' ? 'agency-logo-bg--dark' : ''}} {{item.logoBgTone === 'light' ? 'agency-logo-bg--light' : ''}}"
          src="{{item.agencyLogoUrl}}"
          mode="aspectFit"
          data-index="{{index}}"
          binderror="onAgencyLogoError"
        />
        <text class="ncm-agency-name" user-select="{{true}}">{{item.agencyName}}</text>
      </view>

      <view class="ncm-timeline">
        <view class="ncm-time-row ncm-time-row--old">
          <view class="ncm-time-rail">
            <view class="ncm-time-node ncm-time-node--old"></view>
            <view class="ncm-time-line"></view>
          </view>
          <view class="ncm-time-content">
            <text class="ncm-time-label">原时间</text>
            <view class="ncm-time-value ncm-time-value--old">
              <text user-select="{{true}}">{{item.oldTimeText}}</text>
            </view>
          </view>
        </view>
        <view class="ncm-time-row ncm-time-row--new">
          <view class="ncm-time-rail">
            <view class="ncm-time-node ncm-time-node--new"></view>
          </view>
          <view class="ncm-time-content">
            <text class="ncm-time-label {{item.newTimeUntrusted ? 'ncm-time-label--pending' : 'ncm-time-label--new'}}">{{item.newTimeLabel || '新时间'}}</text>
            <view class="ncm-time-value {{item.newTimeUntrusted ? 'ncm-time-value--pending' : 'ncm-time-value--new'}}">
              <text user-select="{{true}}">{{item.newTimeText}}</text>
            </view>
          </view>
        </view>
      </view>

      <view class="ncm-pager" wx:if="{{cardCount > 1}}">
        <view class="ncm-dots">
          <view
            wx:for="{{cards}}"
            wx:for-item="dot"
            wx:for-index="dotIndex"
            wx:key="_key"
            class="ncm-dot {{dotIndex === cardIndex ? 'ncm-dot--on' : ''}}"
          ></view>
        </view>
        <text class="ncm-pager-count">{{cardIndex + 1}} / {{cardCount}}</text>
      </view>
    </view>
  </view>
</template>

<root-portal wx:if="{{visible}}">
  <view class="ncm-mask {{themeClass}}" catchtouchmove="noop">
    <view class="ncm-stack {{cardCount > 1 ? 'ncm-stack--multi' : ''}}" catchtap="noop">
      <!-- 单卡：不挂 swiper，直接渲染卡片 -->
      <view wx:if="{{cardCount <= 1}}" class="ncm-swiper-wrap ncm-single">
        <template
          is="ncmCard"
          data="{{item: cards[0], index: 0, active: true, devMode, cardCount, cards, cardIndex}}"
        />
      </view>
      <!-- 多卡：左右滑卡 -->
      <view wx:else class="ncm-swiper-wrap {{swipeHintOn ? 'ncm-swiper-wrap--hint' : ''}}">
        <swiper
          class="ncm-swiper ncm-swiper--multi"
          current="{{cardIndex}}"
          bindchange="onCardChange"
          bindtouchstart="onSwiperTouch"
          previous-margin="32rpx"
          next-margin="32rpx"
          snap-to-edge="{{true}}"
          easing-function="easeOutCubic"
        >
          <swiper-item wx:for="{{cards}}" wx:key="_key">
            <template
              is="ncmCard"
              data="{{item, index, active: index === cardIndex, devMode, cardCount, cards, cardIndex}}"
            />
          </swiper-item>
        </swiper>
      </view>

      <view class="ncm-btn" hover-class="ncm-btn--hover" catchtap="onConfirm">我知道了</view>
    </view>
  </view>
</root-portal>
