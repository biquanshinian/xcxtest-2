page {
  background: var(--color-bg-page);
  height: 100vh;
}

.detail-page {
  height: 100vh;
  overflow: hidden;
}

/* 导航标题包裹层：min-width:0 允许在 grid 中收缩，flex 保证标题始终水平居中 */
.nav-title-wrap {
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
}


/* 滚动容器 */
.detail-scroll {
  height: 100vh;
}

.detail-container {
  padding: var(--space-lg);
  padding-bottom: var(--space-xl);
}

/* 加载和错误状态 */
.loading-state,
.error-state {
  min-height: 60vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 24rpx;
  padding: 80rpx 40rpx;
}

.loading-spinner {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(59, 130, 246, 0.2);
  border-top-color: var(--color-brand);
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text,
.error-text {
  font-size: 28rpx;
  color: #8e8e93;
  text-align: center;
}

.error-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #ffffff;
}

.retry-btn {
  margin-top: var(--space-xs);
  padding: 0 var(--space-xl);
  height: 80rpx;
  line-height: 80rpx;
  border-radius: var(--radius-pill);
  background: var(--color-brand);
  color: #ffffff;
  font-size: var(--font-size-md);
  font-weight: var(--font-weight-semibold);
  border: none;
}

.retry-btn::after {
  border: none;
}

/* 玻璃卡片 */
.glass-card {
  background: var(--bg-glass);
  border-radius: var(--radius-card);
  overflow: hidden;
}

/* ── Hero 全幅大图：原图干净展示 + 底部渐变收边（与火箭型号详情页一致） ── */
.hero-section {
  position: relative;
  width: 100%;
  height: 460rpx;
  overflow: hidden;
  background: rgba(255, 255, 255, 0.03);
}

.hero-img {
  width: 100%;
  height: 100%;
  opacity: 0;
  transform: scale(1.02);
  transition: opacity 0.4s ease, transform 0.4s ease;
}

.hero-img--loaded {
  opacity: 1;
  transform: scale(1);
}

.hero-placeholder {
  opacity: 1;
  transform: scale(1);
  display: flex;
  align-items: center;
  justify-content: center;
  background: radial-gradient(circle at center, rgba(59, 130, 246, 0.08), rgba(255, 255, 255, 0.02) 72%);
}

.hero-placeholder-icon {
  font-size: 96rpx;
}

/* 仅底部 160rpx 渐变收边，不再整图压暗 */
.hero-gradient {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 160rpx;
  background: linear-gradient(transparent, rgba(11, 12, 14, 0.88));
}

/* ── 信息头：logo/名称/徽标下移出头图 ── */
.info-header {
  padding: 24rpx 32rpx 0;
}

.info-main-row {
  display: flex;
  align-items: center;
  gap: 22rpx;
  width: 100%;
  margin-bottom: 18rpx;
}

/* logo 白底圆片：无描边，靠柔和投影与照片分层 */
.agency-logo-chip {
  flex-shrink: 0;
  width: 116rpx;
  height: 116rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.92);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: var(--shadow-card);
}

.agency-logo {
  width: 82rpx;
  height: 82rpx;
}

.info-title-col {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

/* 收藏爱心：名称列右侧。未收藏灰色，收藏后红色 + 弹跳 */
.fav-btn {
  position: relative;
  flex-shrink: 0;
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.06);
  transition: transform 0.12s ease, background 0.2s ease;
}

.fav-btn--pressed {
  transform: scale(0.9);
}

/* 真机对本地 svg 的 CSS mask 基本无效；改用内联 data-URI（同仓库其他图标写法） */
