533 9.897 4.613 21.69 0.284 26.26-9.661 4.593-9.923 0.264-21.689-9.659-26.263' fill='%23C7C7CC'/%3E%3C/svg%3E") center / contain no-repeat;
}

.fav-btn--on {
  background: rgba(255, 69, 58, 0.12);
}

/* 已收藏：实心红心，左上高光改为白色 */
.fav-btn--on .fav-heart {
  background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 1024 1024' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M903.71 350.208c-10.823-65.651-47.47-117.512-108.93-154.145-35.295-21.054-75.018-32.187-114.86-32.187-50.882 0-99.14 18.619-135.887 52.429-11.387 10.475-21.796 21.929-31.83 33.075-31.21-38.05-63.1-61.566-100.056-73.884-64.875-21.61-129.477-13.271-188.864 24.404-70.592 44.777-106.096 108.17-105.54 188.434 0.314 47.263 16.053 92.117 48.104 137.098 34.412 48.333 76.751 97.541 133.233 154.868 38.018 38.589 77.401 76.948 115.481 114.07l37.169 36.26c3.313 3.249 6.687 6.444 10.076 9.629l4.201 3.901c7.898 6.584 24.392 17.641 45.993 17.641 17.884 0 34.842-7.332 50.56-21.906 64.632-60.87 133.501-126.994 199.05-198.044 33.94-36.8 72.802-80.07 104.448-128.092 34.276-52.043 46.956-107.075 37.653-163.551z' fill='%23FF453A'/%3E%3Cpath d='M383.521 288.707c-14.65-6.777-30.349-10.192-46.63-10.192-61.502 0-111.547 50.046-111.547 111.534 0 22.06 6.43 43.372 18.578 61.668 3.814 5.722 10.097 8.827 16.494 8.827 3.763 0 7.575-1.07 10.939-3.313 9.103-6.041 11.584-18.334 5.53-27.433-7.829-11.778-11.958-25.525-11.958-39.749 0-39.685 32.276-71.951 71.964-71.951 10.514 0 20.608 2.189 30.029 6.533 9.897 4.613 21.69 0.284 26.26-9.661 4.593-9.923 0.264-21.689-9.659-26.263' fill='%23FFFFFF'/%3E%3C/svg%3E");
}

/* 仅点击收藏时弹跳（favAnimate 由 JS 在切换时置位），进入已收藏页面不播动画 */
.fav-btn--animate .fav-heart {
  animation: fav-heart-pop 0.38s cubic-bezier(0.34, 1.56, 0.64, 1);
}

.fav-btn--animate::after {
  content: '';
  position: absolute;
  inset: 0;
  border-radius: 50%;
  border: 2rpx solid rgba(255, 69, 58, 0.55);
  pointer-events: none;
  animation: fav-ring 0.42s ease-out forwards;
}

@keyframes fav-heart-pop {
  0% { transform: scale(0.6); }
  60% { transform: scale(1.22); }
  100% { transform: scale(1); }
}

@keyframes fav-ring {
  0% { transform: scale(0.72); opacity: 0.75; }
  100% { transform: scale(1.48); opacity: 0; }
}

/* 类型/重点机构徽标 + 地区·成立时间同一行 */
.info-tags {
  display: flex;
  align-items: center;
  gap: 10rpx;
  flex-wrap: wrap;
  margin-bottom: 14rpx;
}

.type-badge {
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 600;
  line-height: 1.3;
  backdrop-filter: blur(20rpx);
  -webkit-backdrop-filter: blur(20rpx);
}

.agency-type--government {
  color: #ffd60a;
  background: rgba(255, 214, 10, 0.18);
  border: 1px solid rgba(255, 214, 10, 0.35);
  box-shadow: 0 0 20rpx rgba(255, 214, 10, 0.2);
}

.agency-type--commercial {
  color: #30d158;
  background: rgba(48, 209, 88, 0.18);
  border: 1px solid rgba(48, 209, 88, 0.35);
  box-shadow: 0 0 20rpx rgba(48, 209, 88, 0.2);
}

.agency-type--multinational {
  color: var(--color-brand);
  background: rgba(59, 130, 246, 0.18);
  border: 1px solid rgba(59, 130, 246, 0.35);
  box-shadow: 0 0 20rpx rgba(59, 130, 246, 0.2);
}

.featured-badge {
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 600;
  line-height: 1.3;
  color: #ff9f0a;
  background: rgba(255, 159, 10, 0.18);
  border: 1px solid rgba(255, 159, 10, 0.35);
  backdrop-filter: blur(20rpx);
  -webkit-backdrop-filter: blur(20rpx);
}

.info-name {
  font-size: 46rpx;
  font-weight: 800;
  color: #ffffff;
  line-height: 1.25;
  letter-spacing: 1rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.info-abbrev {
  font-size: 26rpx;
  color: rgba(142, 189, 255, 0.95);
  margin-top: 6rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
}

/* 元信息：贴在胶囊右侧，纯文字 + 圆点分隔 */
.info-meta {
  display: flex;
  align-items: center;
  gap: 8rpx;
  flex-shrink: 0;
  margin-left: 4rpx;
}

.meta-item {
  font-size: 22rpx;
  color: rgba(235, 235, 245, 0.72);
}

.meta-divider {
  font-size: 22rpx;
  color: rgba(235, 235, 245, 0.4);
}

.partial-banner {
  padding: 28rpx 28rpx 24rpx;
  margin-bottom: 24rpx;
  border-color: rgba(59, 130, 246, 0.18);
  background: linear-gradient(135deg, rgba(59, 130, 246, 0.12), rgba(59, 130, 246, 0.08));
}

.partial-banner__title {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  color: #8ebdff;
  margin-bottom: 10rpx;
}

.partial-banner__desc {
  display: block;
  font-size: 24rpx;
  line-height: 1.7;
  color: rgba(255, 255, 255, 0.72);
}

/* 统计区域 */
.stats-section {
  margin-bottom: 24rpx;
}

/* 发射统计 / 回收统计整块可点：轻按反馈（与 al-card--pressed 同风格） */
.stats-section--pressed {
  opacity: 0.85;
}

/* 板块标题右侧轻量跳转箭头（整块可点提示） */
.section-title-arrow {
  margin-left: auto;
  font-size: 36rpx;
  line-height: 1;
  color: rgba(255, 255, 255, 0.4);
  padding-right: 8rpx;
}

.section-title {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
  color: #ffffff;
  margin-bottom: 20rpx;
  padding: 0 8rpx;
}

/* 标题 + 翻译按钮同行 */
.section-title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.section-title-row .section-title {
  margin-bottom: 0;
}

/* ===== 即将发射 / 历史发射板块 ===== */
.al-title-row {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.al-title-row .section-title {
  margin-bottom: 0;
}

.al-count {
  font-size: 22rpx;
  font-weight: 600;
  color: rgba(255, 255, 255, 0.55);
  background: rgba(255, 255, 255, 0.08);
  border-radius: 999rpx;
  padding: 2rpx 14rpx;
  margin-left: 12rpx;
}

/* 查看全部：灰色纯文字入口（金色仅保留在「我的」页会员区） */
.al-view-all {
  display: flex;
  align-items: center;
  gap: 4rpx;
  font-size: 24rpx;
  font-weight: 500;
  color: var(--color-text-secondary, rgba(255, 255, 255, 0.55));
  padding: 8rpx 4rpx;
  transition: opacity 0.12s ease;
  margin-left: auto;
}

.al-view-all--pressed {
  opacity: 0.6;
}

.al-view-all-arrow {
  font-size: 30rpx;
  line-height: 1;
  color: var(--color-text-tertiary, rgba(255, 255, 255, 0.38));
}

.al-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.al-card {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 20rpx;
  background: rgba(255, 255, 255, 0.05);
  border-radius: 20rpx;
  transition: transform 0.12s ease, opacity 0.12s ease;
}

.al-card--pressed {
  transform: scale(0.98);
  opacity: 0.85;
}

.al-thumb {
  width: 96rpx;
  height: 96rpx;
  border-radius: 16rpx;
  flex-shrink: 0;
  background: rgba(255, 255, 255, 0.06);
}

.al-thumb--placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
}

.al-body {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.al-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #ffffff;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.al-meta {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.55);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.al-status {
  flex-shrink: 0;
  font-size: 20rpx;
  font-weight: 600;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  max-width: 140rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.al-status--success {
  color: #34C759;
  background: rgba(52, 199, 89, 0.14);
}

.al-status--failure {
  color: #FF5A5F;
  background: rgba(255, 90, 95, 0.14);
}

.al-status--neutral {
  color: #FFAA00;
  background: rgba(255, 170, 0, 0.14);
}

.al-arrow {
  flex-shrink: 0;
  font-size: 36rpx;
  color: rgba(255, 255, 255, 0.35);
  line-height: 1;
}

.al-empty {
  padding: 28rpx 20rpx;
  background: rgba(255, 255, 255, 0.04);
  border: 1rpx dashed rgba(255, 255, 255, 0.12);
  border-radius: 20rpx;
  text-align: center;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.45);
}

/* 紧凑布局：一行 4 列，压缩纵向空间 */
.stats-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 12rpx;
}

.stat-card {
  background: var(--bg-glass);
  border-radius: var(--radius-card);
  padding: var(--space-sm) 8rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  position: relative;
  overflow: hidden;
  transition: all 0.3s ease;
}

.stat-card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 4rpx;
  opacity: 0.6;
}

.stat-card--primary::before {
  background: linear-gradient(90deg, var(--color-brand), var(--color-brand));
}

.stat-card--success::before {
  background: linear-gradient(90deg, #30d158, #00c853);
}

.stat-card--warning::before {
  background: linear-gradient(90deg, #ff9f0a, #ff6b00);
}

.stat-card--danger::before {
  background: linear-gradient(90deg, #ff453a, #ff2d55);
}

.stat-value {
  font-size: 38rpx;
  font-weight: 800;
  color: #ffffff;
  line-height: 1.2;
  margin-bottom: 6rpx;
}

.stat-label {
  font-size: 22rpx;
  color: #8e8e93;
  font-weight: 500;
}

.stat-rate {
  font-size: 22rpx;
  color: #30d158;
  margin-top: 4rpx;
  font-weight: 600;
}

/* ========== SpaceX 回收方式统计（自监控中心迁入） ========== */
.recovery-panel {
  padding: 28rpx;
  border-radius: 20rpx;
  border: 1px solid rgba(0, 230, 118, 0.12);
  background: linear-gradient(135deg, rgba(28, 28, 30, 0.9), rgba(0, 230, 118, 0.03));
}

.recovery-layout {
  display: flex;
  align-items: center;
  gap: 28rpx;
}

.recovery-ring-compact {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex-shrink: 0;
}

.recovery-ring-mini {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 0 24rpx rgba(0, 230, 118, 0.15), inset 0 0 12rpx rgba(0, 0, 0, 0.3);
}

.recovery-ring-core {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: #1C1C1E;
  display: flex;
  align-items: center;
  justify-content: center;
}

.recovery-core-num {
  font-size: 36rpx;
  font-weight: 800;
  color: #fff;
  font-variant-numeric: tabular-nums;
}

.recovery-ring-sub {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.4);
  margin-top: 8rpx;
}

.recovery-bars {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.recovery-bar-row {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.recovery-bar-header {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.recovery-bar-indicator {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  box-shadow: 0 0 6rpx currentColor;
}

.recovery-bar-name {
  flex: 1;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.65);
}

.recovery-bar-count {
  font-size: 24rpx;
  font-weight: 700;
  color: #fff;
  font-variant-numeric: tabular-nums;
}

.recovery-bar-track {
  height: 10rpx;
  background: rgba(255, 255, 255, 0.06);
  border-radius: 5rpx;
  overflow: hidden;
}

.recovery-bar-value {
  height: 100%;
  border-radius: 5rpx;
  transition: width 0.8s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  box-shadow: 0 0 8rpx rgba(255, 255, 255, 0.1);
}

.recovery-rate-bar {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 20rpx;
  padding-top: 18rpx;
  border-top: 1px solid rgba(255, 255, 255, 0.06);
}

.recovery-rate-label {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.5);
  flex-shrink: 0;
}

.recovery-rate-track {
  flex: 1;
  height: 12rpx;
  background: rgba(255, 255, 255, 0.06);
  border-radius: 6rpx;
  overflow: hidden;
}

.recovery-rate-fill {
  height: 100%;
  border-radius: 6rpx;
  background: linear-gradient(90deg, #00E676, #448AFF);
  box-shadow: 0 0 12rpx rgba(0, 230, 118, 0.3);
  transition: width 0.8s cubic-bezier(0.25, 0.46, 0.45, 0.94);
}

.recovery-rate-pct {
  font-size: 26rpx;
  font-weight: 700;
  color: #00E676;
  flex-shrink: 0;
  font-variant-numeric: tabular-nums;
}

/* 着陆统计（紧凑布局：单行 flex-wrap，最多 4 项并排） */
.landing-stats {
  background: var(--bg-glass);
  border-radius: var(--radius-card);
  padding: var(--space-sm);
}

.landing-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.landing-item {
  flex: 1 1 140rpx;
  min-width: 0;
  text-align: center;
  padding: 12rpx 8rpx;
  background: rgba(255, 255, 255, 0.04);
  border-radius: 16rpx;
  border: 1px solid rgba(255, 255, 255, 0.06);
}

.landing-label {
  display: block;
  font-size: 22rpx;
  color: #8e8e93;
  margin-bottom: 4rpx;
}

.landing-value {
  display: block;
  font-size: 30rpx;
  font-weight: 700;
  color: #ffffff;
  margin-bottom: 4rpx;
}

.landing-rate {
  display: block;
  font-size: 22rpx;
  color: #30d158;
  font-weight: 600;
}

/* 信息区域 */
.info-section,
.desc-section,
.vehicles-section,
.social-section {
  padding: 32rpx 28rpx;
  margin-bottom: 24rpx;
}

/* 机构信息：两列整齐网格（对齐型号档案「技术规格」） */
.info-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 14rpx;
}

.info-row {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 4rpx;
  box-sizing: border-box;
  min-width: 0;
  padding: 14rpx 18rpx;
  border-radius: 10rpx;
  background: rgba(255, 255, 255, 0.04);
  border: 1px solid rgba(255, 255, 255, 0.08);
}

.info-label {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.4);
  font-weight: 400;
}

.info-value {
  font-size: 26rpx;
  color: #ffffff;
  text-align: left;
  line-height: 1.35;
  font-weight: 600;
  word-break: break-word;
}

/* 简介 */
.desc-text {
  font-size: 28rpx;
  line-height: 1.8;
  color: #d1d1d6;
  white-space: pre-wrap;
}

/* 运载工具标签 */
.tag-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.vehicle-tag {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx 24rpx;
  border-radius: 999rpx;
  font-size: 26rpx;
  font-weight: 500;
  transition: all 0.2s ease;
}

/* 可跳转标签：加箭头提示，按压反馈 */
.vehicle-tag--link:active {
  transform: scale(0.96);
  opacity: 0.8;
}

.vehicle-tag-arrow {
  font-size: 28rpx;
  font-weight: 600;
  opacity: 0.7;
  line-height: 1;
}

.vehicle-tag--rocket {
  color: var(--color-brand);
  background: rgba(59, 130, 246, 0.15);
  border: 1px solid rgba(59, 130, 246, 0.3);
}

.vehicle-tag--spacecraft {
  color: var(--color-text-secondary);
  background: rgba(255, 255, 255, 0.08);
  border: 1px solid rgba(255, 255, 255, 0.14);
}

/* 社交媒体：一排 6 个 logo，自动换行并整体居中 */
.social-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  align-items: center;
  /* 5 个间距 × 20rpx = 100rpx，保证满行正好 6 格 */
  column-gap: 20rpx;
  row-gap: 28rpx;
}

.social-item {
  flex: 0 0 calc((100% - 100rpx) / 6);
  width: calc((100% - 100rpx) / 6);
  max-width: calc((100% - 100rpx) / 6);
  aspect-ratio: 1;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
  background: transparent;
  border: none;
  border-radius: 50%;
  transition: transform 0.15s ease, opacity 0.15s ease;
}

.social-item--pressed {
  transform: scale(0.92);
  opacity: 0.85;
}

.social-logo {
  width: 88%;
  height: 88%;
  border-radius: 50%;
  display: block;
}

/* ========== SpaceX 专属：手机直连星链 D2C（自监控中心迁入） ========== */
.d2c-overview {
  padding: 28rpx;
  border-radius: 20rpx;
  margin-bottom: 20rpx;
}

.d2c-stat-row {
  display: flex;
  justify-content: space-around;
  margin-bottom: 24rpx;
}

.d2c-stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.d2c-stat-value {
  font-size: 40rpx;
  font-weight: 700;
  color: #fff;
}

.d2c-stat-value.accent {
  color: var(--color-brand);
}

.d2c-stat-label {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.5);
  margin-top: 4rpx;
}

.d2c-bar-wrapper {
  margin-top: 8rpx;
}

.d2c-bar-bg {
  height: 16rpx;
  background: rgba(255, 255, 255, 0.1);
  border-radius: 8rpx;
  overflow: hidden;
}

.d2c-bar-fill {
  height: 100%;
  background: linear-gradient(90deg, var(--color-brand), var(--color-brand));
  border-radius: 8rpx;
  transition: width 0.6s ease;
}

.d2c-bar-legend {
  display: flex;
  gap: 24rpx;
  margin-top: 12rpx;
}

.d2c-legend-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.6);
}

.d2c-legend-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
}

.d2c-legend-dot.d2c-color {
  background: var(--color-brand);
}

.d2c-legend-dot.normal-color {
  background: rgba(255, 255, 255, 0.2);
}

.d2c-recent-section {
  margin-top: 20rpx;
}

.d2c-recent-toggle {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 24rpx;
  background: rgba(255, 255, 255, 0.04);
  border-radius: 14rpx;
  margin-bottom: 12rpx;
}

.d2c-recent-toggle-text {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.6);
  font-weight: 500;
}

.icon-arrow--d2c-toggle {
  font-size: 30rpx;
  color: rgba(255, 255, 255, 0.4);
  transition: transform 0.3s ease;
  transform: rotate(0deg);
}

.icon-arrow--d2c-toggle.expanded {
  transform: rotate(90deg);
}

.d2c-recent {
  padding: 24rpx;
  border-radius: 20rpx;
}

.d2c-mission-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 12rpx 0;
  border-bottom: 1px solid rgba(255, 255, 255, 0.06);
}

.d2c-mission-item:last-child {
  border-bottom: none;
}

.d2c-mission-img {
  width: 72rpx;
  height: 72rpx;
  border-radius: 12rpx;
  flex-shrink: 0;
  object-fit: cover;
}

.d2c-mission-placeholder {
  width: 72rpx;
  height: 72rpx;
  border-radius: 12rpx;
  flex-shrink: 0;
  background: rgba(255, 255, 255, 0.06);
  display: flex;
  align-items: center;
  justify-content: center;
}

.d2c-mission-placeholder-icon {
  font-size: 32rpx;
}

.d2c-mission-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.d2c-mission-name {
  font-size: 26rpx;
  color: #fff;
  font-weight: 500;
}

.d2c-mission-date {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.4);
  margin-top: 4rpx;
}

/* ========== 明亮主题（theme-light）覆盖 ========== */
.detail-page.theme-light {
  background: var(--color-bg-page);
