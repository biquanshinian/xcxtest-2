.pass-actions {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.MARS-preview-section {
  margin-bottom: var(--space-xl);
}

.MARS-preview-card {
  padding: 0;
  overflow: hidden;
}

.preview-card-content {
  display: flex;
  align-items: center;
  padding: var(--space-lg) var(--space-xl);
  gap: var(--space-lg);
}

.preview-card-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: var(--space-2xs);
}

.preview-card-title {
  font-size: var(--font-size-lg);
  font-weight: var(--font-weight-semibold);
  color: var(--color-text-primary);
}

.preview-card-desc {
  font-size: 24rpx;
  color: var(--color-text-secondary);
}

.MARS-preview-section > .monitor-livestream-section {
  margin-top: var(--space-lg);
}

.starlink-section {
  padding: 0 var(--space-lg);
  margin-bottom: var(--space-xl);
}

.starlink-card {
  padding: 0;
  overflow: hidden;
  border-radius: var(--radius-card);
  background: linear-gradient(135deg, var(--color-bg-card), rgba(52, 199, 89, 0.03));
}

.starlink-loading {
  height: 420rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
}

.starlink-loading-orbit {
  position: relative;
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  border: 2rpx solid rgba(52, 199, 89, 0.25);
  box-sizing: border-box;
  animation: starlinkOrbitSpin 1.2s linear infinite;
}

.starlink-loading-orbit::before {
  content: '';
  position: absolute;
  top: -6rpx;
  left: 50%;
  margin-left: -5rpx;
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: var(--color-success);
  box-shadow: 0 0 12rpx rgba(52, 199, 89, 0.55);
}

.starlink-loading-text {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.5);
}

.starlink-error {
  height: 420rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 20rpx;
}

.starlink-error-text {
  font-size: 26rpx;
  color: rgba(255, 100, 100, 0.8);
}

.starlink-retry-btn {
  font-size: 24rpx;
  color: var(--color-success);
  padding: 10rpx 32rpx;
  border: 1px solid rgba(52, 199, 89, 0.35);
  border-radius: var(--radius-pill);
}

.starlink-canvas-wrap {
  position: relative;
  width: 100%;
}

.starlink-hud-corners {
  position: absolute;
  left: 12rpx;
  right: 12rpx;
  height: 24rpx;
  pointer-events: none;
  z-index: 2;
}

.starlink-hud-corners--top {
  top: 12rpx;
}

.starlink-hud-corners--bottom {
  bottom: 12rpx;
}

.starlink-hud-corners::before,
.starlink-hud-corners::after {
  content: '';
  position: absolute;
  top: 0;
  width: 24rpx;
  height: 24rpx;
  box-sizing: border-box;
}

.starlink-hud-corners--top::before {
  left: 0;
  border-top: 2rpx solid rgba(52, 199, 89, 0.45);
  border-left: 2rpx solid rgba(52, 199, 89, 0.45);
}

.starlink-hud-corners--top::after {
  right: 0;
  border-top: 2rpx solid rgba(52, 199, 89, 0.45);
  border-right: 2rpx solid rgba(52, 199, 89, 0.45);
}

.starlink-hud-corners--bottom::before {
  left: 0;
  border-bottom: 2rpx solid rgba(52, 199, 89, 0.45);
  border-left: 2rpx solid rgba(52, 199, 89, 0.45);
}

.starlink-hud-corners--bottom::after {
  right: 0;
  border-bottom: 2rpx solid rgba(52, 199, 89, 0.45);
  border-right: 2rpx solid rgba(52, 199, 89, 0.45);
}

.starlink-canvas {
  width: 100%;
  height: 420rpx;
  display: block;
}

.starlink-ctrl-bar {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 12rpx 16rpx;
  background: linear-gradient(to top, rgba(0, 0, 0, 0.7) 0%, rgba(0, 0, 0, 0) 100%);
}

.starlink-ctrl-btn {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(52, 199, 89, 0.14);
  border: 1px solid rgba(52, 199, 89, 0.3);
  border-radius: 50%;
}

.ctrl-icon-play {
  width: 0;
  height: 0;
  border-style: solid;
  border-width: 9rpx 0 9rpx 15rpx;
  border-color: transparent transparent transparent var(--color-success);
  margin-left: 4rpx;
}

.ctrl-icon-pause {
  display: flex;
  gap: 6rpx;
}

.ctrl-icon-pause::before,
.ctrl-icon-pause::after {
  content: '';
  display: block;
  width: 5rpx;
  height: 18rpx;
  border-radius: 3rpx;
  background: var(--color-success);
}

.starlink-ctrl-info {
  font-size: 22rpx;
  font-family: 'Courier New', Consolas, monospace;
  letter-spacing: 1rpx;
  color: rgba(255, 255, 255, 0.5);
}

.starlink-expand-hint {
  position: absolute;
  top: 16rpx;
  right: 16rpx;
  padding: 6rpx 16rpx;
  background: rgba(0, 0, 0, 0.5);
  border-radius: var(--radius-sm);
  border: 1px solid rgba(52, 199, 89, 0.35);
  display: flex;
  align-items: center;
  justify-content: center;
}

.starlink-expand-text {
  font-size: 20rpx;
  color: rgba(52, 199, 89, 0.9);
  line-height: 1;
}

.pass-section {
  padding: 0 var(--space-lg);
  margin-bottom: var(--space-xl);
}

.pass-hero-card {
  position: relative;
  overflow: hidden;
  padding: var(--space-lg) var(--space-lg) var(--space-md);
  border-radius: var(--radius-lg);
  background: var(--color-divider-faint);
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.pass-hero-trail {
  position: absolute;
  height: 1.5rpx;
  border-radius: 2rpx;
  background: linear-gradient(90deg, transparent 0%, rgba(255, 255, 255, 0.6) 40%, rgba(255, 255, 255, 0.9) 60%, transparent 100%);
  opacity: 0;
  pointer-events: none;
}

.pass-hero-trail--1 {
  top: 30%;
  left: -60%;
  width: 35%;
  animation: passTrailFlash 8s ease-in-out infinite;
  animation-delay: 2s;
}

.pass-hero-trail--2 {
  top: 62%;
  left: -50%;
  width: 25%;
  animation: passTrailFlash 12s ease-in-out infinite;
  animation-delay: 6s;
  height: 1rpx;
}

.pass-hero-trail--3 {
  display: none;
}

.pass-hero-card-body {
  flex: 1;
  min-width: 0;
  position: relative;
  z-index: 1;
}

.pass-hero-card-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  margin-bottom: 20rpx;
}

.pass-hero-card-info {
  flex: 1;
  min-width: 0;
}

.pass-hero-card-title {
  display: block;
  font-size: 34rpx;
  font-weight: 700;
  color: #fff;
  margin-bottom: 8rpx;
}

.pass-hero-card-loc {
  display: block;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.4);
}

.pass-hero-card-btns {
  display: flex;
  gap: 14rpx;
  flex-shrink: 0;
}

.pass-hero-chip {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 96rpx;
  height: 56rpx;
  padding: 0 22rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.06);
  border: 1px solid rgba(255, 255, 255, 0.12);
}

.pass-hero-chip text {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
  font-weight: 500;
  line-height: 1;
}

.pass-hero-chip--pro {
  border-color: rgba(255, 214, 10, 0.25);
  background: rgba(255, 214, 10, 0.06);
}

.pass-hero-chip--pro text {
  color: #FFD60A;
}

.pass-hero-card-bottom {
  position: relative;
  z-index: 1;
}

.pass-hero-card-next {
  display: inline;
  font-size: 28rpx;
  font-weight: 600;
  color: #fff;
  margin-right: 12rpx;
}

.pass-hero-card-meta {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.45);
}

.pass-hero-card-arrow {
  font-size: 44rpx;
  color: rgba(255, 255, 255, 0.2);
  line-height: 1;
  flex-shrink: 0;
  position: relative;
  z-index: 1;
}

.pass-refresh-chip {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 80rpx;
  height: 48rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.08);
  border: 1px solid rgba(255, 255, 255, 0.12);
}

.pass-refresh-chip text {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.5);
  line-height: 1;
}

.pass-location {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 24rpx;
  border-radius: 16rpx;
  margin-bottom: 16rpx;
}

.pass-time {
  font-size: 36rpx;
  font-weight: 700;
  color: #fff;
  font-variant-numeric: tabular-nums;
}

.pass-loading, .pass-empty {
  padding: 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border-radius: 20rpx;
  gap: 12rpx;
}

.pass-location-icon {
  width: 56rpx;
  height: 56rpx;
}

.theme-light .pass-location-icon {
  filter: invert(0.72);
}

.pass-locate-btn {
  margin-top: 12rpx;
  padding: 12rpx 32rpx;
  border-radius: var(--radius-pill);
  background: var(--color-brand-soft);
  border: 1px solid rgba(59, 130, 246, 0.3);
  display: flex;
  align-items: center;
  justify-content: center;
}

.pass-locate-btn text {
  font-size: 26rpx;
  color: var(--color-brand);
  font-weight: 500;
}

.station-section {
  padding: 0 var(--space-lg);
  margin-bottom: var(--space-xl);
}

.station-loading {
  display: flex;
  justify-content: center;
  padding: 40rpx 0;
}

.station-loading-text {
  font-size: 24rpx;
  color: #636366;
}

.station-row {
  display: flex;
  gap: var(--space-sm);
}

.station-mini-card {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: var(--space-sm) var(--space-xs) var(--space-sm);
  border-radius: var(--radius-card);
  background: var(--color-bg-card);
  backdrop-filter: blur(20rpx);
  -webkit-backdrop-filter: blur(20rpx);
  transition: all 0.25s ease;
  position: relative;
  overflow: hidden;
}

.station-mini-card:active {
  transform: scale(0.97);
}

.station-mini-img {
  width: 100%;
  height: 187rpx; 
  border-radius: 12rpx;
  background: rgba(255, 255, 255, 0.04);
  margin-bottom: 12rpx;
  opacity: 0;
  transform: scale(1.02);
  transition: opacity 0.32s ease, transform 0.32s ease;
}

.station-mini-img--loaded {
  opacity: 1;
  transform: scale(1);
}

.station-mini-img--placeholder {
  background: radial-gradient(circle at center, rgba(90, 200, 250, 0.10), rgba(255, 255, 255, 0.03) 72%);
  box-shadow: inset 0 0 18rpx rgba(90, 200, 250, 0.05);
  position: relative;
}

.station-mini-img--placeholder::after {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  width: 44rpx;
  height: 44rpx;
  transform: translate(-50%, -50%);
  border-radius: 50%;
  border: 2rpx solid rgba(90, 200, 250, 0.22);
  box-shadow: 0 0 16rpx rgba(90, 200, 250, 0.08);
}

.station-mini-body {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.station-mini-name {
  font-size: 26rpx;
  font-weight: 600;
  color: #FFFFFF;
  text-align: center;
  display: block;
  width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.station-mini-tags {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-top: 8rpx;
  flex-wrap: wrap;
  justify-content: center;
}

.station-mini-dock {
  font-size: 20rpx;
  color: #8E8E93;
}

.station-mini-arrow {
  position: absolute;
  top: 10rpx;
  right: 10rpx;
  width: 36rpx;
  height: 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: #636366;
  transition: transform 0.25s ease;
}

.station-tag {
  font-size: 20rpx;
  padding: 2rpx 12rpx;
  border-radius: 6rpx;
  font-weight: 500;
}

.station-tag--active {
  color: #34C759;
  background: rgba(52, 199, 89, 0.15);
  border: 1px solid rgba(52, 199, 89, 0.3);
}

.station-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 0;
}

.station-empty-visual {
  width: 120rpx;
  height: 120rpx;
  margin-bottom: 18rpx;
  border-radius: 28rpx;
  background: radial-gradient(circle at 35% 35%, rgba(90, 200, 250, 0.22), rgba(90, 200, 250, 0.06) 32%, rgba(255, 255, 255, 0.03) 72%);
  border: 1px solid rgba(90, 200, 250, 0.16);
  box-shadow: inset 0 0 32rpx rgba(90, 200, 250, 0.08), 0 0 32rpx rgba(90, 200, 250, 0.08);
  position: relative;
}

.station-empty-visual::after {
  content: '';
  position: absolute;
  inset: 26rpx;
  border-radius: 50%;
  border: 2rpx solid rgba(90, 200, 250, 0.3);
  box-shadow: 0 0 16rpx rgba(90, 200, 250, 0.1);
}

.theme-light .preview-card-title {
  color: var(--color-text-primary);
}

.theme-light .preview-card-desc {
  color: var(--color-text-secondary);
}

.theme-light .pass-hero-card {
  background: var(--color-bg-card);
}

.theme-light .pass-hero-trail {
  background: linear-gradient(90deg, transparent 0%, rgba(0, 0, 0, 0.14) 40%, rgba(0, 0, 0, 0.24) 60%, transparent 100%);
}

.theme-light .pass-hero-card-title {
  color: var(--color-text-primary);
}

.theme-light .pass-hero-card-loc {
  color: var(--color-text-tertiary);
}

.theme-light .pass-hero-chip {
  background: rgba(0, 0, 0, 0.05);
  border: 1px solid var(--color-divider);
}

.theme-light .pass-hero-chip text {
  color: var(--color-text-secondary);
}

.theme-light .pass-hero-chip--pro {
  border-color: rgba(255, 214, 10, 0.35);
  background: rgba(255, 214, 10, 0.12);
}

.theme-light .pass-hero-card-next {
  color: var(--color-text-primary);
}

.theme-light .pass-hero-card-meta {
  color: var(--color-text-tertiary);
}

.theme-light .pass-hero-card-arrow {
  color: rgba(0, 0, 0, 0.2);
}

.theme-light .pass-refresh-chip {
  background: rgba(0, 0, 0, 0.05);
  border: 1px solid var(--color-divider);
}

.theme-light .pass-refresh-chip text {
  color: var(--color-text-secondary);
}

.theme-light .pass-time {
  color: var(--color-text-primary);
}

.theme-light .station-loading-text {
  color: var(--color-text-secondary);
}

.theme-light .station-mini-card {
  background: var(--color-bg-card);
}

.theme-light .station-mini-img {
  background: rgba(0, 0, 0, 0.05);
}

.theme-light .station-mini-img--placeholder {
  background: radial-gradient(circle at center, rgba(90, 200, 250, 0.14), rgba(0, 0, 0, 0.04) 72%);
  box-shadow: inset 0 0 18rpx rgba(90, 200, 250, 0.06);
}

.theme-light .station-mini-name {
  color: var(--color-text-primary);
}

.theme-light .station-mini-dock {
  color: var(--color-text-secondary);
}

.theme-light .station-mini-arrow {
  color: var(--color-text-tertiary);
}

.theme-light .station-empty-visual {
  background: radial-gradient(circle at 35% 35%, rgba(90, 200, 250, 0.2), rgba(90, 200, 250, 0.06) 32%, rgba(0, 0, 0, 0.03) 72%);
  box-shadow: inset 0 0 32rpx rgba(90, 200, 250, 0.08), 0 0 24rpx rgba(90, 200, 250, 0.06);
}
