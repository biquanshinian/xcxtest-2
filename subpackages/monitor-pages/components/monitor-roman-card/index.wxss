@import "../../../../styles/monitor-block.wxss";

/* 根节点挂 themeClass；标题显式用变量着色。
   宿主页 .section-title 常写死 #fff，且页面 .theme-light 后代选不进组件，
   不在这里着色会浅色白底上仍是近白字。 */
.roman-card-root {
  overflow: hidden;
  color: var(--color-text-primary);
}

.roman-card-root .roman-card-title,
.roman-card-root .roman-card-title text {
  color: var(--color-text-primary);
}

.theme-light.roman-card-root .roman-card-title,
.theme-light.roman-card-root .roman-card-title text {
  color: var(--color-text-primary);
}

.roman-card-title {
  display: flex;
  align-items: baseline;
  flex-wrap: wrap;
  gap: 12rpx 16rpx;
  margin-bottom: var(--space-sm);
  min-height: 56rpx;
  box-sizing: border-box;
}

.roman-hero {
  position: relative;
  margin-top: 0;
  padding: var(--space-lg) var(--space-md) var(--space-md);
  border-radius: var(--radius-lg);
  background: #0B0C0E;
  overflow: hidden;
  box-shadow: none;
}

.roman-hero__probe {
  position: absolute;
  left: -16rpx;
  top: -16rpx;
  width: 8rpx;
  height: 8rpx;
  overflow: hidden;
  opacity: 0;
  pointer-events: none;
}

.roman-hero__bg {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
  pointer-events: none;
  opacity: 0.55;
}

.roman-hero__mask {
  position: absolute;
  inset: 0;
  z-index: 0;
  pointer-events: none;
  background:
    linear-gradient(135deg,
      rgba(0, 0, 0, 0.78) 0%,
      rgba(0, 0, 0, 0.5) 50%,
      rgba(0, 0, 0, 0.85) 100%);
}

/* 右上角：地球（蓝）· 罗曼转移圈（证书紫）· L2 晕轨道（金） */
.roman-hero__viz {
  position: absolute;
  top: -40rpx;
  right: -40rpx;
  width: 280rpx;
  height: 280rpx;
  pointer-events: none;
  z-index: 0;
}

.roman-viz__earth {
  position: absolute;
  left: 34rpx;
  top: 168rpx;
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: radial-gradient(circle at 32% 28%, #E0F2FE 0%, #60A5FA 40%, #1D4ED8 78%, #172554 100%);
  box-shadow: 0 0 8rpx rgba(96, 165, 250, 0.7);
  animation: roman-orb-glow 2.8s ease-in-out infinite;
}

.roman-viz__cruise {
  position: absolute;
  left: 18rpx;
  top: 46rpx;
  width: 192rpx;
  height: 192rpx;
  border-radius: 50%;
  border: 1rpx solid rgba(181, 122, 201, 0.55);
  animation: roman-viz-spin 16s linear infinite;
}

.roman-viz__craft-hold {
  position: absolute;
  top: 0;
  left: 50%;
  width: 0;
  height: 0;
}

.roman-viz__craft-fix {
  position: absolute;
  left: -18rpx;
  top: -10rpx;
  width: 36rpx;
  height: 20rpx;
  animation: roman-viz-spin 16s linear infinite reverse;
}

.roman-viz__craft-glow {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 14rpx;
  height: 14rpx;
  margin: -7rpx 0 0 -7rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(201, 154, 224, 0.8) 0%, transparent 72%);
}

.roman-viz__craft {
  position: relative;
  width: 36rpx;
  height: 20rpx;
  display: block;
}

.roman-viz__l2-wrap {
  position: absolute;
  left: 116rpx;
  top: 84rpx;
  width: 96rpx;
  height: 96rpx;
}

.roman-viz__l2 {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 12rpx;
  height: 12rpx;
  margin: -6rpx 0 0 -6rpx;
  border-radius: 50%;
  background: radial-gradient(circle at 32% 28%, #FFF6C2 0%, #FFD60A 42%, #B8860B 80%, #713F12 100%);
  box-shadow: 0 0 8rpx rgba(255, 214, 10, 0.7);
  animation: roman-orb-glow 2.8s ease-in-out infinite 0.6s;
}

.roman-viz__halo-tilt {
  position: absolute;
  inset: 0;
  transform: rotate(-30deg) scaleX(1.58);
}

.roman-viz__halo {
  width: 100%;
  height: 100%;
  border-radius: 50%;
  border: 1rpx solid rgba(255, 214, 10, 0.4);
}

.roman-viz__halo--outer {
  position: absolute;
  left: -16%;
  top: -16%;
  width: 132%;
  height: 132%;
  border-color: rgba(255, 214, 10, 0.16);
}

.roman-viz__orb {
  position: absolute;
  left: 50%;
  top: 50%;
  border-radius: 50%;
}

.roman-viz__orb--halo {
  width: 12rpx;
  height: 12rpx;
  background: radial-gradient(circle at 32% 28%, #FFF6C2 0%, #FFD60A 42%, #B8860B 100%);
  box-shadow: 0 0 7rpx rgba(255, 214, 10, 0.65);
  animation: roman-halo-ride 22s linear infinite reverse;
}

.roman-hero__viz--ended {
  opacity: 0.55;
}

@keyframes roman-viz-spin {
  to { transform: rotate(360deg); }
}

@keyframes roman-orb-glow {
  0%, 100% { opacity: 1; }
  50%      { opacity: 0.62; }
}

/* 椭圆路径上保持正圆：先走椭圆，再反缩放，避免跟着 halo 被压扁 */
@keyframes roman-halo-ride {
  from {
    transform: rotate(-30deg) scaleX(1.58) rotate(0deg) translateX(48rpx) rotate(0deg) scaleX(0.633) rotate(30deg) translate(-6rpx, -6rpx);
  }
  to {
    transform: rotate(-30deg) scaleX(1.58) rotate(360deg) translateX(48rpx) rotate(-360deg) scaleX(0.633) rotate(30deg) translate(-6rpx, -6rpx);
  }
}

.roman-hero__content {
  position: relative;
  z-index: 1;
}

.roman-hero__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.roman-hero__badge {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 6rpx 12rpx;
  border-radius: 100rpx;
  background: rgba(255, 255, 255, 0.06);
  border: 1rpx solid rgba(255, 255, 255, 0.18);
}

.roman-hero__badge-dot {
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: #FFFFFF;
  box-shadow: 0 0 8rpx rgba(255, 255, 255, 0.6);
  animation: roman-hero-blink 1.4s ease-in-out infinite;
}

.roman-hero__badge-dot--live {
  background: #34D399;
  box-shadow: 0 0 8rpx #34D399;
}

@keyframes roman-hero-blink {
  0%, 100% { opacity: 1; }
  50%      { opacity: 0.35; }
}

.roman-hero__badge-text {
  font-size: 18rpx;
  letter-spacing: 1.4rpx;
  color: rgba(255, 255, 255, 0.85);
  font-weight: 600;
  font-family: 'SF Mono', Menlo, Consolas, monospace;
}

.roman-hero__title {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
  letter-spacing: 0.6rpx;
  color: #FFFFFF;
}

.roman-hero__title-cn {
  display: block;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.65);
  letter-spacing: 1rpx;
  margin-top: 4rpx;
}

.roman-hero__desc {
  display: block;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.45);
  line-height: 1.6;
  margin-top: 16rpx;
  letter-spacing: 0.4rpx;
}

.roman-hero__metrics {
  display: flex;
  align-items: center;
  margin-top: 24rpx;
  padding: 18rpx 0;
  border-top: 1rpx solid rgba(255, 255, 255, 0.08);
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.08);
}

.roman-hero__metric {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
}

.roman-hero__metric-value {
  font-size: 22rpx;
  font-weight: 700;
  color: #FFFFFF;
  font-family: 'SF Mono', Menlo, Consolas, monospace;
  letter-spacing: 0.2rpx;
  font-variant-numeric: tabular-nums;
  max-width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.roman-hero__metric-label {
  font-size: 18rpx;
  color: rgba(255, 255, 255, 0.4);
  letter-spacing: 0.6rpx;
}

.roman-hero__metric-divider {
  width: 1rpx;
  height: 32rpx;
  flex-shrink: 0;
  background: linear-gradient(180deg,
    transparent 0%,
    rgba(255, 255, 255, 0.16) 50%,
    transparent 100%);
}

.roman-hero__progress {
  margin-top: 18rpx;
}

.roman-hero__progress-head {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.55);
  margin-bottom: 4rpx;
}

.roman-hero__progress-pct {
  color: #FFFFFF;
  font-variant-numeric: tabular-nums;
  font-family: 'SF Mono', Menlo, Consolas, monospace;
}

.roman-hero__progress-rail {
  position: relative;
  height: 72rpx;
  margin: 0 48rpx;
}

.roman-hero__progress-track {
  position: absolute;
  left: 0;
  right: 0;
  top: 50%;
  height: 8rpx;
  margin-top: -4rpx;
  overflow: hidden;
  border-radius: 8rpx;
  background: rgba(255, 255, 255, 0.12);
}

.roman-hero__progress-fill {
  position: relative;
  height: 100%;
  border-radius: 8rpx;
  overflow: hidden;
  background: linear-gradient(90deg, #3B82F6 0%, #6A3D9A 48%, #FFD60A 100%);
}

.roman-hero__progress-pulse {
  position: absolute;
  top: 0;
  bottom: 0;
  left: -46%;
  width: 46%;
  background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.55), transparent);
  animation: roman-progress-shimmer 1.8s ease-in-out infinite;
}

.roman-hero__progress-beat {
  position: absolute;
  top: 50%;
  width: 18rpx;
  height: 18rpx;
  margin-left: -9rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.55);
  box-shadow: 0 0 12rpx rgba(181, 122, 201, 0.75);
  animation: roman-progress-beat 1.5s ease-in-out infinite;
  z-index: 1;
  pointer-events: none;
}

.roman-hero__progress-craft {
  position: absolute;
  top: 50%;
  width: 96rpx;
  height: 62rpx;
  transform: translate(-50%, -50%);
  z-index: 2;
  pointer-events: none;
}

.roman-hero__progress-craft-img {
  width: 96rpx;
  height: 62rpx;
  display: block;
}

@keyframes roman-progress-shimmer {
  0%   { transform: translateX(0); }
  100% { transform: translateX(320%); }
}

@keyframes roman-progress-beat {
  0%, 100% { transform: translateY(-50%) scale(0.7); opacity: 0.4; }
  50%      { transform: translateY(-50%) scale(1.35); opacity: 1; }
}

.roman-hero__dsn {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  margin-top: 14rpx;
}

.roman-hero__dsn-dot {
  width: 12rpx;
  height: 12rpx;
  margin-top: 8rpx;
  border-radius: 50%;
  flex-shrink: 0;
  background: #34D399;
  box-shadow: 0 0 8rpx rgba(52, 211, 153, 0.45);
}

.roman-hero__dsn-text {
  flex: 1;
  min-width: 0;
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.55);
  line-height: 1.5;
}

.roman-hero__retry {
  margin-top: 16rpx;
  display: inline-flex;
  padding: 10rpx 28rpx;
  border-radius: 12rpx;
  background: rgba(106, 61, 154, 0.72);
  font-size: 24rpx;
  color: #ffffff;
}

.roman-hero__cta {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 18rpx;
  padding: 16rpx 18rpx;
  border-radius: 12rpx;
  background: rgba(255, 255, 255, 0.04);
  border: 1rpx solid rgba(255, 255, 255, 0.12);
}

.roman-hero__cta-text {
  font-size: 26rpx;
  font-weight: 600;
  color: #FFFFFF;
  letter-spacing: 0.8rpx;
}

.roman-hero__cta-arrow {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.85);
  font-weight: 700;
  animation: roman-hero-arrow 1.8s ease-in-out infinite;
}

@keyframes roman-hero-arrow {
  0%, 100% { transform: translateX(0); }
  50%      { transform: translateX(6rpx); }
}

/* NASA Adopt a Pixel：证书罗曼紫 + 像素格 / 半调网点 */
.roman-adopt {
  position: relative;
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: var(--space-sm);
  padding: 20rpx 18rpx 20rpx 16rpx;
  border-radius: var(--radius-md);
  overflow: hidden;
  background-color: #6A3D9A;
  background-image: radial-gradient(circle, rgba(255, 255, 255, 0.08) 1.2rpx, transparent 1.8rpx);
  background-size: 12rpx 12rpx;
  box-shadow: 0 8rpx 22rpx rgba(106, 61, 154, 0.42);
}

.roman-adopt__strip {
  display: grid;
  grid-template-columns: repeat(6, 12rpx);
  grid-template-rows: repeat(6, 12rpx);
  gap: 5rpx;
  flex-shrink: 0;
}

.roman-adopt__px {
  width: 12rpx;
  height: 12rpx;
  border-radius: 2rpx;
  background: rgba(255, 255, 255, 0.28);
}

.roman-adopt__px--on {
  background: #FFFFFF;
  box-shadow: 0 0 8rpx rgba(255, 255, 255, 0.55);
}

.roman-adopt__copy {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.roman-adopt__title {
  font-size: 28rpx;
  font-weight: 800;
  letter-spacing: 1.2rpx;
  color: #FFFFFF;
}

.roman-adopt__sub {
  font-size: 18rpx;
  font-weight: 600;
  letter-spacing: 0.1em;
  color: rgba(255, 255, 255, 0.72);
}

.roman-adopt__go {
  flex-shrink: 0;
  font-size: 22rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
  color: #FFFFFF;
  padding: 8rpx 16rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.55);
  border-radius: 8rpx;
}

.roman-adopt__corner {
  position: absolute;
  right: 10rpx;
  bottom: 8rpx;
  display: grid;
  grid-template-columns: 8rpx 8rpx;
  grid-template-rows: 8rpx 8rpx;
  gap: 3rpx;
  opacity: 0.55;
  pointer-events: none;
}

.roman-adopt__corner .roman-adopt__px:nth-child(1) {
  grid-column: 1;
  grid-row: 2;
}

.roman-adopt__corner .roman-adopt__px:nth-child(2) {
  grid-column: 2;
  grid-row: 2;
}

.roman-adopt__corner .roman-adopt__px:nth-child(3) {
  grid-column: 2;
  grid-row: 1;
}

.theme-light.roman-card-root .roman-adopt {
  background-color: #6A3D9A;
  box-shadow: 0 8rpx 20rpx rgba(106, 61, 154, 0.28);
}

.theme-light.roman-card-root .roman-adopt__title,
.theme-light.roman-card-root .roman-adopt__go {
  color: #FFFFFF;
}
