@import "../../../../styles/monitor-block.wxss";
/* 从 pages/monitor/monitor.wxss 拆出；共享基类与 theme-light 覆盖仍在页面 wxss，
   经 styleIsolation: apply-shared 作用进组件。
   组件 wxss 会盖过页面 apply-shared，故须自行引入 .monitor-block
   （数值唯一来源：styles/monitor-block.wxss）。 */

/* ========== 即将进行的在轨任务（事件流，可点击跳详情） ========== */

/* 根节点挂 themeClass；显式用变量着色，避免继承 page 深色态算死的近白字 */
.orbit-section {
  color: var(--color-text-primary);
}

/* 未加载占位：与监控页「发射通告地图」入口卡同高（由 lazy-load-card 内边距决定） */
.orbit-lazy-host {
  display: block;
  box-sizing: border-box;
}

/* 点击懒加载卡之后的 loading 提示（样式原先只在 core-sections，本组件拿不到） */
.station-loading {
  display: flex;
  justify-content: center;
  padding: 40rpx 0;
}

.station-loading-text {
  font-size: 24rpx;
  color: var(--color-text-secondary);
}

.orbit-card--clickable {
  position: relative;
  transition: transform 0.15s ease, box-shadow 0.15s ease;
}

.orbit-card--clickable:active {
  transform: scale(0.98);
}

.orbit-card-meta--top {
  margin-bottom: 6rpx;
}

.orbit-meta-tag--type {
  color: var(--color-brand);
  background: rgba(59, 130, 246, 0.15);
  font-weight: 600;
  letter-spacing: 1rpx;
  text-transform: uppercase;
}

.orbit-meta-tag--date {
  color: rgba(255, 255, 255, 0.85);
}

.orbit-meta-tag--location {
  color: #fff;
  background: rgba(59, 130, 246, 0.45);
}

.orbit-stat--countdown .orbit-stat-value {
  color: #34C759;
  font-size: 26rpx;
}

.orbit-stat--countdown.soon .orbit-stat-value {
  color: #FF9F0A;
}

.orbit-stat--countdown.live .orbit-stat-value {
  color: #FF453A;
}

.orbit-stat--cta {
  margin-left: auto;
}

.orbit-stat-cta-text {
  font-size: 24rpx;
  font-weight: 600;
  color: rgba(255, 255, 255, 0.7);
}

/* .section-badge 定义已上移回 pages/monitor/monitor.wxss（页面与多个分包组件共用，
   经 styleIsolation: apply-shared 作用进来） */

.orbit-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.orbit-card {
  display: flex;
  flex-direction: row;
  align-items: stretch;
  overflow: hidden;
  border-radius: 20rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  box-sizing: border-box;
  min-height: 200rpx;
}

/* 左侧配图随卡片高度撑满（绝对定位填满 media 槽） */
.orbit-card-media {
  position: relative;
  width: 200rpx;
  flex-shrink: 0;
  align-self: stretch;
  min-height: 200rpx;
  overflow: hidden;
}

.orbit-card-img {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  display: block;
}

.orbit-card-body {
  flex: 1;
  padding: var(--space-sm) var(--space-md);
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.orbit-card-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #fff;
  margin-bottom: 8rpx;
}

.orbit-card-meta {
  display: flex;
  gap: 12rpx;
  margin-bottom: 12rpx;
  flex-wrap: wrap;
}

.orbit-meta-tag {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.6);
  background: rgba(255, 255, 255, 0.08);
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}

.orbit-timeline {
  display: flex;
  gap: 24rpx;
}

.orbit-stat {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.orbit-stat-value {
  font-size: 32rpx;
  font-weight: 700;
  color: #34C759;
}

.orbit-stat-value.orbit-date {
  font-size: 22rpx;
  font-weight: 500;
  color: #FF9F0A;
}

.orbit-stat-label {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.5);
  margin-top: 2rpx;
}

/* ========== 在轨任务 Hero 倒计时面板 ========== */
.orbit-hero {
  position: relative;
  border-radius: 24rpx;
  overflow: hidden;
  margin-bottom: 20rpx;
  min-height: 360rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.12);
  box-sizing: border-box;
}

.orbit-hero-bg {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.orbit-hero-mask {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: linear-gradient(180deg, rgba(0,0,0,0.3) 0%, rgba(0,0,0,0.75) 100%);
}

.orbit-hero-content {
  position: relative;
  z-index: 1;
  padding: var(--space-lg) var(--space-lg);
  display: flex;
  flex-direction: column;
  align-items: center;
}

.orbit-hero-tags {
  display: flex;
  gap: 12rpx;
  margin-bottom: 12rpx;
}

.orbit-hero-type {
  font-size: 22rpx;
  color: #fff;
  background: rgba(52, 199, 89, 0.25);
  border: 1rpx solid rgba(52, 199, 89, 0.5);
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
}

.orbit-hero-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #fff;
  text-align: center;
  margin-bottom: 20rpx;
}

.orbit-hero-countdown {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-bottom: 16rpx;
}

.orbit-hero-countdown--live {
  justify-content: center;
}

.orbit-cd-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  min-width: 80rpx;
}

.orbit-cd-value {
  font-size: 56rpx;
  font-weight: 700;
  color: #fff;
  font-variant-numeric: tabular-nums;
  line-height: 1.1;
}

.orbit-cd-label {
  font-size: 20rpx;
  color: rgba(255,255,255,0.6);
  margin-top: 4rpx;
}

.orbit-cd-sep {
  font-size: 44rpx;
  font-weight: 300;
  color: rgba(255,255,255,0.5);
  margin-top: -20rpx;
}

.orbit-cd-live-text {
  font-size: 36rpx;
  font-weight: 600;
  color: #FF453A;
}

.orbit-hero-meta {
  display: flex;
  gap: 16rpx;
  align-items: center;
  margin-bottom: 16rpx;
}

.orbit-hero-date {
  font-size: 24rpx;
  color: rgba(255,255,255,0.7);
}

.orbit-hero-location {
  font-size: 24rpx;
  color: rgba(255,255,255,0.6);
  background: rgba(255,255,255,0.08);
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}

.orbit-hero-cta {
  margin-top: 4rpx;
}

.orbit-hero-cta-text {
  font-size: 26rpx;
  color: var(--color-brand);
  font-weight: 500;
}


/* ── 自 pages/monitor/monitor.wxss 迁入 ── */
/* --- 在轨任务小卡片：白底 + 细灰边（不要灰底/磨砂） --- */
.theme-light .orbit-card {
  border: 1rpx solid rgba(0, 0, 0, 0.12) !important;
  background: #ffffff !important;
  backdrop-filter: none !important;
  -webkit-backdrop-filter: none !important;
  box-shadow: none !important;
}

.theme-light .orbit-hero {
  border-color: rgba(0, 0, 0, 0.12);
}

.theme-light .orbit-card-title {
  color: var(--color-text-primary);
}

.theme-light .orbit-meta-tag {
  color: var(--color-text-secondary);
  background: rgba(0, 0, 0, 0.05);
}

.theme-light .orbit-meta-tag--date {
  color: var(--color-text-secondary);
}

.theme-light .orbit-meta-tag--location {
  color: var(--color-brand);
  background: rgba(59, 130, 246, 0.12);
}

.theme-light .orbit-stat-label {
  color: var(--color-text-tertiary);
}

.theme-light .orbit-stat-cta-text {
  color: var(--color-text-secondary);
}
