page {
  background: var(--color-bg-page);
  overflow: hidden;
  height: 100vh;
}

.detail-page {
  min-height: 100vh;
  height: 100vh;
  background: var(--color-bg-page);
  overflow: hidden;
}

.detail-scroll {
  height: 100vh;
}

.roman-shell {
  padding: 8rpx 30rpx 0;
}

.glass-card {
  background: var(--bg-glass);
  border-radius: var(--radius-card);
}

.loading-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 0;
}

.roman-scan {
  width: 48rpx;
  height: 48rpx;
  border: 4rpx solid var(--color-divider-strong);
  border-top-color: var(--color-brand);
  border-radius: 50%;
  animation: romanSpin 0.8s linear infinite;
}

@keyframes romanSpin {
  to { transform: rotate(360deg); }
}

.loading-text {
  font-size: 26rpx;
  color: var(--color-text-tertiary);
  margin-top: 20rpx;
}

.error-state {
  padding: 40rpx 28rpx;
  text-align: center;
}

.error-text {
  font-size: 26rpx;
  color: var(--color-warning);
  display: block;
  white-space: pre-wrap;
  word-break: break-word;
}

.retry-btn {
  margin-top: 20rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 14rpx 32rpx;
  border-radius: 12rpx;
  background: rgba(59, 130, 246, 0.35);
  font-size: 26rpx;
  color: #ffffff;
}

.roman-hero,
.roman-met,
.roman-track,
.roman-dsn,
.roman-block {
  padding: 32rpx 28rpx 28rpx;
  margin-bottom: 20rpx;
}

.roman-kicker {
  display: block;
  font-size: 18rpx;
  letter-spacing: 0.18em;
  color: var(--color-text-tertiary);
  margin-bottom: 12rpx;
}

.roman-hero-name {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
  color: var(--color-text-primary);
  letter-spacing: 0.01em;
  line-height: 1.3;
}

.roman-chip {
  display: inline-flex;
  margin-top: 18rpx;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 600;
  color: var(--color-brand);
  background: var(--color-brand-soft);
}

.roman-chip--l2 {
  color: #E3B341;
  background: rgba(255, 214, 10, 0.14);
}

.roman-chip--before {
  color: var(--color-warning);
  background: rgba(255, 149, 0, 0.14);
}

.roman-chip--ended {
  color: var(--color-text-secondary);
  background: var(--color-divider);
}

.roman-hero-desc {
  display: block;
  margin-top: 16rpx;
  font-size: 24rpx;
  color: var(--color-text-secondary);
  line-height: 1.55;
}

.roman-met {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 8rpx;
}

.roman-met-label {
  font-size: 20rpx;
  letter-spacing: 0.12em;
  color: var(--color-text-secondary);
}

.roman-met-hint {
  font-size: 20rpx;
  color: var(--color-text-quaternary);
}

.roman-met-value {
  font-size: 48rpx;
  font-weight: 700;
  line-height: 1.1;
  font-variant-numeric: tabular-nums;
  font-family: 'SF Mono', 'Menlo', 'Courier New', monospace;
  color: var(--color-text-primary);
  letter-spacing: 0.04em;
}

.roman-track-head,
.roman-track-ends {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 20rpx;
  color: var(--color-text-tertiary);
  letter-spacing: 0.04em;
}

.roman-track-end {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.roman-track-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
}

.roman-track-dot--earth {
  background: var(--color-brand);
}

.roman-track-dot--l2 {
  background: #FFD60A;
}

.roman-track-pct {
  color: var(--color-text-primary);
  font-family: 'SF Mono', 'Menlo', 'Courier New', monospace;
  font-variant-numeric: tabular-nums;
  letter-spacing: 0;
}

.roman-track-rail {
  position: relative;
  height: 96rpx;
  margin: 8rpx 36rpx 4rpx;
}

.roman-track-bar {
  position: absolute;
  left: 0;
  right: 0;
  top: 50%;
  height: 8rpx;
  margin-top: -4rpx;
  border-radius: 8rpx;
  overflow: hidden;
  background: var(--color-divider-strong);
}

.roman-track-fill {
  height: 100%;
  border-radius: 8rpx;
  background: linear-gradient(90deg, #3B82F6 0%, #7DD3FC 48%, #FFD60A 100%);
}

.roman-track-craft {
  position: absolute;
  top: 50%;
  width: 120rpx;
  height: 72rpx;
  transform: translate(-50%, -50%);
  pointer-events: none;
}

.roman-track-img {
  width: 120rpx;
  height: 72rpx;
  display: block;
}

.roman-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.roman-stat {
  flex: 0 0 calc(50% - 8rpx);
  box-sizing: border-box;
  padding: 24rpx 22rpx 20rpx;
}

.roman-stat-k {
  display: block;
  font-size: 20rpx;
  letter-spacing: 0.06em;
  color: var(--color-text-secondary);
}

.roman-stat-v {
  display: block;
  margin-top: 10rpx;
  font-size: 34rpx;
  font-weight: 700;
  font-variant-numeric: tabular-nums;
  font-family: 'SF Mono', 'Menlo', 'Courier New', monospace;
  color: var(--color-text-primary);
}

.roman-stat-u {
  display: block;
  margin-top: 6rpx;
  font-size: 20rpx;
  color: var(--color-text-tertiary);
}

.roman-dsn-head {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 20rpx;
  letter-spacing: 0.08em;
  color: var(--color-text-secondary);
  margin-bottom: 14rpx;
}

.roman-pulse {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: var(--color-text-quaternary);
}

.roman-pulse--on {
  background: var(--color-success);
  box-shadow: 0 0 8rpx rgba(52, 199, 89, 0.6);
  animation: romanPulse 1.6s ease-in-out infinite;
}

@keyframes romanPulse {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.35; }
}

.roman-dsn-line {
  display: block;
  font-size: 26rpx;
  color: var(--color-text-primary);
  line-height: 1.5;
}

.roman-dsn-idle {
  display: block;
  font-size: 24rpx;
  color: var(--color-text-secondary);
  line-height: 1.45;
}

.roman-section-title {
  display: block;
  font-size: 20rpx;
  letter-spacing: 0.12em;
  color: var(--color-text-secondary);
  margin-bottom: 8rpx;
}

.roman-kv-row {
  display: flex;
  justify-content: space-between;
  gap: 24rpx;
  padding: 16rpx 0;
  border-bottom: 1rpx solid var(--color-divider);
  font-size: 26rpx;
}

.roman-kv-row:last-child {
  border-bottom: none;
}

.roman-kv-row text:first-child {
  color: var(--color-text-secondary);
  flex-shrink: 0;
}

.roman-kv-row text:last-child {
  color: var(--color-text-primary);
  text-align: right;
  flex: 1;
  font-variant-numeric: tabular-nums;
}

.roman-actions {
  margin: 8rpx 0 12rpx;
}

.roman-action {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 28rpx;
  margin-bottom: 16rpx;
  font-size: 26rpx;
  color: var(--color-brand);
  border: 1px solid rgba(59, 130, 246, 0.18);
  background: rgba(59, 130, 246, 0.08);
}

.roman-action-arrow {
  font-size: 32rpx;
  color: var(--color-brand);
  opacity: 0.9;
}

.roman-credit text {
  display: block;
  font-size: 20rpx;
  color: var(--color-text-quaternary);
  line-height: 1.5;
}

/* ========== 明亮主题（theme-light）覆盖 ========== */

.detail-page.theme-light {
  background: var(--color-bg-page);
}

.theme-light .glass-card {
  background: var(--bg-glass);
}

.theme-light .roman-scan {
  border-color: rgba(0, 0, 0, 0.08);
  border-top-color: var(--color-brand);
}

.theme-light .loading-text {
  color: var(--color-text-tertiary);
}

.theme-light .retry-btn {
  background: var(--color-brand);
  color: #ffffff;
}

.theme-light .roman-kicker,
.theme-light .roman-met-label,
.theme-light .roman-stat-k,
.theme-light .roman-dsn-head,
.theme-light .roman-section-title,
.theme-light .roman-kv-row text:first-child,
.theme-light .roman-dsn-idle,
.theme-light .roman-hero-desc,
.theme-light .roman-track-head,
.theme-light .roman-track-ends {
  color: var(--color-text-secondary);
}

.theme-light .roman-hero-name,
.theme-light .roman-met-value,
.theme-light .roman-track-pct,
.theme-light .roman-stat-v,
.theme-light .roman-dsn-line,
.theme-light .roman-kv-row text:last-child {
  color: var(--color-text-primary);
}

.theme-light .roman-met-hint,
.theme-light .roman-stat-u,
.theme-light .roman-credit text {
  color: var(--color-text-tertiary);
}

.theme-light .roman-chip {
  color: var(--color-brand);
  background: var(--color-brand-soft);
}

.theme-light .roman-chip--l2 {
  color: #9A6700;
  background: rgba(217, 119, 6, 0.12);
}

.theme-light .roman-chip--before {
  color: #B45309;
  background: rgba(255, 149, 0, 0.12);
}

.theme-light .roman-chip--ended {
  color: var(--color-text-secondary);
  background: rgba(0, 0, 0, 0.06);
}

.theme-light .roman-track-dot--l2 {
  background: #D97706;
}

.theme-light .roman-track-bar {
  background: rgba(0, 0, 0, 0.08);
}

.theme-light .roman-track-fill {
  background: linear-gradient(90deg, #2563EB 0%, #0284C7 48%, #D97706 100%);
}

.theme-light .roman-pulse {
  background: rgba(0, 0, 0, 0.18);
}

.theme-light .roman-pulse--on {
  background: #248A3D;
  box-shadow: 0 0 8rpx rgba(36, 138, 61, 0.35);
}

.theme-light .roman-kv-row {
  border-bottom-color: var(--color-divider);
}

.theme-light .roman-action {
  background: rgba(59, 130, 246, 0.08);
  border: 1px solid rgba(59, 130, 246, 0.2);
  color: var(--color-brand);
}

.theme-light .roman-action-arrow {
  color: var(--color-brand);
}
