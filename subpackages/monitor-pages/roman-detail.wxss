page {
  background: var(--color-bg-page);
  overflow: hidden;
  height: 100vh;
}

.detail-page {
  min-height: 100vh;
  height: 100vh;
  background: var(--color-bg-page);
  overflow: hidden;
  --roman-accent: #B57AC9;
  --roman-accent-soft: rgba(106, 61, 154, 0.2);
  --roman-accent-border: rgba(181, 122, 201, 0.4);
  --roman-accent-strong: #6A3D9A;
  --roman-accent-mid: #6A3D9A;
}

.detail-scroll {
  height: 100vh;
}

.roman-shell {
  padding: 8rpx 30rpx 0;
}

.glass-card {
  background: var(--bg-glass);
  border-radius: var(--radius-card);
}

.loading-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 0;
}

.roman-scan {
  width: 48rpx;
  height: 48rpx;
  border: 4rpx solid var(--color-divider-strong);
  border-top-color: var(--roman-accent);
  border-radius: 50%;
  animation: romanSpin 0.8s linear infinite;
}

@keyframes romanSpin {
  to { transform: rotate(360deg); }
}

.loading-text {
  font-size: 26rpx;
  color: var(--color-text-tertiary);
  margin-top: 20rpx;
}

.error-state {
  padding: 40rpx 28rpx;
  text-align: center;
}

.error-text {
  font-size: 26rpx;
  color: var(--color-warning);
  display: block;
  white-space: pre-wrap;
  word-break: break-word;
}

.retry-btn {
  margin-top: 20rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 14rpx 32rpx;
  border-radius: 12rpx;
  background: var(--roman-accent-strong);
  font-size: 26rpx;
  color: #ffffff;
}

.roman-hero,
.roman-met,
.roman-track,
.roman-dsn,
.roman-block {
  padding: 32rpx 28rpx 28rpx;
  margin-bottom: 20rpx;
}

.roman-kicker {
  display: block;
  font-size: 18rpx;
  letter-spacing: 0.18em;
  color: var(--color-text-tertiary);
  margin-bottom: 12rpx;
}

.roman-hero-name {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
  color: var(--color-text-primary);
  letter-spacing: 0.01em;
  line-height: 1.3;
}

.roman-chip {
  display: inline-flex;
  margin-top: 18rpx;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 600;
  color: var(--roman-accent);
  background: var(--roman-accent-soft);
}

.roman-chip--l2 {
  color: #E3B341;
  background: rgba(255, 214, 10, 0.14);
}

.roman-chip--before {
  color: var(--color-warning);
  background: rgba(255, 149, 0, 0.14);
}

.roman-chip--ended {
  color: var(--color-text-secondary);
  background: var(--color-divider);
}

.roman-hero-desc {
  display: block;
  margin-top: 16rpx;
  font-size: 24rpx;
  color: var(--color-text-secondary);
  line-height: 1.55;
}

.roman-met {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 8rpx;
}

.roman-met-label {
  font-size: 20rpx;
  letter-spacing: 0.12em;
  color: var(--color-text-secondary);
}

.roman-met-hint {
  font-size: 20rpx;
  color: var(--color-text-quaternary);
}

.roman-met-value {
  font-size: 48rpx;
  font-weight: 700;
  line-height: 1.1;
  font-variant-numeric: tabular-nums;
  font-family: 'SF Mono', 'Menlo', 'Courier New', monospace;
  color: var(--color-text-primary);
  letter-spacing: 0.04em;
}

.roman-track-head,
.roman-track-ends {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 20rpx;
  color: var(--color-text-tertiary);
  letter-spacing: 0.04em;
}

.roman-track-end {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.roman-track-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
}

.roman-track-dot--earth {
  background: #3B82F6;
}

.roman-track-dot--l2 {
  background: #FFD60A;
}

.roman-track-pct {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--color-text-primary);
  font-family: 'SF Mono', 'Menlo', 'Courier New', monospace;
  font-variant-numeric: tabular-nums;
  letter-spacing: 0;
}

.roman-track-rail {
  position: relative;
  height: 96rpx;
  margin: 8rpx 36rpx 4rpx;
}

.roman-track-bar {
  position: absolute;
  left: 0;
  right: 0;
  top: 50%;
  height: 8rpx;
  margin-top: -4rpx;
  border-radius: 8rpx;
  overflow: hidden;
  background: var(--color-divider-strong);
}

.roman-track-fill {
  position: relative;
  height: 100%;
  border-radius: 8rpx;
  overflow: hidden;
  background: linear-gradient(90deg, #3B82F6 0%, #6A3D9A 48%, #FFD60A 100%);
}

.roman-track-pulse {
  position: absolute;
  top: 0;
  bottom: 0;
  left: -46%;
  width: 46%;
  background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.55), transparent);
  animation: roman-progress-shimmer 1.8s ease-in-out infinite;
}

.roman-track-beat {
  position: absolute;
  top: 50%;
  width: 18rpx;
  height: 18rpx;
  margin-left: -9rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.55);
  box-shadow: 0 0 12rpx rgba(181, 122, 201, 0.75);
  animation: roman-progress-beat 1.5s ease-in-out infinite;
  z-index: 1;
  pointer-events: none;
}

@keyframes roman-progress-shimmer {
  0%   { transform: translateX(0); }
  100% { transform: translateX(320%); }
}

@keyframes roman-progress-beat {
  0%, 100% { transform: translateY(-50%) scale(0.7); opacity: 0.4; }
  50%      { transform: translateY(-50%) scale(1.35); opacity: 1; }
}

.roman-track-craft {
  position: absolute;
  top: 50%;
  width: 120rpx;
  height: 72rpx;
  transform: translate(-50%, -50%);
  pointer-events: none;
}

.roman-track-img {
  width: 120rpx;
  height: 72rpx;
  display: block;
}

.roman-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.roman-stat {
  flex: 0 0 calc(50% - 8rpx);
  box-sizing: border-box;
  padding: 24rpx 22rpx 20rpx;
}

.roman-stat-k {
  display: block;
  font-size: 20rpx;
  letter-spacing: 0.06em;
  color: var(--color-text-secondary);
}

.roman-stat-v {
  display: block;
  margin-top: 10rpx;
  font-size: 34rpx;
  font-weight: 700;
  font-variant-numeric: tabular-nums;
  font-family: 'SF Mono', 'Menlo', 'Courier New', monospace;
  color: var(--color-text-primary);
}

.roman-stat-u {
  display: block;
  margin-top: 6rpx;
  font-size: 20rpx;
  color: var(--color-text-tertiary);
}

.roman-dsn-head {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 20rpx;
  letter-spacing: 0.08em;
  color: var(--color-text-secondary);
  margin-bottom: 14rpx;
}

.roman-pulse {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: var(--color-text-quaternary);
}

.roman-pulse--on {
  background: var(--color-success);
  box-shadow: 0 0 8rpx rgba(52, 199, 89, 0.6);
  animation: romanPulse 1.6s ease-in-out infinite;
}

@keyframes romanPulse {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.35; }
}

.roman-dsn-line {
  display: block;
  font-size: 26rpx;
  color: var(--color-text-primary);
  line-height: 1.5;
}

.roman-dsn-idle {
  display: block;
  font-size: 24rpx;
  color: var(--color-text-secondary);
  line-height: 1.45;
}

.roman-section-title {
  display: block;
  font-size: 20rpx;
  letter-spacing: 0.12em;
  color: var(--color-text-secondary);
  margin-bottom: 8rpx;
}

.roman-kv-row {
  display: flex;
  justify-content: space-between;
  gap: 24rpx;
  padding: 16rpx 0;
  border-bottom: 1rpx solid var(--color-divider);
  font-size: 26rpx;
}

.roman-kv-row:last-child {
  border-bottom: none;
}

.roman-kv-row text:first-child {
  color: var(--color-text-secondary);
  flex-shrink: 0;
}

.roman-kv-row text:last-child {
  color: var(--color-text-primary);
  text-align: right;
  flex: 1;
  font-variant-numeric: tabular-nums;
}

.roman-adopt-card {
  display: flex;
  align-items: stretch;
  gap: 18rpx;
  padding: 28rpx 28rpx 26rpx 18rpx;
  margin-bottom: 20rpx;
  position: relative;
  overflow: hidden;
}

.roman-adopt-card__strip {
  display: grid;
  grid-template-columns: repeat(6, 12rpx);
  grid-template-rows: repeat(6, 12rpx);
  gap: 5rpx;
  align-content: center;
  flex-shrink: 0;
}

.roman-adopt-card__px {
  width: 12rpx;
  height: 12rpx;
  border-radius: 2rpx;
  background: rgba(181, 122, 201, 0.32);
}

.roman-adopt-card__px--on {
  background: #6A3D9A;
}

.roman-adopt-card__main {
  flex: 1;
  min-width: 0;
}

.roman-adopt-card__kicker {
  display: block;
  font-size: 18rpx;
  letter-spacing: 0.14em;
  color: var(--roman-accent);
  margin-bottom: 10rpx;
}

.roman-adopt-card__title {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
  color: var(--color-text-primary);
}

.roman-adopt-card__desc {
  display: block;
  margin-top: 12rpx;
  font-size: 24rpx;
  line-height: 1.55;
  color: var(--color-text-secondary);
}

.roman-adopt-card__hint {
  display: block;
  margin-top: 10rpx;
  font-size: 20rpx;
  color: var(--color-text-tertiary);
}

.roman-adopt-card__cta {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 20rpx;
  padding: 16rpx 18rpx;
  border-radius: 12rpx;
  background-color: #6A3D9A;
  background-image: radial-gradient(circle, rgba(255, 255, 255, 0.08) 1.2rpx, transparent 1.8rpx);
  background-size: 12rpx 12rpx;
  font-size: 26rpx;
  font-weight: 700;
  letter-spacing: 0.8rpx;
  color: #FFFFFF;
}

.roman-adopt-card__cta-strip {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  flex-shrink: 0;
}

.roman-adopt-card__cta .roman-adopt-card__px {
  width: 8rpx;
  height: 8rpx;
  background: rgba(255, 255, 255, 0.3);
}

.roman-adopt-card__cta .roman-adopt-card__px--on {
  background: #FFFFFF;
}

.roman-adopt-card__cta .roman-action-arrow {
  margin-left: auto;
  color: #FFFFFF;
}

.roman-actions {
  margin: 8rpx 0 12rpx;
}

.roman-action {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 28rpx;
  margin-bottom: 16rpx;
  font-size: 26rpx;
  color: var(--roman-accent);
  border: 1px solid var(--roman-accent-border);
  background: var(--roman-accent-soft);
}

.roman-action-arrow {
  font-size: 32rpx;
  color: var(--roman-accent);
  opacity: 0.9;
}

.roman-credit text {
  display: block;
  font-size: 20rpx;
  color: var(--color-text-quaternary);
  line-height: 1.5;
}

/* ========== 明亮主题（theme-light）覆盖 ========== */

.detail-page.theme-light {
  background: var(--color-bg-page);
  --roman-accent: #6A3D9A;
  --roman-accent-soft: rgba(106, 61, 154, 0.1);
  --roman-accent-border: rgba(106, 61, 154, 0.28);
  --roman-accent-strong: #6A3D9A;
  --roman-accent-mid: #6A3D9A;
}

.theme-light .glass-card {
  background: var(--bg-glass);
}

.theme-light .roman-scan {
  border-color: rgba(0, 0, 0, 0.08);
  border-top-color: var(--roman-accent);
}

.theme-light .loading-text {
  color: var(--color-text-tertiary);
}

.theme-light .retry-btn {
  background: var(--roman-accent-strong);
  color: #ffffff;
}

.theme-light .roman-kicker,
.theme-light .roman-met-label,
.theme-light .roman-stat-k,
.theme-light .roman-dsn-head,
.theme-light .roman-section-title,
.theme-light .roman-kv-row text:first-child,
.theme-light .roman-dsn-idle,
.theme-light .roman-hero-desc,
.theme-light .roman-track-head,
.theme-light .roman-track-ends,
.theme-light .roman-adopt-card__desc {
  color: var(--color-text-secondary);
}

.theme-light .roman-hero-name,
.theme-light .roman-met-value,
.theme-light .roman-track-pct,
.theme-light .roman-stat-v,
.theme-light .roman-dsn-line,
.theme-light .roman-kv-row text:last-child,
.theme-light .roman-adopt-card__title {
  color: var(--color-text-primary);
}

.theme-light .roman-adopt-card__hint {
  color: var(--color-text-tertiary);
}

.theme-light .roman-adopt-card__kicker {
  color: var(--roman-accent);
}

.theme-light .roman-adopt-card__px {
  background: rgba(106, 61, 154, 0.22);
}

.theme-light .roman-adopt-card__px--on {
  background: #6A3D9A;
}

.theme-light .roman-adopt-card__cta,
.theme-light .roman-adopt-card__cta .roman-action-arrow {
  color: #FFFFFF;
}

.theme-light .roman-adopt-card__cta {
  background-color: #6A3D9A;
}

.theme-light .roman-met-hint,
.theme-light .roman-stat-u,
.theme-light .roman-credit text {
  color: var(--color-text-tertiary);
}

.theme-light .roman-chip {
  color: var(--roman-accent);
  background: var(--roman-accent-soft);
}

.theme-light .roman-chip--l2 {
  color: #9A6700;
  background: rgba(217, 119, 6, 0.12);
}

.theme-light .roman-chip--before {
  color: #B45309;
  background: rgba(255, 149, 0, 0.12);
}

.theme-light .roman-chip--ended {
  color: var(--color-text-secondary);
  background: rgba(0, 0, 0, 0.06);
}

.theme-light .roman-track-dot--l2 {
  background: #D97706;
}

.theme-light .roman-track-bar {
  background: rgba(0, 0, 0, 0.08);
}

.theme-light .roman-track-fill {
  background: linear-gradient(90deg, #3B82F6 0%, #6A3D9A 48%, #D97706 100%);
}

.theme-light .roman-pulse {
  background: rgba(0, 0, 0, 0.18);
}

.theme-light .roman-pulse--on {
  background: #248A3D;
  box-shadow: 0 0 8rpx rgba(36, 138, 61, 0.35);
}

.theme-light .roman-kv-row {
  border-bottom-color: var(--color-divider);
}

.theme-light .roman-action {
  background: var(--roman-accent-soft);
  border: 1px solid var(--roman-accent-border);
  color: var(--roman-accent);
}

.theme-light .roman-action-arrow {
  color: var(--roman-accent);
}
