<!-- SPACE_NOTICES_FEATURE -->
<page-meta background-color="{{pageBgColor}}" background-color-top="{{pageBgColor}}" background-color-bottom="{{pageBgColor}}" />
<view class="map-page sn-map-page {{themeClass}}">
  <view class="top-nav-wrapper" style="padding-top: {{statusBarHeight}}px;">
    <view class="top-nav top-nav--page-grid">
      <view class="nav-left top-nav-slot--back {{isDirectEntry ? 'top-nav-slot--home' : ''}}" bindtap="goBack" style="width: {{menuButtonWidth}}px;">
        <text class="icon-back icon-back--nav">‹</text>
      </view>
      <view class="nav-title-wrap nav-title-wrap--page-grid">
        <text class="nav-title nav-title--page-grid">{{title || '通告地图'}}</text>
      </view>
      <view class="nav-right-space top-nav-slot--spacer" style="width: {{menuButtonWidth}}px;"></view>
    </view>
  </view>
  <view class="map-action-container glass-card {{actionMenuCollapsed ? 'map-action-container--collapsed' : ''}}" wx:if="{{mapActionTop > 0}}" style="top: {{mapActionTop}}px;">
    <view class="map-action-header">
      <text class="map-action-title">地图工具</text>
      <view class="map-action-toggle-btn" bindtap="toggleActionMenuCollapsed"><text>{{actionMenuCollapsed ? '展开' : '折叠'}}</text></view>
    </view>
    <view class="map-action-stack" wx:if="{{!actionMenuCollapsed}}">
      <view class="map-action-type-row">
        <view class="map-action-btn {{enableSatellite ? 'map-action-btn--active' : ''}}" bindtap="setMapSatellite" data-map-mode="satellite"><text>卫星</text></view>
        <view class="map-action-btn {{!enableSatellite ? 'map-action-btn--active' : ''}}" bindtap="setMapSatellite" data-map-mode="standard"><text>平面</text></view>
      </view>
    </view>
  </view>

  <map
    class="sn-map"
    latitude="{{latitude}}"
    longitude="{{longitude}}"
    scale="{{scale}}"
    markers="{{markers}}"
    polygons="{{polygons}}"
    polyline="{{polylines}}"
    include-points="{{includePoints}}"
    enable-scroll="{{true}}"
    enable-zoom="{{true}}"
    show-location="{{false}}"
    enable-satellite="{{enableSatellite}}"
    setting="{{mapSetting}}"
  />

  <view class="sn-state glass-card" wx:if="{{loading || errorText}}">
    <text class="sn-state-title">{{loading ? '加载中…' : '加载失败'}}</text>
    <text class="sn-state-desc">{{loading ? '正在读取通告与发射台点位' : errorText}}</text>
    <view class="sn-btn sn-btn--primary sn-state-btn" wx:if="{{errorText && !loading}}" bindtap="retryLoad">
      <text>重试</text>
    </view>
  </view>

  <view class="panel sn-panel glass-card {{panelCollapsed ? 'panel--collapsed' : ''}}" wx:if="{{!loading && !errorText}}">
    <view class="panel-header">
      <view class="sn-head-main">
        <text class="panel-title">通告图层</text>
        <text class="panel-subtitle">{{subtitle || padName || '发射危险区'}}{{netText ? ' · NET ' + netText : ''}}</text>
      </view>
      <view class="panel-header-actions">
        <view class="panel-badge {{stats.live ? 'panel-badge--green' : (stats.soon ? 'panel-badge--soon' : '')}}">
          <text wx:if="{{stats.live || stats.soon}}">{{stats.live ? '生效 ' + stats.live : ''}}{{stats.live && stats.soon ? ' · ' : ''}}{{stats.soon ? '预警 ' + stats.soon : ''}}</text>
          <text wx:else>{{notices.length}} 条</text>
        </view>
        <view class="panel-toggle-btn" bindtap="togglePanel">
          <text>{{panelCollapsed ? '展开' : '收起'}}</text>
        </view>
      </view>
    </view>

    <view class="mini-summary-row" wx:if="{{panelCollapsed}}">
      <text class="mini-summary-text">NOTAM {{stats.notam}} · 航海 {{stats.nav}} · 走廊 {{stats.adp}}{{stats.soon ? ' · 预警 ' + stats.soon : ''}}{{stats.ended ? ' · 已结束 ' + stats.ended : ''}}{{stats.cancelled ? ' · 已取消 ' + stats.cancelled : ''}}</text>
    </view>

    <block wx:if="{{!panelCollapsed}}">
      <view class="sn-seg">
        <view class="sn-seg-item {{mapRegion === 'pad' ? 'sn-seg-item--on' : ''}}" data-region="pad" bindtap="setMapRegion">
          <text>发射区</text>
        </view>
        <view class="sn-seg-item {{mapRegion === 'splash' ? 'sn-seg-item--on' : ''}}" data-region="splash" bindtap="setMapRegion">
          <text>溅落区</text>
        </view>
        <view class="sn-seg-item {{mapRegion === 'global' ? 'sn-seg-item--on' : ''}}" data-region="global" bindtap="setMapRegion">
          <text>全程</text>
        </view>
      </view>

      <view class="sn-chips">
        <view class="sn-chip {{showCorridor ? 'sn-chip--on' : ''}}" data-key="showCorridor" bindtap="toggleLayer" wx:if="{{hasTrajectory}}">
          <view class="sn-chip-dot sn-chip-dot--adp"></view>
          <text>轨迹</text>
        </view>
        <view class="sn-chip {{showNotam ? 'sn-chip--on' : ''}}" data-key="showNotam" bindtap="toggleLayer">
          <view class="sn-chip-dot sn-chip-dot--notam"></view>
          <text>NOTAM</text>
        </view>
        <view class="sn-chip {{showNav ? 'sn-chip--on' : ''}}" data-key="showNav" bindtap="toggleLayer">
          <view class="sn-chip-dot sn-chip-dot--nav"></view>
          <text>航海</text>
        </view>
        <view class="sn-chip {{showPad ? 'sn-chip--on' : ''}}" data-key="showPad" bindtap="toggleLayer">
          <view class="sn-chip-dot sn-chip-dot--pad"></view>
          <text>发射台</text>
        </view>
        <view class="sn-chip sn-chip--ghost" bindtap="resetView">
          <text>重置视野</text>
        </view>
      </view>

      <view class="sn-chips">
        <view class="sn-chip {{showLive ? 'sn-chip--on' : ''}}" data-key="showLive" bindtap="toggleLayer">
          <view class="sn-chip-dot sn-chip-dot--live"></view>
          <text>生效{{stats.live ? ' ' + stats.live : ''}}</text>
        </view>
        <view class="sn-chip {{showSoon ? 'sn-chip--on' : ''}}" data-key="showSoon" bindtap="toggleLayer">
          <view class="sn-chip-dot sn-chip-dot--soon"></view>
          <text>预警{{stats.soon ? ' ' + stats.soon : ''}}</text>
        </view>
        <view class="sn-chip {{showEnded ? 'sn-chip--on' : ''}}" data-key="showEnded" bindtap="toggleLayer">
          <text>结束{{stats.ended ? ' ' + stats.ended : ''}}</text>
        </view>
        <view class="sn-chip {{showCancelled ? 'sn-chip--on' : ''}}" data-key="showCancelled" bindtap="toggleLayer">
          <text>取消{{stats.cancelled ? ' ' + stats.cancelled : ''}}</text>
        </view>
      </view>

      <text class="sn-note">{{hasTrajectory ? '黄线与 space-notices.com Trajectory 同源（Ship 40）。橙虚线 = 尚未生效的提前预警。点通告可高亮并定位，切「发射区」聚焦场区细节。' : '橙虚线 = 尚未生效的提前预警。本任务无飞行轨迹数据；地图展示 NOTAM / 航海危险区多边形。点通告可高亮并定位。'}}</text>

      <scroll-view scroll-y class="sn-list" enhanced="{{true}}" show-scrollbar="{{false}}">
        <view
          class="sn-item {{item.noticeKey === selectedKey ? 'sn-item--on' : ''}} {{item.cancelled ? 'sn-item--muted' : ''}}"
          wx:for="{{notices}}"
          wx:key="noticeKey"
          data-key="{{item.noticeKey}}"
          bindtap="selectNotice"
        >
          <view class="sn-item-bar sn-item-bar--{{item.typeTone}}"></view>
          <view class="sn-item-body">
            <view class="sn-item-top">
              <text class="sn-item-name">{{item.name}}</text>
              <view class="sn-tag sn-tag--{{item.statusTone}}" wx:if="{{item.statusText}}">
                <text>{{item.statusText}}</text>
              </view>
            </view>
            <text class="sn-item-meta">{{item.typeShort}}{{item.timeText ? ' · ' + item.timeText : ''}}{{item.hasGeo ? '' : ' · 无坐标'}}</text>
            <text class="sn-item-reason" wx:if="{{item.reason}}">{{item.reason}}</text>
          </view>
          <view class="sn-item-arrow"></view>
        </view>
        <view class="sn-empty" wx:if="{{!notices.length}}">
          <text>该任务暂无通告多边形。可在云函数 ingestRaw 粘贴 NOTAM 原文。</text>
        </view>
      </scroll-view>
    </block>
  </view>

  <view class="sn-mask" wx:if="{{selectedNotice}}" bindtap="minimizeDetail" catchtouchmove="noop"></view>
  <view class="sn-sheet glass-card" wx:if="{{selectedNotice}}">
    <view class="sn-sheet-grip"></view>
    <view class="sn-sheet-head">
      <view class="sn-sheet-title-wrap">
        <text class="sn-sheet-title">{{selectedNotice.name}}</text>
        <text class="sn-sheet-sub">{{selectedNotice.typeLabel}}{{selectedNotice.sourceName ? ' · ' + selectedNotice.sourceName : ''}}</text>
      </view>
      <view class="sn-sheet-close" bindtap="closeDetail"><text>关闭</text></view>
    </view>

    <view class="sn-sheet-tags">
      <view class="sn-tag sn-tag--{{selectedNotice.statusTone}}" wx:if="{{selectedNotice.statusText}}">
        <text>{{selectedNotice.statusText}}</text>
      </view>
      <view class="sn-tag sn-tag--plain"><text>{{selectedNotice.typeShort}}</text></view>
      <view class="sn-tag sn-tag--plain" wx:if="{{selectedNotice.hasGeo}}"><text>已在地图高亮</text></view>
      <view class="sn-tag sn-tag--off" wx:else><text>无坐标图形</text></view>
    </view>

    <scroll-view scroll-y class="sn-sheet-scroll" enhanced="{{true}}" show-scrollbar="{{false}}">
      <view class="sn-sheet-block" wx:if="{{selectedNotice.leadText}}">
        <text class="sn-sheet-label">提前预警</text>
        <text class="sn-sheet-text">{{selectedNotice.leadText}}，窗口开始后自动改为生效中。</text>
      </view>
      <view class="sn-sheet-block" wx:if="{{selectedNotice.reason}}">
        <text class="sn-sheet-label">说明</text>
        <text class="sn-sheet-text">{{selectedNotice.reason}}</text>
      </view>
      <view class="sn-sheet-block" wx:if="{{selectedNotice.windows.length}}">
        <text class="sn-sheet-label">生效窗口（本地时间）</text>
        <view class="sn-win" wx:for="{{selectedNotice.windows}}" wx:key="i">
          <text>{{item.text}}</text>
        </view>
      </view>
      <view class="sn-sheet-block" wx:if="{{selectedNotice.rawLines.length}}">
        <text class="sn-sheet-label">通告原文</text>
        <text class="sn-sheet-raw" wx:for="{{selectedNotice.rawLines}}" wx:key="i">{{item.text}}</text>
      </view>
    </scroll-view>

    <view class="sn-sheet-actions">
      <view class="sn-btn sn-btn--ghost" bindtap="copySourceLink"><text>复制来源</text></view>
      <view class="sn-btn sn-btn--primary" bindtap="copyRawText"><text>复制原文</text></view>
    </view>
  </view>

  <share-gate-countdown expire-at="{{shareGateExpireAt}}" />
</view>
