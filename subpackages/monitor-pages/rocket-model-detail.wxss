/* rocket-model-detail.wxss — 火箭型号详情页（暗色毛玻璃，与监控中心一致） */
@import "./styles/fav-btn.wxss";
@import "./hero-3d-btn.wxss";

page {
  background: var(--color-bg-page);
}
.container {
  min-height: 100vh;
  background: var(--color-bg-page);
  color: var(--color-text-primary);
}
.detail-scroll {
  width: 100%;
  height: 100vh;
}
.glass-card {
  background: var(--bg-glass);
  border-radius: var(--radius-card);
  backdrop-filter: var(--blur-card);
  -webkit-backdrop-filter: var(--blur-card);
}

/* 加载/错误 */
.loading-wrap, .error-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding-top: 200rpx;
}
.loading-text {
  font-size: 28rpx;
  color: #636366;
}
.error-icon {
  font-size: 64rpx;
  margin-bottom: 20rpx;
}
.error-text {
  font-size: 28rpx;
  color: #8E8E93;
  margin-bottom: 30rpx;
}
.error-btn {
  font-size: 28rpx;
  color: var(--color-brand);
  padding: 12rpx 40rpx;
  border: 1px solid rgba(59, 130, 246, 0.3);
  border-radius: 999rpx;
}
.score-loading-hint {
  display: block;
  margin: 8rpx 8rpx 0;
  font-size: 24rpx;
  color: #8E8E93;
}

/* Hero */
.hero-section {
  position: relative;
  width: 100%;
  height: 460rpx;
  overflow: hidden;
  background: rgba(255, 255, 255, 0.03);
}
.hero-img {
  width: 100%;
  height: 100%;
  opacity: 0;
  transform: scale(1.02);
  transition: opacity 0.4s ease, transform 0.4s ease;
}
.hero-img--loaded {
  opacity: 1;
  transform: scale(1);
}
.hero-placeholder {
  opacity: 1;
  transform: scale(1);
  display: flex;
  align-items: center;
  justify-content: center;
  background: radial-gradient(circle at center, rgba(59, 130, 246, 0.08), rgba(255, 255, 255, 0.02) 72%);
}
.hero-placeholder-icon {
  font-size: 96rpx;
}
.hero-gradient {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 160rpx;
  background: linear-gradient(transparent, rgba(0, 0, 0, 0.85));
}
.hero-credit-btn {
  position: absolute;
  bottom: 12rpx;
  right: 16rpx;
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, rgba(59, 130, 246, 0.2), rgba(59, 130, 246, 0.2));
  border: 1px solid rgba(59, 130, 246, 0.3);
  backdrop-filter: blur(10rpx);
  -webkit-backdrop-filter: blur(10rpx);
  display: flex;
  align-items: center;
  justify-content: center;
}
.hero-credit-text {
  font-size: 20rpx;
  color: var(--color-brand);
  font-weight: 500;
  line-height: 1;
}

/* 贴图讨论区容器 */
.model-discuss-wrap {
  padding: 0 var(--space-lg);
}

/* 信息头 */
.info-header {
  padding: var(--space-md) var(--space-lg) 0;
}
.info-name-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
}
.info-name {
  flex: 1;
  min-width: 0;
  font-size: 46rpx;
  font-weight: 800;
  color: var(--color-text-primary);
}
.info-flag {
  flex-shrink: 0;
  font-size: 40rpx;
  line-height: 1;
}
.info-name-row .fav-btn {
  flex-shrink: 0;
  margin-left: auto;
}
.info-alias {
  display: block;
  font-size: 28rpx;
  color: rgba(255, 149, 0, 0.9);
  margin-top: 6rpx;
}
.info-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 14rpx;
}
.info-tag {
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border-radius: 6rpx;
  font-weight: 500;
}
.info-tag--mfr {
  color: var(--color-brand);
  background: rgba(59, 130, 246, 0.15);
  border: 1px solid rgba(59, 130, 246, 0.3);
}
/* 发射商跳转按钮：胶囊蓝色渐变，全局统一（同首页倒计时 info-jump-btn） */
.info-tag--link {
  color: #ffffff;
  background: linear-gradient(135deg, var(--color-brand), #60A5FA);
  border: none;
  border-radius: 999rpx;
  padding: 5rpx 17rpx 5rpx 19rpx;
  font-weight: 500;
}
.info-tag--link:active {
  opacity: 0.7;
  transform: scale(0.96);
}
.info-tag-arrow {
  font-size: 26rpx;
  margin-left: 2rpx;
  line-height: 1;
}
.info-tag--reusable {
  color: #34C759;
  background: rgba(52, 199, 89, 0.15);
  border: 1px solid rgba(52, 199, 89, 0.3);
}
.info-tag--variant {
  color: #AF52DE;
  background: rgba(175, 82, 222, 0.15);
  border: 1px solid rgba(175, 82, 222, 0.3);
}
.info-tag--pending {
  color: #FF9500;
  background: rgba(255, 149, 0, 0.15);
  border: 1px solid rgba(255, 149, 0, 0.3);
}

/* 描述 */
.desc-section {
  padding: var(--space-sm) var(--space-lg) 0;
  display: flex;
  flex-direction: column;
  align-items: stretch;
  gap: 12rpx;
}
/* 标题左 + 翻译按钮右（全局统一布局） */
.desc-title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.desc-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-text-primary);
}
.desc-text {
  font-size: 26rpx;
  color: var(--color-text-secondary);
  line-height: 1.6;
}

/* 「翻译为中文/显示原文」小按钮 */
/* 全局 .translate-toggle 样式在 app.wxss */

/* 通用区块标签 */
.section-label {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-text-primary);
  display: block;
  margin-bottom: 16rpx;
}

/* 回收方式卡 */
.recovery-card {
  margin: 24rpx 30rpx 0;
  padding: 24rpx;
  border-radius: 16rpx;
}
.recovery-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
}
.recovery-icon {
  width: 72rpx;
  height: 72rpx;
  flex-shrink: 0;
}
.recovery-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}
.recovery-label {
  font-size: 30rpx;
  font-weight: 700;
  color: #34C759;
}
.recovery-desc {
  font-size: 22rpx;
  color: var(--color-text-secondary);
  line-height: 1.5;
}

/* 规格网格 */
.spec-section {
  margin: 16rpx 30rpx 0;
  padding: 24rpx;
  border-radius: 16rpx;
}
.spec-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 14rpx;
}
.spec-item {
  display: flex;
  flex-direction: column;
  padding: 14rpx 18rpx;
  background: var(--color-divider-faint);
  border-radius: 10rpx;
}
.spec-label {
  font-size: 20rpx;
  color: var(--color-text-tertiary);
}
.spec-value {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-text-primary);
  margin-top: 4rpx;
  font-variant-numeric: tabular-nums;
}

/* 回收战绩 */
.record-section {
  margin: 16rpx 30rpx 0;
  padding: 24rpx;
  border-radius: 16rpx;
}
.record-grid {
  display: grid;
  grid-template-columns: 1fr 1fr 1fr;
  gap: 14rpx;
}
.record-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 16rpx 8rpx;
  background: var(--color-divider-faint);
  border-radius: 10rpx;
}
.record-value {
  font-size: 34rpx;
  font-weight: 800;
  color: var(--color-text-primary);
  font-variant-numeric: tabular-nums;
}
.record-value--turnaround {
  font-size: 24rpx;
  color: var(--color-brand);
}
.record-label {
  font-size: 20rpx;
  color: var(--color-text-tertiary);
  margin-top: 6rpx;
  text-align: center;
}

/* 旗下箭实体 */
.fleet-section {
  margin: 24rpx 30rpx 0;
}
.section-label--fleet {
  margin-bottom: 16rpx;
}
.fleet-count {
  color: var(--color-text-tertiary);
  font-weight: 500;
}
.fleet-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}
.fleet-card {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 16rpx;
  border-radius: 16rpx;
}
.fleet-img-wrap {
  flex-shrink: 0;
  width: 120rpx;
  height: 120rpx;
  border-radius: 12rpx;
  overflow: hidden;
  background: var(--color-divider-faint);
}
.fleet-img {
  width: 100%;
  height: 100%;
  opacity: 0;
  transition: opacity 0.35s ease;
}
.fleet-img--loaded {
  opacity: 1;
}
.fleet-img--placeholder {
  opacity: 1;
  background: radial-gradient(circle at center, rgba(59, 130, 246, 0.08), rgba(255, 255, 255, 0.02) 72%);
}
.fleet-body {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}
.fleet-serial-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.fleet-serial {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--color-text-primary);
}
.fleet-status {
  font-size: 18rpx;
  font-weight: 600;
  padding: 2rpx 12rpx;
  border-radius: 6rpx;
  background: var(--color-divider);
}
.fleet-status--active { color: #34C759; }
.fleet-status--retired { color: #8E8E93; }
.fleet-status--destroyed { color: #FF3B30; }
.fleet-status--expended { color: #FF9500; }
.fleet-status--unknown { color: #8E8E93; }
.fleet-stats-row {
  display: flex;
  gap: 16rpx;
}
.fleet-stat {
  font-size: 20rpx;
  color: var(--color-text-secondary);
}
.fleet-flights-bar {
  display: flex;
  flex-wrap: wrap;
  gap: 4rpx;
}
.flight-block {
  width: 14rpx;
  height: 14rpx;
  border-radius: 3rpx;
}
.flight-success {
  background: rgba(52, 199, 89, 0.55);
}
.flight-fail {
  background: rgba(255, 59, 48, 0.55);
}
.flight-pending {
  background: rgba(255, 149, 0, 0.55);
}
.flight-unknown {
  background: var(--color-divider);
}
.fleet-arrow {
  flex-shrink: 0;
  font-size: 40rpx;
  color: var(--color-text-quaternary);
}
.fleet-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  padding: 40rpx 24rpx;
  border-radius: 16rpx;
}
.fleet-empty-text {
  font-size: 26rpx;
  color: #FF9500;
  font-weight: 600;
}
.fleet-empty-hint {
  font-size: 22rpx;
  color: var(--color-text-tertiary);
}

/* ========== 明亮主题（theme-light）覆盖 ==========
 * 正文色已走 token，随 .theme-light 自动反色。
 * 这里只补：实心底卡、照片浮层保持深色、白色中性 SVG 反色。
 */
.container.theme-light {
  background: var(--color-bg-page);
}
.theme-light .glass-card {
  background: var(--color-bg-card);
}
.theme-light .loading-text {
  color: var(--color-text-tertiary);
}
.theme-light .error-text {
  color: var(--color-text-secondary);
}
.theme-light .hero-placeholder {
  background: radial-gradient(circle at center, rgba(59, 130, 246, 0.08), rgba(0, 0, 0, 0.03) 72%);
}
.theme-light .info-alias {
  color: #C77700;
}
/* 回收方式图标恒为白色中性 SVG（buildLandingIcon neutral），浅色主题反色压深 */
.theme-light .recovery-icon {
  filter: invert(0.72);
}
.theme-light .fleet-img--placeholder {
  background: radial-gradient(circle at center, rgba(59, 130, 246, 0.08), rgba(0, 0, 0, 0.03) 72%);
}
.theme-light .fleet-status--retired,
.theme-light .fleet-status--unknown {
  color: var(--color-text-tertiary);
}

/* 底部 PK + 档案指数：与任务详情同坞 */
.mission-fab-dock {
  position: fixed;
  left: 50%;
  transform: translateX(-50%);
  z-index: 80;
  display: flex;
  align-items: center;
  gap: 16rpx;
  pointer-events: auto;
}

.mission-pk-fab {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 72rpx;
  padding: 0 40rpx;
  border-radius: 999rpx;
  background: var(--bg-glass, rgba(22, 24, 28, 0.72));
  backdrop-filter: blur(32rpx) saturate(160%);
  -webkit-backdrop-filter: blur(32rpx) saturate(160%);
  border: 1px solid var(--color-border-glass, rgba(255, 255, 255, 0.1));
  box-shadow: var(--shadow-tabbar, 0 4rpx 20rpx rgba(0, 0, 0, 0.2));
}

.mission-pk-fab--pressed {
  opacity: 0.86;
  transform: scale(0.98);
}

.mission-pk-fab-mark {
  width: 72rpx;
  height: 34rpx;
  display: block;
}

.mission-score-fab {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 72rpx;
  height: 72rpx;
  border-radius: 999rpx;
  background: var(--bg-glass, rgba(22, 24, 28, 0.72));
  backdrop-filter: blur(32rpx) saturate(160%);
  -webkit-backdrop-filter: blur(32rpx) saturate(160%);
  border: 1px solid var(--color-border-glass, rgba(255, 255, 255, 0.1));
  box-shadow: var(--shadow-tabbar, 0 4rpx 20rpx rgba(0, 0, 0, 0.2));
}

.mission-score-fab--pressed {
  opacity: 0.86;
  transform: scale(0.98);
}

.mission-score-fab-mark {
  width: 40rpx;
  height: 40rpx;
  display: block;
}

.theme-light .mission-pk-fab,
.theme-light .mission-score-fab {
  background: var(--bg-glass, rgba(255, 255, 255, 0.78));
  box-shadow: 0 8rpx 20rpx rgba(0, 0, 0, 0.08);
}

.theme-light .mission-pk-fab-mark,
.theme-light .mission-score-fab-mark {
  filter: invert(1);
}
