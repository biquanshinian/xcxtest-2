page {
  background: #0B0C0E;
  overflow: hidden;
  height: 100vh;
}

.map-page {
  position: relative;
  width: 100%;
  height: 100vh;
}

.map-page.theme-light {
  background: var(--color-bg-page, #F2F2F7);
}

.main-map {
  width: 100%;
  height: 100vh;
}

/* 空间站 marker 自定义 HUD（cover-view，深底青绿遥测风） */
/* HUD 气泡：暗玻璃 + 荧光绿描边（cover-view 仅支持基础样式，不用渐变/阴影/动画） */
.station-hud {
  min-width: 300rpx;
  padding: 16rpx 20rpx 18rpx;
  border-radius: 20rpx;
  background-color: #16181C;
  border: 1rpx solid rgba(44, 245, 155, 0.4);
}

.station-hud-top {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.station-hud-live-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background-color: #2CF59B;
  margin-right: 10rpx;
}

.station-hud-live {
  font-size: 18rpx;
  font-weight: 700;
  letter-spacing: 3rpx;
  color: #2CF59B;
}

.station-hud-title {
  margin-top: 8rpx;
  font-size: 26rpx;
  font-weight: 700;
  color: #ffffff;
  max-width: 360rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.station-hud-divider {
  margin: 12rpx 0 6rpx;
  height: 2rpx;
  background-color: rgba(255, 255, 255, 0.08);
}

.station-hud-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  margin-top: 6rpx;
}

.station-hud-k {
  width: 64rpx;
  font-size: 18rpx;
  font-weight: 700;
  color: rgba(139, 247, 199, 0.6);
  letter-spacing: 2rpx;
}

.station-hud-v {
  flex: 1;
  font-size: 23rpx;
  font-weight: 600;
  color: #F2FFF8;
  font-family: Menlo, Courier, monospace;
}

/* 坐标胶囊：与数值区分层，弱发光底 */
.station-hud-coord {
  margin-top: 12rpx;
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  background-color: rgba(44, 245, 155, 0.12);
  font-size: 19rpx;
  letter-spacing: 1rpx;
  color: #9BF7CC;
  font-family: Menlo, Courier, monospace;
}

.glass-card {
  background: var(--color-bg-card);
}

/* 轨道实时数据网格 */
.orbit-stats-grid {
  display: flex;
  gap: var(--space-xs);
  margin-top: var(--space-sm);
}

.orbit-stat-card {
  flex: 1;
  padding: 16rpx 12rpx;
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.04);
  text-align: center;
}

.orbit-stat-card-value {
  display: block;
  font-size: 26rpx;
  font-weight: 700;
  color: #ffffff;
  line-height: 1.3;
}

.orbit-stat-card-label {
  display: block;
  margin-top: 6rpx;
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.5);
}

/* 轨道参数详情 */
.orbit-detail-card {
  margin-top: 16rpx;
  padding: 16rpx 18rpx;
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.04);
}

.orbit-detail-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 10rpx 0;
  border-bottom: 1px solid rgba(255, 255, 255, 0.05);
}

.orbit-detail-row:last-child {
  border-bottom: none;
}

.orbit-detail-label {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.5);
}

.orbit-detail-value {
  font-size: 24rpx;
  color: #ffffff;
  font-family: 'Menlo', 'Courier New', monospace;
}

/* 图例 */
.orbit-legend-row {
  margin-top: 14rpx;
  display: flex;
  gap: 20rpx;
}

.legend-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.legend-line {
  width: 24rpx;
  height: 4rpx;
  border-radius: 2rpx;
}

.legend-line--future {
  height: 0;
  background: none;
  border-top: 4rpx dashed #12E896;
  border-radius: 0;
}

.legend-line--past {
  background: linear-gradient(90deg, rgba(78, 161, 255, 0.14), rgba(78, 161, 255, 0.62));
}

.legend-text {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.6);
}

/* 数据来源 */
.data-meta-row {
  margin-top: 14rpx;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.data-meta-text {
  color: rgba(255, 255, 255, 0.54);
  font-size: 20rpx;
  line-height: 1.4;
}

/* ========== 明亮主题（theme-light）覆盖 ========== */
.theme-light .glass-card {
  background: var(--color-bg-card);
}

.theme-light .orbit-stat-card {
  background: rgba(0, 0, 0, 0.04);
}

.theme-light .orbit-stat-card-value {
  color: var(--color-text-primary);
}

.theme-light .orbit-stat-card-label {
  color: var(--color-text-tertiary);
}

.theme-light .orbit-detail-card {
  background: rgba(0, 0, 0, 0.04);
}

.theme-light .orbit-detail-row {
  border-bottom-color: var(--color-divider);
}

.theme-light .orbit-detail-label {
  color: var(--color-text-tertiary);
}

.theme-light .orbit-detail-value {
  color: var(--color-text-primary);
}

.theme-light .legend-text {
  color: var(--color-text-secondary);
}

.theme-light .data-meta-text {
  color: var(--color-text-tertiary);
}
