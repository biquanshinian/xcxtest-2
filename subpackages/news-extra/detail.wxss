page {
  background: var(--color-bg-page);
  overflow: hidden;
  height: 100vh;
  width: 100%;
}

.detail-page {
  min-height: 100vh;
  height: 100vh;
  background: var(--color-bg-page);
  overflow: hidden;
}

.detail-scroll {
  height: 100vh;
}

.detail-container {
  padding: var(--space-xl) var(--space-lg);
  box-sizing: border-box;
}

.glass-card {
  background: var(--bg-glass);
  border-radius: var(--radius-card);
}

.detail-card {
  padding: var(--space-lg);
  /* 头图悬浮卡（hero-float）的毛玻璃叠层要露出卡外一段，不能被全局 .glass-card 的 overflow:hidden 裁剪 */
  overflow: visible;
}

/* 出框悬浮统一参数适配：本页头图在 detail-container(36rpx) + detail-card(36rpx) 双层横向内衬里，
 * 累计 T=72rpx ≠ 36rpx，全局 flush 的 -16rpx 只能落到屏边 56rpx，
 * 覆盖为 -52rpx 让最终落点 = 72 - 52 = 20rpx 屏边（总宽 710rpx，未超视口）。
 * 卡片上内边距 36rpx ≥ 32rpx，-32rpx 负上边距压不过卡顶（只会顶到距卡顶 4rpx 的尴尬位置），
 * 覆盖 margin-top: 0 保持卡内正常间距（不上浮）。 */
.detail-card .hero-float--flush {
  margin-top: 0;
  margin-left: -52rpx;
  margin-right: -52rpx;
}

/* 文章头图：与任务卡片详情一致，widthFix + 外层包裹自适应高度；
 * 外边距/下探叠层由 hero-float 承担，圆角与全局 hero-float-card 对齐 */
.hero-image-wrap {
  width: 100%;
  border-radius: var(--radius-lg);
  overflow: hidden;
  background: transparent;
  margin-bottom: 0;
  font-size: 0;
  line-height: 0;
}

.hero-image {
  display: block;
  width: 100%;
  background: var(--color-bg-elevated, #1A1C20);
}


.article-rich-body {
  display: block;
  font-size: var(--font-size-base);
  line-height: var(--line-height-relaxed);
  color: var(--color-text-secondary);
  word-break: break-word;
}

.meta-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-xs);
  margin-bottom: var(--space-sm);
}

.type-badge {
  max-width: 60%;
  padding: 8rpx 18rpx;
  border-radius: var(--radius-pill);
  background: var(--color-brand-soft);
  border: 1px solid rgba(59, 130, 246, 0.35);
  color: var(--color-brand);
  font-size: var(--font-size-sm);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.type-badge.article {
  background: rgba(59, 130, 246, 0.12);
  border-color: rgba(59, 130, 246, 0.28);
  color: var(--color-brand);
}

.date-text {
  font-size: 24rpx;
  color: var(--color-text-secondary);
  text-align: right;
}

.detail-title {
  display: block;
  font-size: var(--font-size-2xl);
  line-height: 1.45;
  font-weight: var(--font-weight-bold);
  color: var(--color-text-primary);
  margin-bottom: var(--space-lg);
}

/* 标题 + 翻译按钮同行（按钮不随标题换行拉伸） */
.detail-title-row {
  display: flex;
  align-items: flex-start;
  gap: var(--space-xs);
  margin-bottom: var(--space-lg);
}

.detail-title-row .detail-title {
  flex: 1;
  margin-bottom: 0;
}

.detail-title-row .translate-toggle {
  flex-shrink: 0;
  margin-top: 8rpx;
}

.info-grid {
  display: flex;
  flex-direction: column;
  gap: 0;
  margin-bottom: var(--space-lg);
}

.info-row {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: var(--space-md);
  padding: var(--space-sm) 0;
  border-bottom: 1px solid var(--color-divider-faint);
}

.info-row:last-child {
  border-bottom: none;
}

.info-label {
  font-size: 26rpx;
  color: var(--color-text-secondary);
  flex-shrink: 0;
}

.info-value {
  font-size: 26rpx;
  line-height: var(--line-height-normal);
  color: var(--color-text-primary);
  text-align: right;
  flex: 1;
}

.info-value.live {
  color: var(--color-danger);
  font-weight: var(--font-weight-semibold);
}

.section {
  margin-top: var(--space-lg);
}

.section-title {
  display: block;
  font-size: var(--font-size-md);
  font-weight: var(--font-weight-bold);
  color: var(--color-text-primary);
  margin-bottom: var(--space-sm);
}

.section-text {
  display: block;
  font-size: var(--font-size-base);
  line-height: var(--line-height-relaxed);
  color: var(--color-text-secondary);
  white-space: pre-wrap;
}

.link-list {
  display: flex;
  flex-direction: column;
  gap: var(--space-xs);
}

.link-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-sm);
  padding: var(--space-sm) var(--space-md);
  border-radius: var(--radius-card);
  background: var(--color-divider-faint);
  border: 1px solid var(--color-divider);
}

.link-item.single {
  margin-top: 4rpx;
}

.link-main {
  flex: 1;
  min-width: 0;
}

.link-title {
  display: block;
  font-size: var(--font-size-base);
  color: var(--color-text-primary);
  line-height: 1.5;
}

.link-sub {
  display: block;
  font-size: 24rpx;
  line-height: 1.5;
  color: var(--color-text-secondary);
  margin-top: 6rpx;
}

.link-action {
  flex-shrink: 0;
  font-size: 24rpx;
  color: var(--color-brand);
}

.loading-state,
.error-state {
  min-height: 50vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: var(--space-sm);
  text-align: center;
  padding: var(--space-xl) var(--space-lg);
  box-sizing: border-box;
}

.loading-spinner {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  border: 4rpx solid var(--color-brand-soft);
  border-top-color: var(--color-brand);
  animation: spin 0.8s linear infinite;
}

.loading-text,
.error-text {
  font-size: var(--font-size-base);
  line-height: var(--line-height-relaxed);
  color: var(--color-text-secondary);
}

.error-title {
  font-size: var(--font-size-xl);
  font-weight: var(--font-weight-bold);
  color: var(--color-text-primary);
}

.retry-btn {
  margin-top: var(--space-2xs);
  padding: 0 var(--space-lg);
  height: 76rpx;
  line-height: 76rpx;
  border-radius: var(--radius-pill);
  background: var(--color-brand);
  color: #ffffff;
  font-size: var(--font-size-base);
  border: none;
}

.retry-btn::after {
  border: none;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

/* ========== 明亮主题（theme-light）覆盖 ========== */

.detail-page.theme-light {
  background: var(--color-bg-page);
}

.theme-light .glass-card {
  background: var(--bg-glass);
}

.theme-light .hero-image {
  background: #E5E5EA;
}

.theme-light .article-rich-body {
  color: var(--color-text-primary);
}

.theme-light .section-text {
  color: var(--color-text-primary);
}

.theme-light .type-badge {
  background: var(--color-brand-soft);
  border: 1px solid rgba(59, 130, 246, 0.25);
  color: var(--color-brand);
}

.theme-light .type-badge.article {
  background: var(--color-brand-soft);
  border-color: rgba(59, 130, 246, 0.28);
  color: var(--color-brand);
}

.theme-light .date-text {
  color: var(--color-text-secondary);
}

.theme-light .detail-title {
  color: var(--color-text-primary);
}

.theme-light .info-row {
  border-bottom: 1px solid var(--color-divider);
}

.theme-light .info-row:last-child {
  border-bottom: none;
}

.theme-light .info-label {
  color: var(--color-text-secondary);
}

.theme-light .info-value {
  color: var(--color-text-primary);
}

.theme-light .section-title {
  color: var(--color-text-primary);
}

.theme-light .link-item {
  background: rgba(0, 0, 0, 0.04);
  border: 1px solid var(--color-divider);
}

.theme-light .link-title {
  color: var(--color-text-primary);
}

.theme-light .link-sub {
  color: var(--color-text-secondary);
}

.theme-light .link-action {
  color: var(--color-brand);
}

.theme-light .loading-spinner {
  border-top-color: var(--color-brand);
}

.theme-light .loading-text,
.theme-light .error-text {
  color: var(--color-text-secondary);
}

.theme-light .error-title {
  color: var(--color-text-primary);
}
