<page-meta background-color="{{pageBgColor}}" background-color-top="{{pageBgColor}}" background-color-bottom="{{pageBgColor}}" />
<view class="page {{themeClass}}">
  <!-- 自定义导航栏 -->
  <view class="top-nav-wrapper" style="padding-top:{{statusBarHeight}}px;">
    <view class="top-nav top-nav--page-grid">
      <view class="top-nav-slot--back {{isDirectEntry ? 'top-nav-slot--home' : ''}}" bindtap="goBack">
        <text class="icon-back icon-back--nav">‹</text>
      </view>
      <text class="nav-title nav-title--page-grid">现场抽奖</text>
      <view class="top-nav-slot--spacer"></view>
    </view>
  </view>

  <scroll-view class="page-scroll" scroll-y enhanced show-scrollbar="{{false}}">
    <view style="height: {{navPlaceholderHeight}}px;"></view>

    <!-- 加载 / 错误 -->
    <view class="gc-loading" wx:if="{{loading}}">
      <view class="loading-spinner-lg"></view>
      <text class="gc-loading-text">正在解锁抽奖资格…</text>
    </view>
    <view class="gc-error" wx:elif="{{error}}">
      <text class="gc-error-text">{{error}}</text>
      <view class="gc-retry-btn" bindtap="onRetry"><text>重试</text></view>
      <view class="gc-code-fallback">
        <text class="gc-code-fallback-tip">扫码不灵？输入现场物料上的场次码</text>
        <view class="gc-code-row">
          <textarea
            id="c_gacha_1" class="gc-code-input"
            value="{{codeInput}}"
            placeholder="如 wc01"
            placeholder-class="gc-code-ph"
            maxlength="10"
            confirm-type="done"
            bindinput="onCodeInput"
            bindconfirm="onSubmitCode" cursor-spacing="24" show-confirm-bar="{{false}}" disable-default-padding="{{true}}" data-single="1" bindkeyboardheightchange="onInputKeyboardHeightChange" bindblur="onInputBlur" />
          <view class="gc-code-btn" bindtap="onSubmitCode"><text>解锁</text></view>
        </view>
      </view>
    </view>

    <block wx:elif="{{session}}">
      <view class="gc-session">
        <text class="gc-session-title">{{session.title}}</text>
        <text class="gc-session-sub">{{session.rocketName}}{{session.missionName ? ' · ' + session.missionName : ''}}</text>
        <text class="gc-ssr-tip" wx:if="{{!session.prizeDrawEnabled}}">本场次未开放现场抽奖</text>
        <text class="gc-ssr-tip" wx:elif="{{!fromMaterial}}">请扫描现场物料码解锁抽奖（站内进入无效）</text>
        <text class="gc-ssr-tip" wx:elif="{{!successUnlocked}}">已扫码 · 等待商家确认发射成功后开放</text>
        <text class="gc-ssr-tip" wx:elif="{{session.prizeRemaining === 0}}">奖品已抽完</text>
      </view>

      <view class="gc-pass" wx:if="{{passExpireText}}">
        <view class="gc-pass-info">
          <text class="gc-pass-title">观礼通行证已生效</text>
          <text class="gc-pass-sub">星问AI会员功能免费畅用至 {{passExpireText}}</text>
        </view>
      </view>

      <!-- 奖品预览 -->
      <scroll-view class="gc-prize-scroll" scroll-x enhanced show-scrollbar="{{false}}" wx:if="{{session.prizeDrawEnabled && session.prizes.length}}">
        <view class="gc-prize-chip" wx:for="{{session.prizes}}" wx:key="id">
          <image class="gc-prize-chip-img" wx:if="{{item.image}}" src="{{item.image}}" mode="aspectFill" />
          <view class="gc-prize-chip-body">
            <text class="gc-prize-chip-name">{{item.name}}</text>
            <text class="gc-prize-chip-meta">剩{{item.remaining}}{{item.valueYuan != null ? ' · ¥' + item.valueYuan : ''}}</text>
          </view>
        </view>
      </scroll-view>

      <view class="gc-stage" wx:if="{{session.prizeDrawEnabled && fromMaterial && successUnlocked}}">
        <view class="gc-deck {{drawing ? 'gc-deck--shaking' : ''}}" bindtap="onDraw">
          <view class="gc-deck-card gc-deck-card--3"></view>
          <view class="gc-deck-card gc-deck-card--2"></view>
          <view class="gc-deck-card gc-deck-card--1">
            <text class="gc-deck-logo">✦</text>
            <text class="gc-deck-text">现场奖品</text>
          </view>
        </view>
        <view class="gc-draw-btn {{quota.remaining <= 0 || drawing || session.prizeRemaining === 0 ? 'gc-draw-btn--disabled' : ''}}" bindtap="onDraw">
          <text>{{drawing ? '抽取中…' : '抽一件'}}</text>
        </view>
        <text class="gc-quota-text">剩余次数：{{quota.remaining}} / 共{{quota.total}}次</text>
        <button class="gc-share-btn" open-type="share" wx:if="{{!shareBonusUsed}}">
          <text>分享给好友 · 加抽1次</text>
        </button>
      </view>

      <view class="gc-links">
        <view class="gc-link" bindtap="onGoAlbum"><text>我的奖品</text></view>
        <view class="gc-link" bindtap="onGoLanding"><text>观礼服务详情</text></view>
      </view>
      <view class="gc-rules">
        <text class="gc-rules-title">抽奖规则</text>
        <text class="gc-rules-item">· 须扫描现场物料码解锁 1 次；商家确认发射成功后开放抽取</text>
        <text class="gc-rules-item">· 分享好友可再加抽 1 次（每场一次）</text>
        <text class="gc-rules-item">· 奖品由观礼商家提供，按剩余库存加权；中奖后联系现场领取</text>
      </view>
    </block>

    <view class="page-footer">
      <text class="footer-text">Per Aspera Ad Astra · 循此苦旅以达星辰</text>
    </view>
    <view class="kb-pad" style="height: {{keyboardHeight}}px;"></view>
  </scroll-view>

  <!-- 抽奖结果覆盖层：票券式领奖凭证（分档视觉见 utils/prize-card.js） -->
  <view class="gc-overlay" wx:if="{{drawnCard}}" bindtap="onCloseCard">
    <!-- 翻面后：分档光晕；SR/SSR 追加星屑氛围 -->
    <view class="gc-halo gc-halo--{{drawnCard.tier}}" wx:if="{{flipped && drawnCard.tier !== 'N'}}"></view>
    <view class="gc-fx" wx:if="{{flipped && (drawnCard.tier === 'SR' || drawnCard.tier === 'SSR')}}">
      <text class="gc-fx-star gc-fx-star--1">✦</text>
      <text class="gc-fx-star gc-fx-star--2">✦</text>
      <text class="gc-fx-star gc-fx-star--3">✦</text>
      <text class="gc-fx-star gc-fx-star--4">✦</text>
      <text class="gc-fx-star gc-fx-star--5">✦</text>
      <text class="gc-fx-star gc-fx-star--6">✦</text>
    </view>
    <view class="gc-flip-wrap {{flipped ? 'gc-flip-wrap--punched' : ''}}" catchtap="onCloseCard">
      <view class="gc-flip {{flipped ? 'gc-flip--flipped' : ''}}">
        <view class="gc-face gc-face--back">
          <view class="gc-face-back-ring gc-face-back-ring--1"></view>
          <view class="gc-face-back-ring gc-face-back-ring--2"></view>
          <text class="gc-face-back-logo">✦</text>
          <text class="gc-face-back-text">现场奖品</text>
          <text class="gc-face-back-en">ROCKET WATCH PARTY</text>
        </view>
        <view class="gc-face gc-face--front pcard pcard--{{drawnCard.tier}}">
          <view class="pcard-shine"></view>
          <view class="pcard-head">
            <view class="pcard-brand">
              <text class="pcard-brand-mark">✦</text>
              <view class="pcard-brand-col">
                <text class="pcard-brand-name">火箭观礼</text>
                <text class="pcard-brand-en">ON-SITE PRIZE</text>
              </view>
            </view>
            <view class="pcard-tier pcard-tier--{{drawnCard.tier}}">
              <text>{{drawnCard.tierLabel}}</text>
            </view>
          </view>
          <view class="pcard-media">
            <image class="pcard-image" wx:if="{{drawnCard.image}}" src="{{drawnCard.image}}" mode="aspectFill" />
            <view class="pcard-image pcard-image--empty" wx:else>
              <text>✦</text>
            </view>
            <text class="pcard-media-en">{{drawnCard.tierEn}}</text>
            <view class="pcard-serial-chip" wx:if="{{drawnCard.serialText}}">
              <text>{{drawnCard.serialText}}</text>
            </view>
          </view>
          <text class="pcard-name">{{drawnCard.name}}</text>
          <view class="pcard-value" wx:if="{{drawnCard.valueYuan != null}}">
            <text class="pcard-value-sym">¥</text>
            <text class="pcard-value-num">{{drawnCard.valueYuan}}</text>
            <text class="pcard-value-note">奖品价值 · 商家提供</text>
          </view>
          <text class="pcard-desc" wx:elif="{{drawnCard.desc}}">{{drawnCard.desc}}</text>
          <view class="pcard-tear">
            <view class="pcard-tear-notch pcard-tear-notch--l"></view>
            <view class="pcard-tear-line"></view>
            <view class="pcard-tear-notch pcard-tear-notch--r"></view>
          </view>
          <view class="pcard-stub">
            <view class="pcard-stub-row" wx:if="{{drawnCard.sessionLine}}">
              <text class="pcard-stub-label">观礼场次</text>
              <text class="pcard-stub-value">{{drawnCard.sessionLine}}</text>
            </view>
            <view class="pcard-stub-row" wx:if="{{drawnCard.voucherNo || drawnCard.dateText}}">
              <text class="pcard-stub-label">领奖凭证</text>
              <text class="pcard-stub-value">{{drawnCard.voucherNo}}{{drawnCard.voucherNo && drawnCard.dateText ? ' · ' : ''}}{{drawnCard.dateText}}</text>
            </view>
            <text class="pcard-redeem">凭此卡向现场工作人员领取奖品</text>
          </view>
        </view>
      </view>
    </view>
    <view class="gc-overlay-actions" wx:if="{{flipped}}">
      <button class="gc-overlay-share" open-type="share" catchtap="">
        <text>炫耀一下</text>
      </button>
      <view class="gc-overlay-row">
        <view class="gc-overlay-btn" catchtap="onGoAlbum"><text>查看我的奖品</text></view>
        <view class="gc-overlay-btn gc-overlay-btn--ghost" wx:if="{{quota.remaining > 0}}" catchtap="onDraw"><text>再抽一件</text></view>
      </view>
    </view>
  </view>
</view>
