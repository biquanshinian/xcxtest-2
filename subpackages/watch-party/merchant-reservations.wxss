/* 商家中心 · 预约名单（简约，对齐 merchant 卡片语言） */

.page {
  min-height: 100vh;
  background: var(--color-bg);
  color: var(--color-text-primary);
  box-sizing: border-box;
}
.page-scroll {
  height: 100vh;
  width: 100%;
  box-sizing: border-box;
  padding-bottom: env(safe-area-inset-bottom);
}
.loading-spinner-lg {
  width: 56rpx;
  height: 56rpx;
  border: 4rpx solid var(--color-divider);
  border-top-color: #3B82F6;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}
@keyframes spin { to { transform: rotate(360deg); } }
.page-footer { text-align: center; padding: 24rpx 0 80rpx; }
.footer-text { font-size: 22rpx; color: var(--color-text-quaternary); }

.wpr-loading,
.wpr-error {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 160rpx 48rpx;
  gap: 20rpx;
}
.wpr-loading-text,
.wpr-error-text {
  font-size: 26rpx;
  color: var(--color-text-tertiary);
  text-align: center;
}
.wpr-retry-btn {
  margin-top: 8rpx;
  padding: 16rpx 64rpx;
  border-radius: 40rpx;
  background: #3B82F6;
  color: #fff;
  font-size: 28rpx;
}

.wpr-head {
  margin: 24rpx 32rpx 0;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}
.wpr-title {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--color-text-primary);
  line-height: 1.3;
}
.wpr-sub {
  font-size: 24rpx;
  color: var(--color-text-tertiary);
}

/* 汇总：一行四格，无卡片堆叠 */
.wpr-summary {
  margin: 24rpx 32rpx 0;
  padding: 28rpx 8rpx;
  border-radius: 20rpx;
  background: var(--color-bg-card);
  border: 1rpx solid var(--color-divider);
  display: flex;
}
.wpr-sum-cell {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}
.wpr-sum-num {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--color-text-primary);
  line-height: 1;
  font-variant-numeric: tabular-nums;
}
.wpr-sum-label {
  font-size: 22rpx;
  color: var(--color-text-tertiary);
}

.wpr-filters {
  margin: 24rpx 32rpx 0;
  display: flex;
  gap: 12rpx;
}
.wpr-filter {
  flex: 1;
  height: 60rpx;
  border-radius: 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: var(--color-text-tertiary);
  background: var(--color-bg-card);
  border: 1rpx solid var(--color-divider);
  box-sizing: border-box;
}
.wpr-filter--on {
  color: #fff;
  background: #3B82F6;
  border-color: #3B82F6;
  font-weight: 600;
}

.wpr-empty {
  margin: 40rpx 32rpx;
  padding: 64rpx 32rpx;
  border-radius: 20rpx;
  background: var(--color-bg-card);
  border: 1rpx dashed var(--color-divider);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
}
.wpr-empty-text {
  font-size: 28rpx;
  color: var(--color-text-secondary);
}
.wpr-empty-hint {
  font-size: 24rpx;
  color: var(--color-text-quaternary);
  text-align: center;
  line-height: 1.5;
}

.wpr-list {
  margin: 20rpx 32rpx 0;
  border-radius: 20rpx;
  background: var(--color-bg-card);
  border: 1rpx solid var(--color-divider);
  overflow: hidden;
}
.wpr-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 28rpx 24rpx;
  border-bottom: 1rpx solid var(--color-divider);
}
.wpr-row:last-child { border-bottom: none; }
.wpr-row-main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}
.wpr-row-top {
  display: flex;
  align-items: center;
  gap: 12rpx;
  min-width: 0;
}
.wpr-name {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-text-primary);
  max-width: 40%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.wpr-people {
  font-size: 24rpx;
  color: var(--color-text-tertiary);
  flex-shrink: 0;
}
.wpr-tag {
  margin-left: auto;
  height: 36rpx;
  padding: 0 14rpx;
  border-radius: 18rpx;
  font-size: 20rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  line-height: 1;
}
.wpr-tag--pending {
  color: #B45309;
  background: rgba(245, 158, 11, 0.14);
}
.wpr-tag--ok {
  color: #fff;
  background: #07C160;
}
.wpr-tag--off {
  color: var(--color-text-quaternary);
  background: var(--color-divider);
}
.wpr-row-mid {
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.wpr-phone {
  font-size: 26rpx;
  color: #60A5FA;
  letter-spacing: 0.5rpx;
}
.wpr-time {
  font-size: 22rpx;
  color: var(--color-text-quaternary);
}
.wpr-row-actions {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  flex-shrink: 0;
}
.wpr-act {
  min-width: 96rpx;
  height: 52rpx;
  padding: 0 20rpx;
  border-radius: 26rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: #60A5FA;
  background: rgba(59, 130, 246, 0.1);
  border: 1rpx solid rgba(96, 165, 250, 0.35);
  box-sizing: border-box;
}
.wpr-act--ok {
  color: #fff;
  background: #07C160;
  border-color: #07C160;
  font-weight: 600;
}

.wpr-more {
  padding: 28rpx 0 8rpx;
  text-align: center;
}
.wpr-more-text {
  font-size: 22rpx;
  color: var(--color-text-quaternary);
}

/* 浅色主题 */
.theme-light .wpr-filter--on {
  background: #2563EB;
  border-color: #2563EB;
}
.theme-light .wpr-phone { color: #2563EB; }
.theme-light .wpr-act {
  color: #2563EB;
  background: rgba(37, 99, 235, 0.08);
  border-color: rgba(37, 99, 235, 0.28);
}
.theme-light .wpr-act--ok {
  color: #fff;
  background: #07C160;
  border-color: #07C160;
}
.theme-light .wpr-tag--pending {
  color: #B45309;
  background: rgba(245, 158, 11, 0.12);
}
