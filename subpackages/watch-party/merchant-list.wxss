/* 用户端：同任务多商家选择列表 */

.page {
  min-height: 100vh;
  background: var(--color-bg);
  color: var(--color-text-primary);
  box-sizing: border-box;
}
.page-scroll {
  height: 100vh;
  width: 100%;
  box-sizing: border-box;
  padding-bottom: env(safe-area-inset-bottom);
}
.loading-spinner-lg {
  width: 56rpx;
  height: 56rpx;
  border: 4rpx solid var(--color-divider);
  border-top-color: #3B82F6;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}
@keyframes spin { to { transform: rotate(360deg); } }
.page-footer { text-align: center; padding: 40rpx 0 80rpx; }
.footer-text { display: block; font-size: 22rpx; color: var(--color-text-quaternary); }
/* 商家快捷入口：刻意低调，页脚同级灰字 + 足够点按区 */
.wpl-merchant-entry {
  display: inline-block;
  margin-top: 12rpx;
  padding: 14rpx 32rpx;
  font-size: 22rpx;
  color: var(--color-text-quaternary);
}
.wpl-merchant-entry--hover {
  opacity: 0.6;
}

.wpl-loading,
.wpl-error,
.wpl-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 48rpx;
  gap: 24rpx;
}
.wpl-loading-text,
.wpl-error-text,
.wpl-empty-text {
  font-size: 28rpx;
  color: var(--color-text-tertiary);
  text-align: center;
}
.wpl-retry-btn {
  margin-top: 8rpx;
  padding: 16rpx 40rpx;
  border-radius: 32rpx;
  background: #3B82F6;
  color: #fff;
  font-size: 26rpx;
}
.wpl-link {
  margin-top: 8rpx;
  font-size: 26rpx;
  color: #60A5FA;
}

.wpl-hero {
  padding: 24rpx 32rpx 8rpx;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}
.wpl-hero-label {
  font-size: 22rpx;
  color: var(--color-text-quaternary);
  letter-spacing: 2rpx;
}
.wpl-hero-title {
  font-size: 36rpx;
  font-weight: 600;
  color: var(--color-text-primary);
}
.wpl-hero-desc {
  font-size: 24rpx;
  color: var(--color-text-tertiary);
  line-height: 1.5;
}

/* ── 多任务：横滑任务筛选标签 ── */
.wpl-filter-bar {
  width: 100%;
  box-sizing: border-box;
  margin-top: 20rpx;
  padding: 0 32rpx;
  white-space: nowrap;
}
.wpl-filter-chip {
  display: inline-block;
  max-width: 420rpx;
  margin-right: 12rpx;
  padding: 10rpx 24rpx;
  border-radius: 30rpx;
  border: 1rpx solid var(--color-divider);
  background: var(--color-bg-card);
  color: var(--color-text-secondary);
  font-size: 24rpx;
  line-height: 40rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  vertical-align: top;
}
.wpl-filter-chip:last-child {
  margin-right: 32rpx;
}
.wpl-filter-chip--active {
  background: rgba(59, 130, 246, 0.14);
  border-color: rgba(59, 130, 246, 0.45);
  color: #60A5FA;
  font-weight: 600;
}

/* ── 多任务：任务分组头（标题 + 发射窗口/商家数） ── */
.wpl-group-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 16rpx;
  margin: 36rpx 32rpx 0;
}
.wpl-group-title {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-text-primary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.wpl-group-meta {
  flex-shrink: 0;
  font-size: 22rpx;
  color: var(--color-text-tertiary);
}

.wpl-card {
  margin: 20rpx 32rpx 0;
  padding: 24rpx;
  border-radius: 20rpx;
  background: var(--color-bg-card);
  border: 1rpx solid var(--color-divider);
}
.wpl-card-main {
  display: flex;
  align-items: center;
  gap: 20rpx;
}
.wpl-rocket {
  /* 竖版比例（≈0.73）与详情页英雄卡/商家中心一致，aspectFill 撑满无留白 */
  width: 96rpx;
  height: 132rpx;
  flex-shrink: 0;
  border-radius: 16rpx;
  background: rgba(59, 130, 246, 0.08);
  overflow: hidden;
}
.wpl-rocket--empty {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
}
.wpl-card-body {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}
.wpl-merchant {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-text-primary);
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.wpl-head { display: flex; align-items: center; gap: 12rpx; }
/* 商家头像：商家名前圆形小图；与火箭配置图一方一圆、尺寸悬殊，不致误看 */
.wpl-avatar {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  flex-shrink: 0;
  border: 1rpx solid var(--color-divider);
  background: rgba(148, 163, 184, 0.12);
}
.wpl-status {
  flex-shrink: 0;
  font-size: 20rpx;
  height: 38rpx;
  padding: 0 14rpx;
  border-radius: 19rpx;
  display: inline-flex;
  align-items: center;
}
.wpl-status--open { color: #34D399; background: rgba(52, 211, 153, 0.14); }
.wpl-status--closed { color: #FBBF24; background: rgba(251, 191, 36, 0.14); }
.wpl-status--off { color: var(--color-text-quaternary); background: rgba(148, 163, 184, 0.14); }
.wpl-time { font-size: 22rpx; color: var(--color-text-tertiary); }
.wpl-title {
  font-size: 24rpx;
  color: var(--color-text-secondary);
}
.wpl-sub {
  font-size: 22rpx;
  color: var(--color-text-tertiary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.wpl-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 6rpx;
}
.wpl-tag {
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  background: rgba(59, 130, 246, 0.12);
  color: #93C5FD;
}
.wpl-arrow {
  flex-shrink: 0;
  font-size: 36rpx;
  color: var(--color-text-quaternary);
  line-height: 1;
}

.theme-light .wpl-card {
  background: #fff;
  border-color: rgba(28, 28, 30, 0.08);
}
.theme-light .wpl-filter-chip {
  background: #fff;
  border-color: rgba(28, 28, 30, 0.08);
}
.theme-light .wpl-filter-chip--active {
  background: rgba(37, 99, 235, 0.08);
  border-color: rgba(37, 99, 235, 0.35);
  color: #2563EB;
}
.theme-light .wpl-tag {
  background: rgba(37, 99, 235, 0.1);
  color: #2563EB;
}
.theme-light .wpl-status--open { color: #059669; background: rgba(5, 150, 105, 0.1); }
.theme-light .wpl-status--closed { color: #B45309; background: rgba(180, 83, 9, 0.1); }
.theme-light .wpl-status--off { color: #6B7280; background: rgba(107, 114, 128, 0.1); }
.theme-light .wpl-link { color: #2563EB; }
