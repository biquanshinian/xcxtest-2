/* 用户端：同任务多商家选择列表 */

.page {
  min-height: 100vh;
  background: var(--color-bg);
  color: var(--color-text-primary);
  box-sizing: border-box;
}
.page-scroll {
  height: 100vh;
  width: 100%;
  box-sizing: border-box;
  padding-bottom: env(safe-area-inset-bottom);
}
.loading-spinner-lg {
  width: 56rpx;
  height: 56rpx;
  border: 4rpx solid var(--color-divider);
  border-top-color: #3B82F6;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}
@keyframes spin { to { transform: rotate(360deg); } }
.page-footer { text-align: center; padding: 40rpx 0 80rpx; }
.footer-text { font-size: 22rpx; color: var(--color-text-quaternary); }

.wpl-loading,
.wpl-error,
.wpl-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 48rpx;
  gap: 24rpx;
}
.wpl-loading-text,
.wpl-error-text,
.wpl-empty-text {
  font-size: 28rpx;
  color: var(--color-text-tertiary);
  text-align: center;
}
.wpl-retry-btn {
  margin-top: 8rpx;
  padding: 16rpx 40rpx;
  border-radius: 32rpx;
  background: #3B82F6;
  color: #fff;
  font-size: 26rpx;
}
.wpl-link {
  margin-top: 8rpx;
  font-size: 26rpx;
  color: #60A5FA;
}

.wpl-hero {
  padding: 24rpx 32rpx 8rpx;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}
.wpl-hero-label {
  font-size: 22rpx;
  color: var(--color-text-quaternary);
  letter-spacing: 2rpx;
}
.wpl-hero-title {
  font-size: 36rpx;
  font-weight: 600;
  color: var(--color-text-primary);
}
.wpl-hero-desc {
  font-size: 24rpx;
  color: var(--color-text-tertiary);
  line-height: 1.5;
}

.wpl-card {
  margin: 20rpx 32rpx 0;
  padding: 24rpx;
  border-radius: 20rpx;
  background: var(--color-bg-card);
  border: 1rpx solid var(--color-divider);
}
.wpl-card-main {
  display: flex;
  align-items: center;
  gap: 20rpx;
}
.wpl-rocket {
  width: 96rpx;
  height: 96rpx;
  flex-shrink: 0;
  border-radius: 16rpx;
  background: rgba(59, 130, 246, 0.08);
}
.wpl-rocket--empty {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
}
.wpl-card-body {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}
.wpl-merchant {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-text-primary);
}
.wpl-title {
  font-size: 24rpx;
  color: var(--color-text-secondary);
}
.wpl-sub {
  font-size: 22rpx;
  color: var(--color-text-tertiary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.wpl-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 6rpx;
}
.wpl-tag {
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  background: rgba(59, 130, 246, 0.12);
  color: #93C5FD;
}
.wpl-arrow {
  flex-shrink: 0;
  font-size: 36rpx;
  color: var(--color-text-quaternary);
  line-height: 1;
}

.theme-light .wpl-card {
  background: #fff;
  border-color: rgba(28, 28, 30, 0.08);
}
.theme-light .wpl-tag {
  background: rgba(37, 99, 235, 0.1);
  color: #2563EB;
}
.theme-light .wpl-link { color: #2563EB; }
