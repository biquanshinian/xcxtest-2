/* 火箭观礼服务落地页
 * 中性色走 tokens.wxss 变量（根节点 themeClass 挂 theme-light 时自动翻转），
 * 彩色强调色在文件末尾集中做 .theme-light 覆盖。
 */

/* 页面骨架（与其他分包详情页同款） */
.page {
  min-height: 100vh;
  background: var(--color-bg);
  color: var(--color-text-primary);
  /* 与星问 AI 详情页一致：键盘高度靠 padding-bottom 上收 */
  transition: padding-bottom 0.22s ease;
  box-sizing: border-box;
}
.page-scroll { height: 100vh; width: 100%; box-sizing: border-box; padding-bottom: env(safe-area-inset-bottom); }
.section-header { display: flex; align-items: center; padding: 40rpx 32rpx 20rpx; gap: 12rpx; }
.section-title { font-size: 32rpx; font-weight: 600; color: var(--color-text-primary); flex: 1; }
.loading-spinner-lg { width: 56rpx; height: 56rpx; border: 4rpx solid var(--color-divider); border-top-color: #3B82F6; border-radius: 50%; animation: spin 0.8s linear infinite; }
@keyframes spin { to { transform: rotate(360deg); } }
.page-footer { text-align: center; padding: 40rpx 0 80rpx; }
.footer-text { font-size: 22rpx; color: var(--color-text-quaternary); }

.wp-loading {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 160rpx 0;
  gap: 24rpx;
}

.wp-loading-text {
  font-size: 26rpx;
  color: var(--color-text-tertiary);
}

.wp-error {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 140rpx 48rpx;
  gap: 20rpx;
}

.wp-error-text {
  font-size: 28rpx;
  color: var(--color-text-secondary);
  text-align: center;
}

.wp-retry-btn {
  margin-top: 12rpx;
  padding: 16rpx 64rpx;
  border-radius: 40rpx;
  background: #3B82F6;
  color: #fff;
  font-size: 28rpx;
}
.wp-retry-btn--ghost {
  background: transparent;
  border: 1rpx solid rgba(96, 165, 250, 0.45);
  color: #60A5FA;
}
.theme-light .wp-retry-btn--ghost {
  border-color: rgba(37, 99, 235, 0.35);
  color: #2563EB;
}

/* ── 头卡 ── */
.wp-hero {
  position: relative;
  margin: 24rpx 32rpx 0;
  padding: 44rpx 36rpx 40rpx;
  border-radius: 28rpx;
  background:
    radial-gradient(120% 90% at 88% -12%, rgba(99, 102, 241, 0.32), transparent 55%),
    radial-gradient(90% 70% at 0% 105%, rgba(59, 130, 246, 0.12), transparent 62%),
    linear-gradient(165deg, #131a33 0%, #0b0c0e 64%);
  border: 1rpx solid rgba(96, 165, 250, 0.3);
  box-shadow: 0 16rpx 48rpx rgba(8, 12, 34, 0.45);
  overflow: hidden;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

/* 装饰层（纯展示，不响应触摸） */
.wp-hero-fx {
  position: absolute;
  pointer-events: none;
}

.wp-hero-fx--glow {
  top: -180rpx;
  right: -140rpx;
  width: 560rpx;
  height: 560rpx;
  background: radial-gradient(closest-side, rgba(99, 102, 241, 0.35), rgba(99, 102, 241, 0.1) 55%, transparent 75%);
}

.wp-hero-fx--topline {
  top: 0;
  left: 36rpx;
  right: 36rpx;
  height: 2rpx;
  background: linear-gradient(90deg, transparent, rgba(147, 197, 253, 0.75), transparent);
}

.wp-hero-top {
  position: relative;
  display: flex;
  align-items: flex-start;
  gap: 26rpx;
  min-width: 0;
}

.wp-hero-rocket {
  position: relative;
  width: 132rpx;
  height: 186rpx;
  flex-shrink: 0;
  border-radius: 20rpx;
  overflow: hidden;
  background: linear-gradient(180deg, rgba(59, 130, 246, 0.16), rgba(255, 255, 255, 0.04));
  border: 1rpx solid rgba(147, 197, 253, 0.35);
  box-shadow: 0 12rpx 32rpx rgba(59, 130, 246, 0.22);
}

.wp-hero-rocket-shine {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(200deg, rgba(255, 255, 255, 0.16) 0%, transparent 32%);
  pointer-events: none;
}

/* 对齐 styles/mission-card .mission-rocket-image：等比例放大居中撑满槽位 */
.wp-hero-rocket-img {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  min-width: 0;
  object-fit: cover;
  object-position: center center;
  display: block;
}

.wp-hero-meta {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.wp-hero-badge {
  align-self: flex-start;
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 8rpx 22rpx;
  border-radius: 999rpx;
  background: linear-gradient(90deg, rgba(59, 130, 246, 0.22), rgba(168, 85, 247, 0.16));
  border: 1rpx solid rgba(147, 197, 253, 0.4);
}

.wp-hero-badge text {
  font-size: 22rpx;
  color: #BFDBFE;
  letter-spacing: 1rpx;
}

.wp-hero-badge-dot {
  flex-shrink: 0;
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: #60A5FA;
  box-shadow: 0 0 12rpx rgba(96, 165, 250, 0.9);
  animation: wp-dot-pulse 2s ease-in-out infinite;
}

.wp-hero-title {
  font-size: 42rpx;
  font-weight: 800;
  color: #fff;
  margin-top: 4rpx;
  line-height: 1.22;
  letter-spacing: 1rpx;
}

.wp-hero-mission {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.65);
}

.wp-hero-time {
  font-size: 26rpx;
  font-weight: 600;
  color: #FBBF24;
}

.wp-hero-merchant {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.45);
  margin-top: 4rpx;
}

/* ── 倒计时：发射控制台风格 ── */
.wp-countdown {
  position: relative;
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  margin-top: 24rpx;
}

.wp-cd-head {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.wp-cd-live-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: #34D399;
  box-shadow: 0 0 12rpx rgba(52, 211, 153, 0.9);
  animation: wp-dot-pulse 2s ease-in-out infinite;
}

.wp-cd-caption {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.55);
  letter-spacing: 3rpx;
}

.wp-cd-row {
  display: flex;
  align-items: stretch;
  gap: 8rpx;
}

.wp-cd-cell {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 18rpx 0 14rpx;
  border-radius: 18rpx;
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.1), rgba(255, 255, 255, 0.03));
  border: 1rpx solid rgba(255, 255, 255, 0.09);
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.14);
}

.wp-cd-cell--secs {
  background: linear-gradient(180deg, rgba(59, 130, 246, 0.22), rgba(59, 130, 246, 0.06));
  border-color: rgba(96, 165, 250, 0.4);
}

.wp-cd-num {
  font-size: 48rpx;
  font-weight: 800;
  color: #fff;
  font-variant-numeric: tabular-nums;
  text-shadow: 0 0 24rpx rgba(96, 165, 250, 0.4);
  line-height: 1.15;
}

.wp-cd-num--secs {
  color: #93C5FD;
}

.wp-cd-label {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.45);
  margin-top: 4rpx;
}

.wp-cd-sep {
  align-self: center;
  padding-bottom: 26rpx;
  font-size: 36rpx;
  font-weight: 700;
  color: rgba(147, 197, 253, 0.45);
}

.wp-cd-done {
  margin-top: 20rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: #34D399;
  text-shadow: 0 0 20rpx rgba(52, 211, 153, 0.4);
}

@keyframes wp-dot-pulse {
  0%, 100% { opacity: 0.45; transform: scale(0.85); }
  50% { opacity: 1; transform: scale(1); }
}

/* ── 抽卡入口 ── */
/* ── 奖品入口组（现场抽奖 / 我的奖品）：规整的分组入口卡 ── */
.wp-entry-card {
  margin: 24rpx 32rpx 0;
  padding: 8rpx 28rpx;
  border-radius: 24rpx;
  background: var(--color-bg-card);
  border: 1rpx solid var(--color-border-glass);
}

.wp-entry-row {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 24rpx 4rpx;
}

.wp-entry-icon {
  flex-shrink: 0;
  width: 76rpx;
  height: 76rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.wp-entry-icon text {
  font-size: 32rpx;
  font-weight: 700;
  color: #fff;
}

.wp-entry-icon--gacha {
  background: linear-gradient(135deg, #A855F7, #6366F1);
}

.wp-entry-icon--album {
  background: linear-gradient(135deg, #F59E0B, #EF4444);
}

.wp-entry-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.wp-entry-title {
  font-size: 29rpx;
  font-weight: 600;
  color: var(--color-text-primary);
}

.wp-entry-desc {
  font-size: 23rpx;
  color: var(--color-text-tertiary);
}

.wp-entry-arrow {
  font-size: 44rpx;
  color: var(--color-text-quaternary);
}

/* ── 无开放场次空态 ── */
.wp-empty {
  margin: 120rpx 40rpx 8rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
}
.wp-empty-title {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--color-text-primary);
}
.wp-empty-desc {
  font-size: 26rpx;
  line-height: 1.6;
  text-align: center;
  color: var(--color-text-tertiary);
}
/* 现场大屏模式入口（商家工作人员用，弱化展示） */
.wp-screen-link {
  margin: 32rpx 32rpx 0;
  padding: 20rpx 0;
  text-align: center;
  font-size: 24rpx;
  color: var(--color-text-tertiary);
}

/* ── 通用卡片 ── */
.wp-card {
  margin: 16rpx 32rpx 0;
  padding: 28rpx 32rpx;
  border-radius: 24rpx;
  background: var(--color-bg-card);
  border: 1rpx solid var(--color-divider);
}

.wp-divider {
  height: 1rpx;
  background: var(--color-divider);
  margin: 20rpx 0;
}

.wp-rich-text {
  font-size: 26rpx;
  line-height: 1.7;
  color: var(--color-text-secondary);
  white-space: pre-wrap;
}

/* ── 服务标签 ── */
.wp-svc-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}
.wp-svc-tag {
  font-size: 24rpx;
  line-height: 1.4;
  padding: 10rpx 20rpx;
  border-radius: 12rpx;
  background: rgba(59, 130, 246, 0.12);
  color: #93C5FD;
}

/* ── 微信群二维码 ── */
.wp-qr-block {
  margin-top: 28rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
}
.wp-qr-label {
  font-size: 26rpx;
  color: var(--color-text-secondary);
}
.wp-qr-img {
  width: 280rpx;
  height: 280rpx;
  border-radius: 16rpx;
  background: #fff;
}
.wp-qr-hint {
  font-size: 22rpx;
  color: var(--color-text-quaternary);
}
.wp-qr-list {
  display: flex;
  gap: 24rpx;
  justify-content: center;
  flex-wrap: wrap;
}

/* ── 联系商家：微信好友二维码弹层 ── */
.wp-contact-mask {
  position: fixed;
  left: 0; right: 0; top: 0; bottom: 0;
  z-index: 1000;
  background: rgba(0, 0, 0, 0.55);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48rpx;
  box-sizing: border-box;
}
.wp-contact-sheet {
  width: 100%;
  max-width: 560rpx;
  background: var(--color-bg-card);
  border-radius: 24rpx;
  padding: 40rpx 36rpx 32rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  box-sizing: border-box;
}
.wp-contact-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--color-text-primary);
}
.wp-contact-sub {
  font-size: 24rpx;
  color: var(--color-text-secondary);
  text-align: center;
}
.wp-contact-qr {
  width: 360rpx;
  height: 360rpx;
  margin-top: 12rpx;
  border-radius: 16rpx;
  background: #fff;
}
.wp-contact-hint {
  font-size: 22rpx;
  color: var(--color-text-quaternary);
}
.wp-contact-close {
  margin-top: 12rpx;
  padding: 16rpx 64rpx;
  border-radius: 40rpx;
  background: rgba(255, 255, 255, 0.08);
}
.wp-contact-close text {
  font-size: 28rpx;
  color: var(--color-text-secondary);
}
.theme-light .wp-contact-close { background: rgba(0, 0, 0, 0.06); }

/* 合作申请内上传微信好友二维码 */
.wp-coop-qr {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}
.wp-coop-qr-label {
  font-size: 24rpx;
  color: var(--color-text-tertiary);
}
.wp-coop-qr-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
}
.wp-coop-qr-img {
  width: 120rpx;
  height: 120rpx;
  border-radius: 12rpx;
  background: #fff;
}
.wp-coop-qr-actions {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}
.wp-coop-qr-link {
  font-size: 26rpx;
  color: #60A5FA;
}
.wp-coop-qr-add {
  padding: 24rpx;
  border-radius: 16rpx;
  border: 1rpx dashed var(--color-divider);
  text-align: center;
}
.wp-coop-qr-add text {
  font-size: 26rpx;
  color: var(--color-text-secondary);
}
.theme-light .wp-coop-qr-link { color: #2563EB; }

/* ── 现场照片 / 现场视频 ── */
.wp-media-label {
  display: block;
  font-size: 26rpx;
  color: var(--color-text-secondary);
  margin-bottom: 16rpx;
}
.wp-site-photos { margin-top: 28rpx; }
.wp-site-photo-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}
.wp-site-photo {
  width: 200rpx;
  height: 200rpx;
  border-radius: 12rpx;
  background: var(--color-divider);
}
.wp-site-video { margin-top: 28rpx; }
.wp-site-video-player {
  width: 100%;
  height: 360rpx;
  border-radius: 16rpx;
  background: #000;
}
.wp-site-video-cover {
  position: relative;
  width: 100%;
  height: 360rpx;
  border-radius: 16rpx;
  overflow: hidden;
  background: #000;
}
.wp-site-video-poster {
  width: 100%;
  height: 100%;
}
.wp-site-video-poster--empty {
  background: linear-gradient(135deg, #1a1f2e, #0e1220);
}
.wp-site-video-play {
  position: absolute;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.55);
  border: 2rpx solid rgba(255, 255, 255, 0.6);
  display: flex;
  align-items: center;
  justify-content: center;
}
.wp-site-video-play text {
  color: #fff;
  font-size: 36rpx;
  margin-left: 6rpx;
}

/* ── 位置导航 ── */
.wp-loc-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.wp-loc-main {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  min-width: 0;
}

.wp-loc-name {
  font-size: 28rpx;
  color: var(--color-text-primary);
}

.wp-loc-sub {
  font-size: 22rpx;
  color: var(--color-text-tertiary);
}

.wp-loc-btn {
  flex-shrink: 0;
  padding: 12rpx 32rpx;
  border-radius: 32rpx;
  background: #07C160;
  color: #fff;
  font-size: 24rpx;
}

.wp-loc-btn text {
  color: #fff;
}

/* ── 预约 ── */
/* ── 我的预约：凭证卡 ── */
.wp-reserved-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.wp-reserved-status text {
  font-size: 30rpx;
  font-weight: 600;
  color: #34D399;
}

.wp-reserved-status--in text {
  color: #60A5FA;
}

.wp-reserved-code {
  display: flex;
  align-items: baseline;
  gap: 10rpx;
  padding: 8rpx 20rpx;
  border-radius: 16rpx;
  background: rgba(52, 211, 153, 0.12);
}

.wp-reserved-code-label {
  font-size: 22rpx;
  color: var(--color-text-tertiary);
}

.wp-reserved-code-num {
  font-size: 32rpx;
  font-weight: 700;
  letter-spacing: 3rpx;
  color: #34D399;
  font-variant-numeric: tabular-nums;
}

.wp-reserved-rows {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.wp-reserved-line {
  display: flex;
  gap: 20rpx;
}

.wp-reserved-k {
  flex-shrink: 0;
  width: 130rpx;
  font-size: 25rpx;
  color: var(--color-text-tertiary);
}

.wp-reserved-v {
  flex: 1;
  font-size: 25rpx;
  color: var(--color-text-primary);
}

.wp-reserved-hint {
  display: block;
  margin-top: 16rpx;
  font-size: 22rpx;
  color: var(--color-text-quaternary);
}

.wp-reserved-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 24rpx;
}

.wp-rsv-btn {
  flex: 1;
  height: 68rpx;
  border-radius: 34rpx;
  border: 1rpx solid var(--color-divider-strong);
  display: flex;
  align-items: center;
  justify-content: center;
}

.wp-rsv-btn text {
  font-size: 25rpx;
  color: var(--color-text-secondary);
}

.wp-rsv-btn--warn {
  border-color: rgba(248, 113, 113, 0.4);
}

.wp-rsv-btn--warn text {
  color: #F87171;
}

.wp-form-row {
  display: flex;
  align-items: center;
  min-height: 88rpx;
  gap: 24rpx;
}

.wp-form-label {
  width: 160rpx;
  flex-shrink: 0;
  font-size: 26rpx;
  line-height: 44rpx;
  color: var(--color-text-secondary);
}

.wp-form-input {
  flex: 1;
  min-width: 0;
  width: auto;
  height: 88rpx;
  min-height: 88rpx;
  /* 单行 textarea：行高 + 上下 padding 垂直居中 */
  line-height: 40rpx;
  padding: 24rpx 0;
  font-size: 28rpx;
  /* 原生输入组件：CSS 变量在聚焦输入时经常失效（回落系统黑字 → 深色底看不见），须字面色 */
  color: #F5F5F7;
  caret-color: #F5F5F7;
  box-sizing: border-box;
}

.wp-form-ph {
  /* 同原生输入组件：placeholder-class 上 var() 不可靠 */
  color: #5A5A5E;
}

.wp-form-slider {
  flex: 1;
  margin: 0;
  /* show-value 数字：部分基础库继承 color，深色页用字面浅色 */
  color: #F5F5F7;
}

.wp-submit-btn {
  margin-top: 32rpx;
  padding: 22rpx 0;
  border-radius: 44rpx;
  background: linear-gradient(90deg, #3B82F6, #6366F1);
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
  text-align: center;
}

.wp-submit-btn--disabled {
  opacity: 0.5;
}

.wp-form-note {
  display: block;
  margin-top: 20rpx;
  font-size: 22rpx;
  line-height: 1.6;
  color: var(--color-text-tertiary);
}

/* ── 同行商家合作申请 ── */
.wp-coop {
  margin: 40rpx 32rpx 0;
  border-radius: 20rpx;
  background: var(--color-bg-card);
  border: 1rpx solid var(--color-divider);
  overflow: hidden;
}

.wp-coop-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 28rpx;
}

.wp-coop-head-left {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.wp-coop-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-text-primary);
}

.wp-coop-sub {
  font-size: 22rpx;
  color: var(--color-text-tertiary);
}

.wp-coop-chevron {
  font-size: 24rpx;
  color: var(--color-text-tertiary);
}

.wp-coop-body {
  padding: 0 28rpx 28rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.wp-input {
  display: block;
  width: 100%;
  height: 80rpx;
  min-height: 80rpx;
  /* 单行 textarea：行高 + 上下 padding 垂直居中 */
  line-height: 40rpx;
  padding: 20rpx 24rpx;
  border-radius: 14rpx;
  background: rgba(255, 255, 255, 0.06);
  border: 1rpx solid var(--color-divider-strong);
  color: #F5F5F7;
  caret-color: #F5F5F7;
  font-size: 28rpx;
  box-sizing: border-box;
}

/* 原生 input/textarea 占位色不继承 color，必须单独指定；浅色用字面色避免 var 在 placeholder 上失效 */
/* 注意：不要给 placeholder-class 写固定行高，单行/多行共用时会错位 */
.wp-input-ph {
  color: rgba(255, 255, 255, 0.35);
}

.wp-textarea {
  height: 140rpx;
  min-height: 140rpx;
  line-height: 1.5;
  padding: 20rpx 24rpx;
  width: auto;
  box-sizing: border-box;
}

.wp-coop-hint {
  font-size: 22rpx;
  color: rgba(251, 191, 36, 0.7);
  text-align: center;
}

.wp-coop-done {
  display: block;
  padding: 20rpx 0;
  font-size: 28rpx;
  color: #34D399;
  text-align: center;
}

.wp-closed-text {
  font-size: 26rpx;
  color: var(--color-text-secondary);
  line-height: 1.7;
}

/* ── 朋友圈单页模式引导 ── */
.wp-single {
  margin: 120rpx 48rpx 0;
  padding: 72rpx 48rpx;
  border-radius: 28rpx;
  background: var(--color-bg-card);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 24rpx;
  text-align: center;
}
.wp-single-icon { font-size: 72rpx; }
.wp-single-title { font-size: 34rpx; font-weight: 700; color: #F5F5F7; }
.wp-single-desc { font-size: 26rpx; color: var(--color-text-secondary); line-height: 1.9; }
.theme-light .wp-single-title { color: #1C1C1E; }

/* 预约截止后的电话兜底入口 */
.wp-closed-call {
  margin-top: 20rpx;
  height: 80rpx;
  border-radius: 40rpx;
  border: 1rpx solid rgba(96, 165, 250, 0.45);
  display: flex;
  align-items: center;
  justify-content: center;
}
.wp-closed-call text { font-size: 26rpx; color: #60A5FA; }
.theme-light .wp-closed-call { border-color: rgba(37, 99, 235, 0.35); }
.theme-light .wp-closed-call text { color: #2563EB; }

/* ── 本观礼点·更多场次 ── */
.wp-others { padding-top: 8rpx; padding-bottom: 8rpx; }
.wp-other-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 24rpx 0;
}
.wp-other-row + .wp-other-row { border-top: 1rpx solid var(--color-divider-faint); }
.wp-other-main { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 6rpx; }
.wp-other-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #F5F5F7;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.wp-other-sub {
  font-size: 24rpx;
  color: var(--color-text-secondary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.wp-other-time { font-size: 22rpx; color: var(--color-text-quaternary); }
.wp-other-side { flex-shrink: 0; display: flex; align-items: center; gap: 10rpx; }
.wp-other-tag {
  font-size: 20rpx;
  height: 40rpx;
  padding: 0 16rpx;
  border-radius: 20rpx;
  display: inline-flex;
  align-items: center;
}
.wp-other-tag--open { color: #34D399; background: rgba(52, 211, 153, 0.14); }
.wp-other-tag--closed { color: #FBBF24; background: rgba(251, 191, 36, 0.14); }
.wp-other-tag--off { color: var(--color-text-quaternary); background: rgba(148, 163, 184, 0.14); }
.wp-other-arrow { font-size: 32rpx; color: var(--color-text-quaternary); }

.theme-light .wp-other-title { color: #1C1C1E; }
.theme-light .wp-other-tag--open { color: #059669; background: rgba(5, 150, 105, 0.1); }
.theme-light .wp-other-tag--closed { color: #B45309; background: rgba(180, 83, 9, 0.1); }
.theme-light .wp-other-tag--off { color: #6B7280; background: rgba(107, 114, 128, 0.1); }

/* ── 分享 ── */
.wp-share-wrap {
  margin: 32rpx 32rpx 0;
}

.wp-share-btn {
  width: 100%;
  padding: 22rpx 0;
  border-radius: 44rpx;
  background: rgba(255, 255, 255, 0.08);
  border: 1rpx solid var(--color-divider-strong);
  color: var(--color-text-primary);
  font-size: 28rpx;
  line-height: 1.4;
}

.wp-share-btn::after {
  border: none;
}

/* ============================================================
 * 明亮主题覆盖：彩色强调与深色专属背景
 * ============================================================ */

/* 头卡：浅蓝渐变白底，保留蓝色系点缀 */
.theme-light .wp-hero {
  background:
    radial-gradient(120% 90% at 88% -12%, rgba(99, 102, 241, 0.14), transparent 55%),
    radial-gradient(90% 70% at 0% 105%, rgba(59, 130, 246, 0.07), transparent 62%),
    linear-gradient(165deg, #FDFEFF 0%, #F1F5FC 70%);
  border-color: rgba(59, 130, 246, 0.2);
  box-shadow: 0 12rpx 36rpx rgba(30, 58, 138, 0.1);
}

.theme-light .wp-hero-fx--glow { opacity: 0.45; }
.theme-light .wp-hero-fx--topline {
  background: linear-gradient(90deg, transparent, rgba(59, 130, 246, 0.4), transparent);
}

.theme-light .wp-hero-badge {
  background: linear-gradient(90deg, rgba(59, 130, 246, 0.1), rgba(168, 85, 247, 0.08));
  border-color: rgba(59, 130, 246, 0.3);
}

.theme-light .wp-hero-badge text { color: #1D4ED8; }
.theme-light .wp-hero-badge-dot {
  background: #2563EB;
  box-shadow: 0 0 10rpx rgba(37, 99, 235, 0.55);
}

.theme-light .wp-hero-title { color: #101828; }
.theme-light .wp-hero-mission { color: rgba(28, 28, 30, 0.62); }
.theme-light .wp-hero-time { color: #B45309; }
.theme-light .wp-hero-merchant { color: rgba(28, 28, 30, 0.45); }
.theme-light .wp-hero-rocket {
  background: linear-gradient(180deg, rgba(59, 130, 246, 0.08), rgba(255, 255, 255, 0.65));
  border-color: rgba(59, 130, 246, 0.22);
  box-shadow: 0 10rpx 28rpx rgba(59, 130, 246, 0.16);
}

.theme-light .wp-hero-rocket-shine {
  background: linear-gradient(200deg, rgba(255, 255, 255, 0.5) 0%, transparent 32%);
}

.theme-light .wp-cd-caption { color: rgba(28, 28, 30, 0.5); }
.theme-light .wp-cd-live-dot {
  background: #059669;
  box-shadow: 0 0 10rpx rgba(5, 150, 105, 0.5);
}

.theme-light .wp-cd-cell {
  background: #FFFFFF;
  border-color: rgba(59, 130, 246, 0.14);
  box-shadow: 0 4rpx 16rpx rgba(30, 58, 138, 0.07), inset 0 1rpx 0 #FFFFFF;
}

.theme-light .wp-cd-cell--secs {
  background: linear-gradient(180deg, rgba(59, 130, 246, 0.1), rgba(59, 130, 246, 0.02));
  border-color: rgba(59, 130, 246, 0.3);
}

.theme-light .wp-cd-num {
  color: #101828;
  text-shadow: none;
}

.theme-light .wp-cd-num--secs { color: #2563EB; }
.theme-light .wp-cd-label { color: rgba(28, 28, 30, 0.45); }
.theme-light .wp-cd-sep { color: rgba(37, 99, 235, 0.35); }
.theme-light .wp-cd-done {
  color: #059669;
  text-shadow: none;
}

/* 抽卡入口横幅 */
.theme-light .wp-entry-card {
  box-shadow: var(--shadow-card);
}

.theme-light .wp-loc-btn {
  background: #07C160;
  color: #fff;
}

.theme-light .wp-loc-btn text {
  color: #fff;
}

.theme-light .wp-svc-tag {
  background: rgba(37, 99, 235, 0.1);
  color: #2563EB;
}

.theme-light .wp-reserved-status text { color: #059669; }
.theme-light .wp-reserved-status--in text { color: #2563EB; }
.theme-light .wp-reserved-code { background: rgba(5, 150, 105, 0.08); }
.theme-light .wp-reserved-code-num { color: #059669; }
.theme-light .wp-rsv-btn--warn { border-color: rgba(220, 38, 38, 0.35); }
.theme-light .wp-rsv-btn--warn text { color: #DC2626; }
.theme-light .wp-coop-done { color: #059669; }
.theme-light .wp-coop-hint { color: #B45309; }

.theme-light .wp-input {
  background: rgba(0, 0, 0, 0.04);
  color: #1C1C1E;
  caret-color: #1C1C1E;
  border-color: rgba(0, 0, 0, 0.1);
}
.theme-light .wp-input-ph { color: #8E8E93; }
.theme-light .wp-form-ph { color: #8E8E93; }
.theme-light .wp-form-input {
  color: #1C1C1E;
  caret-color: #1C1C1E;
}
.theme-light .wp-form-slider { color: #1C1C1E; }

.theme-light .wp-share-btn {
  background: rgba(0, 0, 0, 0.05);
  color: #1C1C1E;
  border-color: rgba(0, 0, 0, 0.1);
}
