<page-meta background-color="{{pageBgColor}}" background-color-top="{{pageBgColor}}" background-color-bottom="{{pageBgColor}}" />
<view class="page {{themeClass}}">
  <view class="top-nav-wrapper" style="padding-top:{{statusBarHeight}}px;">
    <view class="top-nav top-nav--page-grid">
      <view class="top-nav-slot--back {{isDirectEntry ? 'top-nav-slot--home' : ''}}" bindtap="goBack">
        <text class="icon-back icon-back--nav">‹</text>
      </view>
      <text class="nav-title nav-title--page-grid">我的奖品</text>
      <view class="top-nav-slot--spacer"></view>
    </view>
  </view>

  <scroll-view class="page-scroll" scroll-y enhanced show-scrollbar="{{false}}">
    <view style="height: {{navPlaceholderHeight}}px;"></view>

    <view class="ab-loading" wx:if="{{loading}}">
      <view class="loading-spinner-lg"></view>
      <text class="ab-loading-text">正在加载奖品…</text>
    </view>
    <view class="ab-error" wx:elif="{{error}}">
      <text class="ab-error-text">{{error}}</text>
      <view class="ab-retry-btn" bindtap="onRetry"><text>重试</text></view>
    </view>

    <block wx:else>
      <view class="ab-summary">
        <view class="ab-summary-total">
          <text class="ab-summary-num">{{total}}</text>
          <text class="ab-summary-label">已抽中</text>
        </view>
        <view class="ab-summary-rarities" wx:if="{{tierCounts.length}}">
          <text
            class="ab-rarity-pill ab-rarity-pill--{{item.tier}}"
            wx:for="{{tierCounts}}"
            wx:key="tier"
          >{{item.label}} ×{{item.count}}</text>
        </view>
      </view>

      <view class="ab-empty" wx:if="{{!total}}">
        <text class="ab-empty-text">还没有抽到现场奖品</text>
        <view class="ab-empty-btn" bindtap="onGoGacha"><text>去抽奖</text></view>
      </view>

      <view class="ab-grid" wx:else>
        <view
          class="ab-cell ab-cell--{{item.tier}}"
          wx:for="{{list}}"
          wx:key="drawId"
          bindtap="onViewCard"
          data-index="{{index}}"
        >
          <image class="ab-cell-image" wx:if="{{item.image}}" src="{{item.image}}" mode="aspectFill" lazy-load />
          <view class="ab-cell-image ab-cell-image--empty" wx:else><text>✦</text></view>
          <text class="ab-cell-name">{{item.name}}</text>
          <text class="ab-cell-serial" wx:if="{{item.valueText}}">{{item.valueText}}</text>
          <text class="ab-cell-serial">{{item.sessionTitle || ''}} · {{item.dateText}}</text>
        </view>
      </view>
    </block>

    <view class="page-footer">
      <text class="footer-text">Per Aspera Ad Astra · 循此苦旅以达星辰</text>
    </view>
  </scroll-view>

  <!-- 单卡查看：与抽卡结果同一张票券卡面（styles/prize-card.wxss） -->
  <view class="ab-overlay" wx:if="{{viewCard}}" bindtap="onCloseView">
    <view class="ab-view-wrap" catchtap="">
      <view class="pcard pcard--{{viewCard.tier}}">
        <view class="pcard-shine"></view>
        <view class="pcard-head">
          <view class="pcard-brand">
            <text class="pcard-brand-mark">✦</text>
            <view class="pcard-brand-col">
              <text class="pcard-brand-name">火箭观礼</text>
              <text class="pcard-brand-en">ON-SITE PRIZE</text>
            </view>
          </view>
          <view class="pcard-tier pcard-tier--{{viewCard.tier}}">
            <text>{{viewCard.tierLabel}}</text>
          </view>
        </view>
        <view class="pcard-media">
          <image class="pcard-image" wx:if="{{viewCard.image}}" src="{{viewCard.image}}" mode="aspectFill" />
          <view class="pcard-image pcard-image--empty" wx:else>
            <text>✦</text>
          </view>
          <text class="pcard-media-en">{{viewCard.tierEn}}</text>
          <view class="pcard-serial-chip" wx:if="{{viewCard.serialText}}">
            <text>{{viewCard.serialText}}</text>
          </view>
        </view>
        <text class="pcard-name">{{viewCard.name}}</text>
        <view class="pcard-value" wx:if="{{viewCard.valueYuan != null}}">
          <text class="pcard-value-sym">¥</text>
          <text class="pcard-value-num">{{viewCard.valueYuan}}</text>
          <text class="pcard-value-note">奖品价值 · 商家提供</text>
        </view>
        <text class="pcard-desc" wx:elif="{{viewCard.desc}}">{{viewCard.desc}}</text>
        <view class="pcard-tear">
          <view class="pcard-tear-notch pcard-tear-notch--l"></view>
          <view class="pcard-tear-line"></view>
          <view class="pcard-tear-notch pcard-tear-notch--r"></view>
        </view>
        <view class="pcard-stub">
          <view class="pcard-stub-row" wx:if="{{viewCard.sessionLine}}">
            <text class="pcard-stub-label">观礼场次</text>
            <text class="pcard-stub-value">{{viewCard.sessionLine}}</text>
          </view>
          <view class="pcard-stub-row" wx:if="{{viewCard.voucherNo || viewCard.dateText}}">
            <text class="pcard-stub-label">领奖凭证</text>
            <text class="pcard-stub-value">{{viewCard.voucherNo}}{{viewCard.voucherNo && viewCard.dateText ? ' · ' : ''}}{{viewCard.dateText}}</text>
          </view>
          <text class="pcard-redeem">凭此卡向现场工作人员领取奖品</text>
        </view>
      </view>
      <button class="ab-view-share" open-type="share">炫耀一下</button>
    </view>
  </view>
</view>
