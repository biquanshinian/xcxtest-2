<page-meta background-color="{{pageBgColor}}" background-color-top="{{pageBgColor}}" background-color-bottom="{{pageBgColor}}" />
<view class="page {{themeClass}}">
  <view class="top-nav-wrapper" style="padding-top:{{statusBarHeight}}px;">
    <view class="top-nav top-nav--page-grid">
      <view class="top-nav-slot--back {{isDirectEntry ? 'top-nav-slot--home' : ''}}" bindtap="goBack">
        <text class="icon-back icon-back--nav">‹</text>
      </view>
      <text class="nav-title nav-title--page-grid">{{editing ? '编辑场次' : '新建场次'}}</text>
      <view class="top-nav-slot--spacer"></view>
    </view>
  </view>

  <scroll-view class="page-scroll" scroll-y show-scrollbar="{{false}}">
    <view style="height: {{navPlaceholderHeight}}px;"></view>

    <view class="wpe-loading" wx:if="{{loading}}">
      <view class="loading-spinner-lg"></view>
      <text class="wpe-loading-text">正在加载…</text>
    </view>

    <view class="wpe-error" wx:elif="{{error}}">
      <text class="wpe-error-text">{{error}}</text>
      <view class="wpe-retry-btn" bindtap="onRetry"><text>重试</text></view>
    </view>

    <block wx:else>
      <!-- 发射任务 -->
      <view class="section-header">
        <text class="section-title">发射任务</text>
        <view class="wpe-mode-switch">
          <view class="wpe-mode-item {{missionMode === 'auto' ? 'wpe-mode-item--on' : ''}}" bindtap="onMissionModeTap" data-mode="auto"><text>自动获取</text></view>
          <view class="wpe-mode-item {{missionMode === 'manual' ? 'wpe-mode-item--on' : ''}}" bindtap="onMissionModeTap" data-mode="manual"><text>手动填写</text></view>
        </view>
      </view>

      <view class="wpe-card" wx:if="{{missionMode === 'auto'}}">
        <view class="wpe-picker-row" bindtap="onOpenMissionSheet">
          <image
            wx:if="{{selectedRocketImage && missionIndex >= 0}}"
            class="wpe-rocket-thumb"
            src="{{selectedRocketImage}}"
            mode="aspectFill"
          />
          <view wx:elif="{{missionIndex >= 0}}" class="wpe-rocket-thumb wpe-rocket-thumb--empty">
            <text>🚀</text>
          </view>
          <text class="wpe-picker-text {{missionIndex < 0 ? 'wpe-picker-text--ph' : ''}}">
            {{missionIndex >= 0 ? missionLabels[missionIndex] : (missionLoading ? '正在获取即将发射的任务…' : (missionOptions.length ? '点击选择即将发射的任务' : '任务列表暂不可用，请切「手动填写」'))}}
          </text>
          <text class="wpe-picker-arrow">›</text>
        </view>
        <view class="wpe-mission-picked" wx:if="{{form.missionId}}">
          <image
            wx:if="{{selectedRocketImage}}"
            class="wpe-rocket-thumb wpe-rocket-thumb--picked"
            src="{{selectedRocketImage}}"
            mode="aspectFill"
          />
          <view wx:else class="wpe-rocket-thumb wpe-rocket-thumb--picked wpe-rocket-thumb--empty">
            <text>🚀</text>
          </view>
          <view class="wpe-mission-picked-info">
            <text class="wpe-mission-line">火箭型号：{{form.rocketName || '—'}}</text>
            <text class="wpe-mission-line">任务名称：{{form.missionName || '—'}}</text>
            <text class="wpe-hint">发射时间与任务信息已自动带入，选错可重新选择；配置图已锁定，之后手动改火箭名不会换图</text>
          </view>
        </view>
      </view>

      <view class="wpe-card" wx:else>
        <view class="wpe-form-row" wx:if="{{selectedRocketImage || form.rocketName}}">
          <text class="wpe-form-label">配置图</text>
          <view class="wpe-manual-rocket">
            <image
              wx:if="{{selectedRocketImage}}"
              class="wpe-rocket-thumb"
              src="{{selectedRocketImage}}"
              mode="aspectFill"
            />
            <view wx:else class="wpe-rocket-thumb wpe-rocket-thumb--empty">
              <text>🚀</text>
            </view>
            <text class="wpe-manual-rocket-tip">{{form.rocketImageName ? '已锁定自动获取的配置图，改火箭名不换图' : '根据火箭型号自动匹配'}}</text>
          </view>
        </view>
        <view class="wpe-divider" wx:if="{{selectedRocketImage || form.rocketName}}"></view>
        <view class="wpe-form-row">
          <text class="wpe-form-label">火箭型号</text>
          <textarea id="c_form_rocketName" class="wpe-form-input" value="{{form.rocketName}}" placeholder="例：长征八号" placeholder-class="wpe-ph" maxlength="40" data-path="form.rocketName" bindinput="onTextInput" cursor-spacing="24" confirm-type="done" show-confirm-bar="{{false}}" disable-default-padding="{{true}}" data-single="1" />
        </view>
        <view class="wpe-divider"></view>
        <view class="wpe-form-row">
          <text class="wpe-form-label">任务名称</text>
          <textarea id="c_form_missionName" class="wpe-form-input" value="{{form.missionName}}" placeholder="选填，例：卫星互联网低轨组网" placeholder-class="wpe-ph" maxlength="60" data-path="form.missionName" bindinput="onTextInput" cursor-spacing="24" confirm-type="done" show-confirm-bar="{{false}}" disable-default-padding="{{true}}" data-single="1" />
        </view>
        <view class="wpe-divider"></view>
        <view class="wpe-form-row">
          <text class="wpe-form-label">发射日期</text>
          <picker mode="date" value="{{manualDate}}" bindchange="onManualDateChange">
            <text class="wpe-form-value {{manualDate ? '' : 'wpe-ph'}}">{{manualDate || '点击选择'}}</text>
          </picker>
        </view>
        <view class="wpe-divider"></view>
        <view class="wpe-form-row">
          <text class="wpe-form-label">发射时刻</text>
          <picker mode="time" value="{{manualTime}}" bindchange="onManualTimeChange">
            <text class="wpe-form-value {{manualTime ? '' : 'wpe-ph'}}">{{manualTime || '点击选择'}}</text>
          </picker>
        </view>
      </view>

      <!-- 任务显示名（商家自定义中文名，跨商家共享；仅该任务下最早入驻的商家可改） -->
      <view class="wpe-card" wx:if="{{form.missionId && (missionNameEditable || missionDisplayName)}}">
        <view class="wpe-form-row">
          <text class="wpe-form-label">任务中文名</text>
          <textarea
            wx:if="{{missionNameEditable}}"
            id="c_missionDisplayName" class="wpe-form-input"
            value="{{missionDisplayName}}"
            placeholder="{{missionNameLoading ? '加载中…' : '选填，例：千帆星座第六批'}}"
            placeholder-class="wpe-ph"
            maxlength="60"
            data-path="missionDisplayName"
            bindinput="onTextInput"
            cursor-spacing="24" confirm-type="done" show-confirm-bar="{{false}}" disable-default-padding="{{true}}" data-single="1" />
          <text wx:else class="wpe-form-value">{{missionDisplayName}}</text>
        </view>
        <text class="wpe-hint wpe-hint--pad" wx:if="{{missionNameEditable}}">给英文任务起个中文名，所有用户页面将优先显示；由该任务下最早入驻的商家维护，留空则显示原名</text>
        <text class="wpe-hint wpe-hint--pad" wx:else>任务中文名由该任务下最早入驻的商家维护，您暂无修改权限</text>
      </view>

      <!-- 基本信息 -->
      <view class="section-header"><text class="section-title">场次信息</text></view>
      <view class="wpe-card">
        <view class="wpe-form-row">
          <text class="wpe-form-label">场次标题</text>
          <textarea id="c_form_title" class="wpe-form-input" value="{{form.title}}" placeholder="选任务后自动生成，可修改" placeholder-class="wpe-ph" maxlength="60" data-path="form.title" bindinput="onTextInput" cursor-spacing="24" confirm-type="done" show-confirm-bar="{{false}}" disable-default-padding="{{true}}" data-single="1" />
        </view>
        <view class="wpe-divider"></view>
        <view class="wpe-form-row">
          <text class="wpe-form-label">亮点角标</text>
          <textarea id="c_form_heroBadge" class="wpe-form-input" value="{{form.heroBadge}}" placeholder="例：近距离观礼 · 距工位约1.5km" placeholder-class="wpe-ph" maxlength="30" data-path="form.heroBadge" bindinput="onTextInput" cursor-spacing="24" confirm-type="done" show-confirm-bar="{{false}}" disable-default-padding="{{true}}" data-single="1" />
        </view>
        <view class="wpe-divider"></view>
        <view class="wpe-form-row">
          <text class="wpe-form-label">联系电话</text>
          <textarea id="c_form_contactPhone" class="wpe-form-input" value="{{form.contactPhone}}" placeholder="顾客页可一键拨打，选填" placeholder-class="wpe-ph" maxlength="20" data-path="form.contactPhone" bindinput="onTextInput" cursor-spacing="24" confirm-type="done" show-confirm-bar="{{false}}" disable-default-padding="{{true}}" data-single="1" />
        </view>
        <view class="wpe-divider"></view>
        <view class="wpe-form-row">
          <text class="wpe-form-label">观礼点地址</text>
          <textarea id="c_form_address" class="wpe-form-input" value="{{form.address}}" placeholder="例：龙楼镇 ×× 号楼顶观礼台" placeholder-class="wpe-ph" maxlength="120" data-path="form.address" bindinput="onTextInput" cursor-spacing="24" confirm-type="done" show-confirm-bar="{{false}}" disable-default-padding="{{true}}" data-single="1" />
        </view>
        <view class="wpe-divider"></view>
        <view class="wpe-form-row">
          <text class="wpe-form-label">观礼点定位</text>
          <view class="wpe-loc-actions">
            <text class="wpe-loc-status" wx:if="{{located}}" bindtap="onOpenLocationPreview">已定位 ✓</text>
            <view class="wpe-loc-btn" bindtap="onChooseLocation"><text>{{located ? '重新选点' : '地图选点'}}</text></view>
          </view>
        </view>
        <text class="wpe-hint wpe-hint--pad">在地图上点一下观礼位置即可，用户会按这个定位一键导航过来</text>
      </view>

      <!-- 停车点 -->
      <view class="section-header">
        <text class="section-title">停车点</text>
        <view class="wpe-add-link" bindtap="onAddParking"><text>+ 添加</text></view>
      </view>
      <view class="wpe-card">
        <block wx:if="{{parkingSpots.length}}">
          <view class="wpe-park" wx:for="{{parkingSpots}}" wx:key="index">
            <view class="wpe-park-head">
              <text class="wpe-park-idx">停车点 {{index + 1}}</text>
              <text class="wpe-park-del" bindtap="onRemoveParking" data-index="{{index}}">删除</text>
            </view>
            <view class="wpe-form-row">
              <text class="wpe-form-label">名称</text>
              <textarea id="c_parkingSpots_{{index}}_name" class="wpe-form-input" value="{{item.name}}" placeholder="例：村口停车场" placeholder-class="wpe-ph" maxlength="40" data-path="parkingSpots[{{index}}].name" bindinput="onTextInput" cursor-spacing="24" confirm-type="done" show-confirm-bar="{{false}}" disable-default-padding="{{true}}" data-single="1" />
            </view>
            <view class="wpe-divider"></view>
            <view class="wpe-form-row">
              <text class="wpe-form-label">坐标</text>
              <view class="wpe-loc-actions">
                <text class="wpe-loc-status" wx:if="{{item.lat && item.lng}}">已定位 ✓</text>
                <view class="wpe-loc-btn" bindtap="onChooseParkingLocation" data-index="{{index}}"><text>{{item.lat && item.lng ? '重新选点' : '地图选点'}}</text></view>
              </view>
            </view>
            <view class="wpe-divider"></view>
            <view class="wpe-form-row">
              <text class="wpe-form-label">步行分钟</text>
              <textarea id="c_parkingSpots_{{index}}_walkMinutes" class="wpe-form-input" value="{{item.walkMinutes}}" placeholder="选填" placeholder-class="wpe-ph" maxlength="3" data-path="parkingSpots[{{index}}].walkMinutes" bindinput="onTextInput" cursor-spacing="24" confirm-type="done" show-confirm-bar="{{false}}" disable-default-padding="{{true}}" data-single="1" />
            </view>
            <view class="wpe-divider"></view>
            <view class="wpe-form-row">
              <text class="wpe-form-label">备注</text>
              <textarea id="c_parkingSpots_{{index}}_note" class="wpe-form-input" value="{{item.note}}" placeholder="例：免费 / 需向村民示意" placeholder-class="wpe-ph" maxlength="80" data-path="parkingSpots[{{index}}].note" bindinput="onTextInput" cursor-spacing="24" confirm-type="done" show-confirm-bar="{{false}}" disable-default-padding="{{true}}" data-single="1" />
            </view>
          </view>
        </block>
        <text class="wpe-hint wpe-hint--pad" wx:else>可选。添加后用户可在观礼详情页一键导航到停车点</text>
        <text class="wpe-hint wpe-hint--pad" wx:if="{{parkingSpots.length}}">最多 10 个；无名称的停车点保存时会自动忽略</text>
      </view>

      <!-- 服务套餐（多选，用户可见） -->
      <view class="section-header"><text class="section-title">服务套餐</text></view>
      <view class="wpe-card">
        <text class="wpe-area-label">按自身能力勾选，用户将在落地页看到这些服务</text>
        <view
          class="wpe-card-row"
          wx:for="{{serviceRows}}"
          wx:key="id"
          bindtap="onToggleService"
          data-id="{{item.id}}"
        >
          <view class="wpe-card-info">
            <text class="wpe-card-name">{{item.label}}</text>
          </view>
          <view class="wpe-check {{item.selected ? 'wpe-check--on' : ''}}">
            <text wx:if="{{item.selected}}">✓</text>
          </view>
        </view>
      </view>

      <!-- 介绍与须知 -->
      <view class="section-header"><text class="section-title">介绍与须知</text></view>
      <view class="wpe-card">
        <text class="wpe-area-label">观礼介绍（视野、设施等）</text>
        <textarea id="c_form_intro" class="wpe-textarea" value="{{form.intro}}" placeholder="例：楼顶开阔视野，正对发射工位，提供饮水与遮阳棚…" placeholder-class="wpe-ph" maxlength="2000" show-confirm-bar="{{false}}" data-path="form.intro" bindinput="onTextInput" cursor-spacing="24" />
        <view class="wpe-divider"></view>
        <text class="wpe-area-label">现场照片（最多 8 张，自动在顾客页展示）</text>
        <view class="wpe-img-grid">
          <view class="wpe-img-cell" wx:for="{{sitePhotos}}" wx:key="*this">
            <image class="wpe-img" src="{{item}}" mode="aspectFill" bindtap="onPreviewSitePhoto" data-index="{{index}}" />
            <view class="wpe-img-del" catchtap="onRemoveSitePhoto" data-index="{{index}}"><text>×</text></view>
          </view>
          <view class="wpe-img-add" bindtap="onAddSitePhotos" wx:if="{{sitePhotos.length < 8}}">
            <text class="wpe-img-add-plus">＋</text>
            <text class="wpe-img-add-text">{{sitePhotoUploading ? '上传中…' : '添加照片'}}</text>
          </view>
        </view>
        <view class="wpe-divider"></view>
        <text class="wpe-area-label">现场视频（可选 1 个，60 秒内；自动压缩，压缩后需小于 20MB）</text>
        <view class="wpe-img-grid" wx:if="{{siteVideo}}">
          <view class="wpe-img-cell">
            <image wx:if="{{siteVideoPoster}}" class="wpe-img" src="{{siteVideoPoster}}" mode="aspectFill" />
            <view wx:else class="wpe-img wpe-video-ph"><text>视频</text></view>
            <view class="wpe-video-badge"><text>▶</text></view>
            <view class="wpe-img-del" catchtap="onRemoveSiteVideo"><text>×</text></view>
          </view>
        </view>
        <view class="wpe-img-add" wx:else bindtap="onUploadSiteVideo">
          <text class="wpe-img-add-plus">＋</text>
          <text class="wpe-img-add-text">{{siteVideoUploading ? '上传中…' : '上传视频'}}</text>
        </view>
        <view class="wpe-divider"></view>
        <text class="wpe-area-label">微信二维码（最多 2 张，上传几张顾客页显示几张）</text>
        <view class="wpe-img-grid">
          <view class="wpe-img-cell" wx:for="{{wechatGroupQrs}}" wx:key="*this">
            <image class="wpe-img" src="{{item}}" mode="aspectFill" bindtap="onPreviewWechatQr" data-index="{{index}}" />
            <view class="wpe-img-del" catchtap="onRemoveWechatQr" data-index="{{index}}"><text>×</text></view>
          </view>
          <view class="wpe-img-add" bindtap="onUploadWechatQr" wx:if="{{wechatGroupQrs.length < 2}}">
            <text class="wpe-img-add-plus">＋</text>
            <text class="wpe-img-add-text">{{qrUploading ? '上传中…' : '上传群码'}}</text>
          </view>
        </view>
        <view class="wpe-divider"></view>
        <text class="wpe-area-label">观礼须知（安全提示等）</text>
        <textarea id="c_form_notice" class="wpe-textarea" value="{{form.notice}}" placeholder="例：请勿携带无人机；发射前 30 分钟停止入场…" placeholder-class="wpe-ph" maxlength="2000" show-confirm-bar="{{false}}" data-path="form.notice" bindinput="onTextInput" cursor-spacing="24" />
      </view>

      <!-- 管控区车辆预约（小程序短链） -->
      <view class="section-header"><text class="section-title">车辆预约</text></view>
      <view class="wpe-card">
        <text class="wpe-area-label">车辆预约小程序短链（按当地规定自行填写）</text>
        <textarea id="c_vehicleBookingUrl" class="wpe-form-input wpe-form-input--block" value="{{vehicleBookingUrl}}" placeholder="例：#小程序://车辆预约/xxxxxx" placeholder-class="wpe-ph" maxlength="500" data-path="vehicleBookingUrl" bindinput="onTextInput" cursor-spacing="24" confirm-type="done" show-confirm-bar="{{false}}" disable-default-padding="{{true}}" data-single="1" />
        <text class="wpe-hint">在预约小程序内「…」→ 复制链接 获取短链；顾客点击即可直接跳转到该小程序预约</text>
      </view>

      <!-- 大屏科普轮播 -->
      <view class="section-header"><text class="section-title">大屏科普轮播</text></view>
      <view class="wpe-card">
        <text class="wpe-area-label">科普文字（每行一条，支持「标题|正文」）</text>
        <textarea id="c_sciencePointsText" class="wpe-textarea" value="{{sciencePointsText}}" placeholder="例：长征八号有多高？|全长约 50 米，相当于 17 层楼" placeholder-class="wpe-ph" maxlength="4000" show-confirm-bar="{{false}}" data-path="sciencePointsText" bindinput="onTextInput" cursor-spacing="24" />
        <view class="wpe-divider"></view>
        <text class="wpe-area-label">发射配置图（手机相册上传，将在大屏轮播展示）</text>
        <view class="wpe-img-grid">
          <view class="wpe-img-cell" wx:for="{{scienceImages}}" wx:key="*this">
            <image class="wpe-img" src="{{item}}" mode="aspectFill" bindtap="onPreviewImage" data-index="{{index}}" />
            <view class="wpe-img-del" catchtap="onRemoveImage" data-index="{{index}}"><text>×</text></view>
          </view>
          <view class="wpe-img-add" bindtap="onAddImages" wx:if="{{scienceImages.length < 10}}">
            <text class="wpe-img-add-plus">＋</text>
            <text class="wpe-img-add-text">上传</text>
          </view>
        </view>
      </view>

      <!-- 现场奖品抽奖 -->
      <view class="section-header">
        <text class="section-title">现场奖品</text>
        <view class="wpe-add-link" wx:if="{{prizeDrawEnabled}}" bindtap="onAddPrize"><text>+ 添加</text></view>
      </view>
      <view class="wpe-card">
        <view class="wpe-form-row">
          <text class="wpe-form-label">开启现场抽奖</text>
          <switch checked="{{prizeDrawEnabled}}" color="#3B82F6" bindchange="onPrizeDrawToggle" />
        </view>
        <text class="wpe-hint wpe-hint--pad">默认关闭。开启后须：①用户扫现场物料码 ②您在场次页点「确认发射成功」后，用户才能抽奖。奖品照片、名称、数量自定义，列表顺序即展示等级</text>
        <block wx:if="{{prizeDrawEnabled}}">
          <view class="wpe-park" wx:for="{{prizes}}" wx:key="index">
            <view class="wpe-park-head">
              <text class="wpe-park-idx">奖品 {{index + 1}}</text>
              <view class="wpe-prize-ops">
                <text class="wpe-prize-op" bindtap="onMovePrize" data-index="{{index}}" data-dir="up">上移</text>
                <text class="wpe-prize-op" bindtap="onMovePrize" data-index="{{index}}" data-dir="down">下移</text>
                <text class="wpe-park-del" bindtap="onRemovePrize" data-index="{{index}}">删除</text>
              </view>
            </view>
            <view class="wpe-prize-img-row">
              <view class="wpe-prize-img-box" bindtap="onChoosePrizeImage" data-index="{{index}}">
                <image wx:if="{{item.image}}" class="wpe-prize-img" src="{{item.image}}" mode="aspectFill" />
                <text wx:else class="wpe-prize-img-ph">上传照片</text>
              </view>
              <view class="wpe-prize-fields">
                <textarea id="c_prizes_{{index}}_name" class="wpe-form-input" value="{{item.name}}" placeholder="奖品名称（必填）" placeholder-class="wpe-ph" maxlength="40" data-path="prizes[{{index}}].name" bindinput="onTextInput" cursor-spacing="24" confirm-type="done" show-confirm-bar="{{false}}" disable-default-padding="{{true}}" data-single="1" />
                <view class="wpe-prize-meta-row">
                  <text class="wpe-prize-meta-label">数量</text>
                  <textarea id="c_prizes_{{index}}_stock" class="wpe-form-input wpe-prize-num" value="{{item.stock}}" placeholder="1" placeholder-class="wpe-ph" maxlength="4" data-path="prizes[{{index}}].stock" bindinput="onTextInput" cursor-spacing="24" confirm-type="done" show-confirm-bar="{{false}}" disable-default-padding="{{true}}" data-single="1" />
                  <text class="wpe-prize-meta-label">价值¥</text>
                  <textarea id="c_prizes_{{index}}_valueYuan" class="wpe-form-input wpe-prize-num" value="{{item.valueYuan}}" placeholder="选填" placeholder-class="wpe-ph" maxlength="8" data-path="prizes[{{index}}].valueYuan" bindinput="onTextInput" cursor-spacing="24" confirm-type="done" show-confirm-bar="{{false}}" disable-default-padding="{{true}}" data-single="1" />
                </view>
                <text class="wpe-hint" wx:if="{{editing && item.id}}">剩余 {{item.remaining}} / {{item.stock}}（已发放不可改小库存）</text>
              </view>
            </view>
          </view>
          <text class="wpe-hint wpe-hint--pad" wx:if="{{!prizes.length}}">请添加奖品：上传照片、填写名称与数量；排序靠前的奖品展示等级更高</text>
        </block>
      </view>

      <!-- 预约设置 -->
      <view class="section-header"><text class="section-title">预约设置</text></view>
      <view class="wpe-card">
        <view class="wpe-form-row">
          <text class="wpe-form-label">预约人数上限</text>
          <textarea id="c_form_capacity" class="wpe-form-input" value="{{form.capacity}}" placeholder="不填 = 不限制" placeholder-class="wpe-ph" maxlength="5" data-path="form.capacity" bindinput="onTextInput" cursor-spacing="24" confirm-type="done" show-confirm-bar="{{false}}" disable-default-padding="{{true}}" data-single="1" />
        </view>
        <view class="wpe-divider"></view>
        <view class="wpe-form-row">
          <text class="wpe-form-label">开放预约</text>
          <switch checked="{{form.status === 'open'}}" color="#3B82F6" bindchange="onStatusToggle" />
        </view>
        <text class="wpe-hint wpe-hint--pad">开放中也会在距发射 30 分钟时自动停止新预约，便于备场核对名单，无需手动关闭</text>
        <view class="wpe-divider"></view>
        <view class="wpe-form-row">
          <text class="wpe-form-label">对用户可见</text>
          <switch checked="{{form.enabled}}" color="#3B82F6" bindchange="onEnabledToggle" />
        </view>
        <view class="wpe-divider"></view>
        <view class="wpe-form-row">
          <text class="wpe-form-label">扫码赠通行证</text>
          <switch checked="{{form.passEnabled}}" color="#3B82F6" bindchange="onPassToggle" />
        </view>
        <view class="wpe-divider" wx:if="{{form.passEnabled}}"></view>
        <view class="wpe-form-row" wx:if="{{form.passEnabled}}">
          <text class="wpe-form-label">通行证时长</text>
          <slider
            class="wpe-form-slider"
            min="1"
            max="48"
            step="1"
            value="{{form.passHours}}"
            show-value
            activeColor="#3B82F6"
            bindchange="onPassHoursChange"
          />
        </view>
        <text class="wpe-hint wpe-hint--pad">默认关闭。开启后现场扫场次码即赠限时免会员（含 AI 次数，与 Pro 同等）；开启默认 12 小时，最长 48 小时</text>
      </view>

      <view class="wpe-save-wrap">
        <view class="wpe-save-btn {{saving ? 'wpe-save-btn--disabled' : ''}}" bindtap="onSave">
          <text>{{saving ? '保存中…' : (editing ? '保存修改' : '创建场次')}}</text>
        </view>
        <text class="wpe-save-note" wx:if="{{!editing}}">创建后自动生成场次短码与现场物料码，无需其他操作</text>
      </view>
    </block>

    <view class="page-footer">
      <text class="footer-text">Per Aspera Ad Astra · 循此苦旅以达星辰</text>
    </view>
  </scroll-view>

  <!-- 隐私授权弹窗：地图选点（wx.chooseLocation）触发隐私授权时由 app.js 唤起 -->
  <privacy-modal id="globalPrivacyModal"></privacy-modal>

  <!-- 任务选择弹层：左侧火箭配置图，便于商家按外形识别 -->
  <view class="wpe-sheet-mask" wx:if="{{showMissionSheet}}" bindtap="onCloseMissionSheet" catchtouchmove="preventMove">
    <view class="wpe-sheet" catchtap="">
      <view class="wpe-sheet-head">
        <text class="wpe-sheet-title">选择即将发射的任务</text>
        <text class="wpe-sheet-close" bindtap="onCloseMissionSheet">关闭</text>
      </view>
      <scroll-view class="wpe-sheet-scroll" scroll-y enhanced show-scrollbar="{{false}}">
        <view
          class="wpe-mission-option {{missionIndex === index ? 'wpe-mission-option--on' : ''}}"
          wx:for="{{missionOptions}}"
          wx:key="missionId"
          bindtap="onMissionSelect"
          data-index="{{index}}"
        >
          <image
            wx:if="{{item.rocketImage}}"
            class="wpe-rocket-thumb"
            src="{{item.rocketImage}}"
            mode="aspectFill"
          />
          <view wx:else class="wpe-rocket-thumb wpe-rocket-thumb--empty">
            <text>🚀</text>
          </view>
          <view class="wpe-mission-option-info">
            <text class="wpe-mission-option-rocket">{{item.rocketName || '未知火箭'}}</text>
            <text class="wpe-mission-option-name">{{item.missionName || item.name || '任务待定'}}</text>
            <text class="wpe-mission-option-time">{{item.launchTimeText}}</text>
          </view>
          <text class="wpe-mission-option-check" wx:if="{{missionIndex === index}}">✓</text>
        </view>
      </scroll-view>
    </view>
  </view>
</view>
