/* 观礼现场奖品抽奖页
 * 中性色走 tokens.wxss 变量（根节点 themeClass 挂 theme-light 时自动翻转）。
 * 抽卡台卡背 / 结果覆盖层保持深色「实体卡」质感，两种主题下一致，不做翻转。
 * 结果卡票券样式与卡册共用：styles/prize-card.wxss。
 */
@import "styles/prize-card.wxss";

/* 页面骨架（与其他分包详情页同款） */
.page {
  min-height: 100vh;
  background: var(--color-bg);
  color: var(--color-text-primary);
  transition: padding-bottom 0.22s ease;
  box-sizing: border-box;
}
.page-scroll { height: 100vh; width: 100%; box-sizing: border-box; padding-bottom: env(safe-area-inset-bottom); }
.section-header { display: flex; align-items: center; padding: 40rpx 32rpx 20rpx; gap: 12rpx; }
.section-title { font-size: 32rpx; font-weight: 600; color: var(--color-text-primary); flex: 1; }
.loading-spinner-lg { width: 56rpx; height: 56rpx; border: 4rpx solid var(--color-divider); border-top-color: #A855F7; border-radius: 50%; animation: spin 0.8s linear infinite; }
@keyframes spin { to { transform: rotate(360deg); } }
.page-footer { text-align: center; padding: 40rpx 0 80rpx; }
.footer-text { font-size: 22rpx; color: var(--color-text-quaternary); }

.gc-loading {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 160rpx 0;
  gap: 24rpx;
}

.gc-loading-text {
  font-size: 26rpx;
  color: var(--color-text-tertiary);
}

.gc-error {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 140rpx 48rpx;
  gap: 20rpx;
}

.gc-error-text {
  font-size: 28rpx;
  color: var(--color-text-secondary);
  text-align: center;
}

.gc-retry-btn {
  margin-top: 12rpx;
  padding: 16rpx 64rpx;
  border-radius: 40rpx;
  background: #3B82F6;
  color: #fff;
  font-size: 28rpx;
}

/* ── 扫码失败兜底：手动输入场次码 ── */
.gc-code-fallback {
  margin-top: 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  width: 100%;
}

.gc-code-fallback-tip {
  font-size: 24rpx;
  color: var(--color-text-tertiary);
}

.gc-code-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.gc-code-input {
  width: 320rpx;
  height: 76rpx;
  min-height: 76rpx;
  /* 单行 textarea：行高 + 上下 padding 垂直居中 */
  line-height: 40rpx;
  padding: 18rpx 24rpx;
  border-radius: 38rpx;
  background: rgba(255, 255, 255, 0.08);
  border: 1rpx solid var(--color-divider-strong);
  /* 原生输入组件聚焦时 var() 易失效 → 字面色 */
  color: #F5F5F7;
  caret-color: #F5F5F7;
  font-size: 28rpx;
  text-align: center;
  box-sizing: border-box;
}
.gc-code-ph {
  color: rgba(255, 255, 255, 0.35);
  text-align: center;
}

.gc-code-btn {
  padding: 18rpx 40rpx;
  border-radius: 38rpx;
  background: rgba(59, 130, 246, 0.25);
  border: 1rpx solid rgba(59, 130, 246, 0.5);
  color: #93C5FD;
  font-size: 28rpx;
}

/* ── 观礼通行证横幅 ── */
.gc-pass {
  margin: 20rpx 32rpx 0;
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx 24rpx;
  border-radius: 16rpx;
  background: linear-gradient(135deg, rgba(251, 191, 36, 0.12), rgba(249, 115, 22, 0.08));
  border: 1rpx solid rgba(251, 191, 36, 0.3);
}

.gc-pass-info {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.gc-pass-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #FBBF24;
}

.gc-pass-sub {
  font-size: 22rpx;
  color: var(--color-text-secondary);
}

/* ── 场次信息 ── */
.gc-session {
  margin: 24rpx 32rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.gc-session-title {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--color-text-primary);
}

.gc-session-sub {
  font-size: 24rpx;
  color: var(--color-text-secondary);
}

.gc-ssr-tip {
  margin-top: 8rpx;
  padding: 8rpx 24rpx;
  border-radius: 28rpx;
  font-size: 24rpx;
  color: #FDE68A;
  background: rgba(251, 191, 36, 0.12);
  border: 1rpx solid rgba(251, 191, 36, 0.4);
}

.gc-prize-scroll {
  margin: 24rpx 0 0;
  white-space: nowrap;
  width: 100%;
}
.gc-prize-chip {
  display: inline-flex;
  align-items: center;
  gap: 12rpx;
  margin-left: 24rpx;
  padding: 12rpx 16rpx 12rpx 12rpx;
  border-radius: 16rpx;
  background: var(--color-bg-card);
  border: 1rpx solid var(--color-divider);
  vertical-align: top;
}
.gc-prize-chip:last-child { margin-right: 24rpx; }
.gc-prize-chip-img {
  width: 72rpx;
  height: 72rpx;
  border-radius: 10rpx;
  flex-shrink: 0;
  background: var(--color-divider);
}
.gc-prize-chip-body {
  display: inline-flex;
  flex-direction: column;
  gap: 4rpx;
  max-width: 200rpx;
}
.gc-prize-chip-name {
  font-size: 24rpx;
  color: var(--color-text-primary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.gc-prize-chip-meta {
  font-size: 20rpx;
  color: var(--color-text-tertiary);
}

/* ── 抽奖台 ── */
.gc-stage {
  margin-top: 48rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 28rpx;
}

.gc-deck {
  position: relative;
  width: 340rpx;
  height: 480rpx;
}

.gc-deck--shaking {
  animation: gc-shake 0.4s ease-in-out infinite;
}

@keyframes gc-shake {
  0%, 100% { transform: rotate(0deg); }
  25% { transform: rotate(-2deg); }
  75% { transform: rotate(2deg); }
}

.gc-deck-card {
  position: absolute;
  inset: 0;
  border-radius: 24rpx;
  background: linear-gradient(160deg, #1e1b4b, #0b0c0e);
  border: 1rpx solid rgba(129, 140, 248, 0.4);
}

.gc-deck-card--3 {
  transform: rotate(6deg);
  opacity: 0.5;
}

.gc-deck-card--2 {
  transform: rotate(-4deg);
  opacity: 0.75;
}

.gc-deck-card--1 {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  box-shadow: 0 12rpx 48rpx rgba(99, 102, 241, 0.25);
}

.gc-deck-logo {
  font-size: 88rpx;
  color: #A5B4FC;
}

.gc-deck-text {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.7);
  letter-spacing: 4rpx;
}

.gc-draw-btn {
  padding: 22rpx 120rpx;
  border-radius: 48rpx;
  background: linear-gradient(90deg, #A855F7, #6366F1);
  color: #fff;
  font-size: 32rpx;
  font-weight: 700;
  box-shadow: 0 8rpx 32rpx rgba(168, 85, 247, 0.35);
}

.gc-draw-btn--disabled {
  opacity: 0.45;
  box-shadow: none;
}

.gc-quota-text {
  font-size: 24rpx;
  color: var(--color-text-tertiary);
}

.gc-share-btn {
  padding: 14rpx 48rpx;
  border-radius: 40rpx;
  background: transparent;
  border: 1rpx solid rgba(96, 165, 250, 0.5);
  color: #93C5FD;
  font-size: 26rpx;
  line-height: 1.4;
}

.gc-share-btn::after {
  border: none;
}

/* ── 链接与规则 ── */
.gc-links {
  margin: 48rpx 32rpx 0;
  display: flex;
  gap: 20rpx;
}

.gc-link {
  flex: 1;
  padding: 24rpx 0;
  border-radius: 20rpx;
  background: var(--color-bg-card);
  border: 1rpx solid var(--color-divider);
  text-align: center;
  font-size: 26rpx;
  color: var(--color-text-secondary);
}

.gc-rules {
  margin: 24rpx 32rpx 0;
  padding: 28rpx 32rpx;
  border-radius: 20rpx;
  background: var(--color-bg-card);
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.gc-rules-title {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--color-text-secondary);
}

.gc-rules-item {
  font-size: 24rpx;
  line-height: 1.6;
  color: var(--color-text-tertiary);
}

/* ── 抽卡结果覆盖层（深色实体卡质感，双主题一致，颜色用字面值不翻转） ── */
.gc-overlay {
  position: fixed;
  inset: 0;
  z-index: 999;
  background: rgba(0, 0, 0, 0.88);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 48rpx;
}

.gc-flip-wrap {
  width: 500rpx;
  height: 764rpx;
  perspective: 1200rpx;
}

.gc-flip {
  position: relative;
  width: 100%;
  height: 100%;
  transform-style: preserve-3d;
  transition: transform 0.6s cubic-bezier(0.4, 0.2, 0.2, 1);
}

.gc-flip--flipped {
  transform: rotateY(180deg);
}

.gc-face {
  position: absolute;
  inset: 0;
  border-radius: 28rpx;
  backface-visibility: hidden;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.gc-face--back {
  justify-content: center;
  gap: 20rpx;
  background:
    radial-gradient(100% 70% at 50% 0%, rgba(99, 102, 241, 0.22), transparent 60%),
    linear-gradient(160deg, #1e1b4b, #0b0c0e);
  border: 1rpx solid rgba(129, 140, 248, 0.5);
  overflow: hidden;
}

.gc-face-back-ring {
  position: absolute;
  left: 50%;
  top: 50%;
  border-radius: 50%;
  border: 1rpx solid rgba(129, 140, 248, 0.25);
  transform: translate(-50%, -50%);
}

.gc-face-back-ring--1 { width: 320rpx; height: 320rpx; }
.gc-face-back-ring--2 { width: 480rpx; height: 480rpx; border-color: rgba(129, 140, 248, 0.14); }

.gc-face-back-logo {
  font-size: 100rpx;
  color: #A5B4FC;
}

.gc-face-back-text {
  font-size: 30rpx;
  color: rgba(255, 255, 255, 0.7);
  letter-spacing: 6rpx;
}

.gc-face-back-en {
  font-size: 18rpx;
  letter-spacing: 4rpx;
  color: rgba(255, 255, 255, 0.32);
}

/* 正面视觉全部由 pcard（styles/prize-card.wxss）接管，这里只保留翻面定位 */
.gc-face--front {
  transform: rotateY(180deg);
  align-items: stretch;
}

/* 固定高度卡面内：撕裂线吸底，存根贴在票根位 */
.gc-face--front .pcard-tear {
  margin-top: auto;
}

/* 翻面后扫光掠过；压轴大奖扫两遍 */
.gc-flip--flipped .pcard-shine {
  animation: pcard-shine-sweep 1.5s ease 0.45s both;
}

.gc-flip--flipped .pcard--SSR .pcard-shine {
  animation: pcard-shine-sweep 1.5s ease 0.45s 2 both;
}

/* ── 分档光晕（覆盖层中央、卡片身后） ── */
.gc-halo {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 660rpx;
  height: 900rpx;
  border-radius: 50%;
  transform: translate(-50%, -56%);
  filter: blur(60rpx);
  pointer-events: none;
  animation: gc-halo-pulse 2.6s ease-in-out infinite alternate;
}

.gc-halo--R { background: radial-gradient(closest-side, rgba(59, 130, 246, 0.32), transparent 70%); }
.gc-halo--SR { background: radial-gradient(closest-side, rgba(168, 85, 247, 0.36), transparent 70%); }
.gc-halo--SSR { background: radial-gradient(closest-side, rgba(251, 191, 36, 0.38), transparent 70%); }

@keyframes gc-halo-pulse {
  from { opacity: 0.55; }
  to { opacity: 1; }
}

/* ── SR/SSR 星屑氛围 ── */
.gc-fx {
  position: absolute;
  inset: 0;
  pointer-events: none;
}

.gc-fx-star {
  position: absolute;
  color: #FDE68A;
  text-shadow: 0 0 16rpx rgba(251, 191, 36, 0.8);
  animation: gc-star-twinkle 1.8s ease-in-out infinite;
  opacity: 0;
}

.gc-fx-star--1 { left: 12%; top: 18%; font-size: 30rpx; animation-delay: 0.5s; }
.gc-fx-star--2 { right: 10%; top: 24%; font-size: 22rpx; animation-delay: 0.9s; color: #E9D5FF; }
.gc-fx-star--3 { left: 7%; top: 52%; font-size: 20rpx; animation-delay: 1.3s; color: #fff; }
.gc-fx-star--4 { right: 6%; top: 56%; font-size: 32rpx; animation-delay: 0.7s; }
.gc-fx-star--5 { left: 18%; bottom: 26%; font-size: 24rpx; animation-delay: 1.1s; color: #E9D5FF; }
.gc-fx-star--6 { right: 16%; bottom: 22%; font-size: 26rpx; animation-delay: 1.5s; }

@keyframes gc-star-twinkle {
  0%, 100% { opacity: 0; transform: scale(0.6) rotate(0deg); }
  50% { opacity: 1; transform: scale(1.15) rotate(24deg); }
}

/* 主按钮独占一行居中，次按钮等宽一行在下（三个横排会挤爆换行） */
.gc-overlay-actions {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 24rpx;
}

.gc-overlay-share {
  width: 420rpx;
  margin: 0;
  padding: 20rpx 0;
  border-radius: 48rpx;
  background: linear-gradient(90deg, #F59E0B, #EF4444);
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 1.4;
  text-align: center;
}

.gc-overlay-share::after {
  border: none;
}

.gc-overlay-row {
  display: flex;
  justify-content: center;
  gap: 24rpx;
}

.gc-overlay-btn {
  width: 198rpx;
  padding: 16rpx 0;
  border-radius: 40rpx;
  text-align: center;
  box-sizing: border-box;
  background: rgba(255, 255, 255, 0.12);
  color: #fff;
  font-size: 26rpx;
}

.gc-overlay-btn--ghost {
  background: transparent;
  border: 1rpx solid rgba(255, 255, 255, 0.3);
}

/* ============================================================
 * 明亮主题覆盖：彩色强调与半透明底
 * ============================================================ */

.theme-light .gc-code-input {
  background: rgba(0, 0, 0, 0.04);
  color: #1C1C1E;
  caret-color: #1C1C1E;
}
.theme-light .gc-code-ph { color: #8E8E93; }

.theme-light .gc-code-btn {
  background: rgba(59, 130, 246, 0.1);
  border-color: rgba(37, 99, 235, 0.4);
  color: #2563EB;
}

.theme-light .gc-pass {
  background: linear-gradient(135deg, rgba(251, 191, 36, 0.14), rgba(249, 115, 22, 0.06));
  border-color: rgba(217, 119, 6, 0.35);
}

.theme-light .gc-pass-title { color: #B45309; }

.theme-light .gc-ssr-tip {
  color: #B45309;
  background: rgba(251, 191, 36, 0.14);
  border-color: rgba(217, 119, 6, 0.4);
}

.theme-light .gc-share-btn {
  border-color: rgba(37, 99, 235, 0.45);
  color: #2563EB;
}
